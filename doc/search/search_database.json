32), intent(in), dimension(n_selected_factors) :: factor_indices indices of factors to compute the contributions for\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_factors . integer(kind=int32), intent(in) :: n_selected_factors number of selected factors in factor_indices integer(kind=int32), intent(in), dimension(n_selected_dependents) :: dependent_indices indices of dependents to compute the contributions for\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_factors . integer(kind=int32), intent(in) :: n_selected_dependents number of selected dependents in dependent_indices integer(kind=int32), intent(in) :: baseline_mode Read more… real(kind=real64), intent(out), dimension(n_timepoints, n_selected_factors, n_selected_dependents, n_samples) :: local_contributions Per-timepoint contributions per sample-dependent-factor combination real(kind=real64), intent(out), dimension(n_selected_factors, n_selected_dependents, n_samples) :: total_contributions Total contribution ( sum(local_contributions) ) per sample-dependent-factor combination real(kind=real64), intent(out), dimension(n_timepoints, n_selected_factors) :: tmp_factors Working array to hold the currently handled sample's factors in contiguous memory real(kind=real64), intent(out), dimension(n_timepoints) :: tmp_dependent Working array to hold the currently handled dependent in contiguous memory integer(kind=int32), intent(out) :: ierr Error code public pure subroutine compute_baselines_factor_dependent (n_timepoints, factor, dependent, baseline_mode, factor_baseline, dependent_baseline, ierr) Validates its inputs, then calls compute_baselines_factor_dependent_impl . Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_timepoints Number of timepoints in both factor and dependent arrays real(kind=real64), intent(in), dimension(n_timepoints) :: factor Factor time series, length n_timepoints real(kind=real64), intent(in), dimension(n_t