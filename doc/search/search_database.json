ds_elements_dim_2, ierr) bind(C, name=\"validate_family_centroids_c\") Uses tox_data_validation Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_family_centroids_elements_dim_1, n_family_centroids_elements_dim_2), target :: family_centroids Family centroids array integer(kind=c_int), intent(in), target :: n_family_centroids_elements_dim_1 dimension of family_centroids integer(kind=c_int), intent(in), target :: n_family_centroids_elements_dim_2 dimension of family_centroids integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"proc/validate_family_centroids_c.html"},{"title":"validate_shift_vectors_c – TensorOmics","text":"public  subroutine validate_shift_vectors_c(shift_vectors, n_shift_vectors_elements_dim_1, n_shift_vectors_elements_dim_2, expression_vectors, n_expression_vectors_elements_dim_1, n_expression_vectors_elements_dim_2, family_centroids, n_family_centroids_elements_dim_1, n_family_centroids_elements_dim_2, gene_to_fam, n_gene_to_fam_elements, n_samples, ierr) bind(C, name=\"validate_shift_vectors_c\") Uses tox_data_validation Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_shift_vectors_elements_dim_1, n_shift_vectors_elements_dim_2), target :: shift_vectors shift vectors integer(kind=c_int), intent(in), target :: n_shift_vectors_elements_dim_1 dimension of shift_vectors integer(kind=c_int), intent(in), target :: n_shift_vectors_elements_dim_2 dimension of shift_vectors real(kind=c_double), intent(in), dimension(n_expression_vectors_elements_dim_1, n_expression_vectors_elements_dim_2), target :: expression_vectors expression vectors integer(kind=c_int), intent(in), target :: n_expression_vectors_elements_dim_1 dimension of expression_vectors integer(kind=c_int), intent(in), target :: n_expression_vectors_elements_dim_2 dimension of expression_vectors real(kind=c_double), intent(in), dimension(n_family_centroids_elements_dim_1, n_family_centroids_elements_dim_2), target :: family_centroids family centroids integer(kind=c_int), intent(in), target :: n_family_centroids_elements_dim_1 dimension of family_centroids integer(kind=c_int), intent(in), target :: n_family_centroids_elements_dim_2 dimension of family_centroids integer(kind=c_int), intent(in), dimension(n_gene_to_fam_elements), target :: gene_to_fam gene to family mapping integer(kind=c_int), intent(in), target :: n_gene_to_fam_elements number of elements in gene_to_fam integer(kind=c_int), intent(in), target :: n_samples Number of samples integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"proc/validate_shift_vectors_c.html"},{"title":"validate_string_array_uniqueness_c – TensorOmics","text":"public  subroutine validate_string_array_uniqueness_c(str_arr, str_arr_strlen, n_str_arr_elements, ierr) bind(C, name=\"validate_string_array_uniqueness_c\") Uses tox_data_validation Arguments Type Intent Optional Attributes Name character(kind=c_char, len=1), intent(in), dimension(str_arr_strlen, n_str_arr_elements), target :: str_arr string array integer(kind=c_int), intent(in), target :: str_arr_strlen length of the strings in str_arr integer(kind=c_int), intent(in), target :: n_str_arr_elements number of elements in str_arr integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"proc/validate_string_array_uniqueness_c.html"},{"title":"validate_all_data_c – TensorOmics","text":"public  subroutine validate_all_data_c(n_genes, n_families, n_samples, gene_ids, gene_ids_strlen, n_gene_ids_elements, gene_family_ids, gene_family_ids_strlen, n_gene_family_ids_elements, gene_to_fam, n_gene_to_fam_elements, expression_vectors, n_expression_vectors_elements_dim_1, n_expression_vectors_elements_dim_2, family_centroids, n_family_centroids_elements_dim_1, n_family_centroids_elements_dim_2, shift_vectors, n_shift_vectors_elements_dim_1, n_shift_vectors_elements_dim_2, ierr, check_uniqueness, check_shift_consistency) bind(C, name=\"validate_all_data_c\") Uses tox_data_validation Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_genes Number of genes integer(kind=c_int), intent(in), target :: n_families Number of families integer(kind=c_int), intent(in), target :: n_samples Number of samples character(kind=c_char, len=1), intent(in), dimension(gene_ids_strlen, n_gene_ids_elements), target :: gene_ids Gene ids array integer(kind=c_int), intent(in), target :: gene_ids_strlen length of the strings in gene_ids integer(kind=c_int), intent(in), target :: n_gene_ids_elements number of elements in gene_ids character(kind=c_char, len=1), intent(in), dimension(gene_family_ids_strlen, n_gene_family_ids_elements), target :: gene_family_ids gene family ids integer(kind=c_int), intent(in), target :: gene_family_ids_strlen length of the strings in gene_family_ids integer(kind=c_int), intent(in), target :: n_gene_family_ids_elements number of elements in gene_family_ids integer(kind=c_int), intent(in), dimension(n_gene_to_fam_elements), target :: gene_to_fam gene to family mapping integer(kind=c_int), intent(in), target :: n_gene_to_fam_elements number of elements in gene_to_fam real(kind=c_double), intent(in), dimension(n_expression_vectors_elements_dim_1, n_expression_vectors_elements_dim_2), target :: expression_vectors Expression vectors integer(kind=c_int), intent(in), target :: n_expression_vectors_elements_dim_1 dimension of expression_vectors integer(kind=c_int), intent(in), target :: n_expression_vectors_elements_dim_2 dimension of expression_vectors real(kind=c_double), intent(in), dimension(n_family_centroids_elements_dim_1, n_family_centroids_elements_dim_2), target :: family_centroids family centroids integer(kind=c_int), intent(in), target :: n_family_centroids_elements_dim_1 dimension of family_centroids integer(kind=c_int), intent(in), target :: n_family_centroids_elements_dim_2 dimension of family_centroids real(kind=c_double), intent(in), dimension(n_shift_vectors_elements_dim_1, n_shift_vectors_elements_dim_2), target :: shift_vectors shift vectors integer(kind=c_int), intent(in), target :: n_shift_vectors_elements_dim_1 dimension of shift_vectors integer(kind=c_int), intent(in), target :: n_shift_vectors_elements_dim_2 dimension of shift_vectors integer(kind=c_int), intent(out), target :: ierr error code logical(kind=c_bool), intent(in), target :: check_uniqueness Check ID arrays for uniqueness.\nThe default value is .true. . logical(kind=c_bool), intent(in), target :: check_shift_consistency Check consitency of shift array.\nThe default value is .true. .","tags":"","url":"proc/validate_all_data_c.html"},{"title":"deserialize_int_helper_c – TensorOmics","text":"public  subroutine deserialize_int_helper_c(arr, n_elements, arr_shape, n_arr_shape_elements, filename, filename_strlen, ierr) bind(C, name=\"deserialize_int_helper_c\") Uses f42_serde_arrays_deserialize_int Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(out), dimension(*), target :: arr Pre-allocated array to read the data into integer(kind=c_int), intent(in), target :: n_elements Size of arr integer(kind=c_int), intent(in), dimension(n_arr_shape_elements), target :: arr_shape Extents of arr , one per dimension\nIt is VERY IMPORTANT to compute this argument from the dims_out output produced by get_array_metadata . Producer input Supplied by dims_out_capacity 5_int32 integer(kind=c_int), intent(in), target :: n_arr_shape_elements number of elements in arr_shape character(kind=c_char, len=1), intent(in), dimension(filename_strlen), target :: filename Name of the file integer(kind=c_int), intent(in), target :: filename_strlen length of the strings in filename integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"proc/deserialize_int_helper_c.html"},{"title":"compute_family_scaling_impl – TensorOmics","text":"public  subroutine compute_family_scaling_impl(n_genes, n_families, distances, gene_to_fam, dscale, loess_x, loess_y, indices_used, tmp_perm, tmp_stack_left, tmp_stack_right, tmp_int_workspace, int_workspace_size, tmp_real_workspace, real_workspace_size, tmp_diagl, tmp_weights, tmp_eval_points, tmp_robust_weights, tmp_combined_weights, tmp_residuals, tmp_permutation_indices, tmp_fitted_values, span, degree, mode, n_iters, low_sd_cutoff, excluded_low_sd, tmp_means_aux, ierr) Uses LOESS on the median/stddev of intra-family distances for scaling, regardless of orthologs. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Total number of genes integer(kind=int32), intent(in) :: n_families Total number of gene families real(kind=real64), intent(in) :: distances (n_genes) Array of Euclidean distances for each gene\nNaN is permitted for this value.\nInfinite values are permitted for this value. integer(kind=int32), intent(in) :: gene_to_fam (n_genes) Mapping of each gene to its family (1-based) real(kind=real64), intent(out) :: dscale (n_families) Array of scaling factors per family (output) real(kind=real64), intent(out) :: loess_x (n_families) Reference x-coordinates for LOESS smoothing real(kind=real64), intent(out) :: loess_y (n_families) Reference y-coordinates for LOESS smoothing integer(kind=int32), intent(out) :: indices_used (n_families) Indices of reference points used for smoothing integer(kind=int32), intent(out) :: tmp_perm (n_genes) Permutation array for sorting gene distances integer(kind=int32), intent(out) :: tmp_stack_left (n_genes) Stack array for left indices during sorting integer(kind=int32), intent(out) :: tmp_stack_right (n_genes) Stack array for right indices during sorting integer(kind=int32), intent(out) :: tmp_int_workspace (int_workspace_size) Integer workspace array integer(kind=int32), intent(in) :: int_workspace_size Length of integer workspace.\nIt is VERY IMPORTANT to compute this argument from the int_workspace_size output produced by tox_loess_required_workspace . Producer input Supplied by n_dim 1_int32 max_neighborhood_size n_families save_factorization .false. real(kind=real64), intent(out) :: tmp_real_workspace (real_workspace_size) Real workspace array integer(kind=int32), intent(in) :: real_workspace_size Length of real workspace.\nIt is VERY IMPORTANT to compute this argument from the real_workspace_size output produced by tox_loess_required_workspace . Producer input Supplied by n_dim 1_int32 max_neighborhood_size n_families save_factorization .false. real(kind=real64), intent(inout) :: tmp_diagl (n_families) Diagonal elements of the weight matrix real(kind=real64), intent(out) :: tmp_weights (n_families) Initial weights for LOESS real(kind=real64), intent(inout) :: tmp_eval_points (n_families,1) Z matrix for LOESS fitting real(kind=real64), intent(out) :: tmp_robust_weights (n_families) Residuals for robust LOESS fitting real(kind=real64), intent(out), dimension(n_families), target :: tmp_combined_weights Working weights array real(kind=real64), intent(out), dimension(n_families), target :: tmp_residuals Residuals array integer(kind=int32), intent(out) :: tmp_permutation_indices (n_families) Permutation indices for robust LOESS fitting real(kind=real64), intent(out) :: tmp_fitted_values (n_families) Output array for LOESS predictions real(kind=real64), intent(in), optional :: span Span parameter for LOESS smoothing, passed straight to loess_fit_plain_impl , so it is held to that\nprocedure's own range rather than to the NaN tolerance the distance data carries.\nThe default value is 0.7_real64 .\nThe minimum valid value is EPS_LOESS .\nThe maximum valid value is 1.0_real64 . integer(kind=int32), intent(in), optional :: degree Degree of the LOESS polynomial\nThe default value is 2_int32 . integer(kind=int32), intent(in), optional :: mode Mode for LOESS fitting\nThe default value is 1_int32 . Mode Value Plain LOESS fitting MODE_PLAIN Robust LOESS fitting MODE_ROBUST integer(kind=int32), intent(in), optional :: n_iters Number of iterations for robust LOESS fitting\nThe default value is 3_int32 . real(kind=real64), intent(out) :: low_sd_cutoff cutoff used to filter families with low std integer(kind=int32), intent(out) :: excluded_low_sd (n_families) Mask to save those families that have low sd real(kind=real64), intent(out) :: tmp_means_aux (n_families) Work array for saving raw means integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/compute_family_scaling_impl.html"},{"title":"compute_rdi_impl – TensorOmics","text":"public pure subroutine compute_rdi_impl(n_genes, distances, gene_to_fam, dscale, rdi, sorted_rdi, perm, tmp_stack_left, tmp_stack_right) RDI = Euclidean distance / family scaling factor Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Total number of genes real(kind=real64), intent(in) :: distances (n_genes) Array of Euclidean distances for each gene to its centroid\nNaN is permitted for this value.\nInfinite values are permitted for this value. integer(kind=int32), intent(in) :: gene_to_fam (n_genes) Gene-to-family mapping (1-based indexing) real(kind=real64), intent(in) :: dscale (:) Array of scaling factors for each family\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(out) :: rdi (n_genes) Output array of RDI values for each gene real(kind=real64), intent(out) :: sorted_rdi (n_genes) Work array for sorting (dimension n_genes) integer(kind=int32), intent(out) :: perm (n_genes) Permutation array for sorting (dimension n_genes, should be pre-initialized with 1:n_genes) integer(kind=int32), intent(out) :: tmp_stack_left (n_genes) Stack array for sorting (dimension n_genes) integer(kind=int32), intent(out) :: tmp_stack_right (n_genes) Stack array for sorting (dimension n_genes)","tags":"","url":"proc/compute_rdi_impl.html"},{"title":"identify_outliers_impl – TensorOmics","text":"public pure subroutine identify_outliers_impl(n_genes, rdi, sorted_rdi, perm, is_outlier, threshold, quantile, percentile) Expects sorted_rdi to be filtered (no negative values) and perm should be sorted in ascending order before calling.\nIf sorted_rdi contains negatives or perm is not sorted, tmp_results may be invalid. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Total number of genes real(kind=real64), intent(in) :: rdi (n_genes) Array of RDI values for each gene\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(in) :: sorted_rdi (n_genes) Sorted RDI array (must be filtered to remove negatives and sorted in ascending order before calling)\nNaN is permitted for this value.\nInfinite values are permitted for this value. integer(kind=int32), intent(in) :: perm (n_genes) Permutation array with sorted indices logical(kind=c_bool), intent(out) :: is_outlier (n_genes) Output boolean array indicating outliers real(kind=real64), intent(out) :: threshold Output threshold value used for detection real(kind=real64), intent(out) :: quantile (n_genes) Empirical one-sided upper-tail quantile (effect-size measure) for each gene, i.e. how extreme an\nobserved distance is relative to all observed distances -- NOT a null-hypothesis-testing p-value.\nReturned in the same order as the input RDI array. Because distances are non-negative, a one-sided\nupper-tail quantile is used. real(kind=real64), intent(in), optional :: percentile Percentile threshold as a fraction in [0,1] (top 5% for the default).\nThe default value is 0.95_real64 .\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 .","tags":"","url":"proc/identify_outliers_impl.html"},{"title":"detect_outliers_impl – TensorOmics","text":"public  subroutine detect_outliers_impl(n_genes, n_families, distances, gene_to_fam, tmp_perm, tmp_stack_left, tmp_stack_right, tmp_int_workspace, int_workspace_size, tmp_real_workspace, real_workspace_size, tmp_diagl, tmp_weights, tmp_eval_points, tmp_robust_weights, tmp_combined_weights, tmp_residuals, tmp_permutation_indices, tmp_fitted_values, tmp_means_aux, tmp_dscale, tmp_excluded_low_sd, tmp_low_sd_cutoff, tmp_rdi, tmp_sorted_rdi, tmp_threshold, is_outlier, loess_x, loess_y, loess_n, quantile, ierr, percentile) Orchestrates the full pipeline: per-family scaling via compute_family_scaling_impl , the RDI per gene via compute_rdi_impl , then flags outliers via identify_outliers_impl . Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Total number of genes integer(kind=int32), intent(in) :: n_families Total number of gene families real(kind=real64), intent(in) :: distances (n_genes) Array of Euclidean distances for each gene to its centroid\nNaN is permitted for this value.\nInfinite values are permitted for this value. integer(kind=int32), intent(in) :: gene_to_fam (n_genes) Gene-to-family mapping (1-based indexing) integer(kind=int32), intent(out) :: tmp_perm (n_genes) Permutation array for sorting integer(kind=int32), intent(out) :: tmp_stack_left (n_genes) Stack array for left indices during sorting integer(kind=int32), intent(out) :: tmp_stack_right (n_genes) Stack array for right indices during sorting integer(kind=int32), intent(out) :: tmp_int_workspace (int_workspace_size) Integer workspace array integer(kind=int32), intent(in) :: int_workspace_size Length of integer workspace.\nIt is VERY IMPORTANT to compute this argument from the int_workspace_size output produced by tox_loess_required_workspace . Producer input Supplied by n_dim 1_int32 max_neighborhood_size n_families save_factorization .false. real(kind=real64), intent(out) :: tmp_real_workspace (real_workspace_size) Real workspace array integer(kind=int32), intent(in) :: real_workspace_size Length of real workspace.\nIt is VERY IMPORTANT to compute this argument from the real_workspace_size output produced by tox_loess_required_workspace . Producer input Supplied by n_dim 1_int32 max_neighborhood_size n_families save_factorization .false. real(kind=real64), intent(out) :: tmp_diagl (n_families) Diagonal elements of the weight matrix real(kind=real64), intent(out) :: tmp_weights (n_families) Initial weights for LOESS real(kind=real64), intent(out) :: tmp_eval_points (n_families,1) Z matrix for LOESS fitting real(kind=real64), intent(out) :: tmp_robust_weights (n_families) Residuals for robust LOESS fitting real(kind=real64), intent(out) :: tmp_combined_weights (n_families) Working weights array real(kind=real64), intent(out) :: tmp_residuals (n_families) Residuals array integer(kind=int32), intent(out) :: tmp_permutation_indices (n_families) Permutation indices for robust LOESS fitting real(kind=real64), intent(out) :: tmp_fitted_values (n_families) Output array for LOESS predictions real(kind=real64), intent(out) :: tmp_means_aux (n_families) Work array for saving raw means real(kind=real64), intent(out) :: tmp_dscale (n_families) Per-family scaling factors (intermediate, consumed by the RDI step) integer(kind=int32), intent(out) :: tmp_excluded_low_sd (n_families) Low-sd family mask (intermediate, discarded) real(kind=real64), intent(out) :: tmp_low_sd_cutoff Low-sd cutoff (intermediate, discarded) real(kind=real64), intent(out) :: tmp_rdi (n_genes) RDI per gene (intermediate, consumed by the outlier step) real(kind=real64), intent(out) :: tmp_sorted_rdi (n_genes) Sorted RDI (intermediate, consumed by the outlier step) real(kind=real64), intent(out) :: tmp_threshold Detection threshold (intermediate, discarded) logical(kind=c_bool), intent(out) :: is_outlier (n_genes) Output boolean array indicating outliers real(kind=real64), intent(out) :: loess_x (n_families) Reference x-coordinates. real(kind=real64), intent(out) :: loess_y (n_families) Reference y-coordinates (length n_total). integer(kind=int32), intent(out) :: loess_n (n_families) Indices of reference points used for smoothing. real(kind=real64), intent(out) :: quantile (n_genes) Empirical one-sided upper-tail quantile (effect-size measure) for each gene, i.e. how extreme an\nobserved distance is relative to all observed distances -- NOT a null-hypothesis-testing p-value.\nReturned in the same order as the input RDI array. Because distances are non-negative, a one-sided\nupper-tail quantile is used. integer(kind=int32), intent(out) :: ierr Error code real(kind=real64), intent(in), optional :: percentile Percentile threshold as a fraction in [0,1] for outlier detection.\nThe default value is 0.95_real64 .\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 .","tags":"","url":"proc/detect_outliers_impl.html"},{"title":"serialize_logical_helper – TensorOmics","text":"public  subroutine serialize_logical_helper(arr, n_elements, arr_shape, filename, ierr) Arguments Type Intent Optional Attributes Name logical(kind=c_bool), intent(in), dimension(n_elements) :: arr Array to be serialized integer(kind=int32), intent(in) :: n_elements Number of strings in arr integer(kind=int32), intent(in), dimension(:) :: arr_shape Extents of arr , one per dimension character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code","tags":"C-binding","url":"proc/serialize_logical_helper.html"},{"title":"serialize_logical_1d – TensorOmics","text":"public  subroutine serialize_logical_1d(arr, filename, ierr) Directly serialize a 1D logical array into a file Arguments Type Intent Optional Attributes Name logical(kind=c_bool), intent(in), dimension(:), contiguous :: arr Array to be serialized character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/serialize_logical_1d.html"},{"title":"serialize_logical_2d – TensorOmics","text":"public  subroutine serialize_logical_2d(arr, filename, ierr) Directly serialize a 2D logical array into a file Arguments Type Intent Optional Attributes Name logical(kind=c_bool), intent(in), dimension(:, :), contiguous :: arr Array to be serialized character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/serialize_logical_2d.html"},{"title":"serialize_logical_3d – TensorOmics","text":"public  subroutine serialize_logical_3d(arr, filename, ierr) Directly serialize a 3D logical array into a file Arguments Type Intent Optional Attributes Name logical(kind=c_bool), intent(in), dimension(:, :, :), contiguous :: arr Array to be serialized character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/serialize_logical_3d.html"},{"title":"serialize_logical_4d – TensorOmics","text":"public  subroutine serialize_logical_4d(arr, filename, ierr) Directly serialize a 4D logical array into a file Arguments Type Intent Optional Attributes Name logical(kind=c_bool), intent(in), dimension(:, :, :, :), contiguous :: arr Array to be serialized character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/serialize_logical_4d.html"},{"title":"serialize_logical_5d – TensorOmics","text":"public  subroutine serialize_logical_5d(arr, filename, ierr) Directly serialize a 5D logical array into a file Arguments Type Intent Optional Attributes Name logical(kind=c_bool), intent(in), dimension(:, :, :, :, :), contiguous :: arr Array to be serialized character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/serialize_logical_5d.html"},{"title":"cluster_factor_trajectories_k_means_impl – TensorOmics","text":"public pure subroutine cluster_factor_trajectories_k_means_impl(n_clusters, trajectories, n_factors, n_samples, n_timepoints, centroids, labels, label_counts, max_iterations) Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_clusters number ( k ) of clusters\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_samples*n_timepoints . real(kind=real64), intent(in), dimension(n_factors, n_samples, n_timepoints) :: trajectories matrix with data points to cluster integer(kind=int32), intent(in) :: n_factors number of factors integer(kind=int32), intent(in) :: n_samples number of samples integer(kind=int32), intent(in) :: n_timepoints number of timepoints real(kind=real64), intent(inout), dimension(n_factors, n_clusters) :: centroids matrix with initial centroids of the clusters, could be random data or actual points or unassigned garbage.\nThe centroids should be unique. This is not checked in this routine. The final values will be the final centroids of the clusters integer(kind=int32), intent(out), dimension(n_samples*n_timepoints) :: labels array of labels, each index corresponds to the respective point's index, so first label is first point's label. each label is the index of its related cluster -> 1<=label<=n_clusters=k integer(kind=int32), intent(out), dimension(n_clusters) :: label_counts holds the number of points having the respective label assigned integer(kind=int32), intent(in) :: max_iterations number of maximum iterations of the clustering","tags":"","url":"proc/cluster_factor_trajectories_k_means_impl.html"},{"title":"k_means_clustering_impl – TensorOmics","text":"public pure subroutine k_means_clustering_impl(n_clusters, data_points, n_points, n_dims, centroids, labels, label_counts, max_iterations) Assigns each data point to one of k clusters whose centroid is clostest Recalculates the centroids using the mean of its assigned points repeat 1-2 until assignment remains unchanged Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_clusters number ( k ) of clusters\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_points . real(kind=real64), intent(in), dimension(n_dims, n_points) :: data_points matrix with data points to cluster integer(kind=int32), intent(in) :: n_points number of points to cluster integer(kind=int32), intent(in) :: n_dims number of elements a point has real(kind=real64), intent(inout), dimension(n_dims, n_clusters) :: centroids matrix with initial centroids of the clusters, could be random data or actual points or unassigned garbage.\nThe centroids should be unique. This is not checked in this routine. The final values will be the final centroids of the clusters integer(kind=int32), intent(out), dimension(n_points) :: labels array of labels, each index corresponds to the respective point's index, so first label is first point's label. each label is the index of its related cluster -> 1<=label<=n_clusters=k integer(kind=int32), intent(out), dimension(n_clusters) :: label_counts holds the number of points having the respective label assigned integer(kind=int32), intent(in), optional :: max_iterations number of maximum iterations of the clustering.\nThe default value is 300_int32 .","tags":"","url":"proc/k_means_clustering_impl.html"},{"title":"k_means_recompute_cluster_centroids_helper – TensorOmics","text":"public pure subroutine k_means_recompute_cluster_centroids_helper(data_points, n_points, n_dims, centroids, n_clusters, labels, label_counts) Helper to recompute the centroids in k-means by taking the mean of assigned points Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_dims, n_points) :: data_points matrix with data points to cluster integer(kind=int32), intent(in) :: n_points number of points to cluster integer(kind=int32), intent(in) :: n_dims number of elements a point has real(kind=real64), intent(inout), dimension(n_dims, n_clusters) :: centroids matrix with initial centroids of the clusters, could be random data or actual points or unassigned garbage.\nThe centroids should be unique. This is not checked in this routine. The final values will be the final centroids of the clusters integer(kind=int32), intent(in) :: n_clusters number ( k ) of clusters integer(kind=int32), intent(in), dimension(n_points) :: labels array of labels, each index corresponds to the respective point's index, so first label is first point's label. each label is the index of its related cluster -> 1<=label<=n_clusters=k integer(kind=int32), intent(in), dimension(n_clusters) :: label_counts holds the number of points having the respective label assigned","tags":"","url":"proc/k_means_recompute_cluster_centroids_helper.html"},{"title":"k_means_assign_cluster_helper – TensorOmics","text":"public pure subroutine k_means_assign_cluster_helper(i_point, n_clusters, data_points, n_points, n_dims, centroids, label) Helper routine to assign a cluster's label to a point in k-means Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: i_point index of the point that should be assigned a cluster integer(kind=int32), intent(in) :: n_clusters number ( k ) of clusters real(kind=real64), intent(in), dimension(n_dims, n_points) :: data_points matrix with data points to cluster integer(kind=int32), intent(in) :: n_points number of points to cluster integer(kind=int32), intent(in) :: n_dims number of elements a point has real(kind=real64), intent(in), dimension(n_dims, n_clusters) :: centroids matrix with initial centroids of the clusters, could be random data or actual points or unassigned garbage.\nThe centroids should be unique. This is not checked in this routine. The final values will be the final centroids of the clusters integer(kind=int32), intent(out) :: label assigned label","tags":"","url":"proc/k_means_assign_cluster_helper.html"},{"title":"linkage_clustering_impl – TensorOmics","text":"public pure subroutine linkage_clustering_impl(distances, n_points, merge_i, merge_j, heights, cluster_sizes, method) Note The bottom triangle is used as scratch and restored from the top triangle before\nreturning, on success or on error, so the matrix comes back unchanged. There is no\nneed to copy it before calling. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(inout), dimension(n_points, n_points) :: distances symmetric distance matrix, holding the positive distances between points. Distance of X->X is always zero. Note The bottom triangle is used as scratch and restored from the top triangle before\nreturning, on success or on error, so the matrix comes back unchanged. There is no\nneed to copy it before calling. Its structure (symmetry, non-negativity, zero diagonal) is validated by the\ndistance-matrix naming convention in the generated wrapper. integer(kind=int32), intent(in) :: n_points number of points to cluster integer(kind=int32), intent(out), dimension(n_points - 1) :: merge_i holds cluster labels of the merged node pair at iteration k -> positives relate to leafs/data point indices, negatives to inner nodes integer(kind=int32), intent(out), dimension(n_points - 1) :: merge_j holds cluster labels of the merged node pair at iteration k -> positives relate to leafs/data point indices, negatives to inner nodes real(kind=real64), intent(out), dimension(n_points - 1) :: heights height of the shorter branch of the merge, e.g. if (A,B)+(C) merges to ((A,B),C), the branch to (A,B) is shorter integer(kind=int32), intent(out), dimension(n_points - 1) :: cluster_sizes size of cluster at iteration k integer(kind=int32), intent(in) :: method used algorithm\nThe minimum valid value is 0_int32 .\nThe maximum valid value is 2_int32 . Method Value Average / UPGMA METHOD_AVERAGE Weighted / WPGMA METHOD_WEIGHTED Ward METHOD_WARD","tags":"","url":"proc/linkage_clustering_impl.html"},{"title":"recover_distance_matrix_helper – TensorOmics","text":"public pure subroutine recover_distance_matrix_helper(distances, n_points) Helper to recover a distance matrix from its top triangle. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(inout), dimension(n_points, n_points) :: distances top triangle holds distances, bottom triangle will be recovered integer(kind=int32), intent(in) :: n_points number of points to cluster","tags":"","url":"proc/recover_distance_matrix_helper.html"},{"title":"get_cluster_data_linkage_helper – TensorOmics","text":"public pure subroutine get_cluster_data_linkage_helper(distances, n_points, cluster_sizes, idx, weight, cluster_label) Helper for linkage clustering to get the size/weight and label of a cluster\nby using the self-distance as indicator in which iteration the cluster was merged Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_points, n_points) :: distances distance matrix, holding the distances between points integer(kind=int32), intent(in) :: n_points number of points to cluster integer(kind=int32), intent(in), dimension(n_points - 1) :: cluster_sizes size of cluster at iteration k integer(kind=int32), intent(in) :: idx index of cluster in distances integer(kind=int32), intent(out) :: weight number of leafs of cluster integer(kind=int32), intent(out) :: cluster_label index/label of cluster","tags":"","url":"proc/get_cluster_data_linkage_helper.html"},{"title":"merge_distances_xPGMA_linkage_helper – TensorOmics","text":"public pure subroutine merge_distances_xPGMA_linkage_helper(distances, n_points, idx_A, idx_B, size_A, size_B, iteration_k) Helper for *PGMA algorithms for updating the distance matrix on merge of two clusters Arguments Type Intent Optional Attributes Name real(kind=real64), intent(inout), dimension(n_points, n_points) :: distances distance matrix, holding the distances between points integer(kind=int32), intent(in) :: n_points number of points to cluster integer(kind=int32), intent(in) :: idx_A row index of min distance in distances integer(kind=int32), intent(in) :: idx_B column index of min distance in distances integer(kind=int32), intent(in) :: size_A cluster size of cluster at idx_A integer(kind=int32), intent(in) :: size_B cluster size of cluster at idx_B integer(kind=int32), intent(in) :: iteration_k iteration of current merge","tags":"","url":"proc/merge_distances_xpgma_linkage_helper.html"},{"title":"merge_distances_ward_linkage_helper – TensorOmics","text":"public pure subroutine merge_distances_ward_linkage_helper(distances, n_points, idx_A, idx_B, size_A, size_B, iteration_k, cluster_sizes, dist_AB) Helper for ward algorithm for updating the distance matrix on merge of two clusters Arguments Type Intent Optional Attributes Name real(kind=real64), intent(inout), dimension(n_points, n_points) :: distances distance matrix, holding the distances between points integer(kind=int32), intent(in) :: n_points number of points to cluster integer(kind=int32), intent(in) :: idx_A row index of min distance in distances integer(kind=int32), intent(in) :: idx_B column index of min distance in distances integer(kind=int32), intent(in) :: size_A cluster size of cluster at idx_A integer(kind=int32), intent(in) :: size_B cluster size of cluster at idx_B integer(kind=int32), intent(in) :: iteration_k iteration of current merge integer(kind=int32), intent(in), dimension(n_points - 1) :: cluster_sizes size of cluster at iteration k, needed for ward algorithm real(kind=real64), intent(in) :: dist_AB distance between cluster A and B","tags":"","url":"proc/merge_distances_ward_linkage_helper.html"},{"title":"post_merge_distances_helper – TensorOmics","text":"public pure subroutine post_merge_distances_helper(distances, n_points, idx_A, idx_B, iteration_k) Helper for doing last updates after merge: disable merged cluster, update self-distance to current iteration Arguments Type Intent Optional Attributes Name real(kind=real64), intent(inout), dimension(n_points, n_points) :: distances distance matrix, holding the distances between points integer(kind=int32), intent(in) :: n_points number of points to cluster integer(kind=int32), intent(in) :: idx_A row index of min distance in distances integer(kind=int32), intent(in) :: idx_B column index of min distance in distances integer(kind=int32), intent(in) :: iteration_k iteration of current merge","tags":"","url":"proc/post_merge_distances_helper.html"},{"title":"get_min_distance_indices_helper – TensorOmics","text":"public pure subroutine get_min_distance_indices_helper(distances, n, row_idx, col_idx, min_dist) Helper routine to find the indices of the minimum value a distance matrix. Expects n>1 Ignores columns with self-distance (i,i)<0 Searches in bottom triangle (excluding self-distance (i, i)) bottom triangle -> row_idx > col_idx Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n, n) :: distances distance matrix, holding the distances between points integer(kind=int32), intent(in) :: n number of rows and columns of square matrix distances integer(kind=int32), intent(out) :: row_idx row index of min distance in distances integer(kind=int32), intent(out) :: col_idx column index of min distance in distances real(kind=real64), intent(out) :: min_dist min distance","tags":"","url":"proc/get_min_distance_indices_helper.html"},{"title":"binary_search_insertion – TensorOmics","text":"public pure function binary_search_insertion(arr, perm, value, lower_idx, upper_idx) result(idx) Function to find the position to place a value in a sorted array using binary search Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(:), contiguous :: arr Array of values integer(kind=int32), intent(in), dimension(size(arr, kind=int32)) :: perm Sorting permutation of arr , NaNs sorted to the end real(kind=real64), intent(in) :: value Value to find integer(kind=int32), intent(in), optional :: lower_idx The lower index to start searching in the array, default 1 -> searching in perm(lower_idx:upper_idx) integer(kind=int32), intent(in), optional :: upper_idx The upper index to stop searching in the array, default size(arr) -> searching in perm(lower_idx:upper_idx) Return Value integer(kind=int32)","tags":"","url":"proc/binary_search_insertion.html"},{"title":"binary_search – TensorOmics","text":"public pure function binary_search(arr, perm, value) result(idx) Function to find a value in a sorted array using binary search. Returns -1 if not found Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(:), contiguous :: arr Array of values integer(kind=int32), intent(in), dimension(size(arr, kind=int32)) :: perm Sorting permutation of arr , NaNs sorted to the end real(kind=real64), intent(in) :: value Value to find Return Value integer(kind=int32)","tags":"","url":"proc/binary_search.html"},{"title":"real_less – TensorOmics","text":"public pure function real_less(lhs, rhs) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: lhs left side of the comparison lhs < rhs real(kind=real64), intent(in) :: rhs right side of the comparison lhs < rhs Return Value logical","tags":"","url":"proc/real_less.html"},{"title":"real_greater – TensorOmics","text":"public pure function real_greater(lhs, rhs) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: lhs left side of the comparison lhs > rhs real(kind=real64), intent(in) :: rhs right side of the comparison lhs > rhs Return Value logical","tags":"","url":"proc/real_greater.html"},{"title":"init_perm – TensorOmics","text":"public pure subroutine init_perm(perm) Initializes a permutation vector with ascending indices Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(out), dimension(:) :: perm Permutation vector to initialize with indices","tags":"","url":"proc/init_perm.html"},{"title":"sort_real – TensorOmics","text":"public pure subroutine sort_real(array, perm, tmp_stack_left, tmp_stack_right) Sort a real array indirectly using quicksort.\nCreates a sorted version of the array by reordering the perm vector. The original data in array remains unchanged. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: array (:) Real input array to sort integer(kind=int32), intent(inout) :: perm (:) Permutation vector that will be sorted integer(kind=int32), intent(out) :: tmp_stack_left (:) Manual stack of left indices for quicksort recursion integer(kind=int32), intent(out) :: tmp_stack_right (:) Manual stack of right indices for quicksort recursion","tags":"","url":"proc/sort_real.html"},{"title":"sort_integer – TensorOmics","text":"public pure subroutine sort_integer(array, perm, tmp_stack_left, tmp_stack_right) Sort an integer array indirectly using quicksort.\nSimilar to sort_real , but for integer input. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: array (:) Integer input array to sort integer(kind=int32), intent(inout) :: perm (:) Permutation vector that will be sorted integer(kind=int32), intent(out) :: tmp_stack_left (:) Manual stack of left indices for quicksort recursion integer(kind=int32), intent(out) :: tmp_stack_right (:) Manual stack of right indices for quicksort recursion","tags":"","url":"proc/sort_integer.html"},{"title":"sort_character – TensorOmics","text":"public pure subroutine sort_character(array, perm, tmp_stack_left, tmp_stack_right) Sort a character array indirectly using quicksort.\nUses lexicographic ordering and permutation vector sorting. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: array (:) Character input array to sort integer(kind=int32), intent(inout) :: perm (:) Permutation vector that will be sorted integer(kind=int32), intent(out) :: tmp_stack_left (:) Manual stack of left indices for quicksort recursion integer(kind=int32), intent(out) :: tmp_stack_right (:) Manual stack of right indices for quicksort recursion","tags":"","url":"proc/sort_character.html"},{"title":"sort_real_heapsort – TensorOmics","text":"public pure subroutine sort_real_heapsort(array, perm) Sort a real array indirectly using heapsort.\nCreates a sorted version of the array by reordering the perm vector. The original data in array remains unchanged. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), contiguous :: array (:) Real input array to sort integer(kind=int32), intent(inout), contiguous :: perm (:) Permutation vector that will be sorted","tags":"","url":"proc/sort_real_heapsort.html"},{"title":"sort_real_heapsort_expl_size – TensorOmics","text":"public pure subroutine sort_real_heapsort_expl_size(array, perm, n) Sort a real explicit-size array indirectly using heapsort.\nCreates a sorted version of the array by reordering the perm vector. The original data in array remains unchanged. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: array (n) Real input array to sort integer(kind=int32), intent(inout) :: perm (n) Permutation vector that will be sorted integer(kind=int32), intent(in) :: n Size of array","tags":"","url":"proc/sort_real_heapsort_expl_size.html"},{"title":"sort_integer_heapsort – TensorOmics","text":"public pure subroutine sort_integer_heapsort(array, perm) Sort an integer array indirectly using heapsort.\nSimilar to sort_real_heapsort , but for integer input. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in), contiguous :: array (:) Integer input array to sort integer(kind=int32), intent(inout), contiguous :: perm (:) Permutation vector that will be sorted","tags":"","url":"proc/sort_integer_heapsort.html"},{"title":"sort_character_heapsort – TensorOmics","text":"public pure subroutine sort_character_heapsort(array, perm) Sort a character array indirectly using heapsort.\nUses lexicographic ordering and permutation vector sorting. Arguments Type Intent Optional Attributes Name character(len=*), intent(in), contiguous :: array (:) Character input array to sort integer(kind=int32), intent(inout), contiguous :: perm (:) Permutation vector that will be sorted","tags":"","url":"proc/sort_character_heapsort.html"},{"title":"quicksort_real – TensorOmics","text":"public pure subroutine quicksort_real(array, perm, n, tmp_stack_left, tmp_stack_right) Internal quicksort implementation for real arrays.\nSorts indirectly using the permutation vector perm . Manual stack replaces recursion. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: array (n) Real input array to sort integer(kind=int32), intent(inout) :: perm (n) Permutation vector that will be sorted integer(kind=int32), intent(in) :: n Size of the array integer(kind=int32), intent(out) :: tmp_stack_left (n) Manual stack of left indices for quicksort recursion integer(kind=int32), intent(out) :: tmp_stack_right (n) Manual stack of right indices for quicksort recursion","tags":"","url":"proc/quicksort_real.html"},{"title":"quicksort_int – TensorOmics","text":"public pure subroutine quicksort_int(array, perm, n, tmp_stack_left, tmp_stack_right) Internal quicksort implementation for integer arrays.\nIndirectly sorts array using perm , same algorithm as quicksort_real . Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: array (n) Integer input array to sort integer(kind=int32), intent(inout) :: perm (n) Permutation vector that will be sorted integer(kind=int32), intent(in) :: n Size of the array integer(kind=int32), intent(out) :: tmp_stack_left (n) Manual stack of left indices for quicksort recursion integer(kind=int32), intent(out) :: tmp_stack_right (n) Manual stack of right indices for quicksort recursion","tags":"","url":"proc/quicksort_int.html"},{"title":"quicksort_char – TensorOmics","text":"public pure subroutine quicksort_char(array, perm, n, tmp_stack_left, tmp_stack_right) Internal quicksort implementation for character arrays.\nLexicographic quicksort using string comparison, indirect via perm . Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: array (n) Character input array to sort integer(kind=int32), intent(inout) :: perm (n) Permutation vector that will be sorted integer(kind=int32), intent(in) :: n Size of the array integer(kind=int32), intent(out) :: tmp_stack_left (n) Manual stack of left indices for quicksort recursion integer(kind=int32), intent(out) :: tmp_stack_right (n) Manual stack of right indices for quicksort recursion","tags":"","url":"proc/quicksort_char.html"},{"title":"heapsort_real – TensorOmics","text":"public pure subroutine heapsort_real(array, perm, n_arr, n_perm) Sorts indirectly using the permutation vector perm . Uses heapify_real to maintain heap property. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: array (n_arr) Real input array to sort integer(kind=int32), intent(inout) :: perm (n_perm) Permutation vector that will be sorted integer(kind=int32), intent(in) :: n_arr Size of arr integer(kind=int32), intent(in) :: n_perm Size of perm","tags":"","url":"proc/heapsort_real.html"},{"title":"heapify_real – TensorOmics","text":"public pure subroutine heapify_real(array, perm, heap_size, root) Iterative heapify (non-recursive, pure)\nRestore the max-heap property for the subtree rooted at root .\nHeap layout (1-based): left child = 2 i, right child = 2 i+1.\nWe reorder the permutation vector perm (indices) rather than moving\narray values. Guard accesses by checking child indices before indexing. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), contiguous :: array (:) Real input array to sort integer(kind=int32), intent(inout), contiguous :: perm (:) Permutation vector that will be sorted integer(kind=int32), intent(in) :: heap_size Size of the heap integer(kind=int32), intent(in) :: root Root index","tags":"","url":"proc/heapify_real.html"},{"title":"heapsort_integer – TensorOmics","text":"public pure subroutine heapsort_integer(array, perm, n_arr, n_perm) Internal heapsort implementation for integer arrays.\nIndirectly sorts array using perm , same algorithm as heapsort_real . Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: array (n_arr) Integer input array to sort integer(kind=int32), intent(inout) :: perm (n_perm) Permutation vector that will be sorted integer(kind=int32), intent(in) :: n_arr Size of arr integer(kind=int32), intent(in) :: n_perm Size of perm","tags":"","url":"proc/heapsort_integer.html"},{"title":"heapify_integer – TensorOmics","text":"public pure subroutine heapify_integer(array, perm, heap_size, root) Iterative heapify (non-recursive, pure)\nRestore the max-heap property for the subtree rooted at root .\nHeap layout (1-based): left child = 2 i, right child = 2 i+1.\nWe reorder the permutation vector perm (indices) rather than moving\narray values. Guard accesses by checking child indices before indexing. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in), contiguous :: array (:) Integer input array to sort integer(kind=int32), intent(inout), contiguous :: perm (:) Permutation vector that will be sorted integer(kind=int32), intent(in) :: heap_size Size of the heap integer(kind=int32), intent(in) :: root Root index","tags":"","url":"proc/heapify_integer.html"},{"title":"heapsort_character – TensorOmics","text":"public pure subroutine heapsort_character(array, perm, n_arr, n_perm) Internal heapsort implementation for character arrays.\nLexicographic heapsort using string comparison, indirect via perm . Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: array (n_arr) Character input array to sort integer(kind=int32), intent(inout) :: perm (n_perm) Permutation vector that will be sorted integer(kind=int32), intent(in) :: n_arr Size of arr integer(kind=int32), intent(in) :: n_perm Size of perm","tags":"","url":"proc/heapsort_character.html"},{"title":"heapify_character – TensorOmics","text":"public pure subroutine heapify_character(array, perm, heap_size, root) Iterative heapify (non-recursive, pure)\nRestore the max-heap property for the subtree rooted at root .\nHeap layout (1-based): left child = 2 i, right child = 2 i+1.\nWe reorder the permutation vector perm (indices) rather than moving\narray values. Guard accesses by checking child indices before indexing. Arguments Type Intent Optional Attributes Name character(len=*), intent(in), contiguous :: array (:) Character input array to sort integer(kind=int32), intent(inout), contiguous :: perm (:) Permutation vector that will be sorted integer(kind=int32), intent(in) :: heap_size Size of the heap integer(kind=int32), intent(in) :: root Root index","tags":"","url":"proc/heapify_character.html"},{"title":"swap_int – TensorOmics","text":"public pure subroutine swap_int(a, b) Swap two integer values in-place. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(inout) :: a First integer to swap integer(kind=int32), intent(inout) :: b Second integer to swap","tags":"","url":"proc/swap_int.html"},{"title":"swap_real – TensorOmics","text":"public pure subroutine swap_real(a, b) Swap two real values in-place. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(inout) :: a First real to swap real(kind=real64), intent(inout) :: b Second real to swap","tags":"","url":"proc/swap_real.html"},{"title":"which – TensorOmics","text":"public pure subroutine which(mask, n, idx_out, m_max, m_out, ierr) Finds the indices of the true values in a logical mask. Arguments Type Intent Optional Attributes Name logical(kind=c_bool), intent(in) :: mask (n) Logical array of size n. integer(kind=int32), intent(in) :: n Size of the mask. integer(kind=int32), intent(out) :: idx_out (m_max) Integer array to store the indices of true values. integer(kind=int32), intent(in) :: m_max Maximum size of idx_out . integer(kind=int32), intent(out) :: m_out Actual size of idx_out (number of true values found). integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/which.html"},{"title":"sort_array – TensorOmics","text":"public interface sort_array Generic indirect (permutation-based) sort, dispatches on the array's element type.\nSee sort_real , sort_integer , sort_character for the implementations. Uses quicksort. Module Procedures public pure subroutine sort_real (array, perm, tmp_stack_left, tmp_stack_right) Author Vivian Bass License MIT Sort a real array indirectly using quicksort.\nCreates a sorted version of the array by reordering the perm vector. The original data in array remains unchanged. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: array (:) Real input array to sort integer(kind=int32), intent(inout) :: perm (:) Permutation vector that will be sorted integer(kind=int32), intent(out) :: tmp_stack_left (:) Manual stack of left indices for quicksort recursion integer(kind=int32), intent(out) :: tmp_stack_right (:) Manual stack of right indices for quicksort recursion public pure subroutine sort_integer (array, perm, tmp_stack_left, tmp_stack_right) Author Vivian Bass License MIT Sort an integer array indirectly using quicksort.\nSimilar to sort_real , but for integer input. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: array (:) Integer input array to sort integer(kind=int32), intent(inout) :: perm (:) Permutation vector that will be sorted integer(kind=int32), intent(out) :: tmp_stack_left (:) Manual stack of left indices for quicksort recursion integer(kind=int32), intent(out) :: tmp_stack_right (:) Manual stack of right indices for quicksort recursion public pure subroutine sort_character (array, perm, tmp_stack_left, tmp_stack_right) Author Vivian Bass License MIT Sort a character array indirectly using quicksort.\nUses lexicographic ordering and permutation vector sorting. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: array (:) Character input array to sort integer(kind=int32), intent(inout) :: perm (:) Permutation vector that will be sorted integer(kind=int32), intent(out) :: tmp_stack_left (:) Manual stack of left indices for quicksort recursion integer(kind=int32), intent(out) :: tmp_stack_right (:) Manual stack of right indices for quicksort recursion","tags":"","url":"interface/sort_array.html"},{"title":"sort_array_heapsort – TensorOmics","text":"public interface sort_array_heapsort Generic indirect (permutation-based) heapsort, dispatches on the array's element type.\nPrefer this over sort_array when a worst-case O(n log n)\nguarantee is needed (quicksort's manual-stack partitioning can degrade on adversarial input),\nor when the temporary quicksort stack workspace should be avoided. Module Procedures public pure subroutine sort_real_heapsort (array, perm) Author Mohamed Akdi License MIT Sort a real array indirectly using heapsort.\nCreates a sorted version of the array by reordering the perm vector. The original data in array remains unchanged. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), contiguous :: array (:) Real input array to sort integer(kind=int32), intent(inout), contiguous :: perm (:) Permutation vector that will be sorted public pure subroutine sort_integer_heapsort (array, perm) Author Mohamed Akdi License MIT Sort an integer array indirectly using heapsort.\nSimilar to sort_real_heapsort , but for integer input. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in), contiguous :: array (:) Integer input array to sort integer(kind=int32), intent(inout), contiguous :: perm (:) Permutation vector that will be sorted public pure subroutine sort_character_heapsort (array, perm) Author Mohamed Akdi License MIT Sort a character array indirectly using heapsort.\nUses lexicographic ordering and permutation vector sorting. Arguments Type Intent Optional Attributes Name character(len=*), intent(in), contiguous :: array (:) Character input array to sort integer(kind=int32), intent(inout), contiguous :: perm (:) Permutation vector that will be sorted public pure subroutine sort_real_heapsort_expl_size (array, perm, n) Author Franz-Eric Sill License MIT Sort a real explicit-size array indirectly using heapsort.\nCreates a sorted version of the array by reordering the perm vector. The original data in array remains unchanged. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: array (n) Real input array to sort integer(kind=int32), intent(inout) :: perm (n) Permutation vector that will be sorted integer(kind=int32), intent(in) :: n Size of array","tags":"","url":"interface/sort_array_heapsort.html"},{"title":"operator(.lessthan.) – TensorOmics","text":"public interface operator(.lessthan.) NaN-aware < comparison operator for real(real64) ; see real_less . Module Procedures public pure function real_less (lhs, rhs) Author Mohamed Akdi License MIT Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: lhs left side of the comparison lhs < rhs real(kind=real64), intent(in) :: rhs right side of the comparison lhs < rhs Return Value logical","tags":"","url":"interface/operator(.lessthan.).html"},{"title":"operator(.greaterthan.) – TensorOmics","text":"public interface operator(.greaterthan.) NaN-aware > comparison operator for real(real64) ; see real_greater . Module Procedures public pure function real_greater (lhs, rhs) Author Mohamed Akdi License MIT Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: lhs left side of the comparison lhs > rhs real(kind=real64), intent(in) :: rhs right side of the comparison lhs > rhs Return Value logical","tags":"","url":"interface/operator(.greaterthan.).html"},{"title":"serialize_real_helper_c – TensorOmics","text":"public  subroutine serialize_real_helper_c(arr, n_elements, arr_shape, n_arr_shape_elements, filename, filename_strlen, ierr) bind(C, name=\"serialize_real_helper_c\") Uses f42_serde_arrays_serialize_real Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(*), target :: arr Array to be serialized integer(kind=c_int), intent(in), target :: n_elements Number of strings in arr integer(kind=c_int), intent(in), dimension(n_arr_shape_elements), target :: arr_shape Extents of arr , one per dimension integer(kind=c_int), intent(in), target :: n_arr_shape_elements number of elements in arr_shape character(kind=c_char, len=1), intent(in), dimension(filename_strlen), target :: filename Name of the file to write to integer(kind=c_int), intent(in), target :: filename_strlen length of the strings in filename integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"proc/serialize_real_helper_c.html"},{"title":"compute_tissue_versatility – TensorOmics","text":"public pure subroutine compute_tissue_versatility(n_axes, n_vectors, expression_vectors, vectors_selection_mask, n_selected_vectors, axes_selection_mask, n_selected_axes, tissue_versatilities, tissue_angles_deg, ierr) The metric is based on the angle between each gene expression vector and the space diagonal.\nVersatility is normalized to [0, 1], where 0 means uniform expression and 1 means expression in only one axis. The masks follow the n_selected_ convention, so the generated wrapper validates that each\nselection count matches its mask; n_selected_axes (not an array extent) carries its own floor. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_axes Number of axes (tissues/dimensions) integer(kind=int32), intent(in) :: n_vectors Number of expression vectors (genes) real(kind=real64), intent(in), dimension(n_axes, n_vectors) :: expression_vectors 2D array (n_axes, n_vectors), each column is a gene expression vector logical(kind=c_bool), intent(in), dimension(n_vectors) :: vectors_selection_mask Logical array (n_vectors), .TRUE. for vectors to process integer(kind=int32), intent(in) :: n_selected_vectors Number of selected expression vectors (count of .TRUE. in vectors_selection_mask) logical(kind=c_bool), intent(in), dimension(n_axes) :: axes_selection_mask Logical array (n_axes), .TRUE. for axes to include in calculation integer(kind=int32), intent(in) :: n_selected_axes Number of selected axes (count of .TRUE. in axes_selection_mask)\nThe minimum valid value is 1_int32 . real(kind=real64), intent(out), dimension(n_selected_vectors) :: tissue_versatilities Output, real array, length = n_selected_vectors, stores the calculated tissue versatilities real(kind=real64), intent(out), dimension(n_selected_vectors) :: tissue_angles_deg Output, real array, length = n_selected_vectors, stores the calculated angles in degrees integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/compute_tissue_versatility.html"},{"title":"serialize_complex_helper – TensorOmics","text":"public  subroutine serialize_complex_helper(arr, n_elements, arr_shape, filename, ierr) Arguments Type Intent Optional Attributes Name complex(kind=real64), intent(in), dimension(n_elements) :: arr Array to be serialized integer(kind=int32), intent(in) :: n_elements Number of strings in arr integer(kind=int32), intent(in), dimension(:) :: arr_shape Extents of arr , one per dimension character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code","tags":"C-binding","url":"proc/serialize_complex_helper.html"},{"title":"serialize_complex_1d – TensorOmics","text":"public  subroutine serialize_complex_1d(arr, filename, ierr) Directly serialize a 1D complex array into a file Arguments Type Intent Optional Attributes Name complex(kind=real64), intent(in), dimension(:), contiguous :: arr Array to be serialized character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/serialize_complex_1d.html"},{"title":"serialize_complex_2d – TensorOmics","text":"public  subroutine serialize_complex_2d(arr, filename, ierr) Directly serialize a 2D complex array into a file Arguments Type Intent Optional Attributes Name complex(kind=real64), intent(in), dimension(:, :), contiguous :: arr Array to be serialized character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/serialize_complex_2d.html"},{"title":"serialize_complex_3d – TensorOmics","text":"public  subroutine serialize_complex_3d(arr, filename, ierr) Directly serialize a 3D complex array into a file Arguments Type Intent Optional Attributes Name complex(kind=real64), intent(in), dimension(:, :, :), contiguous :: arr Array to be serialized character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/serialize_complex_3d.html"},{"title":"serialize_complex_4d – TensorOmics","text":"public  subroutine serialize_complex_4d(arr, filename, ierr) Directly serialize a 4D complex array into a file Arguments Type Intent Optional Attributes Name complex(kind=real64), intent(in), dimension(:, :, :, :), contiguous :: arr Array to be serialized character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/serialize_complex_4d.html"},{"title":"serialize_complex_5d – TensorOmics","text":"public  subroutine serialize_complex_5d(arr, filename, ierr) Directly serialize a 5D complex array into a file Arguments Type Intent Optional Attributes Name complex(kind=real64), intent(in), dimension(:, :, :, :, :), contiguous :: arr Array to be serialized character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/serialize_complex_5d.html"},{"title":"compute_shift_vector_field_impl – TensorOmics","text":"public pure subroutine compute_shift_vector_field_impl(n_tissues, n_genes, n_families, expression_vectors, family_centroids, gene_to_fam, shift_vectors) Computes the shift vectors by subtracting the corresponding family centroid from the expression vector. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_tissues Expression vector dimension integer(kind=int32), intent(in) :: n_genes Total number of genes integer(kind=int32), intent(in) :: n_families Total number of families real(kind=real64), intent(in) :: expression_vectors (n_tissues,n_genes) Gene expression matrix real(kind=real64), intent(in) :: family_centroids (n_tissues,n_families) Family centroid matrix integer(kind=int32), intent(in) :: gene_to_fam (n_genes) Index mapping -> each index i holds the family index for the corresponding gene in expression_vectors , using 0_int32 for unassigned genes\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_families .\nThe value 0_int32 is additionally accepted. real(kind=real64), intent(out) :: shift_vectors (n_tissues,2,n_genes) Output, real matrix array. For each gene it holds two vectors: the centroid of the gene's family first (a zero vector if no family is assigned), then the shift vector","tags":"","url":"proc/compute_shift_vector_field_impl.html"},{"title":"cluster_factor_trajectories_k_means – TensorOmics","text":"public pure subroutine cluster_factor_trajectories_k_means(n_clusters, trajectories, n_factors, n_samples, n_timepoints, centroids, labels, label_counts, max_iterations, ierr) Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_clusters number ( k ) of clusters\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_samples*n_timepoints . real(kind=real64), intent(in), dimension(n_factors, n_samples, n_timepoints) :: trajectories matrix with data points to cluster integer(kind=int32), intent(in) :: n_factors number of factors integer(kind=int32), intent(in) :: n_samples number of samples integer(kind=int32), intent(in) :: n_timepoints number of timepoints real(kind=real64), intent(inout), dimension(n_factors, n_clusters) :: centroids matrix with initial centroids of the clusters, could be random data or actual points or unassigned garbage.\nThe centroids should be unique. This is not checked in this routine. The final values will be the final centroids of the clusters integer(kind=int32), intent(out), dimension(n_samples*n_timepoints) :: labels array of labels, each index corresponds to the respective point's index, so first label is first point's label. each label is the index of its related cluster -> 1<=label<=n_clusters=k integer(kind=int32), intent(out), dimension(n_clusters) :: label_counts holds the number of points having the respective label assigned integer(kind=int32), intent(in) :: max_iterations number of maximum iterations of the clustering integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/cluster_factor_trajectories_k_means.html"},{"title":"k_means_clustering – TensorOmics","text":"public pure subroutine k_means_clustering(n_clusters, data_points, n_points, n_dims, centroids, labels, label_counts, max_iterations, ierr) Assigns each data point to one of k clusters whose centroid is clostest Recalculates the centroids using the mean of its assigned points repeat 1-2 until assignment remains unchanged Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_clusters number ( k ) of clusters\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_points . real(kind=real64), intent(in), dimension(n_dims, n_points) :: data_points matrix with data points to cluster integer(kind=int32), intent(in) :: n_points number of points to cluster integer(kind=int32), intent(in) :: n_dims number of elements a point has real(kind=real64), intent(inout), dimension(n_dims, n_clusters) :: centroids matrix with initial centroids of the clusters, could be random data or actual points or unassigned garbage.\nThe centroids should be unique. This is not checked in this routine. The final values will be the final centroids of the clusters integer(kind=int32), intent(out), dimension(n_points) :: labels array of labels, each index corresponds to the respective point's index, so first label is first point's label. each label is the index of its related cluster -> 1<=label<=n_clusters=k integer(kind=int32), intent(out), dimension(n_clusters) :: label_counts holds the number of points having the respective label assigned integer(kind=int32), intent(in), optional :: max_iterations number of maximum iterations of the clustering.\nThe default value is 300_int32 . integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/k_means_clustering.html"},{"title":"linkage_clustering – TensorOmics","text":"public pure subroutine linkage_clustering(distances, n_points, merge_i, merge_j, heights, cluster_sizes, method, ierr) Note The bottom triangle is used as scratch and restored from the top triangle before\nreturning, on success or on error, so the matrix comes back unchanged. There is no\nneed to copy it before calling. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(inout), dimension(n_points, n_points) :: distances symmetric distance matrix, holding the positive distances between points. Distance of X->X is always zero. Note The bottom triangle is used as scratch and restored from the top triangle before\nreturning, on success or on error, so the matrix comes back unchanged. There is no\nneed to copy it before calling. Its structure (symmetry, non-negativity, zero diagonal) is validated by the\ndistance-matrix naming convention in the generated wrapper. integer(kind=int32), intent(in) :: n_points number of points to cluster integer(kind=int32), intent(out), dimension(n_points - 1) :: merge_i holds cluster labels of the merged node pair at iteration k -> positives relate to leafs/data point indices, negatives to inner nodes integer(kind=int32), intent(out), dimension(n_points - 1) :: merge_j holds cluster labels of the merged node pair at iteration k -> positives relate to leafs/data point indices, negatives to inner nodes real(kind=real64), intent(out), dimension(n_points - 1) :: heights height of the shorter branch of the merge, e.g. if (A,B)+(C) merges to ((A,B),C), the branch to (A,B) is shorter integer(kind=int32), intent(out), dimension(n_points - 1) :: cluster_sizes size of cluster at iteration k integer(kind=int32), intent(in) :: method used algorithm\nThe minimum valid value is 0_int32 .\nThe maximum valid value is 2_int32 . Method Value Average / UPGMA METHOD_AVERAGE Weighted / WPGMA METHOD_WEIGHTED Ward METHOD_WARD integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/linkage_clustering.html"},{"title":"deserialize_logical_helper_c – TensorOmics","text":"public  subroutine deserialize_logical_helper_c(arr, n_elements, arr_shape, n_arr_shape_elements, filename, filename_strlen, ierr) bind(C, name=\"deserialize_logical_helper_c\") Uses f42_serde_arrays_deserialize_logical Arguments Type Intent Optional Attributes Name logical(kind=c_bool), intent(out), dimension(*), target :: arr Pre-allocated array to read the data into integer(kind=c_int), intent(in), target :: n_elements Size of arr integer(kind=c_int), intent(in), dimension(n_arr_shape_elements), target :: arr_shape Extents of arr , one per dimension\nIt is VERY IMPORTANT to compute this argument from the dims_out output produced by get_array_metadata . Producer input Supplied by dims_out_capacity 5_int32 integer(kind=c_int), intent(in), target :: n_arr_shape_elements number of elements in arr_shape character(kind=c_char, len=1), intent(in), dimension(filename_strlen), target :: filename Name of the file integer(kind=c_int), intent(in), target :: filename_strlen length of the strings in filename integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"proc/deserialize_logical_helper_c.html"},{"title":"build_bst_index_c – TensorOmics","text":"public  subroutine build_bst_index_c(values, n_values, sorted_indices, ierr) bind(C, name=\"build_bst_index_c\") Uses f42_binary_search_tree Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_values), target :: values Input real array to be indexed integer(kind=c_int), intent(in), target :: n_values Number of elements in values array integer(kind=c_int), intent(out), dimension(n_values), target :: sorted_indices Output permutation index integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/build_bst_index_c.html"},{"title":"bst_range_query_c – TensorOmics","text":"public  subroutine bst_range_query_c(values, n_values, lower_bound, upper_bound, output_indices, n_matches, ierr) bind(C, name=\"bst_range_query_c\") Uses f42_binary_search_tree Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_values), target :: values Input real array integer(kind=c_int), intent(in), target :: n_values Number of elements real(kind=c_double), intent(in), target :: lower_bound Lower bound of range (inclusive)\nThe maximum valid value is upper_bound . real(kind=c_double), intent(in), target :: upper_bound Upper bound of range (inclusive) integer(kind=c_int), intent(out), dimension(n_values), target :: output_indices Output array of matching indices.\nThe first n_matches elements will hold the results. integer(kind=c_int), intent(out), target :: n_matches Number of matches found integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/bst_range_query_c.html"},{"title":"bst_range_query_expert_c – TensorOmics","text":"public  subroutine bst_range_query_expert_c(values, values_perm, n_values, lower_bound, upper_bound, output_indices, n_matches, ierr) bind(C, name=\"bst_range_query_expert_c\") Uses f42_binary_search_tree Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_values), target :: values Input real array integer(kind=c_int), intent(in), dimension(n_values), target :: values_perm Permutation of values in ascending order -- the BST index. The allocating entry\npoint builds and heapsorts it for you; the expert one takes whatever order you\nsupply, so a caller that already holds one from build_bst_index can reuse it across queries.\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_values . integer(kind=c_int), intent(in), target :: n_values Number of elements real(kind=c_double), intent(in), target :: lower_bound Lower bound of range (inclusive)\nThe maximum valid value is upper_bound . real(kind=c_double), intent(in), target :: upper_bound Upper bound of range (inclusive) integer(kind=c_int), intent(out), dimension(n_values), target :: output_indices Output array of matching indices.\nThe first n_matches elements will hold the results. integer(kind=c_int), intent(out), target :: n_matches Number of matches found integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/bst_range_query_expert_c.html"},{"title":"create_zip_archive_c – TensorOmics","text":"public  subroutine create_zip_archive_c(zip_filename, zip_filename_strlen, keys, keys_strlen, n_keys_elements, filenames, filenames_strlen, n_filenames_elements, ierr) bind(C, name=\"create_zip_archive_c\") Uses tox_data_archive Arguments Type Intent Optional Attributes Name character(kind=c_char, len=1), intent(in), dimension(zip_filename_strlen), target :: zip_filename Name of the zip file to create integer(kind=c_int), intent(in), target :: zip_filename_strlen length of the strings in zip_filename character(kind=c_char, len=1), intent(in), dimension(keys_strlen, n_keys_elements), target :: keys Array of keys for manifest entries integer(kind=c_int), intent(in), target :: keys_strlen length of the strings in keys integer(kind=c_int), intent(in), target :: n_keys_elements number of elements in keys character(kind=c_char, len=1), intent(in), dimension(filenames_strlen, n_filenames_elements), target :: filenames Array of filenames to add to zip integer(kind=c_int), intent(in), target :: filenames_strlen length of the strings in filenames integer(kind=c_int), intent(in), target :: n_filenames_elements number of elements in filenames integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"proc/create_zip_archive_c.html"},{"title":"save_tox_data_c – TensorOmics","text":"public  subroutine save_tox_data_c(zip_filename, zip_filename_strlen, ierr, gene_ids, gene_ids_strlen, n_gene_ids_elements, gene_ids_file, gene_ids_file_strlen, expression, n_expression_elements_dim_1, n_expression_elements_dim_2, expression_file, expression_file_strlen, gene_to_family, n_gene_to_family_elements, gene_to_family_file, gene_to_family_file_strlen, family_ids, family_ids_strlen, n_family_ids_elements, family_ids_file, family_ids_file_strlen, family_centroids, n_family_centroids_elements_dim_1, n_family_centroids_elements_dim_2, family_centroids_file, family_centroids_file_strlen, shift_vectors, n_shift_vectors_elements_dim_1, n_shift_vectors_elements_dim_2, shift_vectors_file, shift_vectors_file_strlen) bind(C, name=\"save_tox_data_c\") Uses tox_data_archive Arguments Type Intent Optional Attributes Name character(kind=c_char, len=1), intent(in), dimension(zip_filename_strlen), target :: zip_filename Zip filename integer(kind=c_int), intent(in), target :: zip_filename_strlen length of the strings in zip_filename integer(kind=c_int), intent(out), target :: ierr Error code character(kind=c_char, len=1), intent(in), optional, dimension(gene_ids_strlen, n_gene_ids_elements), target :: gene_ids Gene ids array, will be saved if provided integer(kind=c_int), intent(in), target :: gene_ids_strlen length of the strings in gene_ids integer(kind=c_int), intent(in), target :: n_gene_ids_elements number of elements in gene_ids character(kind=c_char, len=1), intent(in), optional, dimension(gene_ids_file_strlen), target :: gene_ids_file Name of the gene ids file integer(kind=c_int), intent(in), target :: gene_ids_file_strlen length of the strings in gene_ids_file real(kind=c_double), intent(in), optional, dimension(n_expression_elements_dim_1, n_expression_elements_dim_2) :: expression Expression vectors array, will be saved if provided integer(kind=c_int), intent(in), target :: n_expression_elements_dim_1 dimension of expression integer(kind=c_int), intent(in), target :: n_expression_elements_dim_2 dimension of expression character(kind=c_char, len=1), intent(in), optional, dimension(expression_file_strlen), target :: expression_file Name of the expression file integer(kind=c_int), intent(in), target :: expression_file_strlen length of the strings in expression_file integer(kind=c_int), intent(in), optional, dimension(n_gene_to_family_elements) :: gene_to_family Gene to family mapping array, will be saved if provided integer(kind=c_int), intent(in), target :: n_gene_to_family_elements number of elements in gene_to_family character(kind=c_char, len=1), intent(in), optional, dimension(gene_to_family_file_strlen), target :: gene_to_family_file Name of the gene to family mapping file integer(kind=c_int), intent(in), target :: gene_to_family_file_strlen length of the strings in gene_to_family_file character(kind=c_char, len=1), intent(in), optional, dimension(family_ids_strlen, n_family_ids_elements), target :: family_ids Family ids array, will be saved if provided integer(kind=c_int), intent(in), target :: family_ids_strlen length of the strings in family_ids integer(kind=c_int), intent(in), target :: n_family_ids_elements number of elements in family_ids character(kind=c_char, len=1), intent(in), optional, dimension(family_ids_file_strlen), target :: family_ids_file Name of the family ids file integer(kind=c_int), intent(in), target :: family_ids_file_strlen length of the strings in family_ids_file real(kind=c_double), intent(in), optional, dimension(n_family_centroids_elements_dim_1, n_family_centroids_elements_dim_2) :: family_centroids Family centroids array, will be saved if provided integer(kind=c_int), intent(in), target :: n_family_centroids_elements_dim_1 dimension of family_centroids integer(kind=c_int), intent(in), target :: n_family_centroids_elements_dim_2 dimension of family_centroids character(kind=c_char, len=1), intent(in), optional, dimension(family_centroids_file_strlen), target :: family_centroids_file Name of the family centroids file integer(kind=c_int), intent(in), target :: family_centroids_file_strlen length of the strings in family_centroids_file real(kind=c_double), intent(in), optional, dimension(n_shift_vectors_elements_dim_1, n_shift_vectors_elements_dim_2) :: shift_vectors Shift vectors array, will be saved if provided integer(kind=c_int), intent(in), target :: n_shift_vectors_elements_dim_1 dimension of shift_vectors integer(kind=c_int), intent(in), target :: n_shift_vectors_elements_dim_2 dimension of shift_vectors character(kind=c_char, len=1), intent(in), optional, dimension(shift_vectors_file_strlen), target :: shift_vectors_file Name of the shift vectors file integer(kind=c_int), intent(in), target :: shift_vectors_file_strlen length of the strings in shift_vectors_file","tags":"","url":"proc/save_tox_data_c.html"},{"title":"get_tox_data_dims_c – TensorOmics","text":"public  subroutine get_tox_data_dims_c(zip_filename, zip_filename_strlen, n_gene_ids, gene_id_len, n_expression_rows, n_expression_cols, n_gene_to_family, n_family_ids, family_id_len, n_family_centroids_rows, n_family_centroids_cols, n_shift_vectors_rows, n_shift_vectors_cols, ierr) bind(C, name=\"get_tox_data_dims_c\") Uses tox_data_archive Each count (and each string length) is 0 when the corresponding member is absent, so a\ncaller can size all six output buffers up front. Character members report both an element\ncount and a per-element string length. Pairs with read_tox_data_into . Arguments Type Intent Optional Attributes Name character(kind=c_char, len=1), intent(in), dimension(zip_filename_strlen), target :: zip_filename Name of the zip file integer(kind=c_int), intent(in), target :: zip_filename_strlen length of the strings in zip_filename integer(kind=c_int), intent(out), target :: n_gene_ids Number of gene ids, 0 if absent integer(kind=c_int), intent(out), target :: gene_id_len String length of each gene id, 0 if absent integer(kind=c_int), intent(out), target :: n_expression_rows Rows (samples) of the expression matrix, 0 if absent integer(kind=c_int), intent(out), target :: n_expression_cols Columns (genes) of the expression matrix, 0 if absent integer(kind=c_int), intent(out), target :: n_gene_to_family Number of gene-to-family entries, 0 if absent integer(kind=c_int), intent(out), target :: n_family_ids Number of family ids, 0 if absent integer(kind=c_int), intent(out), target :: family_id_len String length of each family id, 0 if absent integer(kind=c_int), intent(out), target :: n_family_centroids_rows Rows (samples) of the family centroids matrix, 0 if absent integer(kind=c_int), intent(out), target :: n_family_centroids_cols Columns (families) of the family centroids matrix, 0 if absent integer(kind=c_int), intent(out), target :: n_shift_vectors_rows Rows of the shift vectors matrix, 0 if absent integer(kind=c_int), intent(out), target :: n_shift_vectors_cols Columns of the shift vectors matrix, 0 if absent integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"proc/get_tox_data_dims_c.html"},{"title":"read_tox_data_into_c – TensorOmics","text":"public  subroutine read_tox_data_into_c(zip_filename, zip_filename_strlen, n_gene_ids, gene_id_len, gene_ids, n_expression_rows, n_expression_cols, expression, n_gene_to_family, gene_to_family, n_family_ids, family_id_len, family_ids, n_family_centroids_rows, n_family_centroids_cols, family_centroids, n_shift_vectors_rows, n_shift_vectors_cols, shift_vectors, ierr) bind(C, name=\"read_tox_data_into_c\") Uses tox_data_archive Fills every buffer from the archive; size them from get_tox_data_dims first. A member that is absent\nhas a zero extent and is left untouched. Arguments Type Intent Optional Attributes Name character(kind=c_char, len=1), intent(in), dimension(zip_filename_strlen), target :: zip_filename Name of the zip file integer(kind=c_int), intent(in), target :: zip_filename_strlen length of the strings in zip_filename integer(kind=c_int), intent(in), target :: n_gene_ids Number of gene ids.\nIt is VERY IMPORTANT to compute this argument from the n_gene_ids output produced by get_tox_data_dims . integer(kind=c_int), intent(in), target :: gene_id_len String length of each gene id.\nIt is VERY IMPORTANT to compute this argument from the gene_id_len output produced by get_tox_data_dims . character(kind=c_char, len=1), intent(out), dimension(gene_id_len, n_gene_ids), target :: gene_ids Gene ids integer(kind=c_int), intent(in), target :: n_expression_rows Rows (samples) of the expression matrix.\nIt is VERY IMPORTANT to compute this argument from the n_expression_rows output produced by get_tox_data_dims . integer(kind=c_int), intent(in), target :: n_expression_cols Columns (genes) of the expression matrix.\nIt is VERY IMPORTANT to compute this argument from the n_expression_cols output produced by get_tox_data_dims . real(kind=c_double), intent(out), dimension(n_expression_rows, n_expression_cols), target :: expression Expression vectors integer(kind=c_int), intent(in), target :: n_gene_to_family Number of gene-to-family entries.\nIt is VERY IMPORTANT to compute this argument from the n_gene_to_family output produced by get_tox_data_dims . integer(kind=c_int), intent(out), dimension(n_gene_to_family), target :: gene_to_family Gene to family mapping integer(kind=c_int), intent(in), target :: n_family_ids Number of family ids.\nIt is VERY IMPORTANT to compute this argument from the n_family_ids output produced by get_tox_data_dims . integer(kind=c_int), intent(in), target :: family_id_len String length of each family id.\nIt is VERY IMPORTANT to compute this argument from the family_id_len output produced by get_tox_data_dims . character(kind=c_char, len=1), intent(out), dimension(family_id_len, n_family_ids), target :: family_ids Family ids integer(kind=c_int), intent(in), target :: n_family_centroids_rows Rows (samples) of the family centroids matrix.\nIt is VERY IMPORTANT to compute this argument from the n_family_centroids_rows output produced by get_tox_data_dims . integer(kind=c_int), intent(in), target :: n_family_centroids_cols Columns (families) of the family centroids matrix.\nIt is VERY IMPORTANT to compute this argument from the n_family_centroids_cols output produced by get_tox_data_dims . real(kind=c_double), intent(out), dimension(n_family_centroids_rows, n_family_centroids_cols), target :: family_centroids Family centroids integer(kind=c_int), intent(in), target :: n_shift_vectors_rows Rows of the shift vectors matrix.\nIt is VERY IMPORTANT to compute this argument from the n_shift_vectors_rows output produced by get_tox_data_dims . integer(kind=c_int), intent(in), target :: n_shift_vectors_cols Columns of the shift vectors matrix.\nIt is VERY IMPORTANT to compute this argument from the n_shift_vectors_cols output produced by get_tox_data_dims . real(kind=c_double), intent(out), dimension(n_shift_vectors_rows, n_shift_vectors_cols), target :: shift_vectors Shift vectors integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"proc/read_tox_data_into_c.html"},{"title":"write_file_header – TensorOmics","text":"public  subroutine write_file_header(filename, unit, type_code, ndim, dims, ierr) Opens unit and writes fileheader with all metadata to the given filename Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: filename filename to write to integer(kind=int32), intent(out) :: unit Fortran unit number for the file integer(kind=int32), intent(in) :: type_code type code of the array Type Code integer -1_int32 real -2_int32 complex -4_int32 logical -3_int32 character string length integer(kind=int32), intent(in) :: ndim number of dimensions integer(kind=int32), intent(in) :: dims (ndim) dimensions of the array integer(kind=int32), intent(inout) :: ierr error code","tags":"","url":"proc/write_file_header.html"},{"title":"check_file_header – TensorOmics","text":"public  subroutine check_file_header(filename, expected_type_code, expected_shape, unit, ierr) Opens filename , reads its header via read_file_header_helper ,\nand validates the stored type code and shape against the caller's expectations. On any\nmismatch the unit is closed and an error is set; on success the unit is left open (positioned\nright after the header, ready for the caller to read the payload) and it is the caller's\nresponsibility to close it. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: filename filename to read from integer(kind=int32), intent(in) :: expected_type_code Expected type code in header Type Code integer -1_int32 real -2_int32 complex -4_int32 logical -3_int32 character expected string length integer(kind=int32), intent(in), dimension(:) :: expected_shape Expected shape in header integer(kind=int32), intent(out) :: unit Fortran unit number for the file integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/check_file_header.html"},{"title":"read_file_header_helper – TensorOmics","text":"public  subroutine read_file_header_helper(filename, unit, type_code, ndims, dims, ierr) Opens unit and reads file header with all metadata from given file Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: filename filename to read from integer(kind=int32), intent(out) :: unit Fortran unit number for the file integer(kind=int32), intent(out) :: type_code type code of the array Type Code integer -1_int32 real -2_int32 complex -4_int32 logical -3_int32 character string length integer(kind=int32), intent(out) :: ndims number of dimensions integer(kind=int32), intent(out), allocatable :: dims (:) dimensions of the array integer(kind=int32), intent(out) :: ierr error code","tags":"","url":"proc/read_file_header_helper.html"},{"title":"get_array_metadata – TensorOmics","text":"public  subroutine get_array_metadata(filename, dims_out, dims_out_capacity, ndims, type_code, ierr) Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: dims_out (dims_out_capacity) Array to store output dimensions\nThe first ndims elements will hold the results. integer(kind=int32), intent(in) :: dims_out_capacity Capacity of the dims_out array integer(kind=int32), intent(out) :: ndims number of dimensions integer(kind=int32), intent(out) :: type_code Type code of the serialized array Type Code integer -1_int32 real -2_int32 complex -4_int32 logical -3_int32 character string length integer(kind=int32), intent(out) :: ierr Error code","tags":"C-binding","url":"proc/get_array_metadata.html"},{"title":"save_gene_ids – TensorOmics","text":"public  subroutine save_gene_ids(gene_ids, filename, ierr) Wrapper for serialize_char_1D function Arguments Type Intent Optional Attributes Name character(len=*), intent(in), contiguous :: gene_ids (:) Gene IDs to write character(len=*), intent(in) :: filename Filename to write to integer(kind=int32), intent(out) :: ierr Error code (0 if successful)","tags":"","url":"proc/save_gene_ids.html"},{"title":"save_expression_vectors – TensorOmics","text":"public  subroutine save_expression_vectors(expression_vectors, filename, ierr) Wrapper for serialize_real_2D function Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), contiguous :: expression_vectors (:,:) Expression vectors to write character(len=*), intent(in) :: filename Filename to write to integer(kind=int32), intent(out) :: ierr Error code (0 if successful)","tags":"","url":"proc/save_expression_vectors.html"},{"title":"save_gene_to_family – TensorOmics","text":"public  subroutine save_gene_to_family(gene_to_fam, filename, ierr) Wrapper for serialize_int_1D function Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in), contiguous :: gene_to_fam (:) Gene to family mapping to write character(len=*), intent(in) :: filename Filename to write to integer(kind=int32), intent(out) :: ierr Error code (0 if successful)","tags":"","url":"proc/save_gene_to_family.html"},{"title":"save_family_ids – TensorOmics","text":"public  subroutine save_family_ids(family_ids, filename, ierr) Wrapper for serialize_char_1D function Arguments Type Intent Optional Attributes Name character(len=*), intent(in), contiguous :: family_ids (:) Family IDs to write character(len=*), intent(in) :: filename Filename to write to integer(kind=int32), intent(out) :: ierr Error code (0 if successful)","tags":"","url":"proc/save_family_ids.html"},{"title":"save_family_centroids – TensorOmics","text":"public  subroutine save_family_centroids(family_centroids, filename, ierr) Wrapper for serialize_real_2D function Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), contiguous :: family_centroids (:,:) Family centroids to write character(len=*), intent(in) :: filename Filename to write to integer(kind=int32), intent(out) :: ierr Error code (0 if successful)","tags":"","url":"proc/save_family_centroids.html"},{"title":"save_shift_vectors – TensorOmics","text":"public  subroutine save_shift_vectors(shift_vectors, filename, ierr) Wrapper for serialize_real_2D function Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), contiguous :: shift_vectors (:,:) Shift vectors to write character(len=*), intent(in) :: filename Filename to write to integer(kind=int32), intent(out) :: ierr Error code (0 if successful)","tags":"","url":"proc/save_shift_vectors.html"},{"title":"load_gene_ids – TensorOmics","text":"public  subroutine load_gene_ids(gene_ids, filename, ierr) Wrapper for deserialize_char_1D function Arguments Type Intent Optional Attributes Name character(len=*), intent(out), contiguous :: gene_ids (:) Gene IDs to read character(len=*), intent(in) :: filename Filename to read from integer(kind=int32), intent(out) :: ierr Error code (0 if successful)","tags":"","url":"proc/load_gene_ids.html"},{"title":"load_expression_vectors – TensorOmics","text":"public  subroutine load_expression_vectors(expression_vectors, filename, ierr) Wrapper for deserialize_real_2D function Arguments Type Intent Optional Attributes Name real(kind=real64), intent(out), contiguous :: expression_vectors (:,:) Expression vectors to read character(len=*), intent(in) :: filename Filename to read from integer(kind=int32), intent(out) :: ierr Error code (0 if successful)","tags":"","url":"proc/load_expression_vectors.html"},{"title":"load_gene_to_family – TensorOmics","text":"public  subroutine load_gene_to_family(gene_to_fam, filename, ierr) Wrapper for deserialize_int_1D function Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(out), contiguous :: gene_to_fam (:) Gene to family mapping to read character(len=*), intent(in) :: filename Filename to read from integer(kind=int32), intent(out) :: ierr Error code (0 if successful)","tags":"","url":"proc/load_gene_to_family.html"},{"title":"load_family_ids – TensorOmics","text":"public  subroutine load_family_ids(family_ids, filename, ierr) Wrapper for deserialize_char_1D function Arguments Type Intent Optional Attributes Name character(len=*), intent(out), contiguous :: family_ids (:) Family IDs to read character(len=*), intent(in) :: filename Filename to read from integer(kind=int32), intent(out) :: ierr Error code (0 if successful)","tags":"","url":"proc/load_family_ids.html"},{"title":"load_family_centroids – TensorOmics","text":"public  subroutine load_family_centroids(family_centroids, filename, ierr) Wrapper for deserialize_real_2D function Arguments Type Intent Optional Attributes Name real(kind=real64), intent(out), contiguous :: family_centroids (:,:) Family centroids to read character(len=*), intent(in) :: filename Filename to read from integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/load_family_centroids.html"},{"title":"load_shift_vectors – TensorOmics","text":"public  subroutine load_shift_vectors(shift_vectors, filename, ierr) Wrapper for deserialize_real_2D function Arguments Type Intent Optional Attributes Name real(kind=real64), intent(out), contiguous :: shift_vectors (:,:) Shift vectors to read character(len=*), intent(in) :: filename Filename to read from integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/load_shift_vectors.html"},{"title":"mean – TensorOmics","text":"public pure function mean(vec) Calculates the arithmetic mean of vector Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(:) :: vec Vector to compute the mean value from Return Value real(kind=real64)","tags":"","url":"proc/mean.html"},{"title":"std_dev – TensorOmics","text":"public pure function std_dev(vec, do_bessel_correction) Calculates the standard deviation of vector, with or without Bessel's correction Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(:) :: vec Vector to compute the standard deviation value from logical(kind=c_bool), intent(in), optional :: do_bessel_correction Tells whether to apply the bessel's correction or not, default: .false. Case Formula .true. .false. Return Value real(kind=real64)","tags":"","url":"proc/std_dev.html"},{"title":"clamp_real – TensorOmics","text":"public pure function clamp_real(val, min_val, max_val) result(clamped) Clamps a value into a range min_val <= val <= max_val . If max_val < min_val , min_val is returned Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: val Value to be clamped real(kind=real64), intent(in) :: min_val Lower bound real(kind=real64), intent(in) :: max_val Upper bound Return Value real(kind=real64)","tags":"","url":"proc/clamp_real.html"},{"title":"clamp_int – TensorOmics","text":"public pure function clamp_int(val, min_val, max_val) result(clamped) Clamps a value into a range min_val <= val <= max_val . If max_val < min_val , min_val is returned Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: val Value to be clamped integer(kind=int32), intent(in) :: min_val Lower bound integer(kind=int32), intent(in) :: max_val Upper bound Return Value integer(kind=int32)","tags":"","url":"proc/clamp_int.html"},{"title":"below – TensorOmics","text":"public pure function below(val) Returns the next representable float lower than a value. Helpful for exclusive upper bounds in ranges. Doesn't return denormals, thus below(0.0_real64)==-tiny(1.0_real64) and below(tiny(1.0_real64))==0.0_real64 Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: val Return Value real(kind=real64)","tags":"","url":"proc/below.html"},{"title":"above – TensorOmics","text":"public pure function above(val) Returns the next representable float greater than a value. Helpful for exclusive upper bounds in ranges. Doesn't return denormals, thus above(0.0_real64)==tiny(1.0_real64) and above(-tiny(1.0_real64))==0.0_real64 Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: val Return Value real(kind=real64)","tags":"","url":"proc/above.html"},{"title":"is_close_default – TensorOmics","text":"public pure function is_close_default(a, b) Checks if two values are close to eachother, using a tolerance of max(1d-12, EPS*max(abs(a), abs(b))) with EPS=epsilon(1.0_real64) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: a First variable of comparison a==b real(kind=real64), intent(in) :: b Second variable of comparison a==b Return Value logical","tags":"","url":"proc/is_close_default.html"},{"title":"is_close_within – TensorOmics","text":"public pure function is_close_within(a, b, eps) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: a First variable of comparison a==b real(kind=real64), intent(in) :: b Second variable of comparison a==b real(kind=real64), intent(in) :: eps Relative tolerance factor, scaled by the larger operand. Pass a domain epsilon\nto compare on that domain's terms rather than the arithmetic's. Return Value logical","tags":"","url":"proc/is_close_within.html"},{"title":"radians – TensorOmics","text":"public pure function radians(degrees) Returns the given degrees in positive radian value Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: degrees degrees to be converted Return Value real(kind=real64)","tags":"","url":"proc/radians.html"},{"title":"degrees – TensorOmics","text":"public pure function degrees(radians) Returns the given radians in positive degree value Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: radians radians to be converted Return Value real(kind=real64)","tags":"","url":"proc/degrees.html"},{"title":"next_power_of_two – TensorOmics","text":"public  function next_power_of_two(n) result(power) Find the next power of two greater than or equal to n Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n input value Return Value integer(kind=int32) next greater value that is a power of two","tags":"","url":"proc/next_power_of_two.html"},{"title":"logx – TensorOmics","text":"public pure subroutine logx(val, base, exponent, ierr) Compute logarithm for any base Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: val Value ( x in ) real(kind=real64), intent(in) :: base Base ( b in ) real(kind=real64), intent(out) :: exponent Exponent ( y in ) integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/logx.html"},{"title":"logx_helper – TensorOmics","text":"public pure subroutine logx_helper(val, base, exponent) (no input validation) Compute logarithm for any base: log_base(val) = log(val)/log(base) .\nEnsure val > 0 , base > 0 and base /= 1 , yields a NaN/Inf result otherwise. For a caller that has already established those three facts about a whole array -- so the\nper-element check would only re-derive what is known -- and therefore wants the transform\nin a do concurrent with no shared ierr to write. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: val Value ( x in ), must be > 0 real(kind=real64), intent(in) :: base Base ( b in ), must be > 0 and /= 1 real(kind=real64), intent(out) :: exponent Exponent ( y in )","tags":"","url":"proc/logx_helper.html"},{"title":"clamp – TensorOmics","text":"public interface clamp Generic clamp of a scalar into [min_val, max_val] , dispatches on the value's type. Module Procedures public pure function clamp_real (val, min_val, max_val) result(clamped) Author Franz-Eric Sill License MIT Clamps a value into a range min_val <= val <= max_val . If max_val < min_val , min_val is returned Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: val Value to be clamped real(kind=real64), intent(in) :: min_val Lower bound real(kind=real64), intent(in) :: max_val Upper bound Return Value real(kind=real64) public pure function clamp_int (val, min_val, max_val) result(clamped) Author Franz-Eric Sill License MIT Clamps a value into a range min_val <= val <= max_val . If max_val < min_val , min_val is returned Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: val Value to be clamped integer(kind=int32), intent(in) :: min_val Lower bound integer(kind=int32), intent(in) :: max_val Upper bound Return Value integer(kind=int32)","tags":"","url":"interface/clamp.html"},{"title":"is_close – TensorOmics","text":"public interface is_close Tolerance-based approximate equality for real(real64) .\nCalled as is_close(a, b) with the machine-epsilon tolerance, or as is_close(a, b, eps) where the caller has its own notion of \"the same\" -- a domain\nepsilon such as a smoothing floor, which is coarser than anything the arithmetic\nitself would justify. See is_close_within . Module Procedures public pure function is_close_default (a, b) Author Franz-Eric Sill License MIT Checks if two values are close to eachother, using a tolerance of max(1d-12, EPS*max(abs(a), abs(b))) with EPS=epsilon(1.0_real64) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: a First variable of comparison a==b real(kind=real64), intent(in) :: b Second variable of comparison a==b Return Value logical public pure function is_close_within (a, b, eps) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: a First variable of comparison a==b real(kind=real64), intent(in) :: b Second variable of comparison a==b real(kind=real64), intent(in) :: eps Relative tolerance factor, scaled by the larger operand. Pass a domain epsilon\nto compare on that domain's terms rather than the arithmetic's. Return Value logical","tags":"","url":"interface/is_close.html"},{"title":"operator(.isclose.) – TensorOmics","text":"public interface operator(.isclose.) Tolerance-based approximate equality operator for real(real64) ; see is_close_default .\nAn operator takes exactly its two operands, so the custom-tolerance form is reachable\nonly by calling is_close directly. Module Procedures public pure function is_close_default (a, b) Author Franz-Eric Sill License MIT Checks if two values are close to eachother, using a tolerance of max(1d-12, EPS*max(abs(a), abs(b))) with EPS=epsilon(1.0_real64) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: a First variable of comparison a==b real(kind=real64), intent(in) :: b Second variable of comparison a==b Return Value logical","tags":"","url":"interface/operator(.isclose.).html"},{"title":"omics_vector_RAP_projection – TensorOmics","text":"public pure subroutine omics_vector_RAP_projection(vecs, n_axes, n_vecs, vecs_selection_mask, n_selected_vecs, axes_selection_mask, n_selected_axes, projections, ierr) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_axes, n_vecs) :: vecs matrix with expression vectors integer(kind=int32), intent(in) :: n_axes number of axes integer(kind=int32), intent(in) :: n_vecs number of vectors per axis logical(kind=c_bool), intent(in), dimension(n_vecs) :: vecs_selection_mask .true. for vectors where projection is to be computed integer(kind=int32), intent(in) :: n_selected_vecs count of .true. values in vecs_selection_mask logical(kind=c_bool), intent(in), dimension(n_axes) :: axes_selection_mask .true. for axes to be included in RAP integer(kind=int32), intent(in) :: n_selected_axes count of .true. values in axes_selection_mask real(kind=real64), intent(out), dimension(n_selected_axes, n_selected_vecs) :: projections projected vectors integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/omics_vector_rap_projection.html"},{"title":"omics_field_RAP_projection – TensorOmics","text":"public pure subroutine omics_field_RAP_projection(fields, n_axes, n_fields, fields_selection_mask, n_selected_fields, axes_selection_mask, n_selected_axes, projections, ierr) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_axes, 2, n_fields) :: fields matrix with vector fields; each field holds two vectors, the origin first and the target second integer(kind=int32), intent(in) :: n_axes number of axes integer(kind=int32), intent(in) :: n_fields number of vectors per axis logical(kind=c_bool), intent(in), dimension(n_fields) :: fields_selection_mask .true. for vectors where projection is to be computed integer(kind=int32), intent(in) :: n_selected_fields count of .true. values in fields_selection_mask logical(kind=c_bool), intent(in), dimension(n_axes) :: axes_selection_mask .true. for axes to be included in RAP integer(kind=int32), intent(in) :: n_selected_axes count of .true. values in axes_selection_mask real(kind=real64), intent(out), dimension(n_selected_axes, n_selected_fields) :: projections projected vectors integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/omics_field_rap_projection.html"},{"title":"clock_hand_angle_between_vectors – TensorOmics","text":"public pure subroutine clock_hand_angle_between_vectors(v1, v2, n_dims, orientation_reference, signed_angle, ierr) The unsigned angle is acos(v1 . v2) ; orientation_reference supplies the sign by saying\nwhich way round the plane the two vectors span counts as positive. Reports ERR_INVALID_INPUT when the reference is orthogonal to the rotation and so orients nothing. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_dims) :: v1 First normalized vector in RAP space real(kind=real64), intent(in), dimension(n_dims) :: v2 Second normalized vector in RAP space integer(kind=int32), intent(in) :: n_dims Dimension of both vectors real(kind=real64), intent(in), dimension(n_dims) :: orientation_reference Orients the plane the rotation happens in, so the angle can carry a sign. A\nrotation from one vector to another has no inherent direction above two\ndimensions -- and in RAP space not even in two, since the axes are tissues or\nfactors and carry no handedness -- so the caller states which way round counts\nas positive. The sign is that of this vector's component along the rotation. real(kind=real64), intent(out) :: signed_angle Signed angle between vectors in radians [-pi, pi] integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/clock_hand_angle_between_vectors.html"},{"title":"clock_hand_angles_for_shift_vectors – TensorOmics","text":"public pure subroutine clock_hand_angles_for_shift_vectors(fields, n_dims, n_fields, fields_selection_mask, n_selected_fields, orientation_reference, signed_angles, ierr) Each selected field is angled by the rule of clock_hand_angle_between_vectors_impl ,\nwith one orientation_reference shared by the whole batch. A single field whose rotation\nthe reference fails to orient fails the call. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_dims, 2, n_fields) :: fields matrix with vector fields; each field holds two vectors, the origin first and the target second integer(kind=int32), intent(in) :: n_dims Dimension of each vector in RAP space integer(kind=int32), intent(in) :: n_fields Number of vector pairs logical(kind=c_bool), intent(in), dimension(n_fields) :: fields_selection_mask .true. for vector pairs where angle should be computed integer(kind=int32), intent(in) :: n_selected_fields Count of .true. values in fields_selection_mask real(kind=real64), intent(in), dimension(n_dims) :: orientation_reference Orients the plane the rotation happens in, so the angle can carry a sign. A\nrotation from one vector to another has no inherent direction above two\ndimensions -- and in RAP space not even in two, since the axes are tissues or\nfactors and carry no handedness -- so the caller states which way round counts\nas positive. The sign is that of this vector's component along the rotation. real(kind=real64), intent(out), dimension(n_selected_fields) :: signed_angles Signed rotation angles between vector pairs in radians [-π, π] integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/clock_hand_angles_for_shift_vectors.html"},{"title":"compute_relative_axis_contributions – TensorOmics","text":"public pure subroutine compute_relative_axis_contributions(vec, n_axes, contributions, ierr) Shared utility: the shift-vector and expression-vector entry points below both drive it. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_axes) :: vec RAP-projected and normalized vector (expression or shift) integer(kind=int32), intent(in) :: n_axes Number of axes (length of vec and contributions) real(kind=real64), intent(out), dimension(n_axes) :: contributions Fractional contribution of each axis (output), values in [0,1], sum to 1 integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/compute_relative_axis_contributions.html"},{"title":"relative_axes_changes_from_shift_vector – TensorOmics","text":"public pure subroutine relative_axes_changes_from_shift_vector(vec, n_axes, contributions, ierr) Wrapper for shift vectors (e.g. difference between two RAP-projected vectors) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_axes) :: vec RAP-projected and normalized shift vector integer(kind=int32), intent(in) :: n_axes Number of axes real(kind=real64), intent(out), dimension(n_axes) :: contributions Fractional contribution of each axis (output), values in [0,1], sum to 1 integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/relative_axes_changes_from_shift_vector.html"},{"title":"relative_axes_expression_from_expression_vector – TensorOmics","text":"public pure subroutine relative_axes_expression_from_expression_vector(vec, n_axes, contributions, ierr) Wrapper for single RAP-projected expression vectors Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_axes) :: vec RAP-projected and normalized expression vector integer(kind=int32), intent(in) :: n_axes Number of axes real(kind=real64), intent(out), dimension(n_axes) :: contributions Fractional contribution of each axis (output), values in [0,1], sum to 1 integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/relative_axes_expression_from_expression_vector.html"},{"title":"mask_check_state_c – TensorOmics","text":"public  subroutine mask_check_state_c(bit_mask, n_bit_mask_elements, i_gene, state, ierr) bind(C, name=\"mask_check_state_c\") Uses tox_paralog_analysis_impl Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), dimension(n_bit_mask_elements), target :: bit_mask chunked mask to mark active paralogs integer(kind=c_int), intent(in), target :: n_bit_mask_elements number of elements in bit_mask integer(kind=c_int), intent(in), target :: i_gene index of paralog to be marked active logical(kind=c_bool), intent(out), target :: state check result integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"proc/mask_check_state_c.html"},{"title":"mask_chunk_count_c – TensorOmics","text":"public  subroutine mask_chunk_count_c(n_genes, count, ierr) bind(C, name=\"mask_chunk_count_c\") Uses tox_paralog_analysis_impl Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_genes number of genes integer(kind=c_int), intent(out), target :: count number of 32 bit chunks a mask needs to encode n_genes genes Each bitmask is built of 32 bit chunks. (n_genes + 31) / 32 is equivalent to ceil(n_genes / 32.0_real64) and represents the number of chunks integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"proc/mask_chunk_count_c.html"},{"title":"calc_work_arr_paralog_subsets_size_c – TensorOmics","text":"public  subroutine calc_work_arr_paralog_subsets_size_c(max_subset_size, n_genes, work_array_size, filtered_paralogs_mask, n_mask_chunks, ierr) bind(C, name=\"calc_work_arr_paralog_subsets_size_c\") Uses tox_paralog_analysis_impl The detect_* subroutines need a work array for the to be tested subsets.\nIn worst case, all need to be tried and subsets that cannot be extended will be kept as results.\nThis is the reason why the work array holds the results as well, as all subsets that are stored in the array can be results as well. This subroutine calculates the needed size for the work array. Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(inout), target :: max_subset_size maximum size that a subset must not exceed. Zero is in range and means there is\nnothing to size a work array for, which is reported back as a size of zero.\nThe minimum valid value is 0_int32 . Warning If the desired size is too large and leads to an integer overflow, max_subset_size will be set to the maximum valid size. Also, size will be set to number of genes in filtered_paralogs_mask if larger. integer(kind=c_int), intent(in), target :: n_genes number of genes integer(kind=c_int), intent(out), target :: work_array_size The calculated needed work array size in absolute worst case scenario. Look into source for details. integer(kind=c_int), intent(in), dimension(n_mask_chunks), target :: filtered_paralogs_mask Output mask with all genes disabled that did not pass the filter integer(kind=c_int), intent(in), target :: n_mask_chunks number of 32 bit chunks a mask needs to encode n_genes genes integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"proc/calc_work_arr_paralog_subsets_size_c.html"},{"title":"deserialize_logical_helper – TensorOmics","text":"public  subroutine deserialize_logical_helper(arr, n_elements, arr_shape, filename, ierr) Arguments Type Intent Optional Attributes Name logical(kind=c_bool), intent(out), dimension(n_elements) :: arr Pre-allocated array to read the data into integer(kind=int32), intent(in) :: n_elements Size of arr integer(kind=int32), intent(in), dimension(:) :: arr_shape Extents of arr , one per dimension\nIt is VERY IMPORTANT to compute this argument from the dims_out output produced by get_array_metadata . Producer input Supplied by dims_out_capacity 5_int32 character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code","tags":"C-binding","url":"proc/deserialize_logical_helper.html"},{"title":"deserialize_logical_1d – TensorOmics","text":"public  subroutine deserialize_logical_1d(arr, filename, ierr) Directly deserialize a 1D logical array from a file Arguments Type Intent Optional Attributes Name logical(kind=c_bool), intent(out), dimension(:), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/deserialize_logical_1d.html"},{"title":"deserialize_logical_2d – TensorOmics","text":"public  subroutine deserialize_logical_2d(arr, filename, ierr) Directly deserialize a 2D logical array from a file Arguments Type Intent Optional Attributes Name logical(kind=c_bool), intent(out), dimension(:, :), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/deserialize_logical_2d.html"},{"title":"deserialize_logical_3d – TensorOmics","text":"public  subroutine deserialize_logical_3d(arr, filename, ierr) Directly deserialize a 3D logical array from a file Arguments Type Intent Optional Attributes Name logical(kind=c_bool), intent(out), dimension(:, :, :), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/deserialize_logical_3d.html"},{"title":"deserialize_logical_4d – TensorOmics","text":"public  subroutine deserialize_logical_4d(arr, filename, ierr) Directly deserialize a 4D logical array from a file Arguments Type Intent Optional Attributes Name logical(kind=c_bool), intent(out), dimension(:, :, :, :), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/deserialize_logical_4d.html"},{"title":"deserialize_logical_5d – TensorOmics","text":"public  subroutine deserialize_logical_5d(arr, filename, ierr) Directly deserialize a 5D logical array from a file Arguments Type Intent Optional Attributes Name logical(kind=c_bool), intent(out), dimension(:, :, :, :, :), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/deserialize_logical_5d.html"},{"title":"deserialize_complex_helper_c – TensorOmics","text":"public  subroutine deserialize_complex_helper_c(arr, n_elements, arr_shape, n_arr_shape_elements, filename, filename_strlen, ierr) bind(C, name=\"deserialize_complex_helper_c\") Uses f42_serde_arrays_deserialize_complex Arguments Type Intent Optional Attributes Name complex(kind=c_double_complex), intent(out), dimension(*), target :: arr Pre-allocated array to read the data into integer(kind=c_int), intent(in), target :: n_elements Size of arr integer(kind=c_int), intent(in), dimension(n_arr_shape_elements), target :: arr_shape Extents of arr , one per dimension\nIt is VERY IMPORTANT to compute this argument from the dims_out output produced by get_array_metadata . Producer input Supplied by dims_out_capacity 5_int32 integer(kind=c_int), intent(in), target :: n_arr_shape_elements number of elements in arr_shape character(kind=c_char, len=1), intent(in), dimension(filename_strlen), target :: filename Name of the file integer(kind=c_int), intent(in), target :: filename_strlen length of the strings in filename integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"proc/deserialize_complex_helper_c.html"},{"title":"normalize_unit_length_c – TensorOmics","text":"public  subroutine normalize_unit_length_c(vector, n_dims, ierr) bind(C, name=\"normalize_unit_length_c\") Uses tox_normalization Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(inout), dimension(n_dims), target :: vector Vector that will be normalized to unit length\nNaN is permitted for this value.\nInfinite values are permitted for this value. integer(kind=c_int), intent(in), target :: n_dims number of elements in vector integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"proc/normalize_unit_length_c.html"},{"title":"normalization_pipeline_c – TensorOmics","text":"public  subroutine normalization_pipeline_c(n_genes, n_replicates, expr, log_transformed_expr, reps_per_tissue, n_tissues, span, degree, use_quantile, ierr) bind(C, name=\"normalization_pipeline_c\") Uses tox_normalization Final result is in log_transformed_expr. If fold change is needed, call calc_fchange separately. Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_genes Number of genes (rows) integer(kind=c_int), intent(in), target :: n_replicates Number of replicates per gene real(kind=c_double), intent(in), dimension(n_replicates, n_genes), target :: expr Gene Expression matrix\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=c_double), intent(out), dimension(n_tissues, n_genes), target :: log_transformed_expr Log-transformed grouped expr integer(kind=c_int), intent(in), dimension(n_tissues), target :: reps_per_tissue Number of replicates per tissue in expr . It describes, which slices in expr relate to which tissue,\ne.g. [2,3] means 5 total replicates per gene, the first two of which belong to the first tissue and the remaining three to the second. integer(kind=c_int), intent(in), target :: n_tissues Number of tissues real(kind=c_double), intent(in), target :: span LOESS span parameter.\nThe default value is 0.7_real64 . integer(kind=c_int), intent(in), target :: degree LOESS degree parameter.\nThe default value is 2_int32 . logical(kind=c_bool), intent(in), target :: use_quantile Use quantile normalization.\nThe default value is .false. . integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"proc/normalization_pipeline_c.html"},{"title":"normalization_pipeline_expert_c – TensorOmics","text":"public  subroutine normalization_pipeline_expert_c(n_genes, n_replicates, expr, log_transformed_expr, reps_per_tissue, n_tissues, tmp_expr_copy, tmp_loess_y, tmp_indices_used, tmp_yhat_global, tmp_int_workspace, int_workspace_size, tmp_real_workspace, real_workspace_size, tmp_hat_diag, tmp_loess_weights, tmp_eval_points, tmp_robust_weights, tmp_combined_weights, tmp_residuals, tmp_permutation_indices, span, degree, use_quantile, ierr) bind(C, name=\"normalization_pipeline_expert_c\") Uses tox_normalization Final result is in log_transformed_expr. If fold change is needed, call calc_fchange separately. Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_genes Number of genes (rows) integer(kind=c_int), intent(in), target :: n_replicates Number of replicates per gene real(kind=c_double), intent(in), dimension(n_replicates, n_genes), target :: expr Gene Expression matrix\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=c_double), intent(out), dimension(n_tissues, n_genes), target :: log_transformed_expr Log-transformed grouped expr integer(kind=c_int), intent(in), dimension(n_tissues), target :: reps_per_tissue Number of replicates per tissue in expr . It describes, which slices in expr relate to which tissue,\ne.g. [2,3] means 5 total replicates per gene, the first two of which belong to the first tissue and the remaining three to the second. integer(kind=c_int), intent(in), target :: n_tissues Number of tissues real(kind=c_double), intent(out), dimension(n_replicates, n_genes), target :: tmp_expr_copy Work matrix the pipeline normalizes in place real(kind=c_double), intent(out), dimension(n_genes), target :: tmp_loess_y Work vector for the empirical standard deviations (Y-axis for LOESS) integer(kind=c_int), intent(out), dimension(n_genes), target :: tmp_indices_used Work vector mapping the fitted points back to gene indices real(kind=c_double), intent(out), dimension(n_genes), target :: tmp_yhat_global Work vector for the fitted standard deviations (LOESS predictions) integer(kind=c_int), intent(out), dimension(int_workspace_size), target :: tmp_int_workspace Integer workspace array integer(kind=c_int), intent(in), target :: int_workspace_size Length of integer workspace.\nIt is VERY IMPORTANT to compute this argument from the int_workspace_size output produced by tox_loess_required_workspace . Producer input Supplied by n_dim 1_int32 max_neighborhood_size n_genes save_factorization .false. real(kind=c_double), intent(out), dimension(real_workspace_size), target :: tmp_real_workspace Real workspace array integer(kind=c_int), intent(in), target :: real_workspace_size Length of real workspace.\nIt is VERY IMPORTANT to compute this argument from the real_workspace_size output produced by tox_loess_required_workspace . Producer input Supplied by n_dim 1_int32 max_neighborhood_size n_genes save_factorization .false. real(kind=c_double), intent(out), dimension(n_genes), target :: tmp_hat_diag Diagonal elements of the LOESS hat matrix real(kind=c_double), intent(out), dimension(n_genes), target :: tmp_loess_weights Per-point weights handed to the LOESS fit real(kind=c_double), intent(out), dimension(n_genes, 1), target :: tmp_eval_points Points the fitted curve is evaluated at real(kind=c_double), intent(out), dimension(n_genes), target :: tmp_robust_weights Robust bisquare weights of the LOESS fit real(kind=c_double), intent(out), dimension(n_genes), target :: tmp_combined_weights Combined weights of the LOESS fit real(kind=c_double), intent(out), dimension(n_genes), target :: tmp_residuals Residuals of the LOESS fit integer(kind=c_int), intent(out), dimension(n_genes), target :: tmp_permutation_indices Permutation indices of the LOESS fit real(kind=c_double), intent(in), target :: span LOESS span parameter.\nThe default value is 0.7_real64 . integer(kind=c_int), intent(in), target :: degree LOESS degree parameter.\nThe default value is 2_int32 . logical(kind=c_bool), intent(in), target :: use_quantile Use quantile normalization.\nThe default value is .false. . integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"proc/normalization_pipeline_expert_c.html"},{"title":"normalize_by_std_dev_c – TensorOmics","text":"public  subroutine normalize_by_std_dev_c(n_genes, n_replicates, expr, normalized_expr, span, degree, ierr) bind(C, name=\"normalize_by_std_dev_c\") Uses tox_normalization This procedure applies a global stabilization based on the relationship between\ngene-wise mean expression and empirical standard deviation. Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_genes Number of genes (rows) integer(kind=c_int), intent(in), target :: n_replicates Number of replicates per gene real(kind=c_double), intent(in), dimension(n_replicates, n_genes), target :: expr Gene Expression matrix\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=c_double), intent(out), dimension(n_replicates, n_genes), target :: normalized_expr Normalized expr real(kind=c_double), intent(in), target :: span LOESS span parameter.\nThe default value is 0.7_real64 . integer(kind=c_int), intent(in), target :: degree LOESS degree parameter.\nThe default value is 2_int32 . integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"proc/normalize_by_std_dev_c.html"},{"title":"normalize_by_std_dev_expert_c – TensorOmics","text":"public  subroutine normalize_by_std_dev_expert_c(n_genes, n_replicates, expr, normalized_expr, tmp_loess_x, tmp_loess_y, tmp_indices_used, tmp_yhat_global, tmp_int_workspace, int_workspace_size, tmp_real_workspace, real_workspace_size, tmp_hat_diag, tmp_loess_weights, tmp_eval_points, tmp_robust_weights, tmp_combined_weights, tmp_residuals, tmp_permutation_indices, span, degree, ierr) bind(C, name=\"normalize_by_std_dev_expert_c\") Uses tox_normalization This procedure applies a global stabilization based on the relationship between\ngene-wise mean expression and empirical standard deviation. Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_genes Number of genes (rows) integer(kind=c_int), intent(in), target :: n_replicates Number of replicates per gene real(kind=c_double), intent(in), dimension(n_replicates, n_genes), target :: expr Gene Expression matrix\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=c_double), intent(out), dimension(n_replicates, n_genes), target :: normalized_expr Normalized expr real(kind=c_double), intent(out), dimension(n_genes), target :: tmp_loess_x Work vector for the mean values (X-axis for LOESS) real(kind=c_double), intent(out), dimension(n_genes), target :: tmp_loess_y Work vector for the empirical standard deviations (Y-axis for LOESS) integer(kind=c_int), intent(out), dimension(n_genes), target :: tmp_indices_used Work vector mapping the fitted points back to gene indices real(kind=c_double), intent(out), dimension(n_genes), target :: tmp_yhat_global Work vector for the fitted standard deviations (LOESS predictions) integer(kind=c_int), intent(out), dimension(int_workspace_size), target :: tmp_int_workspace Integer workspace array integer(kind=c_int), intent(in), target :: int_workspace_size Length of integer workspace.\nIt is VERY IMPORTANT to compute this argument from the int_workspace_size output produced by tox_loess_required_workspace . Producer input Supplied by n_dim 1_int32 max_neighborhood_size n_genes save_factorization .false. real(kind=c_double), intent(out), dimension(real_workspace_size), target :: tmp_real_workspace Real workspace array integer(kind=c_int), intent(in), target :: real_workspace_size Length of real workspace.\nIt is VERY IMPORTANT to compute this argument from the real_workspace_size output produced by tox_loess_required_workspace . Producer input Supplied by n_dim 1_int32 max_neighborhood_size n_genes save_factorization .false. real(kind=c_double), intent(out), dimension(n_genes), target :: tmp_hat_diag Diagonal elements of the LOESS hat matrix real(kind=c_double), intent(out), dimension(n_genes), target :: tmp_loess_weights Per-point weights handed to the LOESS fit real(kind=c_double), intent(out), dimension(n_genes, 1), target :: tmp_eval_points Points the fitted curve is evaluated at real(kind=c_double), intent(out), dimension(n_genes), target :: tmp_robust_weights Robust bisquare weights of the LOESS fit real(kind=c_double), intent(out), dimension(n_genes), target :: tmp_combined_weights Combined weights of the LOESS fit real(kind=c_double), intent(out), dimension(n_genes), target :: tmp_residuals Residuals of the LOESS fit integer(kind=c_int), intent(out), dimension(n_genes), target :: tmp_permutation_indices Permutation indices of the LOESS fit real(kind=c_double), intent(in), target :: span LOESS span parameter.\nThe default value is 0.7_real64 . integer(kind=c_int), intent(in), target :: degree LOESS degree parameter.\nThe default value is 2_int32 . integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"proc/normalize_by_std_dev_expert_c.html"},{"title":"root_mean_sq_normalization_c – TensorOmics","text":"public  subroutine root_mean_sq_normalization_c(n_genes, n_replicates, expr, normalized_expr, ierr) bind(C, name=\"root_mean_sq_normalization_c\") Uses tox_normalization across tissues (not classical standard deviation). Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_genes Number of genes (rows) integer(kind=c_int), intent(in), target :: n_replicates Number of replicates per gene real(kind=c_double), intent(in), dimension(n_replicates, n_genes), target :: expr Gene Expression matrix\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=c_double), intent(out), dimension(n_replicates, n_genes), target :: normalized_expr Normalized expr integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/root_mean_sq_normalization_c.html"},{"title":"quantile_normalization_c – TensorOmics","text":"public  subroutine quantile_normalization_c(n_genes, n_replicates, expr, normalized_expr, rank_means, ierr) bind(C, name=\"quantile_normalization_c\") Uses tox_normalization Computes average expression per rank across tissues. Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_genes Number of genes (rows) integer(kind=c_int), intent(in), target :: n_replicates Number of replicates per gene real(kind=c_double), intent(in), dimension(n_replicates, n_genes), target :: expr Gene Expression matrix\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=c_double), intent(out), dimension(n_replicates, n_genes), target :: normalized_expr Normalized expr real(kind=c_double), intent(out), dimension(n_genes), target :: rank_means The mean of each rank across tissues, one per gene integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/quantile_normalization_c.html"},{"title":"quantile_normalization_expert_c – TensorOmics","text":"public  subroutine quantile_normalization_expert_c(n_genes, n_replicates, expr, normalized_expr, rank_means, tmp_genes_row, tmp_perm, ierr) bind(C, name=\"quantile_normalization_expert_c\") Uses tox_normalization Computes average expression per rank across tissues. Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_genes Number of genes (rows) integer(kind=c_int), intent(in), target :: n_replicates Number of replicates per gene real(kind=c_double), intent(in), dimension(n_replicates, n_genes), target :: expr Gene Expression matrix\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=c_double), intent(out), dimension(n_replicates, n_genes), target :: normalized_expr Normalized expr real(kind=c_double), intent(out), dimension(n_genes), target :: rank_means The mean of each rank across tissues, one per gene real(kind=c_double), intent(out), dimension(n_genes), target :: tmp_genes_row Temporary vector for sorting a tissue in expr across genes integer(kind=c_int), intent(out), dimension(n_genes), target :: tmp_perm Permutation vector integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/quantile_normalization_expert_c.html"},{"title":"log2_transformation_c – TensorOmics","text":"public  subroutine log2_transformation_c(n_genes, n_tissues, expr, transformed_expr, ierr) bind(C, name=\"log2_transformation_c\") Uses tox_normalization This subroutine performs element-wise log2(x + 1) transformation on a\nmatrix flattened in column-major order. The log2 is computed via: log(x + 1) / log(2) , which is numerically equivalent and avoids the\nnon-portable log2 intrinsic for compatibility with WebAssembly (WASM). Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_genes Number of genes (rows) integer(kind=c_int), intent(in), target :: n_tissues Number of tissues real(kind=c_double), intent(in), dimension(n_tissues, n_genes), target :: expr Gene Expression matrix, from calc_tiss_avg NaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=c_double), intent(out), dimension(n_tissues, n_genes), target :: transformed_expr Log-transformed expr integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"proc/log2_transformation_c.html"},{"title":"calc_tiss_avg_c – TensorOmics","text":"public  subroutine calc_tiss_avg_c(n_genes, n_tissues, reps_per_tissue, expr, tissue_averages, ierr) bind(C, name=\"calc_tiss_avg_c\") Uses tox_normalization For each tissue of tissue replicates, this subroutine computes the average\nexpression per gene. Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_genes Number of genes (rows) integer(kind=c_int), intent(in), target :: n_tissues Number of tissues integer(kind=c_int), intent(in), dimension(n_tissues), target :: reps_per_tissue Number of replicates per tissue in expr . It describes, which slices in expr relate to which tissue,\ne.g. [2,3] means 5 total replicates per gene, the first two of which belong to the first tissue and the remaining three to the second.\nThe minimum valid value is 1_int32 . real(kind=c_double), intent(in), dimension(sum(reps_per_tissue), n_genes), target :: expr Gene Expression matrix\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=c_double), intent(out), dimension(n_tissues, n_genes), target :: tissue_averages Tissue averages per gene integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/calc_tiss_avg_c.html"},{"title":"calc_fchange_c – TensorOmics","text":"public  subroutine calc_fchange_c(n_genes, n_tissues, n_pairs, control_tissues, condition_tissues, expr, fold_changes, ierr) bind(C, name=\"calc_fchange_c\") Uses tox_normalization For each control-condition pair, this subroutine computes the log2 fold change by subtracting the expression value in the control group from the corresponding\nvalue in the condition group, for all genes. Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_genes Number of genes (rows) integer(kind=c_int), intent(in), target :: n_tissues Number of tissues integer(kind=c_int), intent(in), target :: n_pairs Number of control-condition pairs integer(kind=c_int), intent(in), dimension(n_pairs), target :: control_tissues Control tissue indices\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_tissues . integer(kind=c_int), intent(in), dimension(n_pairs), target :: condition_tissues Condition tissue indices\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_tissues . real(kind=c_double), intent(in), dimension(n_tissues, n_genes), target :: expr Gene Expression matrix, from calc_tiss_avg NaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=c_double), intent(out), dimension(n_pairs, n_genes), target :: fold_changes Output matrix for fold changes integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/calc_fchange_c.html"},{"title":"perform_permutation_test – TensorOmics","text":"public  subroutine perform_permutation_test(trajectories, n_factors, n_samples, n_timepoints, factor_idx, dependent_idx, sample_idx, baseline_mode, n_permutations, local_contributions, total_contributions, random_seed, ierr) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_factors, n_samples, n_timepoints) :: trajectories expression vectors across different samples over time integer(kind=int32), intent(in) :: n_factors number of factors integer(kind=int32), intent(in) :: n_samples number of samples integer(kind=int32), intent(in) :: n_timepoints number of timepoints integer(kind=int32), intent(in) :: factor_idx index of factor to compute the permutation contributions for\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_factors . integer(kind=int32), intent(in) :: dependent_idx index of dependent to compute the permutation contributions for\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_factors . integer(kind=int32), intent(in) :: sample_idx index of sample to compute the permutation contributions for\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_samples . integer(kind=int32), intent(in) :: baseline_mode Mode Value Raw/zero baseline MODE_BASELINE_RAW arithmetic mean MODE_BASELINE_MEAN minimum value MODE_BASELINE_MIN integer(kind=int32), intent(in) :: n_permutations number of permutations to perform real(kind=real64), intent(out), dimension(n_timepoints, n_permutations) :: local_contributions Per-timepoint contributions per permutation real(kind=real64), intent(out), dimension(n_permutations) :: total_contributions Total contribution ( sum(local_contributions) ) per permutation integer(kind=int32), intent(in), optional :: random_seed Seed to use for random number generation. integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/perform_permutation_test.html"},{"title":"perform_permutation_test_expert – TensorOmics","text":"public  subroutine perform_permutation_test_expert(trajectories, n_factors, n_samples, n_timepoints, factor_idx, dependent_idx, sample_idx, baseline_mode, n_permutations, local_contributions, total_contributions, tmp_factor, tmp_dependent, random_seed, ierr) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_factors, n_samples, n_timepoints) :: trajectories expression vectors across different samples over time integer(kind=int32), intent(in) :: n_factors number of factors integer(kind=int32), intent(in) :: n_samples number of samples integer(kind=int32), intent(in) :: n_timepoints number of timepoints integer(kind=int32), intent(in) :: factor_idx index of factor to compute the permutation contributions for\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_factors . integer(kind=int32), intent(in) :: dependent_idx index of dependent to compute the permutation contributions for\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_factors . integer(kind=int32), intent(in) :: sample_idx index of sample to compute the permutation contributions for\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_samples . integer(kind=int32), intent(in) :: baseline_mode Mode Value Raw/zero baseline MODE_BASELINE_RAW arithmetic mean MODE_BASELINE_MEAN minimum value MODE_BASELINE_MIN integer(kind=int32), intent(in) :: n_permutations number of permutations to perform real(kind=real64), intent(out), dimension(n_timepoints, n_permutations) :: local_contributions Per-timepoint contributions per permutation real(kind=real64), intent(out), dimension(n_permutations) :: total_contributions Total contribution ( sum(local_contributions) ) per permutation real(kind=real64), intent(out), dimension(n_timepoints) :: tmp_factor Working array to hold the factor in contiguous memory real(kind=real64), intent(out), dimension(n_timepoints) :: tmp_dependent Working array to hold the random dependent in contiguous memory integer(kind=int32), intent(in), optional :: random_seed Seed to use for random number generation. integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/perform_permutation_test_expert.html"},{"title":"compute_p_values – TensorOmics","text":"public pure subroutine compute_p_values(local_contributions_observed, total_contribution_observed, local_contributions_perm_test, total_contributions_perm_test, n_timepoints, n_permutations, local_p_values, total_p_value, ierr) Given the permutation tests ( perform_permutation_test_impl ),\nthis counts how many of the permutation contributions were at least as high as the real ones. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_timepoints) :: local_contributions_observed Per-timepoint contributions for the observed factor-dependent-sample combination real(kind=real64), intent(in) :: total_contribution_observed Total contribution ( sum(local_contributions) ) for the observed factor-dependent-sample combination real(kind=real64), intent(in), dimension(n_timepoints, n_permutations) :: local_contributions_perm_test Per-timepoint contributions for the factor-dependent-random_sample combinations from perform_permutation_test_impl real(kind=real64), intent(in), dimension(n_permutations) :: total_contributions_perm_test Total contribution ( sum(local_contributions) ) for the factor-dependent-random_sample combinations from perform_permutation_test_impl integer(kind=int32), intent(in) :: n_timepoints number of timepoints integer(kind=int32), intent(in) :: n_permutations number of permutations to perform real(kind=real64), intent(out), dimension(n_timepoints) :: local_p_values calculated p values for local contributions, like: (local_contributions_perm_test >= local_contributions_observed)/n_permutations real(kind=real64), intent(out) :: total_p_value calculated p values for total contributions, like: (total_contributions_perm_test >= total_contribution_observed)/n_permutations integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/compute_p_values.html"},{"title":"compute_contributions – TensorOmics","text":"public pure subroutine compute_contributions(factor, dependent, n_dims, baseline_mode, local_contributions, total_contribution, ierr) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_dims) :: factor Factor time series, length n_timepoints real(kind=real64), intent(in), dimension(n_dims) :: dependent Dependent variable time series, length n_timepoints integer(kind=int32), intent(in) :: n_dims Number of elements in factor and dependent integer(kind=int32), intent(in) :: baseline_mode Mode Value Raw/zero baseline MODE_BASELINE_RAW arithmetic mean MODE_BASELINE_MEAN minimum value MODE_BASELINE_MIN real(kind=real64), intent(out), dimension(n_dims) :: local_contributions Per-element contributions real(kind=real64), intent(out) :: total_contribution Total contribution ( sum(local_contributions) ) integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/compute_contributions.html"},{"title":"compute_all_contributions – TensorOmics","text":"public pure subroutine compute_all_contributions(trajectories, n_factors, n_samples, n_timepoints, factor_indices, n_selected_factors, dependent_indices, n_selected_dependents, baseline_mode, local_contributions, total_contributions, ierr) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_factors, n_samples, n_timepoints) :: trajectories expression vectors across different samples over time integer(kind=int32), intent(in) :: n_factors number of factors integer(kind=int32), intent(in) :: n_samples number of samples integer(kind=int32), intent(in) :: n_timepoints number of timepoints integer(kind=int32), intent(in), dimension(n_selected_factors) :: factor_indices indices of factors to compute the contributions for\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_factors . integer(kind=int32), intent(in) :: n_selected_factors number of selected factors in factor_indices integer(kind=int32), intent(in), dimension(n_selected_dependents) :: dependent_indices indices of dependents to compute the contributions for\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_factors . integer(kind=int32), intent(in) :: n_selected_dependents number of selected dependents in dependent_indices integer(kind=int32), intent(in) :: baseline_mode Mode Value Raw/zero baseline MODE_BASELINE_RAW arithmetic mean MODE_BASELINE_MEAN minimum value MODE_BASELINE_MIN real(kind=real64), intent(out), dimension(n_timepoints, n_selected_factors, n_selected_dependents, n_samples) :: local_contributions Per-timepoint contributions per sample-dependent-factor combination real(kind=real64), intent(out), dimension(n_selected_factors, n_selected_dependents, n_samples) :: total_contributions Total contribution ( sum(local_contributions) ) per sample-dependent-factor combination integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/compute_all_contributions.html"},{"title":"compute_all_contributions_expert – TensorOmics","text":"public pure subroutine compute_all_contributions_expert(trajectories, n_factors, n_samples, n_timepoints, factor_indices, n_selected_factors, dependent_indices, n_selected_dependents, baseline_mode, local_contributions, total_contributions, tmp_factors, tmp_dependent, ierr) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_factors, n_samples, n_timepoints) :: trajectories expression vectors across different samples over time integer(kind=int32), intent(in) :: n_factors number of factors integer(kind=int32), intent(in) :: n_samples number of samples integer(kind=int32), intent(in) :: n_timepoints number of timepoints integer(kind=int32), intent(in), dimension(n_selected_factors) :: factor_indices indices of factors to compute the contributions for\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_factors . integer(kind=int32), intent(in) :: n_selected_factors number of selected factors in factor_indices integer(kind=int32), intent(in), dimension(n_selected_dependents) :: dependent_indices indices of dependents to compute the contributions for\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_factors . integer(kind=int32), intent(in) :: n_selected_dependents number of selected dependents in dependent_indices integer(kind=int32), intent(in) :: baseline_mode Mode Value Raw/zero baseline MODE_BASELINE_RAW arithmetic mean MODE_BASELINE_MEAN minimum value MODE_BASELINE_MIN real(kind=real64), intent(out), dimension(n_timepoints, n_selected_factors, n_selected_dependents, n_samples) :: local_contributions Per-timepoint contributions per sample-dependent-factor combination real(kind=real64), intent(out), dimension(n_selected_factors, n_selected_dependents, n_samples) :: total_contributions Total contribution ( sum(local_contributions) ) per sample-dependent-factor combination real(kind=real64), intent(out), dimension(n_timepoints, n_selected_factors) :: tmp_factors Working array to hold the currently handled sample's factors in contiguous memory real(kind=real64), intent(out), dimension(n_timepoints) :: tmp_dependent Working array to hold the currently handled dependent in contiguous memory integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/compute_all_contributions_expert.html"},{"title":"compute_baselines_factor_dependent – TensorOmics","text":"public pure subroutine compute_baselines_factor_dependent(n_timepoints, factor, dependent, baseline_mode, factor_baseline, dependent_baseline, ierr) Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_timepoints Number of timepoints in both factor and dependent arrays real(kind=real64), intent(in), dimension(n_timepoints) :: factor Factor time series, length n_timepoints real(kind=real64), intent(in), dimension(n_timepoints) :: dependent Dependent variable time series, length n_timepoints integer(kind=int32), intent(in) :: baseline_mode Mode Value Raw/zero baseline MODE_BASELINE_RAW arithmetic mean MODE_BASELINE_MEAN minimum value MODE_BASELINE_MIN real(kind=real64), intent(out) :: factor_baseline Computed baseline for factor real(kind=real64), intent(out) :: dependent_baseline Computed baseline for dependent variable integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/compute_baselines_factor_dependent.html"},{"title":"compute_velocity_trajectory – TensorOmics","text":"public pure subroutine compute_velocity_trajectory(trajectory, velocity, n_timepoints, ierr) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_timepoints) :: trajectory input position trajectory real(kind=real64), intent(out), dimension(max(0_int32, n_timepoints - 1)) :: velocity output velocity trajectory integer(kind=int32), intent(in) :: n_timepoints number of timepoints integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/compute_velocity_trajectory.html"},{"title":"compute_acceleration_from_velocity_trajectory – TensorOmics","text":"public pure subroutine compute_acceleration_from_velocity_trajectory(velocity, acceleration, n_timepoints, ierr) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(max(0_int32, n_timepoints - 1)) :: velocity velocity trajectory real(kind=real64), intent(out), dimension(max(0_int32, n_timepoints - 2)) :: acceleration acceleration trajectory integer(kind=int32), intent(in) :: n_timepoints number of timepoints integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/compute_acceleration_from_velocity_trajectory.html"},{"title":"compute_velocity_trajectories – TensorOmics","text":"public pure subroutine compute_velocity_trajectories(trajectories, velocity, n_factors, n_samples, n_timepoints, ierr) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_factors, n_samples, n_timepoints) :: trajectories input position trajectories real(kind=real64), intent(out), dimension(max(0_int32, n_timepoints - 1), n_factors, n_samples) :: velocity output velocity trajectories integer(kind=int32), intent(in) :: n_factors number of factors integer(kind=int32), intent(in) :: n_samples number of samples integer(kind=int32), intent(in) :: n_timepoints number of timepoints integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/compute_velocity_trajectories.html"},{"title":"compute_acceleration_from_velocity – TensorOmics","text":"public pure subroutine compute_acceleration_from_velocity(velocity, acceleration, n_factors, n_samples, n_timepoints, ierr) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(max(0_int32, n_timepoints - 1), n_factors, n_samples) :: velocity input velocity trajectories real(kind=real64), intent(out), dimension(max(0_int32, n_timepoints - 2), n_factors, n_samples) :: acceleration output acceleration trajectories integer(kind=int32), intent(in) :: n_factors number of factors integer(kind=int32), intent(in) :: n_samples number of samples integer(kind=int32), intent(in) :: n_timepoints number of timepoints integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/compute_acceleration_from_velocity.html"},{"title":"compute_velocity_acceleration_contributions – TensorOmics","text":"public pure subroutine compute_velocity_acceleration_contributions(trajectories, n_factors, n_samples, n_timepoints, baseline_mode, contrib_velocity, velocity_contribution_series, contrib_acceleration, acceleration_contribution_series, ierr) Note Performance layout: trajectories uses (n_factors, n_samples, n_timepoints) .\nVelocity and acceleration use time-first layouts: velocity -> (max(0, n_timepoints-1), n_factors, n_samples) acceleration -> (max(0, n_timepoints-2), n_factors, n_samples) This keeps slices like velocity(:, factor, sample) contiguous,\navoids expensive tmporaries, and improves cache efficiency. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_factors, n_samples, n_timepoints) :: trajectories input position trajectories integer(kind=int32), intent(in) :: n_factors number of factors integer(kind=int32), intent(in) :: n_samples number of samples integer(kind=int32), intent(in) :: n_timepoints number of timepoints integer(kind=int32), intent(in) :: baseline_mode Mode Value Raw/zero baseline MODE_BASELINE_RAW arithmetic mean MODE_BASELINE_MEAN minimum value MODE_BASELINE_MIN real(kind=real64), intent(out), dimension(n_factors, n_factors, n_samples) :: contrib_velocity output velocity contributions real(kind=real64), intent(out), dimension(n_timepoints, n_factors, n_factors, n_samples) :: velocity_contribution_series output velocity contribution series real(kind=real64), intent(out), dimension(n_factors, n_factors, n_samples) :: contrib_acceleration output acceleration contributions real(kind=real64), intent(out), dimension(n_timepoints, n_factors, n_factors, n_samples) :: acceleration_contribution_series output acceleration contribution series integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/compute_velocity_acceleration_contributions.html"},{"title":"compute_velocity_acceleration_contributions_expert – TensorOmics","text":"public pure subroutine compute_velocity_acceleration_contributions_expert(trajectories, n_factors, n_samples, n_timepoints, baseline_mode, tmp_factors, tmp_dependent, tmp_contributions, contrib_velocity, velocity_contribution_series, contrib_acceleration, acceleration_contribution_series, ierr) Note Performance layout: trajectories uses (n_factors, n_samples, n_timepoints) .\nVelocity and acceleration use time-first layouts: velocity -> (max(0, n_timepoints-1), n_factors, n_samples) acceleration -> (max(0, n_timepoints-2), n_factors, n_samples) This keeps slices like velocity(:, factor, sample) contiguous,\navoids expensive tmporaries, and improves cache efficiency. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_factors, n_samples, n_timepoints) :: trajectories input position trajectories integer(kind=int32), intent(in) :: n_factors number of factors integer(kind=int32), intent(in) :: n_samples number of samples integer(kind=int32), intent(in) :: n_timepoints number of timepoints integer(kind=int32), intent(in) :: baseline_mode Mode Value Raw/zero baseline MODE_BASELINE_RAW arithmetic mean MODE_BASELINE_MEAN minimum value MODE_BASELINE_MIN real(kind=real64), intent(out), dimension(n_timepoints - 1, n_factors) :: tmp_factors workspace for factor data (used for velocity and acceleration) real(kind=real64), intent(out), dimension(n_timepoints - 1) :: tmp_dependent workspace for dependent data (used for velocity and acceleration) real(kind=real64), intent(out), dimension(n_timepoints - 1) :: tmp_contributions workspace for contribution calculations (used for velocity and acceleration) real(kind=real64), intent(out), dimension(n_factors, n_factors, n_samples) :: contrib_velocity output velocity contributions real(kind=real64), intent(out), dimension(n_timepoints, n_factors, n_factors, n_samples) :: velocity_contribution_series output velocity contribution series real(kind=real64), intent(out), dimension(n_factors, n_factors, n_samples) :: contrib_acceleration output acceleration contributions real(kind=real64), intent(out), dimension(n_timepoints, n_factors, n_factors, n_samples) :: acceleration_contribution_series output acceleration contribution series integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/compute_velocity_acceleration_contributions_expert.html"},{"title":"determine_shared_residual_range_impl – TensorOmics","text":"public pure subroutine determine_shared_residual_range_impl(abs_residual_pool, abs_residual_pool_perm, pool_size, shared_residual_range, residual_range_quantile) This takes the pool already built; determine_study_shared_residual_range builds it from\nthe neighborhood residuals of two studies first, if that is what is at hand. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(pool_size) :: abs_residual_pool The absolute residual values of the concatenated S1,S2 residuals\nNaN is permitted for this value. integer(kind=int32), intent(in), dimension(pool_size) :: abs_residual_pool_perm The permutation vector that sorts abs_residual_pool The minimum valid value is 1_int32 .\nThe maximum valid value is pool_size . integer(kind=int32), intent(in) :: pool_size Size of pool of residuals abs_residual_pool , usually (n_reps_S1 + n_reps_2)*n_neighbors*n_points real(kind=real64), intent(out) :: shared_residual_range Computed residual range (R) real(kind=real64), intent(in), optional :: residual_range_quantile Quantile in [0,1] for determining the residual range\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 .\nThe default value is 0.95 .","tags":"","url":"proc/determine_shared_residual_range_impl.html"},{"title":"determine_study_shared_residual_range_impl – TensorOmics","text":"public pure subroutine determine_study_shared_residual_range_impl(neighborhood_residuals_S1, neighborhood_residuals_S2, n_reps_S1, n_reps_S2, n_neighbors, n_points, tmp_abs_residual_pool, tmp_abs_residual_pool_perm, shared_residual_range, residual_range_quantile) Pools the absolute residuals of both studies, sorts them, and takes the quantile exactly\nas determine_shared_residual_range does. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_reps_S1, n_neighbors, n_points) :: neighborhood_residuals_S1 Computed neighborhood residuals for study 1, NaN is explicitly allowed for missing values\nNaN is permitted for this value. real(kind=real64), intent(in), dimension(n_reps_S2, n_neighbors, n_points) :: neighborhood_residuals_S2 Computed neighborhood residuals for study 2, NaN is explicitly allowed for missing values\nNaN is permitted for this value. integer(kind=int32), intent(in) :: n_reps_S1 Number of replicates in study 1 integer(kind=int32), intent(in) :: n_reps_S2 Number of replicates in study 2 integer(kind=int32), intent(in) :: n_neighbors Number of neighbors in the studies integer(kind=int32), intent(in) :: n_points Number of reference points in the studies real(kind=real64), intent(out), dimension((n_reps_S1 + n_reps_S2)*n_neighbors*n_points) :: tmp_abs_residual_pool Work array holding the pooled absolute residuals of both studies integer(kind=int32), intent(out), dimension((n_reps_S1 + n_reps_S2)*n_neighbors*n_points) :: tmp_abs_residual_pool_perm Work array for the permutation that sorts tmp_abs_residual_pool real(kind=real64), intent(out) :: shared_residual_range Computed residual range (R) real(kind=real64), intent(in), optional :: residual_range_quantile Quantile in [0,1] for determining the residual range\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 .\nThe default value is 0.95 .","tags":"","url":"proc/determine_study_shared_residual_range_impl.html"},{"title":"build_residual_histograms_impl – TensorOmics","text":"public pure subroutine build_residual_histograms_impl(neighborhood_residuals, n_reps, n_neighbors, n_points, shared_residual_range, n_bins, counts, pmf, included_n_reps, neighbor_mask) The probability mass function pmf(residual, bin) is actually a matrix. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_reps, n_neighbors, n_points) :: neighborhood_residuals Computed neighborhood residuals for a study, NaN is explicitly allowed for missing values\nNaN is permitted for this value. integer(kind=int32), intent(in) :: n_reps Number of replicates of the study integer(kind=int32), intent(in) :: n_neighbors Number of reference points (k) integer(kind=int32), intent(in) :: n_points Number of reference points in the study real(kind=real64), intent(in) :: shared_residual_range Computed residual range (R)\nThe minimum valid value is 0.0_real64 . integer(kind=int32), intent(in) :: n_bins Number of equally sized histogram bins in range [-R,R] integer(kind=int32), intent(out), dimension(n_points, n_bins) :: counts Absolute counts of a residual per bin real(kind=real64), intent(out), dimension(n_points, n_bins) :: pmf counts normalized to 0 <= counts(:, i) <= 1 and sum(counts(:, i)) == 1 integer(kind=int32), intent(out), dimension(n_points) :: included_n_reps Stores the count of non-NaN replicates (included ones) logical(kind=c_bool), intent(in), optional, dimension(n_neighbors, n_points) :: neighbor_mask Optional mask to exclude specific neighbors (e.g. for family-wise analysis)","tags":"","url":"proc/build_residual_histograms_impl.html"},{"title":"compute_divergence_per_reference_point_impl – TensorOmics","text":"public pure subroutine compute_divergence_per_reference_point_impl(pmf_S1, pmf_S2, n_points, n_bins, js_divergences) Takes the probabilities pmf produced by build_residual_histograms . Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_points, n_bins) :: pmf_S1 Computed normalized histogram counts for study 1\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 . real(kind=real64), intent(in), dimension(n_points, n_bins) :: pmf_S2 Computed normalized histogram counts for study 2\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 . integer(kind=int32), intent(in) :: n_points Number of reference points (k) integer(kind=int32), intent(in) :: n_bins Number of equally sized histogram bins in range [-R,R] real(kind=real64), intent(out), dimension(n_points) :: js_divergences Jensen-Shannon divergence per reference point","tags":"","url":"proc/compute_divergence_per_reference_point_impl.html"},{"title":"compute_weighted_global_divergence_impl – TensorOmics","text":"public pure subroutine compute_weighted_global_divergence_impl(js_divergences, n_points, included_n_reps_S1, included_n_reps_S2, global_js_divergence, weights) Takes the divergences produced by compute_divergence_per_reference_point . Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_points) :: js_divergences Jensen-Shannon divergence per reference point, computed for studies S1 and S2\nThe minimum valid value is 0.0_real64 . integer(kind=int32), intent(in) :: n_points Number of reference points (k) integer(kind=int32), intent(in), dimension(n_points) :: included_n_reps_S1 Count of non-NaN residuals (included ones) in study 1\nThe minimum valid value is 0_int32 . integer(kind=int32), intent(in), dimension(n_points) :: included_n_reps_S2 Count of non-NaN residuals (included ones) in study 2\nThe minimum valid value is 0_int32 . real(kind=real64), intent(out) :: global_js_divergence Weighted global Jensen-Shannon divergence real(kind=real64), intent(out), dimension(n_points) :: weights Weights used for calculating the global weighted Jensen-Shannon divergence global_js_divergence","tags":"","url":"proc/compute_weighted_global_divergence_impl.html"},{"title":"jct_compute_jsd_pipeline_helper – TensorOmics","text":"public pure subroutine jct_compute_jsd_pipeline_helper(neighborhood_residuals_S1, neighborhood_residuals_S2, n_reps_S1, n_reps_S2, n_neighbors, n_points, n_bins, shared_residual_range, js_divergences, included_n_reps_S1, included_n_reps_S2, global_js_divergence, weights, pmf_S1, pmf_S2, tmp_counts, neighbor_mask_S1, neighbor_mask_S2) Internal helper: the permutation test and the per-family analysis both drive this. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_reps_S1, n_neighbors, n_points) :: neighborhood_residuals_S1 Computed neighborhood residuals for study 1, NaN is explicitly allowed for missing values real(kind=real64), intent(in), dimension(n_reps_S2, n_neighbors, n_points) :: neighborhood_residuals_S2 Computed neighborhood residuals for study 2, NaN is explicitly allowed for missing values integer(kind=int32), intent(in) :: n_reps_S1 Number of replicates in study 1 integer(kind=int32), intent(in) :: n_reps_S2 Number of replicates in study 2 integer(kind=int32), intent(in) :: n_neighbors Number of neighbors in the studies integer(kind=int32), intent(in) :: n_points Number of reference points in the studies integer(kind=int32), intent(in) :: n_bins Number of equally sized histogram bins used for the studies real(kind=real64), intent(in) :: shared_residual_range Computed residual range for both studies real(kind=real64), intent(out), dimension(n_points) :: js_divergences Jensen-Shannon divergence per reference point, computed for studies S1 and S2 integer(kind=int32), intent(out), dimension(n_points) :: included_n_reps_S1 Count of non-NaN residuals (included ones) in study 1 integer(kind=int32), intent(out), dimension(n_points) :: included_n_reps_S2 Count of non-NaN residuals (included ones) in study 2 real(kind=real64), intent(out) :: global_js_divergence Weighted global Jensen-Shannon divergence real(kind=real64), intent(out), dimension(n_points) :: weights Weights used for calculating the global weighted Jensen-Shannon divergence global_js_divergence real(kind=real64), intent(out), dimension(n_points, n_bins) :: pmf_S1 Normalized histogram counts for study 1 real(kind=real64), intent(out), dimension(n_points, n_bins) :: pmf_S2 Normalized histogram counts for study 2 integer(kind=int32), intent(out), dimension(n_points, n_bins) :: tmp_counts Working array for the histogram counts logical(kind=c_bool), intent(in), optional, dimension(n_neighbors, n_points) :: neighbor_mask_S1 Optional mask to exclude specific neighbors from study 1 (e.g. for family-wise analysis) logical(kind=c_bool), intent(in), optional, dimension(n_neighbors, n_points) :: neighbor_mask_S2 Optional mask to exclude specific neighbors from study 2 (e.g. for family-wise analysis)","tags":"","url":"proc/jct_compute_jsd_pipeline_helper.html"},{"title":"mean_vector_c – TensorOmics","text":"public  subroutine mean_vector_c(expression_vectors, n_axes, n_genes, gene_indices, n_selected_genes, centroid, ierr) bind(C, name=\"mean_vector_c\") Uses tox_gene_centroids Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_axes, n_genes), target :: expression_vectors The input matrix of all gene expression vectors (n_axes x n_genes). integer(kind=c_int), intent(in), target :: n_axes Number of axes (tissues/dimensions). integer(kind=c_int), intent(in), target :: n_genes Total number of genes in the input matrix. integer(kind=c_int), intent(in), dimension(n_selected_genes), target :: gene_indices An array containing the column indices of the selected genes in 'expression_vectors'.\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_genes . integer(kind=c_int), intent(in), target :: n_selected_genes The number of genes in the current family to be averaged.\nThe minimum valid value is 0_int32 .\nThe maximum valid value is n_genes . real(kind=c_double), intent(out), dimension(n_axes), target :: centroid The output vector representing the computed centroid. integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/mean_vector_c.html"},{"title":"group_centroid_orthologs_c – TensorOmics","text":"public  subroutine group_centroid_orthologs_c(expression_vectors, n_axes, n_genes, gene_to_family, n_families, centroid_matrix, ortholog_set, ierr) bind(C, name=\"group_centroid_orthologs_c\") Uses tox_gene_centroids Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_axes, n_genes), target :: expression_vectors The input matrix of all gene expression vectors (n_axes x n_genes). integer(kind=c_int), intent(in), target :: n_axes Number of axes (tissues/dimensions). integer(kind=c_int), intent(in), target :: n_genes Total number of genes in the 'expression_vectors' matrix. integer(kind=c_int), intent(in), dimension(n_genes), target :: gene_to_family Index mapping -> each index i holds the family index for the corresponding gene in expression_vectors , using 0_int32 for unassigned genes\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_families .\nThe value 0_int32 is additionally accepted. integer(kind=c_int), intent(in), target :: n_families Total number of gene families to compute centroids for. real(kind=c_double), intent(out), dimension(n_axes, n_families), target :: centroid_matrix The output matrix (n_axes x n_families) to store the computed centroids. logical(kind=c_bool), intent(in), dimension(n_genes), target :: ortholog_set A logical array indicating if a gene is part of a specific subset (e.g., orthologs). integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/group_centroid_orthologs_c.html"},{"title":"group_centroid_orthologs_expert_c – TensorOmics","text":"public  subroutine group_centroid_orthologs_expert_c(expression_vectors, n_axes, n_genes, gene_to_family, n_families, centroid_matrix, tmp_group_indices, ortholog_set, ierr) bind(C, name=\"group_centroid_orthologs_expert_c\") Uses tox_gene_centroids Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_axes, n_genes), target :: expression_vectors The input matrix of all gene expression vectors (n_axes x n_genes). integer(kind=c_int), intent(in), target :: n_axes Number of axes (tissues/dimensions). integer(kind=c_int), intent(in), target :: n_genes Total number of genes in the 'expression_vectors' matrix. integer(kind=c_int), intent(in), dimension(n_genes), target :: gene_to_family Index mapping -> each index i holds the family index for the corresponding gene in expression_vectors , using 0_int32 for unassigned genes\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_families .\nThe value 0_int32 is additionally accepted. integer(kind=c_int), intent(in), target :: n_families Total number of gene families to compute centroids for. real(kind=c_double), intent(out), dimension(n_axes, n_families), target :: centroid_matrix The output matrix (n_axes x n_families) to store the computed centroids. integer(kind=c_int), intent(out), dimension(n_genes), target :: tmp_group_indices Work array for storing the indices of one family's genes. logical(kind=c_bool), intent(in), dimension(n_genes), target :: ortholog_set A logical array indicating if a gene is part of a specific subset (e.g., orthologs). integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/group_centroid_orthologs_expert_c.html"},{"title":"group_centroid_all_c – TensorOmics","text":"public  subroutine group_centroid_all_c(expression_vectors, n_axes, n_genes, gene_to_family, n_families, centroid_matrix, ierr) bind(C, name=\"group_centroid_all_c\") Uses tox_gene_centroids Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_axes, n_genes), target :: expression_vectors The input matrix of all gene expression vectors (n_axes x n_genes). integer(kind=c_int), intent(in), target :: n_axes Number of axes (tissues/dimensions). integer(kind=c_int), intent(in), target :: n_genes Total number of genes in the 'expression_vectors' matrix. integer(kind=c_int), intent(in), dimension(n_genes), target :: gene_to_family Index mapping -> each index i holds the family index for the corresponding gene in expression_vectors , using 0_int32 for unassigned genes\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_families .\nThe value 0_int32 is additionally accepted. integer(kind=c_int), intent(in), target :: n_families Total number of gene families to compute centroids for. real(kind=c_double), intent(out), dimension(n_axes, n_families), target :: centroid_matrix The output matrix (n_axes x n_families) to store the computed centroids. integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/group_centroid_all_c.html"},{"title":"group_centroid_all_expert_c – TensorOmics","text":"public  subroutine group_centroid_all_expert_c(expression_vectors, n_axes, n_genes, gene_to_family, n_families, centroid_matrix, tmp_group_indices, ierr) bind(C, name=\"group_centroid_all_expert_c\") Uses tox_gene_centroids Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_axes, n_genes), target :: expression_vectors The input matrix of all gene expression vectors (n_axes x n_genes). integer(kind=c_int), intent(in), target :: n_axes Number of axes (tissues/dimensions). integer(kind=c_int), intent(in), target :: n_genes Total number of genes in the 'expression_vectors' matrix. integer(kind=c_int), intent(in), dimension(n_genes), target :: gene_to_family Index mapping -> each index i holds the family index for the corresponding gene in expression_vectors , using 0_int32 for unassigned genes\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_families .\nThe value 0_int32 is additionally accepted. integer(kind=c_int), intent(in), target :: n_families Total number of gene families to compute centroids for. real(kind=c_double), intent(out), dimension(n_axes, n_families), target :: centroid_matrix The output matrix (n_axes x n_families) to store the computed centroids. integer(kind=c_int), intent(out), dimension(n_genes), target :: tmp_group_indices Work array for storing the indices of one family's genes. integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/group_centroid_all_expert_c.html"},{"title":"serialize_logical_helper_c – TensorOmics","text":"public  subroutine serialize_logical_helper_c(arr, n_elements, arr_shape, n_arr_shape_elements, filename, filename_strlen, ierr) bind(C, name=\"serialize_logical_helper_c\") Uses f42_serde_arrays_serialize_logical Arguments Type Intent Optional Attributes Name logical(kind=c_bool), intent(in), dimension(*), target :: arr Array to be serialized integer(kind=c_int), intent(in), target :: n_elements Number of strings in arr integer(kind=c_int), intent(in), dimension(n_arr_shape_elements), target :: arr_shape Extents of arr , one per dimension integer(kind=c_int), intent(in), target :: n_arr_shape_elements number of elements in arr_shape character(kind=c_char, len=1), intent(in), dimension(filename_strlen), target :: filename Name of the file to write to integer(kind=c_int), intent(in), target :: filename_strlen length of the strings in filename integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"proc/serialize_logical_helper_c.html"},{"title":"gjct_permutation_test – TensorOmics","text":"public  subroutine gjct_permutation_test(neighborhood_residuals_S1, neighborhood_residuals_S2, n_reps_S1, n_reps_S2, n_neighbors, n_points, global_jsd_observed, n_bins, shared_residual_range, n_permutations, jsd_null, p_value, random_seed, neighbor_mask_S1, neighbor_mask_S2, ierr) Tests the null hypothesis that both studies are exchangeable. The residuals are shuffled in\nthe work copies, so the caller's own arrays are left untouched. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_reps_S1, n_neighbors, n_points) :: neighborhood_residuals_S1 Computed neighborhood residuals for study 1, NaN is explicitly allowed for missing values\nNaN is permitted for this value. real(kind=real64), intent(in), dimension(n_reps_S2, n_neighbors, n_points) :: neighborhood_residuals_S2 Computed neighborhood residuals for study 2, NaN is explicitly allowed for missing values\nNaN is permitted for this value. integer(kind=int32), intent(in) :: n_reps_S1 Number of replicates in study 1 integer(kind=int32), intent(in) :: n_reps_S2 Number of replicates in study 2 integer(kind=int32), intent(in) :: n_neighbors Number of neighbors in the studies integer(kind=int32), intent(in) :: n_points Number of reference points in the studies real(kind=real64), intent(in) :: global_jsd_observed Observed global JSD value for both studies integer(kind=int32), intent(in) :: n_bins Number of equally sized histogram bins used for the studies real(kind=real64), intent(in) :: shared_residual_range Computed residual range for both studies\nThe minimum valid value is 0.0_real64 . integer(kind=int32), intent(in) :: n_permutations Number of permutations to perform real(kind=real64), intent(out), dimension(n_permutations) :: jsd_null Vector of global divergence values obtained under the null hypothesis real(kind=real64), intent(out) :: p_value Empirical p-value of the permutation test: integer(kind=int32), intent(in), optional :: random_seed Seed to use for shuffling logical(kind=c_bool), intent(in), optional, dimension(n_neighbors, n_points) :: neighbor_mask_S1 Optional mask to exclude specific neighbors from study 1 (e.g. for family-wise analysis) logical(kind=c_bool), intent(in), optional, dimension(n_neighbors, n_points) :: neighbor_mask_S2 Optional mask to exclude specific neighbors from study 2 (e.g. for family-wise analysis) integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/gjct_permutation_test.html"},{"title":"gjct_permutation_test_expert – TensorOmics","text":"public  subroutine gjct_permutation_test_expert(neighborhood_residuals_S1, neighborhood_residuals_S2, n_reps_S1, n_reps_S2, n_neighbors, n_points, global_jsd_observed, n_bins, shared_residual_range, n_permutations, jsd_null, p_value, tmp_residuals_S1, tmp_residuals_S2, tmp_pool, tmp_pmf_S1, tmp_pmf_S2, tmp_counts, tmp_included_n_reps_S1, tmp_included_n_reps_S2, tmp_js_divergences, tmp_weights, random_seed, neighbor_mask_S1, neighbor_mask_S2, ierr) Tests the null hypothesis that both studies are exchangeable. The residuals are shuffled in\nthe work copies, so the caller's own arrays are left untouched. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_reps_S1, n_neighbors, n_points) :: neighborhood_residuals_S1 Computed neighborhood residuals for study 1, NaN is explicitly allowed for missing values\nNaN is permitted for this value. real(kind=real64), intent(in), dimension(n_reps_S2, n_neighbors, n_points) :: neighborhood_residuals_S2 Computed neighborhood residuals for study 2, NaN is explicitly allowed for missing values\nNaN is permitted for this value. integer(kind=int32), intent(in) :: n_reps_S1 Number of replicates in study 1 integer(kind=int32), intent(in) :: n_reps_S2 Number of replicates in study 2 integer(kind=int32), intent(in) :: n_neighbors Number of neighbors in the studies integer(kind=int32), intent(in) :: n_points Number of reference points in the studies real(kind=real64), intent(in) :: global_jsd_observed Observed global JSD value for both studies integer(kind=int32), intent(in) :: n_bins Number of equally sized histogram bins used for the studies real(kind=real64), intent(in) :: shared_residual_range Computed residual range for both studies\nThe minimum valid value is 0.0_real64 . integer(kind=int32), intent(in) :: n_permutations Number of permutations to perform real(kind=real64), intent(out), dimension(n_permutations) :: jsd_null Vector of global divergence values obtained under the null hypothesis real(kind=real64), intent(out) :: p_value Empirical p-value of the permutation test: real(kind=real64), intent(out), dimension(n_reps_S1, n_neighbors, n_points) :: tmp_residuals_S1 Work copy of study 1's residuals, shuffled in place real(kind=real64), intent(out), dimension(n_reps_S2, n_neighbors, n_points) :: tmp_residuals_S2 Work copy of study 2's residuals, shuffled in place real(kind=real64), intent(out), dimension(n_reps_S1 + n_reps_S2, n_neighbors) :: tmp_pool Working array for shuffling the concatenated residuals from both studies per reference point real(kind=real64), intent(out), dimension(n_points, n_bins) :: tmp_pmf_S1 Working array for study 1's normalized histogram counts real(kind=real64), intent(out), dimension(n_points, n_bins) :: tmp_pmf_S2 Working array for study 2's normalized histogram counts integer(kind=int32), intent(out), dimension(n_points, n_bins) :: tmp_counts Working array for the histogram counts integer(kind=int32), intent(out), dimension(n_points) :: tmp_included_n_reps_S1 Working array for study 1's included replicate counts integer(kind=int32), intent(out), dimension(n_points) :: tmp_included_n_reps_S2 Working array for study 2's included replicate counts real(kind=real64), intent(out), dimension(n_points) :: tmp_js_divergences Working array for the per-reference-point divergences real(kind=real64), intent(out), dimension(n_points) :: tmp_weights Working array for the divergence weights integer(kind=int32), intent(in), optional :: random_seed Seed to use for shuffling logical(kind=c_bool), intent(in), optional, dimension(n_neighbors, n_points) :: neighbor_mask_S1 Optional mask to exclude specific neighbors from study 1 (e.g. for family-wise analysis) logical(kind=c_bool), intent(in), optional, dimension(n_neighbors, n_points) :: neighbor_mask_S2 Optional mask to exclude specific neighbors from study 2 (e.g. for family-wise analysis) integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/gjct_permutation_test_expert.html"},{"title":"perform_permutation_test_c – TensorOmics","text":"public  subroutine perform_permutation_test_c(trajectories, n_factors, n_samples, n_timepoints, factor_idx, dependent_idx, sample_idx, baseline_mode, n_permutations, local_contributions, total_contributions, random_seed, ierr) bind(C, name=\"perform_permutation_test_c\") Uses tox_trajectory_contribution_analysis tox_trajectory_contribution_analysis_impl Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_factors, n_samples, n_timepoints), target :: trajectories expression vectors across different samples over time integer(kind=c_int), intent(in), target :: n_factors number of factors integer(kind=c_int), intent(in), target :: n_samples number of samples integer(kind=c_int), intent(in), target :: n_timepoints number of timepoints integer(kind=c_int), intent(in), target :: factor_idx index of factor to compute the permutation contributions for\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_factors . integer(kind=c_int), intent(in), target :: dependent_idx index of dependent to compute the permutation contributions for\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_factors . integer(kind=c_int), intent(in), target :: sample_idx index of sample to compute the permutation contributions for\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_samples . character(kind=c_char, len=1), intent(in), dimension(13), target :: baseline_mode Mode Value Raw/zero baseline MODE_BASELINE_RAW arithmetic mean MODE_BASELINE_MEAN minimum value MODE_BASELINE_MIN integer(kind=c_int), intent(in), target :: n_permutations number of permutations to perform real(kind=c_double), intent(out), dimension(n_timepoints, n_permutations), target :: local_contributions Per-timepoint contributions per permutation real(kind=c_double), intent(out), dimension(n_permutations), target :: total_contributions Total contribution ( sum(local_contributions) ) per permutation integer(kind=c_int), intent(in), optional :: random_seed Seed to use for random number generation. integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"proc/perform_permutation_test_c.html"},{"title":"perform_permutation_test_expert_c – TensorOmics","text":"public  subroutine perform_permutation_test_expert_c(trajectories, n_factors, n_samples, n_timepoints, factor_idx, dependent_idx, sample_idx, baseline_mode, n_permutations, local_contributions, total_contributions, tmp_factor, tmp_dependent, random_seed, ierr) bind(C, name=\"perform_permutation_test_expert_c\") Uses tox_trajectory_contribution_analysis tox_trajectory_contribution_analysis_impl Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_factors, n_samples, n_timepoints), target :: trajectories expression vectors across different samples over time integer(kind=c_int), intent(in), target :: n_factors number of factors integer(kind=c_int), intent(in), target :: n_samples number of samples integer(kind=c_int), intent(in), target :: n_timepoints number of timepoints integer(kind=c_int), intent(in), target :: factor_idx index of factor to compute the permutation contributions for\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_factors . integer(kind=c_int), intent(in), target :: dependent_idx index of dependent to compute the permutation contributions for\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_factors . integer(kind=c_int), intent(in), target :: sample_idx index of sample to compute the permutation contributions for\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_samples . character(kind=c_char, len=1), intent(in), dimension(13), target :: baseline_mode Mode Value Raw/zero baseline MODE_BASELINE_RAW arithmetic mean MODE_BASELINE_MEAN minimum value MODE_BASELINE_MIN integer(kind=c_int), intent(in), target :: n_permutations number of permutations to perform real(kind=c_double), intent(out), dimension(n_timepoints, n_permutations), target :: local_contributions Per-timepoint contributions per permutation real(kind=c_double), intent(out), dimension(n_permutations), target :: total_contributions Total contribution ( sum(local_contributions) ) per permutation real(kind=c_double), intent(out), dimension(n_timepoints), target :: tmp_factor Working array to hold the factor in contiguous memory real(kind=c_double), intent(out), dimension(n_timepoints), target :: tmp_dependent Working array to hold the random dependent in contiguous memory integer(kind=c_int), intent(in), optional :: random_seed Seed to use for random number generation. integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"proc/perform_permutation_test_expert_c.html"},{"title":"compute_p_values_c – TensorOmics","text":"public  subroutine compute_p_values_c(local_contributions_observed, total_contribution_observed, local_contributions_perm_test, total_contributions_perm_test, n_timepoints, n_permutations, local_p_values, total_p_value, ierr) bind(C, name=\"compute_p_values_c\") Uses tox_trajectory_contribution_analysis Given the permutation tests ( perform_permutation_test_impl ),\nthis counts how many of the permutation contributions were at least as high as the real ones. Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_timepoints), target :: local_contributions_observed Per-timepoint contributions for the observed factor-dependent-sample combination real(kind=c_double), intent(in), target :: total_contribution_observed Total contribution ( sum(local_contributions) ) for the observed factor-dependent-sample combination real(kind=c_double), intent(in), dimension(n_timepoints, n_permutations), target :: local_contributions_perm_test Per-timepoint contributions for the factor-dependent-random_sample combinations from perform_permutation_test_impl real(kind=c_double), intent(in), dimension(n_permutations), target :: total_contributions_perm_test Total contribution ( sum(local_contributions) ) for the factor-dependent-random_sample combinations from perform_permutation_test_impl integer(kind=c_int), intent(in), target :: n_timepoints number of timepoints integer(kind=c_int), intent(in), target :: n_permutations number of permutations to perform real(kind=c_double), intent(out), dimension(n_timepoints), target :: local_p_values calculated p values for local contributions, like: (local_contributions_perm_test >= local_contributions_observed)/n_permutations real(kind=c_double), intent(out), target :: total_p_value calculated p values for total contributions, like: (total_contributions_perm_test >= total_contribution_observed)/n_permutations integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/compute_p_values_c.html"},{"title":"compute_contributions_c – TensorOmics","text":"public  subroutine compute_contributions_c(factor, dependent, n_dims, baseline_mode, local_contributions, total_contribution, ierr) bind(C, name=\"compute_contributions_c\") Uses tox_trajectory_contribution_analysis tox_trajectory_contribution_analysis_impl Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_dims), target :: factor Factor time series, length n_timepoints real(kind=c_double), intent(in), dimension(n_dims), target :: dependent Dependent variable time series, length n_timepoints integer(kind=c_int), intent(in), target :: n_dims Number of elements in factor and dependent character(kind=c_char, len=1), intent(in), dimension(13), target :: baseline_mode Mode Value Raw/zero baseline MODE_BASELINE_RAW arithmetic mean MODE_BASELINE_MEAN minimum value MODE_BASELINE_MIN real(kind=c_double), intent(out), dimension(n_dims), target :: local_contributions Per-element contributions real(kind=c_double), intent(out), target :: total_contribution Total contribution ( sum(local_contributions) ) integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"proc/compute_contributions_c.html"},{"title":"compute_all_contributions_c – TensorOmics","text":"public  subroutine compute_all_contributions_c(trajectories, n_factors, n_samples, n_timepoints, factor_indices, n_selected_factors, dependent_indices, n_selected_dependents, baseline_mode, local_contributions, total_contributions, ierr) bind(C, name=\"compute_all_contributions_c\") Uses tox_trajectory_contribution_analysis tox_trajectory_contribution_analysis_impl Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_factors, n_samples, n_timepoints), target :: trajectories expression vectors across different samples over time integer(kind=c_int), intent(in), target :: n_factors number of factors integer(kind=c_int), intent(in), target :: n_samples number of samples integer(kind=c_int), intent(in), target :: n_timepoints number of timepoints integer(kind=c_int), intent(in), dimension(n_selected_factors), target :: factor_indices indices of factors to compute the contributions for\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_factors . integer(kind=c_int), intent(in), target :: n_selected_factors number of selected factors in factor_indices integer(kind=c_int), intent(in), dimension(n_selected_dependents), target :: dependent_indices indices of dependents to compute the contributions for\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_factors . integer(kind=c_int), intent(in), target :: n_selected_dependents number of selected dependents in dependent_indices character(kind=c_char, len=1), intent(in), dimension(13), target :: baseline_mode Mode Value Raw/zero baseline MODE_BASELINE_RAW arithmetic mean MODE_BASELINE_MEAN minimum value MODE_BASELINE_MIN real(kind=c_double), intent(out), dimension(n_timepoints, n_selected_factors, n_selected_dependents, n_samples), target :: local_contributions Per-timepoint contributions per sample-dependent-factor combination real(kind=c_double), intent(out), dimension(n_selected_factors, n_selected_dependents, n_samples), target :: total_contributions Total contribution ( sum(local_contributions) ) per sample-dependent-factor combination integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"proc/compute_all_contributions_c.html"},{"title":"compute_all_contributions_expert_c – TensorOmics","text":"public  subroutine compute_all_contributions_expert_c(trajectories, n_factors, n_samples, n_timepoints, factor_indices, n_selected_factors, dependent_indices, n_selected_dependents, baseline_mode, local_contributions, total_contributions, tmp_factors, tmp_dependent, ierr) bind(C, name=\"compute_all_contributions_expert_c\") Uses tox_trajectory_contribution_analysis tox_trajectory_contribution_analysis_impl Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_factors, n_samples, n_timepoints), target :: trajectories expression vectors across different samples over time integer(kind=c_int), intent(in), target :: n_factors number of factors integer(kind=c_int), intent(in), target :: n_samples number of samples integer(kind=c_int), intent(in), target :: n_timepoints number of timepoints integer(kind=c_int), intent(in), dimension(n_selected_factors), target :: factor_indices indices of factors to compute the contributions for\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_factors . integer(kind=c_int), intent(in), target :: n_selected_factors number of selected factors in factor_indices integer(kind=c_int), intent(in), dimension(n_selected_dependents), target :: dependent_indices indices of dependents to compute the contributions for\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_factors . integer(kind=c_int), intent(in), target :: n_selected_dependents number of selected dependents in dependent_indices character(kind=c_char, len=1), intent(in), dimension(13), target :: baseline_mode Mode Value Raw/zero baseline MODE_BASELINE_RAW arithmetic mean MODE_BASELINE_MEAN minimum value MODE_BASELINE_MIN real(kind=c_double), intent(out), dimension(n_timepoints, n_selected_factors, n_selected_dependents, n_samples), target :: local_contributions Per-timepoint contributions per sample-dependent-factor combination real(kind=c_double), intent(out), dimension(n_selected_factors, n_selected_dependents, n_samples), target :: total_contributions Total contribution ( sum(local_contributions) ) per sample-dependent-factor combination real(kind=c_double), intent(out), dimension(n_timepoints, n_selected_factors), target :: tmp_factors Working array to hold the currently handled sample's factors in contiguous memory real(kind=c_double), intent(out), dimension(n_timepoints), target :: tmp_dependent Working array to hold the currently handled dependent in contiguous memory integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"proc/compute_all_contributions_expert_c.html"},{"title":"compute_baselines_factor_dependent_c – TensorOmics","text":"public  subroutine compute_baselines_factor_dependent_c(n_timepoints, factor, dependent, baseline_mode, factor_baseline, dependent_baseline, ierr) bind(C, name=\"compute_baselines_factor_dependent_c\") Uses tox_trajectory_contribution_analysis tox_trajectory_contribution_analysis_impl Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_timepoints Number of timepoints in both factor and dependent arrays real(kind=c_double), intent(in), dimension(n_timepoints), target :: factor Factor time series, length n_timepoints real(kind=c_double), intent(in), dimension(n_timepoints), target :: dependent Dependent variable time series, length n_timepoints character(kind=c_char, len=1), intent(in), dimension(13), target :: baseline_mode Mode Value Raw/zero baseline MODE_BASELINE_RAW arithmetic mean MODE_BASELINE_MEAN minimum value MODE_BASELINE_MIN real(kind=c_double), intent(out), target :: factor_baseline Computed baseline for factor real(kind=c_double), intent(out), target :: dependent_baseline Computed baseline for dependent variable integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"proc/compute_baselines_factor_dependent_c.html"},{"title":"compute_velocity_trajectory_c – TensorOmics","text":"public  subroutine compute_velocity_trajectory_c(trajectory, velocity, n_timepoints, ierr) bind(C, name=\"compute_velocity_trajectory_c\") Uses tox_trajectory_contribution_analysis Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_timepoints), target :: trajectory input position trajectory real(kind=c_double), intent(out), dimension(max(0_int32, n_timepoints - 1)), target :: velocity output velocity trajectory integer(kind=c_int), intent(in), target :: n_timepoints number of timepoints integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/compute_velocity_trajectory_c.html"},{"title":"compute_acceleration_from_velocity_trajectory_c – TensorOmics","text":"public  subroutine compute_acceleration_from_velocity_trajectory_c(velocity, acceleration, n_timepoints, ierr) bind(C, name=\"compute_acceleration_from_velocity_trajectory_c\") Uses tox_trajectory_contribution_analysis Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(max(0_int32, n_timepoints - 1)), target :: velocity velocity trajectory real(kind=c_double), intent(out), dimension(max(0_int32, n_timepoints - 2)), target :: acceleration acceleration trajectory integer(kind=c_int), intent(in), target :: n_timepoints number of timepoints integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/compute_acceleration_from_velocity_trajectory_c.html"},{"title":"compute_velocity_trajectories_c – TensorOmics","text":"public  subroutine compute_velocity_trajectories_c(trajectories, velocity, n_factors, n_samples, n_timepoints, ierr) bind(C, name=\"compute_velocity_trajectories_c\") Uses tox_trajectory_contribution_analysis Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_factors, n_samples, n_timepoints), target :: trajectories input position trajectories real(kind=c_double), intent(out), dimension(max(0_int32, n_timepoints - 1), n_factors, n_samples), target :: velocity output velocity trajectories integer(kind=c_int), intent(in), target :: n_factors number of factors integer(kind=c_int), intent(in), target :: n_samples number of samples integer(kind=c_int), intent(in), target :: n_timepoints number of timepoints integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/compute_velocity_trajectories_c.html"},{"title":"compute_acceleration_from_velocity_c – TensorOmics","text":"public  subroutine compute_acceleration_from_velocity_c(velocity, acceleration, n_factors, n_samples, n_timepoints, ierr) bind(C, name=\"compute_acceleration_from_velocity_c\") Uses tox_trajectory_contribution_analysis Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(max(0_int32, n_timepoints - 1), n_factors, n_samples), target :: velocity input velocity trajectories real(kind=c_double), intent(out), dimension(max(0_int32, n_timepoints - 2), n_factors, n_samples), target :: acceleration output acceleration trajectories integer(kind=c_int), intent(in), target :: n_factors number of factors integer(kind=c_int), intent(in), target :: n_samples number of samples integer(kind=c_int), intent(in), target :: n_timepoints number of timepoints integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/compute_acceleration_from_velocity_c.html"},{"title":"compute_velocity_acceleration_contributions_c – TensorOmics","text":"public  subroutine compute_velocity_acceleration_contributions_c(trajectories, n_factors, n_samples, n_timepoints, baseline_mode, contrib_velocity, velocity_contribution_series, contrib_acceleration, acceleration_contribution_series, ierr) bind(C, name=\"compute_velocity_acceleration_contributions_c\") Uses tox_trajectory_contribution_analysis tox_trajectory_contribution_analysis_impl Note Performance layout: trajectories uses (n_factors, n_samples, n_timepoints) .\nVelocity and acceleration use time-first layouts: velocity -> (max(0, n_timepoints-1), n_factors, n_samples) acceleration -> (max(0, n_timepoints-2), n_factors, n_samples) This keeps slices like velocity(:, factor, sample) contiguous,\navoids expensive tmporaries, and improves cache efficiency. Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_factors, n_samples, n_timepoints), target :: trajectories input position trajectories integer(kind=c_int), intent(in), target :: n_factors number of factors integer(kind=c_int), intent(in), target :: n_samples number of samples integer(kind=c_int), intent(in), target :: n_timepoints number of timepoints character(kind=c_char, len=1), intent(in), dimension(13), target :: baseline_mode Mode Value Raw/zero baseline MODE_BASELINE_RAW arithmetic mean MODE_BASELINE_MEAN minimum value MODE_BASELINE_MIN real(kind=c_double), intent(out), dimension(n_factors, n_factors, n_samples), target :: contrib_velocity output velocity contributions real(kind=c_double), intent(out), dimension(n_timepoints, n_factors, n_factors, n_samples), target :: velocity_contribution_series output velocity contribution series real(kind=c_double), intent(out), dimension(n_factors, n_factors, n_samples), target :: contrib_acceleration output acceleration contributions real(kind=c_double), intent(out), dimension(n_timepoints, n_factors, n_factors, n_samples), target :: acceleration_contribution_series output acceleration contribution series integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"proc/compute_velocity_acceleration_contributions_c.html"},{"title":"compute_velocity_acceleration_contributions_expert_c – TensorOmics","text":"public  subroutine compute_velocity_acceleration_contributions_expert_c(trajectories, n_factors, n_samples, n_timepoints, baseline_mode, tmp_factors, tmp_dependent, tmp_contributions, contrib_velocity, velocity_contribution_series, contrib_acceleration, acceleration_contribution_series, ierr) bind(C, name=\"compute_velocity_acceleration_contributions_expert_c\") Uses tox_trajectory_contribution_analysis tox_trajectory_contribution_analysis_impl Note Performance layout: trajectories uses (n_factors, n_samples, n_timepoints) .\nVelocity and acceleration use time-first layouts: velocity -> (max(0, n_timepoints-1), n_factors, n_samples) acceleration -> (max(0, n_timepoints-2), n_factors, n_samples) This keeps slices like velocity(:, factor, sample) contiguous,\navoids expensive tmporaries, and improves cache efficiency. Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_factors, n_samples, n_timepoints), target :: trajectories input position trajectories integer(kind=c_int), intent(in), target :: n_factors number of factors integer(kind=c_int), intent(in), target :: n_samples number of samples integer(kind=c_int), intent(in), target :: n_timepoints number of timepoints character(kind=c_char, len=1), intent(in), dimension(13), target :: baseline_mode Mode Value Raw/zero baseline MODE_BASELINE_RAW arithmetic mean MODE_BASELINE_MEAN minimum value MODE_BASELINE_MIN real(kind=c_double), intent(out), dimension(n_timepoints - 1, n_factors), target :: tmp_factors workspace for factor data (used for velocity and acceleration) real(kind=c_double), intent(out), dimension(n_timepoints - 1), target :: tmp_dependent workspace for dependent data (used for velocity and acceleration) real(kind=c_double), intent(out), dimension(n_timepoints - 1), target :: tmp_contributions workspace for contribution calculations (used for velocity and acceleration) real(kind=c_double), intent(out), dimension(n_factors, n_factors, n_samples), target :: contrib_velocity output velocity contributions real(kind=c_double), intent(out), dimension(n_timepoints, n_factors, n_factors, n_samples), target :: velocity_contribution_series output velocity contribution series real(kind=c_double), intent(out), dimension(n_factors, n_factors, n_samples), target :: contrib_acceleration output acceleration contributions real(kind=c_double), intent(out), dimension(n_timepoints, n_factors, n_factors, n_samples), target :: acceleration_contribution_series output acceleration contribution series integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"proc/compute_velocity_acceleration_contributions_expert_c.html"},{"title":"serialize_complex_helper_c – TensorOmics","text":"public  subroutine serialize_complex_helper_c(arr, n_elements, arr_shape, n_arr_shape_elements, filename, filename_strlen, ierr) bind(C, name=\"serialize_complex_helper_c\") Uses f42_serde_arrays_serialize_complex Arguments Type Intent Optional Attributes Name complex(kind=c_double_complex), intent(in), dimension(*), target :: arr Array to be serialized integer(kind=c_int), intent(in), target :: n_elements Number of strings in arr integer(kind=c_int), intent(in), dimension(n_arr_shape_elements), target :: arr_shape Extents of arr , one per dimension integer(kind=c_int), intent(in), target :: n_arr_shape_elements number of elements in arr_shape character(kind=c_char, len=1), intent(in), dimension(filename_strlen), target :: filename Name of the file to write to integer(kind=c_int), intent(in), target :: filename_strlen length of the strings in filename integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"proc/serialize_complex_helper_c.html"},{"title":"serialize_int_helper – TensorOmics","text":"public  subroutine serialize_int_helper(arr, n_elements, arr_shape, filename, ierr) Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in), dimension(n_elements) :: arr Array to be serialized integer(kind=int32), intent(in) :: n_elements Number of strings in arr integer(kind=int32), intent(in), dimension(:) :: arr_shape Extents of arr , one per dimension character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code","tags":"C-binding","url":"proc/serialize_int_helper.html"},{"title":"serialize_int_1d – TensorOmics","text":"public  subroutine serialize_int_1d(arr, filename, ierr) Directly serialize a 1D integer array into a file Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in), dimension(:), contiguous :: arr Array to be serialized character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/serialize_int_1d.html"},{"title":"serialize_int_2d – TensorOmics","text":"public  subroutine serialize_int_2d(arr, filename, ierr) Directly serialize a 2D integer array into a file Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in), dimension(:, :), contiguous :: arr Array to be serialized character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/serialize_int_2d.html"},{"title":"serialize_int_3d – TensorOmics","text":"public  subroutine serialize_int_3d(arr, filename, ierr) Directly serialize a 3D integer array into a file Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in), dimension(:, :, :), contiguous :: arr Array to be serialized character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/serialize_int_3d.html"},{"title":"serialize_int_4d – TensorOmics","text":"public  subroutine serialize_int_4d(arr, filename, ierr) Directly serialize a 4D integer array into a file Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in), dimension(:, :, :, :), contiguous :: arr Array to be serialized character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/serialize_int_4d.html"},{"title":"serialize_int_5d – TensorOmics","text":"public  subroutine serialize_int_5d(arr, filename, ierr) Directly serialize a 5D integer array into a file Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in), dimension(:, :, :, :, :), contiguous :: arr Array to be serialized character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/serialize_int_5d.html"},{"title":"detect_neofunctionalization – TensorOmics","text":"public pure subroutine detect_neofunctionalization(ancestors, n_families, genes, n_axes, gene_to_fam, n_genes, thresholds, neofunc, ierr) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_axes, n_families) :: ancestors RAP projected unit length expression vector of ancestral ortholog\nThe minimum valid value is -1.0_real64 .\nThe maximum valid value is 1.0_real64 . integer(kind=int32), intent(in) :: n_families number of vectors in ancestors real(kind=real64), intent(in), dimension(n_axes, n_genes) :: genes RAP projected unit length expression vectors of genes\nThe minimum valid value is -1.0_real64 .\nThe maximum valid value is 1.0_real64 . integer(kind=int32), intent(in) :: n_axes size of ancestors vector and vectors in genes integer(kind=int32), intent(in), dimension(n_genes) :: gene_to_fam Index mapping -> each index i holds the family index for the corresponding gene in genes , using 0_int32 for unassigned genes\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_families .\nThe value 0_int32 is additionally accepted. integer(kind=int32), intent(in) :: n_genes number of vectors in genes real(kind=real64), intent(in), dimension(n_axes) :: thresholds threshold per axis that defines significant change in expression, may be a percentile of all genes' changes per axis\nThe minimum valid value is -1.0_real64 .\nThe maximum valid value is 1.0_real64 . logical(kind=c_bool), intent(out), dimension(n_genes, n_axes) :: neofunc .true. if neofunctionalization has been detected for the respective axes, always .false. for unassigned genes integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/detect_neofunctionalization.html"},{"title":"detect_dosage_effect – TensorOmics","text":"public pure subroutine detect_dosage_effect(ancestor, genes, n_genes, n_dims, filtered_paralogs_mask, n_mask_chunks, n_results, max_subset_size, work_arr_paralog_subsets, n_paralog_subsets, max_angle, gain_gamma, ierr) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_dims) :: ancestor expression vector of ancestral ortholog real(kind=real64), intent(in), dimension(n_dims, n_genes) :: genes expression vectors of genes integer(kind=int32), intent(in) :: n_genes number of vectors in genes integer(kind=int32), intent(in) :: n_dims size of ancestor vector and vectors in genes integer(kind=int32), intent(in), dimension(n_mask_chunks) :: filtered_paralogs_mask bit mask with the genes' indices kept by this pattern set to 1, else 0. Build it with the matching filter_paralogs_by_pattern_* routine integer(kind=int32), intent(in) :: n_mask_chunks number of 32 bit chunks a mask needs to encode n_genes genes. Use subroutine mask_chunk_count for calculation\nThe minimum valid value is (n_genes + 31) / 32 . integer(kind=int32), intent(out) :: n_results number of resulting subsets. They are stored as the first n_results elements of work_arr_paralog_subsets integer(kind=int32), intent(in) :: max_subset_size maximum subset size of checked gene subsets. Too large a value is capped to the\nmaximum valid size. The bindings cap it automatically while sizing the work\narray; a Fortran caller caps it by calling calc_work_arr_paralog_subsets_size first.\nZero is in range and means there is no subset to check -- the sizing routine reports\nit whenever the filtered families hold a single gene each. It reports a work array\nof zero slots along with it, which this routine does not accept, so a caller that\ngets zero back has nothing to detect and should not call here at all.\nThe minimum valid value is 0_int32 . integer(kind=int32), intent(out), dimension(n_mask_chunks, n_paralog_subsets) :: work_arr_paralog_subsets working array to hold bitmask encoded subsets for detection. Note Each bitmask is built of 32 bit chunks. (n_genes + 31) / 32 is equivalent to ceil(n_genes / 32.0_real64) and represents the number of chunks integer(kind=int32), intent(in) :: n_paralog_subsets number of gene subsets that can be stored in work_arr_paralog_subsets .\nIt is VERY IMPORTANT to compute this argument from the work_array_size output produced by calc_work_arr_paralog_subsets_size . real(kind=real64), intent(in), optional :: max_angle maximum angle in radians 0<=angle<=Pi that a subset candidate must not exceed, otherwise pruned\nThe default value is 4.0_real64*atan(1.0_real64) .\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is PI . real(kind=real64), intent(in), optional :: gain_gamma positive magnitude gain for dosage effect\nThe default value is 0.1_real64 .\nThe minimum valid value is above(0.0_real64) . integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/detect_dosage_effect.html"},{"title":"detect_dosage_effect_expert – TensorOmics","text":"public pure subroutine detect_dosage_effect_expert(ancestor, genes, n_genes, n_dims, filtered_paralogs_mask, n_mask_chunks, n_results, max_subset_size, work_arr_paralog_subsets, n_paralog_subsets, tmp_active_mask, tmp_paralog_vector, max_angle, gain_gamma, ierr) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_dims) :: ancestor expression vector of ancestral ortholog real(kind=real64), intent(in), dimension(n_dims, n_genes) :: genes expression vectors of genes integer(kind=int32), intent(in) :: n_genes number of vectors in genes integer(kind=int32), intent(in) :: n_dims size of ancestor vector and vectors in genes integer(kind=int32), intent(in), dimension(n_mask_chunks) :: filtered_paralogs_mask bit mask with the genes' indices kept by this pattern set to 1, else 0. Build it with the matching filter_paralogs_by_pattern_* routine integer(kind=int32), intent(in) :: n_mask_chunks number of 32 bit chunks a mask needs to encode n_genes genes. Use subroutine mask_chunk_count for calculation\nThe minimum valid value is (n_genes + 31) / 32 . integer(kind=int32), intent(out) :: n_results number of resulting subsets. They are stored as the first n_results elements of work_arr_paralog_subsets integer(kind=int32), intent(in) :: max_subset_size maximum subset size of checked gene subsets. Too large a value is capped to the\nmaximum valid size. The bindings cap it automatically while sizing the work\narray; a Fortran caller caps it by calling calc_work_arr_paralog_subsets_size first.\nZero is in range and means there is no subset to check -- the sizing routine reports\nit whenever the filtered families hold a single gene each. It reports a work array\nof zero slots along with it, which this routine does not accept, so a caller that\ngets zero back has nothing to detect and should not call here at all.\nThe minimum valid value is 0_int32 . integer(kind=int32), intent(out), dimension(n_mask_chunks, n_paralog_subsets) :: work_arr_paralog_subsets working array to hold bitmask encoded subsets for detection. Note Each bitmask is built of 32 bit chunks. (n_genes + 31) / 32 is equivalent to ceil(n_genes / 32.0_real64) and represents the number of chunks integer(kind=int32), intent(in) :: n_paralog_subsets number of gene subsets that can be stored in work_arr_paralog_subsets .\nIt is VERY IMPORTANT to compute this argument from the work_array_size output produced by calc_work_arr_paralog_subsets_size . integer(kind=int32), intent(out), dimension(n_mask_chunks) :: tmp_active_mask working array to hold the extended subsets real(kind=real64), intent(out), dimension(n_dims) :: tmp_paralog_vector vector used for pruning subsets real(kind=real64), intent(in), optional :: max_angle maximum angle in radians 0<=angle<=Pi that a subset candidate must not exceed, otherwise pruned\nThe default value is 4.0_real64*atan(1.0_real64) .\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is PI . real(kind=real64), intent(in), optional :: gain_gamma positive magnitude gain for dosage effect\nThe default value is 0.1_real64 .\nThe minimum valid value is above(0.0_real64) . integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/detect_dosage_effect_expert.html"},{"title":"detect_subfunctionalization – TensorOmics","text":"public pure subroutine detect_subfunctionalization(ancestor, genes, n_genes, n_dims, filtered_paralogs_mask, n_mask_chunks, n_results, max_subset_size, work_arr_paralog_subsets, n_paralog_subsets, rdi_threshold, paralog_norms, sorted_paralog_norms_perm, ierr) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_dims) :: ancestor expression vector of ancestral ortholog real(kind=real64), intent(in), dimension(n_dims, n_genes) :: genes expression vectors of genes integer(kind=int32), intent(in) :: n_genes number of vectors in genes integer(kind=int32), intent(in) :: n_dims size of ancestor vector and vectors in genes integer(kind=int32), intent(in), dimension(n_mask_chunks) :: filtered_paralogs_mask bit mask with the genes' indices kept by this pattern set to 1, else 0. Build it with the matching filter_paralogs_by_pattern_* routine integer(kind=int32), intent(in) :: n_mask_chunks number of 32 bit chunks a mask needs to encode n_genes genes. Use subroutine mask_chunk_count for calculation\nThe minimum valid value is (n_genes + 31) / 32 . integer(kind=int32), intent(out) :: n_results number of resulting subsets. They are stored as the first n_results elements of work_arr_paralog_subsets integer(kind=int32), intent(in) :: max_subset_size maximum subset size of checked gene subsets. Too large a value is capped to the\nmaximum valid size. The bindings cap it automatically while sizing the work\narray; a Fortran caller caps it by calling calc_work_arr_paralog_subsets_size first.\nZero is in range and means there is no subset to check -- the sizing routine reports\nit whenever the filtered families hold a single gene each. It reports a work array\nof zero slots along with it, which this routine does not accept, so a caller that\ngets zero back has nothing to detect and should not call here at all.\nThe minimum valid value is 0_int32 . integer(kind=int32), intent(out), dimension(n_mask_chunks, n_paralog_subsets) :: work_arr_paralog_subsets working array to hold bitmask encoded subsets for detection. Note Each bitmask is built of 32 bit chunks. (n_genes + 31) / 32 is equivalent to ceil(n_genes / 32.0_real64) and represents the number of chunks integer(kind=int32), intent(in) :: n_paralog_subsets number of gene subsets that can be stored in work_arr_paralog_subsets .\nIt is VERY IMPORTANT to compute this argument from the work_array_size output produced by calc_work_arr_paralog_subsets_size . real(kind=real64), intent(in) :: rdi_threshold max allowed residual distance from ancestor The minimum valid value is 0.0_real64 . real(kind=real64), intent(in), dimension(n_genes) :: paralog_norms euclidean norms of the genes, used for subset pruning ( norm from f42_vector_impl computes them)\nThe minimum valid value is 0.0_real64 . integer(kind=int32), intent(in), dimension(n_genes) :: sorted_paralog_norms_perm ascending permutation of the norms, for subset pruning: the smallest norm among the genes that could extend a subset must not fall below the subset's angle to the ancestor\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_genes . integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/detect_subfunctionalization.html"},{"title":"detect_subfunctionalization_expert – TensorOmics","text":"public pure subroutine detect_subfunctionalization_expert(ancestor, genes, n_genes, n_dims, filtered_paralogs_mask, n_mask_chunks, n_results, max_subset_size, work_arr_paralog_subsets, n_paralog_subsets, tmp_active_mask, tmp_paralog_vector, rdi_threshold, paralog_norms, sorted_paralog_norms_perm, tmp_work_array, ierr) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_dims) :: ancestor expression vector of ancestral ortholog real(kind=real64), intent(in), dimension(n_dims, n_genes) :: genes expression vectors of genes integer(kind=int32), intent(in) :: n_genes number of vectors in genes integer(kind=int32), intent(in) :: n_dims size of ancestor vector and vectors in genes integer(kind=int32), intent(in), dimension(n_mask_chunks) :: filtered_paralogs_mask bit mask with the genes' indices kept by this pattern set to 1, else 0. Build it with the matching filter_paralogs_by_pattern_* routine integer(kind=int32), intent(in) :: n_mask_chunks number of 32 bit chunks a mask needs to encode n_genes genes. Use subroutine mask_chunk_count for calculation\nThe minimum valid value is (n_genes + 31) / 32 . integer(kind=int32), intent(out) :: n_results number of resulting subsets. They are stored as the first n_results elements of work_arr_paralog_subsets integer(kind=int32), intent(in) :: max_subset_size maximum subset size of checked gene subsets. Too large a value is capped to the\nmaximum valid size. The bindings cap it automatically while sizing the work\narray; a Fortran caller caps it by calling calc_work_arr_paralog_subsets_size first.\nZero is in range and means there is no subset to check -- the sizing routine reports\nit whenever the filtered families hold a single gene each. It reports a work array\nof zero slots along with it, which this routine does not accept, so a caller that\ngets zero back has nothing to detect and should not call here at all.\nThe minimum valid value is 0_int32 . integer(kind=int32), intent(out), dimension(n_mask_chunks, n_paralog_subsets) :: work_arr_paralog_subsets working array to hold bitmask encoded subsets for detection. Note Each bitmask is built of 32 bit chunks. (n_genes + 31) / 32 is equivalent to ceil(n_genes / 32.0_real64) and represents the number of chunks integer(kind=int32), intent(in) :: n_paralog_subsets number of gene subsets that can be stored in work_arr_paralog_subsets .\nIt is VERY IMPORTANT to compute this argument from the work_array_size output produced by calc_work_arr_paralog_subsets_size . integer(kind=int32), intent(out), dimension(n_mask_chunks) :: tmp_active_mask working array to hold the extended subsets real(kind=real64), intent(out), dimension(n_dims) :: tmp_paralog_vector vector used for pruning subsets real(kind=real64), intent(in) :: rdi_threshold max allowed residual distance from ancestor The minimum valid value is 0.0_real64 . real(kind=real64), intent(in), dimension(n_genes) :: paralog_norms euclidean norms of the genes, used for subset pruning ( norm from f42_vector_impl computes them)\nThe minimum valid value is 0.0_real64 . integer(kind=int32), intent(in), dimension(n_genes) :: sorted_paralog_norms_perm ascending permutation of the norms, for subset pruning: the smallest norm among the genes that could extend a subset must not fall below the subset's angle to the ancestor\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_genes . real(kind=real64), intent(out), dimension(n_genes) :: tmp_work_array work array for checking the minimum value after a given index efficiently integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/detect_subfunctionalization_expert.html"},{"title":"filter_paralogs_by_pattern_dosage_effect – TensorOmics","text":"public pure subroutine filter_paralogs_by_pattern_dosage_effect(gene_angles, threshold, n_genes, n_families, gene_to_fam, masks, n_mask_chunks, ierr) This subroutine prefilters the genes for a specific pattern to reduce detection overhead, as less subsets need to be tried. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_genes) :: gene_angles vector, holding the angles between ancestor and genes (0<=angle<=Pi)\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is PI . real(kind=real64), intent(in) :: threshold filter threshold integer(kind=int32), intent(in) :: n_genes number of genes integer(kind=int32), intent(in) :: n_families number of families\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_genes . integer(kind=int32), intent(in), dimension(n_genes) :: gene_to_fam a mapping of gene index to family index, so gene i is related to gene_angles(i) and part of family j=gene_to_fam(i) .\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_families . integer(kind=int32), intent(out), dimension(n_mask_chunks, n_families) :: masks bit mask that will have the indices of genes kept by this pattern set to 1, else 0 integer(kind=int32), intent(in) :: n_mask_chunks number of 32 bit chunks a mask needs to encode n_genes genes\nThe minimum valid value is (n_genes + 31) / 32 . integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/filter_paralogs_by_pattern_dosage_effect.html"},{"title":"filter_paralogs_by_pattern_subfunctionalization – TensorOmics","text":"public pure subroutine filter_paralogs_by_pattern_subfunctionalization(gene_angles, threshold, n_genes, n_families, gene_to_fam, masks, n_mask_chunks, ierr) This subroutine prefilters the genes for a specific pattern to reduce detection overhead, as less subsets need to be tried. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_genes) :: gene_angles vector, holding the angles between ancestor and genes (0<=angle<=Pi)\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is PI . real(kind=real64), intent(in) :: threshold filter threshold integer(kind=int32), intent(in) :: n_genes number of genes integer(kind=int32), intent(in) :: n_families number of families\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_genes . integer(kind=int32), intent(in), dimension(n_genes) :: gene_to_fam a mapping of gene index to family index, so gene i is related to gene_angles(i) and part of family j=gene_to_fam(i) .\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_families . integer(kind=int32), intent(out), dimension(n_mask_chunks, n_families) :: masks bit mask that will have the indices of genes kept by this pattern set to 1, else 0 integer(kind=int32), intent(in) :: n_mask_chunks number of 32 bit chunks a mask needs to encode n_genes genes\nThe minimum valid value is (n_genes + 31) / 32 . integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/filter_paralogs_by_pattern_subfunctionalization.html"},{"title":"read_expression_vectors_tsv_c – TensorOmics","text":"public  subroutine read_expression_vectors_tsv_c(file_list, file_list_strlen, n_file_list_elements, gene_ids, gene_ids_strlen, n_gene_ids_elements, expression_vectors, n_expression_vectors_elements_dim_1, n_expression_vectors_elements_dim_2, n_header_rows, gene_col, value_cols, n_value_cols_elements, start_row, ierr, delimiter) bind(C, name=\"read_expression_vectors_tsv_c\") Uses tox_data_tools Arguments Type Intent Optional Attributes Name character(kind=c_char, len=1), intent(in), dimension(file_list_strlen, n_file_list_elements), target :: file_list List of files to read from integer(kind=c_int), intent(in), target :: file_list_strlen length of the strings in file_list integer(kind=c_int), intent(in), target :: n_file_list_elements number of elements in file_list character(kind=c_char, len=1), intent(in), dimension(gene_ids_strlen, n_gene_ids_elements), target :: gene_ids Array of gene IDS integer(kind=c_int), intent(in), target :: gene_ids_strlen length of the strings in gene_ids integer(kind=c_int), intent(in), target :: n_gene_ids_elements number of elements in gene_ids real(kind=c_double), intent(inout), dimension(n_expression_vectors_elements_dim_1, n_expression_vectors_elements_dim_2), target :: expression_vectors Array of expression vectors integer(kind=c_int), intent(in), target :: n_expression_vectors_elements_dim_1 dimension of expression_vectors integer(kind=c_int), intent(in), target :: n_expression_vectors_elements_dim_2 dimension of expression_vectors integer(kind=c_int), intent(in), target :: n_header_rows Number of header rows to skip integer(kind=c_int), intent(in), target :: gene_col Index of column with gene_ids integer(kind=c_int), intent(in), dimension(n_value_cols_elements), target :: value_cols Indicies of columns containing values integer(kind=c_int), intent(in), target :: n_value_cols_elements number of elements in value_cols integer(kind=c_int), intent(in), target :: start_row Row in the expression vectors to start in integer(kind=c_int), intent(out), target :: ierr Error code character(kind=c_char, len=1), intent(in), dimension(1), target :: delimiter optional delimiter\nThe default value is char(9) .","tags":"","url":"proc/read_expression_vectors_tsv_c.html"},{"title":"read_gene_ids_from_tsv_file_c – TensorOmics","text":"public  subroutine read_gene_ids_from_tsv_file_c(filename, filename_strlen, gene_ids, gene_ids_strlen, n_gene_ids_elements, n_header_rows, gene_col, ierr) bind(C, name=\"read_gene_ids_from_tsv_file_c\") Uses tox_data_tools Arguments Type Intent Optional Attributes Name character(kind=c_char, len=1), intent(in), dimension(filename_strlen), target :: filename Name of the file integer(kind=c_int), intent(in), target :: filename_strlen length of the strings in filename character(kind=c_char, len=1), intent(out), dimension(gene_ids_strlen, n_gene_ids_elements), target :: gene_ids gene ids array integer(kind=c_int), intent(in), target :: gene_ids_strlen length of the strings in gene_ids integer(kind=c_int), intent(in), target :: n_gene_ids_elements number of elements in gene_ids integer(kind=c_int), intent(in), target :: n_header_rows number of headers to skip integer(kind=c_int), intent(in), target :: gene_col Index of the column containing gene ids integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"proc/read_gene_ids_from_tsv_file_c.html"},{"title":"read_orthofinder_file_c – TensorOmics","text":"public  subroutine read_orthofinder_file_c(filename, filename_strlen, gene_ids, gene_ids_strlen, n_gene_ids_elements, family_ids, family_ids_strlen, n_family_ids_elements, gene_to_fam, n_gene_to_fam_elements, ierr) bind(C, name=\"read_orthofinder_file_c\") Uses tox_data_tools Arguments Type Intent Optional Attributes Name character(kind=c_char, len=1), intent(in), dimension(filename_strlen), target :: filename Name of the file integer(kind=c_int), intent(in), target :: filename_strlen length of the strings in filename character(kind=c_char, len=1), intent(in), dimension(gene_ids_strlen, n_gene_ids_elements), target :: gene_ids gene ids array integer(kind=c_int), intent(in), target :: gene_ids_strlen length of the strings in gene_ids integer(kind=c_int), intent(in), target :: n_gene_ids_elements number of elements in gene_ids character(kind=c_char, len=1), intent(out), dimension(family_ids_strlen, n_family_ids_elements), target :: family_ids family ids array integer(kind=c_int), intent(in), target :: family_ids_strlen length of the strings in family_ids integer(kind=c_int), intent(in), target :: n_family_ids_elements number of elements in family_ids integer(kind=c_int), intent(out), dimension(n_gene_to_fam_elements), target :: gene_to_fam gene to family mapping integer(kind=c_int), intent(in), target :: n_gene_to_fam_elements number of elements in gene_to_fam integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"proc/read_orthofinder_file_c.html"},{"title":"get_unassigned_mask_c – TensorOmics","text":"public  subroutine get_unassigned_mask_c(gene_to_fam, n_gene_to_fam_elements, mask, n_genes_kept, ierr) bind(C, name=\"get_unassigned_mask_c\") Uses tox_data_tools Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), dimension(n_gene_to_fam_elements), target :: gene_to_fam gene to family mapping integer(kind=c_int), intent(in), target :: n_gene_to_fam_elements number of elements in gene_to_fam logical(kind=c_bool), intent(out), dimension(size(gene_to_fam)), target :: mask mask for mapping integer(kind=c_int), intent(out), target :: n_genes_kept number of genes kept integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"proc/get_unassigned_mask_c.html"},{"title":"calc_percentile_rank – TensorOmics","text":"public pure function calc_percentile_rank(percentile, n) result(rank) Calculate the fractional index using linear interpolation method Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: percentile desired percentile as a fraction in [0,1] (e.g. 0.95 for the 95th percentile) integer(kind=int32), intent(in) :: n Sample size Return Value real(kind=real64)","tags":"","url":"proc/calc_percentile_rank.html"},{"title":"loess_smooth_2d_impl – TensorOmics","text":"public pure subroutine loess_smooth_2d_impl(n_total, n_target, x_ref, y_ref, indices_used, n_used, x_query, kernel_sigma, kernel_cutoff, y_out) Smooths y_ref at x_query using reference points x_ref , y_ref , and kernel parameters.\nThe user must pre-filter data and provide only valid indices in indices_used. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_total Total number of reference points. integer(kind=int32), intent(in) :: n_target Number of target points to smooth. real(kind=real64), intent(in) :: x_ref (n_total) Reference x-coordinates. real(kind=real64), intent(in) :: y_ref (n_total) Reference y-coordinates (length n_total). integer(kind=int32), intent(in) :: indices_used (n_used) Indices of reference points used for smoothing (only valid indices).\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_total . integer(kind=int32), intent(in) :: n_used Number of indices actually used for smoothing. real(kind=real64), intent(in) :: x_query (n_target) Target x-coordinates to smooth. real(kind=real64), intent(in) :: kernel_sigma Bandwidth parameter for the kernel.\nThe minimum valid value is 0.0_real64 . real(kind=real64), intent(in) :: kernel_cutoff Cutoff for the kernel, not used if zero\nThe minimum valid value is 0.0_real64 . real(kind=real64), intent(out) :: y_out (n_target) Output smoothed values (length n_target).","tags":"","url":"proc/loess_smooth_2d_impl.html"},{"title":"compute_edf_impl – TensorOmics","text":"public pure subroutine compute_edf_impl(values, n_values, values_perm, unique_values, cdf_values, n_unique) Returns the sorted unique values and their cumulative frequencies in [0,1].\nThe number of unique values can be determined by finding the last non-zero cdf_value. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: values (n_values) Array of observed data values (e.g., contributions or spikes). integer(kind=int32), intent(in) :: n_values Number of values in the input array. integer(kind=int32), intent(in) :: values_perm (n_values) Permutation of values in ascending order. The allocating entry point builds\nand heapsorts it for you; the expert one takes whatever order you supply.\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_values . real(kind=real64), intent(out) :: unique_values (n_values) Sorted unique data values.\nThe first n_unique elements will hold the results. real(kind=real64), intent(out) :: cdf_values (n_values) Corresponding cumulative frequencies between 0 and 1.\nThe first n_unique elements will hold the results. integer(kind=int32), intent(out) :: n_unique Number of unique values found (actual size of output arrays)","tags":"","url":"proc/compute_edf_impl.html"},{"title":"calc_percentile_impl – TensorOmics","text":"public pure subroutine calc_percentile_impl(array, n_array, array_perm, percentile, value, n_considered) Uses linear interpolation between adjacent values. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: array (n_array) input array integer(kind=int32), intent(in) :: n_array number of elements in array integer(kind=int32), intent(in) :: array_perm (n_array) Permutation of array in ascending order. The allocating entry point builds and\nheapsorts it for you; the expert one takes whatever order you supply.\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_array . real(kind=real64), intent(in) :: percentile desired percentile as a fraction in [0,1] (e.g. 0.95 for the 95th percentile)\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 . real(kind=real64), intent(out) :: value output percentile value integer(kind=int32), intent(in), optional :: n_considered How many leading entries of array_perm the percentile is taken over, for a\npercentile of a subset -- the trailing entries are ignored rather than sliced\noff, so the permutation stays the shape the sort produced. Zero, the default,\nconsiders all n_array of them.\nThe default value is 0_int32 .\nThe minimum valid value is 0_int32 .\nThe maximum valid value is n_array .","tags":"","url":"proc/calc_percentile_impl.html"},{"title":"compute_scaled_distance_quantile_impl – TensorOmics","text":"public pure subroutine compute_scaled_distance_quantile_impl(n_genes, rdi, sorted_rdi, sorted_rdi_perm, quantile, c_const) This is NOT a null-hypothesis-testing p-value: each distance is compared against the\nobserved distribution it was drawn from, not an independently generated null distribution.\nIt instead measures how extreme an observed distance is relative to all observed distances. Implements:\n  Q(d) = ( #{di in D | di >= d} + c ) / ( |D| + c ) Because distances are non-negative, a one-sided upper-tail quantile is used. Assumptions / preconditions:\n- sorted_rdi(1:n_genes) contains the empirical distribution D.\n- If invalid RDIs exist (negative), they should already be mapped to 0 in the distribution Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Number of genes being processed. real(kind=real64), intent(in) :: rdi (n_genes) empirical distribution D\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(in) :: sorted_rdi (n_genes) empirical distribution D with non negative values\nNaN is permitted for this value.\nInfinite values are permitted for this value. integer(kind=int32), intent(in) :: sorted_rdi_perm (n_genes) Permutation of sorted_rdi in ascending order. The allocating entry point builds\nand heapsorts it for you; the expert one takes whatever order you supply.\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_genes . real(kind=real64), intent(out) :: quantile (n_genes) Output array to store the computed quantile for each gene. real(kind=real64), intent(in) :: c_const Constant used in the computation, typically 1","tags":"","url":"proc/compute_scaled_distance_quantile_impl.html"},{"title":"deserialize_char_helper – TensorOmics","text":"public  subroutine deserialize_char_helper(arr, n_strings, strlen, arr_shape, filename, ierr) Arguments Type Intent Optional Attributes Name character(len=strlen), intent(out), dimension(n_strings) :: arr Pre-allocated array to read the data into integer(kind=int32), intent(in) :: n_strings Number of strings in arr integer(kind=int32), intent(in) :: strlen Length of each string in arr .\nIt is VERY IMPORTANT to compute this argument from the type_code output produced by get_array_metadata . Producer input Supplied by dims_out_capacity 5_int32 integer(kind=int32), intent(in), dimension(:) :: arr_shape Extents of arr , one per dimension\nIt is VERY IMPORTANT to compute this argument from the dims_out output produced by get_array_metadata . Producer input Supplied by dims_out_capacity 5_int32 character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code","tags":"C-binding","url":"proc/deserialize_char_helper.html"},{"title":"deserialize_char_1d – TensorOmics","text":"public  subroutine deserialize_char_1d(arr, filename, ierr) Directly deserialize a 1D character array from a file (array already allocated) Arguments Type Intent Optional Attributes Name character(len=*), intent(out), dimension(:), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file to read from integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/deserialize_char_1d.html"},{"title":"deserialize_char_2d – TensorOmics","text":"public  subroutine deserialize_char_2d(arr, filename, ierr) Directly deserialize a 2D character array from a file (array already allocated) Arguments Type Intent Optional Attributes Name character(len=*), intent(out), dimension(:, :), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file to read from integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/deserialize_char_2d.html"},{"title":"deserialize_char_3d – TensorOmics","text":"public  subroutine deserialize_char_3d(arr, filename, ierr) Directly deserialize a 3D character array from a file (array already allocated) Arguments Type Intent Optional Attributes Name character(len=*), intent(out), dimension(:, :, :), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file to read from integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/deserialize_char_3d.html"},{"title":"deserialize_char_4d – TensorOmics","text":"public  subroutine deserialize_char_4d(arr, filename, ierr) Directly deserialize a 4D character array from a file (array already allocated) Arguments Type Intent Optional Attributes Name character(len=*), intent(out), dimension(:, :, :, :), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file to read from integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/deserialize_char_4d.html"},{"title":"deserialize_char_5d – TensorOmics","text":"public  subroutine deserialize_char_5d(arr, filename, ierr) Directly deserialize a 5D character array from a file (array already allocated) Arguments Type Intent Optional Attributes Name character(len=*), intent(out), dimension(:, :, :, :, :), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file to read from integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/deserialize_char_5d.html"},{"title":"norm – TensorOmics","text":"public pure function norm(vector) Calculates the euclidean norm of a vector Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(:) :: vector Input vector the norm will be calcuated for Return Value real(kind=real64)","tags":"","url":"proc/norm.html"},{"title":"angle_between – TensorOmics","text":"public pure subroutine angle_between(v1, v2, n_dims, angle, ierr) Computes the radian angle between two vectors Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_dims) :: v1 first vector for angle calculation real(kind=real64), intent(in), dimension(n_dims) :: v2 second vector for angle calculation integer(kind=int32), intent(in) :: n_dims number of elements in v1 and v2 real(kind=real64), intent(out) :: angle will hold calculated angle integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/angle_between.html"},{"title":"add_vector – TensorOmics","text":"public pure subroutine add_vector(vector, to_be_added) Adds two vectors in-place Arguments Type Intent Optional Attributes Name real(kind=real64), intent(inout), dimension(:) :: vector First vector, it will be modified in-place real(kind=real64), intent(in), dimension(:) :: to_be_added Vector that should be added to vector","tags":"","url":"proc/add_vector.html"},{"title":"subtract_vector – TensorOmics","text":"public pure subroutine subtract_vector(vector, to_be_subtracted) Subtracts two vectors in-place Arguments Type Intent Optional Attributes Name real(kind=real64), intent(inout), dimension(:) :: vector First vector, it will be modified in-place real(kind=real64), intent(in), dimension(:) :: to_be_subtracted Vector that should be subtracted from vector","tags":"","url":"proc/subtract_vector.html"},{"title":"is_in_hashset – TensorOmics","text":"public  function is_in_hashset(hashset, key) result(res) Checks whether key is a member of hashset . Arguments Type Intent Optional Attributes Name type( hashset_type ), intent(in) :: hashset Hashset to query character(len=*), intent(in) :: key Key to look for Return Value logical","tags":"","url":"proc/is_in_hashset.html"},{"title":"hashmap_get – TensorOmics","text":"public  function hashmap_get(map, key) result(value) Lookup a key Arguments Type Intent Optional Attributes Name type( hashmap_type ), intent(in) :: map hashmap character(len=*), intent(in) :: key key to look for Return Value integer(kind=int32) return value","tags":"","url":"proc/hashmap_get.html"},{"title":"hashmap_create – TensorOmics","text":"public  subroutine hashmap_create(map, initial_size) Create the hashmap Arguments Type Intent Optional Attributes Name type( hashmap_type ), intent(out) :: map Hashmap object to create integer(kind=int32), intent(in), optional :: initial_size Desired initial element capacity; the actual bucket count is derived from this\n(scaled by MAX_LOAD_FACTOR and rounded up to a power of two, floored at 128),\ndefault: 1024 buckets","tags":"","url":"proc/hashmap_create.html"},{"title":"hashset_create – TensorOmics","text":"public  subroutine hashset_create(set, initial_size) Create the hashset Arguments Type Intent Optional Attributes Name type( hashset_type ), intent(out) :: set Hashset object to create integer(kind=int32), intent(in), optional :: initial_size Desired initial element capacity; the actual bucket count is derived from this\n(scaled by MAX_LOAD_FACTOR and rounded up to a power of two, floored at 128),\ndefault: 1024 buckets","tags":"","url":"proc/hashset_create.html"},{"title":"hashmap_destroy – TensorOmics","text":"public  subroutine hashmap_destroy(map) Destroy the hashmap Arguments Type Intent Optional Attributes Name type( hashmap_type ), intent(inout) :: map The hashmap to delete","tags":"","url":"proc/hashmap_destroy.html"},{"title":"hashset_destroy – TensorOmics","text":"public  subroutine hashset_destroy(set) Destroy the set Arguments Type Intent Optional Attributes Name type( hashset_type ), intent(inout) :: set The set to delete","tags":"","url":"proc/hashset_destroy.html"},{"title":"hashmap_put – TensorOmics","text":"public  subroutine hashmap_put(map, key, value) Insert a key-value pair Arguments Type Intent Optional Attributes Name type( hashmap_type ), intent(inout) :: map hashmap to insert into character(len=*), intent(in) :: key Key to store integer(kind=int32), intent(in) :: value value to store","tags":"","url":"proc/hashmap_put.html"},{"title":"hashset_put – TensorOmics","text":"public  subroutine hashset_put(set, key, ierr) Insert a key-value pair Arguments Type Intent Optional Attributes Name type( hashset_type ), intent(inout) :: set hashmap to insert into character(len=*), intent(in) :: key Key to store integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/hashset_put.html"},{"title":"deserialize_real_helper – TensorOmics","text":"public  subroutine deserialize_real_helper(arr, n_elements, arr_shape, filename, ierr) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(out), dimension(n_elements) :: arr Pre-allocated array to read the data into integer(kind=int32), intent(in) :: n_elements Size of arr integer(kind=int32), intent(in), dimension(:) :: arr_shape Extents of arr , one per dimension\nIt is VERY IMPORTANT to compute this argument from the dims_out output produced by get_array_metadata . Producer input Supplied by dims_out_capacity 5_int32 character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code","tags":"C-binding","url":"proc/deserialize_real_helper.html"},{"title":"deserialize_real_1d – TensorOmics","text":"public  subroutine deserialize_real_1d(arr, filename, ierr) Directly deserialize a 1D real array from a file Arguments Type Intent Optional Attributes Name real(kind=real64), intent(out), dimension(:), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/deserialize_real_1d.html"},{"title":"deserialize_real_2d – TensorOmics","text":"public  subroutine deserialize_real_2d(arr, filename, ierr) Directly deserialize a 2D real array from a file Arguments Type Intent Optional Attributes Name real(kind=real64), intent(out), dimension(:, :), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/deserialize_real_2d.html"},{"title":"deserialize_real_3d – TensorOmics","text":"public  subroutine deserialize_real_3d(arr, filename, ierr) Directly deserialize a 3D real array from a file Arguments Type Intent Optional Attributes Name real(kind=real64), intent(out), dimension(:, :, :), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/deserialize_real_3d.html"},{"title":"deserialize_real_4d – TensorOmics","text":"public  subroutine deserialize_real_4d(arr, filename, ierr) Directly deserialize a 4D real array from a file Arguments Type Intent Optional Attributes Name real(kind=real64), intent(out), dimension(:, :, :, :), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/deserialize_real_4d.html"},{"title":"deserialize_real_5d – TensorOmics","text":"public  subroutine deserialize_real_5d(arr, filename, ierr) Directly deserialize a 5D real array from a file Arguments Type Intent Optional Attributes Name real(kind=real64), intent(out), dimension(:, :, :, :, :), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/deserialize_real_5d.html"},{"title":"deserialize_complex_helper – TensorOmics","text":"public  subroutine deserialize_complex_helper(arr, n_elements, arr_shape, filename, ierr) Arguments Type Intent Optional Attributes Name complex(kind=real64), intent(out), dimension(n_elements) :: arr Pre-allocated array to read the data into integer(kind=int32), intent(in) :: n_elements Size of arr integer(kind=int32), intent(in), dimension(:) :: arr_shape Extents of arr , one per dimension\nIt is VERY IMPORTANT to compute this argument from the dims_out output produced by get_array_metadata . Producer input Supplied by dims_out_capacity 5_int32 character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code","tags":"C-binding","url":"proc/deserialize_complex_helper.html"},{"title":"deserialize_complex_1d – TensorOmics","text":"public  subroutine deserialize_complex_1d(arr, filename, ierr) Directly deserialize a 1D complex array from a file Arguments Type Intent Optional Attributes Name complex(kind=real64), intent(out), dimension(:), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/deserialize_complex_1d.html"},{"title":"deserialize_complex_2d – TensorOmics","text":"public  subroutine deserialize_complex_2d(arr, filename, ierr) Directly deserialize a 2D complex array from a file Arguments Type Intent Optional Attributes Name complex(kind=real64), intent(out), dimension(:, :), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/deserialize_complex_2d.html"},{"title":"deserialize_complex_3d – TensorOmics","text":"public  subroutine deserialize_complex_3d(arr, filename, ierr) Directly deserialize a 3D complex array from a file Arguments Type Intent Optional Attributes Name complex(kind=real64), intent(out), dimension(:, :, :), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/deserialize_complex_3d.html"},{"title":"deserialize_complex_4d – TensorOmics","text":"public  subroutine deserialize_complex_4d(arr, filename, ierr) Directly deserialize a 4D complex array from a file Arguments Type Intent Optional Attributes Name complex(kind=real64), intent(out), dimension(:, :, :, :), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/deserialize_complex_4d.html"},{"title":"deserialize_complex_5d – TensorOmics","text":"public  subroutine deserialize_complex_5d(arr, filename, ierr) Directly deserialize a 5D complex array from a file Arguments Type Intent Optional Attributes Name complex(kind=real64), intent(out), dimension(:, :, :, :, :), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/deserialize_complex_5d.html"},{"title":"validate_data_structure – TensorOmics","text":"public  subroutine validate_data_structure(n_genes, n_families, n_samples, gene_ids, gene_family_ids, gene_to_fam, expression_vectors, family_centroids, shift_vectors, ierr) Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Expected number of genes integer(kind=int32), intent(in) :: n_families Expected number of families integer(kind=int32), intent(in) :: n_samples Expected number of samples character(len=*), intent(in) :: gene_ids (:) Gene ids character(len=*), intent(in) :: gene_family_ids (:) Gene family ids integer(kind=int32), intent(in) :: gene_to_fam (:) gene to family mapping real(kind=real64), intent(in) :: expression_vectors (:,:) Expression vectors real(kind=real64), intent(in) :: family_centroids (:,:) Family centroids real(kind=real64), intent(in) :: shift_vectors (:,:) Shift vectors integer(kind=int32), intent(out) :: ierr Error code","tags":"C-binding","url":"proc/validate_data_structure.html"},{"title":"validate_gene_to_family_mapping – TensorOmics","text":"public  subroutine validate_gene_to_family_mapping(gene_to_fam, n_families, ierr) Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: gene_to_fam (:) gene to family mapping integer(kind=int32), intent(in) :: n_families number of families integer(kind=int32), intent(out) :: ierr Error code","tags":"C-binding","url":"proc/validate_gene_to_family_mapping.html"},{"title":"validate_expression_data – TensorOmics","text":"public  subroutine validate_expression_data(expression_vectors, check_non_negative, ierr) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: expression_vectors (:,:) Expression vectors logical(kind=c_bool), intent(in) :: check_non_negative Defines if non negative should be checked integer(kind=int32), intent(out) :: ierr Error code","tags":"C-binding","url":"proc/validate_expression_data.html"},{"title":"validate_family_centroids – TensorOmics","text":"public  subroutine validate_family_centroids(family_centroids, ierr) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: family_centroids (:,:) Family centroids array integer(kind=int32), intent(out) :: ierr Error code","tags":"C-binding","url":"proc/validate_family_centroids.html"},{"title":"validate_shift_vectors – TensorOmics","text":"public  subroutine validate_shift_vectors(shift_vectors, expression_vectors, family_centroids, gene_to_fam, n_samples, ierr) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: shift_vectors (:,:) shift vectors real(kind=real64), intent(in) :: expression_vectors (:,:) expression vectors real(kind=real64), intent(in) :: family_centroids (:,:) family centroids integer(kind=int32), intent(in) :: gene_to_fam (:) gene to family mapping integer(kind=int32), intent(in) :: n_samples Number of samples integer(kind=int32), intent(out) :: ierr Error code","tags":"C-binding","url":"proc/validate_shift_vectors.html"},{"title":"check_for_nan_inf – TensorOmics","text":"public  subroutine check_for_nan_inf(array, ierr) Check if an array of type real contains NaN or Inf values Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: array (:,:) Input array integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/check_for_nan_inf.html"},{"title":"validate_string_array_uniqueness – TensorOmics","text":"public  subroutine validate_string_array_uniqueness(str_arr, ierr) Uses f42_xxh3_hashmap Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: str_arr (:) string array integer(kind=int32), intent(out) :: ierr Error code","tags":"C-binding","url":"proc/validate_string_array_uniqueness.html"},{"title":"validate_empty_strings – TensorOmics","text":"public  subroutine validate_empty_strings(string_array, array_name, ierr) Validate that strings in an array are not empty Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: string_array (:) Array of strings character(len=*), intent(in) :: array_name Name of the array integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/validate_empty_strings.html"},{"title":"validate_all_data – TensorOmics","text":"public  subroutine validate_all_data(n_genes, n_families, n_samples, gene_ids, gene_family_ids, gene_to_fam, expression_vectors, family_centroids, shift_vectors, ierr, check_uniqueness, check_shift_consistency) Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Number of genes integer(kind=int32), intent(in) :: n_families Number of families integer(kind=int32), intent(in) :: n_samples Number of samples character(len=*), intent(in) :: gene_ids (:) Gene ids array character(len=*), intent(in) :: gene_family_ids (:) gene family ids integer(kind=int32), intent(in) :: gene_to_fam (:) gene to family mapping real(kind=real64), intent(in) :: expression_vectors (:,:) Expression vectors real(kind=real64), intent(in) :: family_centroids (:,:) family centroids real(kind=real64), intent(in) :: shift_vectors (:,:) shift vectors integer(kind=int32), intent(out) :: ierr error code logical(kind=c_bool), intent(in), optional :: check_uniqueness Check ID arrays for uniqueness.\nThe default value is .true. . logical(kind=c_bool), intent(in), optional :: check_shift_consistency Check consitency of shift array.\nThe default value is .true. .","tags":"C-binding","url":"proc/validate_all_data.html"},{"title":"determine_shared_residual_range – TensorOmics","text":"public pure subroutine determine_shared_residual_range(abs_residual_pool, pool_size, shared_residual_range, residual_range_quantile, ierr) This takes the pool already built; determine_study_shared_residual_range builds it from\nthe neighborhood residuals of two studies first, if that is what is at hand. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(pool_size) :: abs_residual_pool The absolute residual values of the concatenated S1,S2 residuals\nNaN is permitted for this value. integer(kind=int32), intent(in) :: pool_size Size of pool of residuals abs_residual_pool , usually (n_reps_S1 + n_reps_2)*n_neighbors*n_points real(kind=real64), intent(out) :: shared_residual_range Computed residual range (R) real(kind=real64), intent(in), optional :: residual_range_quantile Quantile in [0,1] for determining the residual range\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 .\nThe default value is 0.95 . integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/determine_shared_residual_range.html"},{"title":"determine_shared_residual_range_expert – TensorOmics","text":"public pure subroutine determine_shared_residual_range_expert(abs_residual_pool, abs_residual_pool_perm, pool_size, shared_residual_range, residual_range_quantile, ierr) This takes the pool already built; determine_study_shared_residual_range builds it from\nthe neighborhood residuals of two studies first, if that is what is at hand. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(pool_size) :: abs_residual_pool The absolute residual values of the concatenated S1,S2 residuals\nNaN is permitted for this value. integer(kind=int32), intent(in), dimension(pool_size) :: abs_residual_pool_perm The permutation vector that sorts abs_residual_pool The minimum valid value is 1_int32 .\nThe maximum valid value is pool_size . integer(kind=int32), intent(in) :: pool_size Size of pool of residuals abs_residual_pool , usually (n_reps_S1 + n_reps_2)*n_neighbors*n_points real(kind=real64), intent(out) :: shared_residual_range Computed residual range (R) real(kind=real64), intent(in), optional :: residual_range_quantile Quantile in [0,1] for determining the residual range\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 .\nThe default value is 0.95 . integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/determine_shared_residual_range_expert.html"},{"title":"determine_study_shared_residual_range – TensorOmics","text":"public pure subroutine determine_study_shared_residual_range(neighborhood_residuals_S1, neighborhood_residuals_S2, n_reps_S1, n_reps_S2, n_neighbors, n_points, shared_residual_range, residual_range_quantile, ierr) Pools the absolute residuals of both studies, sorts them, and takes the quantile exactly\nas determine_shared_residual_range does. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_reps_S1, n_neighbors, n_points) :: neighborhood_residuals_S1 Computed neighborhood residuals for study 1, NaN is explicitly allowed for missing values\nNaN is permitted for this value. real(kind=real64), intent(in), dimension(n_reps_S2, n_neighbors, n_points) :: neighborhood_residuals_S2 Computed neighborhood residuals for study 2, NaN is explicitly allowed for missing values\nNaN is permitted for this value. integer(kind=int32), intent(in) :: n_reps_S1 Number of replicates in study 1 integer(kind=int32), intent(in) :: n_reps_S2 Number of replicates in study 2 integer(kind=int32), intent(in) :: n_neighbors Number of neighbors in the studies integer(kind=int32), intent(in) :: n_points Number of reference points in the studies real(kind=real64), intent(out) :: shared_residual_range Computed residual range (R) real(kind=real64), intent(in), optional :: residual_range_quantile Quantile in [0,1] for determining the residual range\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 .\nThe default value is 0.95 . integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/determine_study_shared_residual_range.html"},{"title":"determine_study_shared_residual_range_expert – TensorOmics","text":"public pure subroutine determine_study_shared_residual_range_expert(neighborhood_residuals_S1, neighborhood_residuals_S2, n_reps_S1, n_reps_S2, n_neighbors, n_points, tmp_abs_residual_pool, tmp_abs_residual_pool_perm, shared_residual_range, residual_range_quantile, ierr) Pools the absolute residuals of both studies, sorts them, and takes the quantile exactly\nas determine_shared_residual_range does. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_reps_S1, n_neighbors, n_points) :: neighborhood_residuals_S1 Computed neighborhood residuals for study 1, NaN is explicitly allowed for missing values\nNaN is permitted for this value. real(kind=real64), intent(in), dimension(n_reps_S2, n_neighbors, n_points) :: neighborhood_residuals_S2 Computed neighborhood residuals for study 2, NaN is explicitly allowed for missing values\nNaN is permitted for this value. integer(kind=int32), intent(in) :: n_reps_S1 Number of replicates in study 1 integer(kind=int32), intent(in) :: n_reps_S2 Number of replicates in study 2 integer(kind=int32), intent(in) :: n_neighbors Number of neighbors in the studies integer(kind=int32), intent(in) :: n_points Number of reference points in the studies real(kind=real64), intent(out), dimension((n_reps_S1 + n_reps_S2)*n_neighbors*n_points) :: tmp_abs_residual_pool Work array holding the pooled absolute residuals of both studies integer(kind=int32), intent(out), dimension((n_reps_S1 + n_reps_S2)*n_neighbors*n_points) :: tmp_abs_residual_pool_perm Work array for the permutation that sorts tmp_abs_residual_pool real(kind=real64), intent(out) :: shared_residual_range Computed residual range (R) real(kind=real64), intent(in), optional :: residual_range_quantile Quantile in [0,1] for determining the residual range\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 .\nThe default value is 0.95 . integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/determine_study_shared_residual_range_expert.html"},{"title":"build_residual_histograms – TensorOmics","text":"public pure subroutine build_residual_histograms(neighborhood_residuals, n_reps, n_neighbors, n_points, shared_residual_range, n_bins, counts, pmf, included_n_reps, neighbor_mask, ierr) The probability mass function pmf(residual, bin) is actually a matrix. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_reps, n_neighbors, n_points) :: neighborhood_residuals Computed neighborhood residuals for a study, NaN is explicitly allowed for missing values\nNaN is permitted for this value. integer(kind=int32), intent(in) :: n_reps Number of replicates of the study integer(kind=int32), intent(in) :: n_neighbors Number of reference points (k) integer(kind=int32), intent(in) :: n_points Number of reference points in the study real(kind=real64), intent(in) :: shared_residual_range Computed residual range (R)\nThe minimum valid value is 0.0_real64 . integer(kind=int32), intent(in) :: n_bins Number of equally sized histogram bins in range [-R,R] integer(kind=int32), intent(out), dimension(n_points, n_bins) :: counts Absolute counts of a residual per bin real(kind=real64), intent(out), dimension(n_points, n_bins) :: pmf counts normalized to 0 <= counts(:, i) <= 1 and sum(counts(:, i)) == 1 integer(kind=int32), intent(out), dimension(n_points) :: included_n_reps Stores the count of non-NaN replicates (included ones) logical(kind=c_bool), intent(in), optional, dimension(n_neighbors, n_points) :: neighbor_mask Optional mask to exclude specific neighbors (e.g. for family-wise analysis) integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/build_residual_histograms.html"},{"title":"compute_divergence_per_reference_point – TensorOmics","text":"public pure subroutine compute_divergence_per_reference_point(pmf_S1, pmf_S2, n_points, n_bins, js_divergences, ierr) Takes the probabilities pmf produced by build_residual_histograms . Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_points, n_bins) :: pmf_S1 Computed normalized histogram counts for study 1\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 . real(kind=real64), intent(in), dimension(n_points, n_bins) :: pmf_S2 Computed normalized histogram counts for study 2\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 . integer(kind=int32), intent(in) :: n_points Number of reference points (k) integer(kind=int32), intent(in) :: n_bins Number of equally sized histogram bins in range [-R,R] real(kind=real64), intent(out), dimension(n_points) :: js_divergences Jensen-Shannon divergence per reference point integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/compute_divergence_per_reference_point.html"},{"title":"compute_weighted_global_divergence – TensorOmics","text":"public pure subroutine compute_weighted_global_divergence(js_divergences, n_points, included_n_reps_S1, included_n_reps_S2, global_js_divergence, weights, ierr) Takes the divergences produced by compute_divergence_per_reference_point . Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_points) :: js_divergences Jensen-Shannon divergence per reference point, computed for studies S1 and S2\nThe minimum valid value is 0.0_real64 . integer(kind=int32), intent(in) :: n_points Number of reference points (k) integer(kind=int32), intent(in), dimension(n_points) :: included_n_reps_S1 Count of non-NaN residuals (included ones) in study 1\nThe minimum valid value is 0_int32 . integer(kind=int32), intent(in), dimension(n_points) :: included_n_reps_S2 Count of non-NaN residuals (included ones) in study 2\nThe minimum valid value is 0_int32 . real(kind=real64), intent(out) :: global_js_divergence Weighted global Jensen-Shannon divergence real(kind=real64), intent(out), dimension(n_points) :: weights Weights used for calculating the global weighted Jensen-Shannon divergence global_js_divergence integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/compute_weighted_global_divergence.html"},{"title":"select_random_sample – TensorOmics","text":"public  subroutine select_random_sample(n_samples, current_sample, random_sample, ierr) Selects a random sample different to current_sample . For reproducibility call init_random beforehand. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_samples number of samples integer(kind=int32), intent(in) :: current_sample sample that won't be selected integer(kind=int32), intent(out) :: random_sample selected random sample integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/select_random_sample.html"},{"title":"select_random_sample_helper – TensorOmics","text":"public  subroutine select_random_sample_helper(n_samples, current_sample, random_sample) Selects a random sample different to current_sample . For reproducibility call init_random beforehand. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_samples number of samples integer(kind=int32), intent(in) :: current_sample sample that won't be selected integer(kind=int32), intent(out) :: random_sample selected random sample","tags":"","url":"proc/select_random_sample_helper.html"},{"title":"perform_permutation_test_impl – TensorOmics","text":"public  subroutine perform_permutation_test_impl(trajectories, n_factors, n_samples, n_timepoints, factor_idx, dependent_idx, sample_idx, baseline_mode, n_permutations, local_contributions, total_contributions, tmp_factor, tmp_dependent, random_seed, ierr) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_factors, n_samples, n_timepoints) :: trajectories expression vectors across different samples over time integer(kind=int32), intent(in) :: n_factors number of factors integer(kind=int32), intent(in) :: n_samples number of samples integer(kind=int32), intent(in) :: n_timepoints number of timepoints integer(kind=int32), intent(in) :: factor_idx index of factor to compute the permutation contributions for\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_factors . integer(kind=int32), intent(in) :: dependent_idx index of dependent to compute the permutation contributions for\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_factors . integer(kind=int32), intent(in) :: sample_idx index of sample to compute the permutation contributions for\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_samples . integer(kind=int32), intent(in) :: baseline_mode Mode Value Raw/zero baseline MODE_BASELINE_RAW arithmetic mean MODE_BASELINE_MEAN minimum value MODE_BASELINE_MIN integer(kind=int32), intent(in) :: n_permutations number of permutations to perform real(kind=real64), intent(out), dimension(n_timepoints, n_permutations) :: local_contributions Per-timepoint contributions per permutation real(kind=real64), intent(out), dimension(n_permutations) :: total_contributions Total contribution ( sum(local_contributions) ) per permutation real(kind=real64), intent(out), dimension(n_timepoints) :: tmp_factor Working array to hold the factor in contiguous memory real(kind=real64), intent(out), dimension(n_timepoints) :: tmp_dependent Working array to hold the random dependent in contiguous memory integer(kind=int32), intent(in), optional :: random_seed Seed to use for random number generation. integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/perform_permutation_test_impl.html"},{"title":"compute_p_values_impl – TensorOmics","text":"public pure subroutine compute_p_values_impl(local_contributions_observed, total_contribution_observed, local_contributions_perm_test, total_contributions_perm_test, n_timepoints, n_permutations, local_p_values, total_p_value) Given the permutation tests ( perform_permutation_test_impl ),\nthis counts how many of the permutation contributions were at least as high as the real ones. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_timepoints) :: local_contributions_observed Per-timepoint contributions for the observed factor-dependent-sample combination real(kind=real64), intent(in) :: total_contribution_observed Total contribution ( sum(local_contributions) ) for the observed factor-dependent-sample combination real(kind=real64), intent(in), dimension(n_timepoints, n_permutations) :: local_contributions_perm_test Per-timepoint contributions for the factor-dependent-random_sample combinations from perform_permutation_test_impl real(kind=real64), intent(in), dimension(n_permutations) :: total_contributions_perm_test Total contribution ( sum(local_contributions) ) for the factor-dependent-random_sample combinations from perform_permutation_test_impl integer(kind=int32), intent(in) :: n_timepoints number of timepoints integer(kind=int32), intent(in) :: n_permutations number of permutations to perform real(kind=real64), intent(out), dimension(n_timepoints) :: local_p_values calculated p values for local contributions, like: (local_contributions_perm_test >= local_contributions_observed)/n_permutations real(kind=real64), intent(out) :: total_p_value calculated p values for total contributions, like: (total_contributions_perm_test >= total_contribution_observed)/n_permutations","tags":"","url":"proc/compute_p_values_impl.html"},{"title":"compute_contributions_impl – TensorOmics","text":"public pure subroutine compute_contributions_impl(factor, dependent, n_dims, baseline_mode, local_contributions, total_contribution, ierr) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_dims) :: factor Factor time series, length n_timepoints real(kind=real64), intent(in), dimension(n_dims) :: dependent Dependent variable time series, length n_timepoints integer(kind=int32), intent(in) :: n_dims Number of elements in factor and dependent integer(kind=int32), intent(in) :: baseline_mode Mode Value Raw/zero baseline MODE_BASELINE_RAW arithmetic mean MODE_BASELINE_MEAN minimum value MODE_BASELINE_MIN real(kind=real64), intent(out), dimension(n_dims) :: local_contributions Per-element contributions real(kind=real64), intent(out) :: total_contribution Total contribution ( sum(local_contributions) ) integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/compute_contributions_impl.html"},{"title":"compute_all_contributions_impl – TensorOmics","text":"public pure subroutine compute_all_contributions_impl(trajectories, n_factors, n_samples, n_timepoints, factor_indices, n_selected_factors, dependent_indices, n_selected_dependents, baseline_mode, local_contributions, total_contributions, tmp_factors, tmp_dependent, ierr) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_factors, n_samples, n_timepoints) :: trajectories expression vectors across different samples over time integer(kind=int32), intent(in) :: n_factors number of factors integer(kind=int32), intent(in) :: n_samples number of samples integer(kind=int32), intent(in) :: n_timepoints number of timepoints integer(kind=int32), intent(in), dimension(n_selected_factors) :: factor_indices indices of factors to compute the contributions for\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_factors . integer(kind=int32), intent(in) :: n_selected_factors number of selected factors in factor_indices integer(kind=int32), intent(in), dimension(n_selected_dependents) :: dependent_indices indices of dependents to compute the contributions for\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_factors . integer(kind=int32), intent(in) :: n_selected_dependents number of selected dependents in dependent_indices integer(kind=int32), intent(in) :: baseline_mode Mode Value Raw/zero baseline MODE_BASELINE_RAW arithmetic mean MODE_BASELINE_MEAN minimum value MODE_BASELINE_MIN real(kind=real64), intent(out), dimension(n_timepoints, n_selected_factors, n_selected_dependents, n_samples) :: local_contributions Per-timepoint contributions per sample-dependent-factor combination real(kind=real64), intent(out), dimension(n_selected_factors, n_selected_dependents, n_samples) :: total_contributions Total contribution ( sum(local_contributions) ) per sample-dependent-factor combination real(kind=real64), intent(out), dimension(n_timepoints, n_selected_factors) :: tmp_factors Working array to hold the currently handled sample's factors in contiguous memory real(kind=real64), intent(out), dimension(n_timepoints) :: tmp_dependent Working array to hold the currently handled dependent in contiguous memory integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/compute_all_contributions_impl.html"},{"title":"compute_baselines_factor_dependent_impl – TensorOmics","text":"public pure subroutine compute_baselines_factor_dependent_impl(n_timepoints, factor, dependent, baseline_mode, factor_baseline, dependent_baseline, ierr) Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_timepoints Number of timepoints in both factor and dependent arrays real(kind=real64), intent(in), dimension(n_timepoints) :: factor Factor time series, length n_timepoints real(kind=real64), intent(in), dimension(n_timepoints) :: dependent Dependent variable time series, length n_timepoints integer(kind=int32), intent(in) :: baseline_mode Mode Value Raw/zero baseline MODE_BASELINE_RAW arithmetic mean MODE_BASELINE_MEAN minimum value MODE_BASELINE_MIN real(kind=real64), intent(out) :: factor_baseline Computed baseline for factor real(kind=real64), intent(out) :: dependent_baseline Computed baseline for dependent variable integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/compute_baselines_factor_dependent_impl.html"},{"title":"compute_velocity_trajectory_helper – TensorOmics","text":"public pure subroutine compute_velocity_trajectory_helper(trajectory, velocity, n_timepoints) This routine computes velocity trajectory from a single position trajectory, no input validation Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_timepoints) :: trajectory input position trajectory real(kind=real64), intent(out), dimension(max(0_int32, n_timepoints - 1)) :: velocity output velocity trajectory integer(kind=int32), intent(in) :: n_timepoints number of timepoints","tags":"","url":"proc/compute_velocity_trajectory_helper.html"},{"title":"compute_factor_velocity_from_trajectories_helper – TensorOmics","text":"public pure subroutine compute_factor_velocity_from_trajectories_helper(trajectories, n_factors, n_samples, n_timepoints, factor_idx, sample_idx, velocity) This routine computes velocity trajectory from the trajectories(n_factors, n_samples, n_timepoints) matrix Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_factors, n_samples, n_timepoints) :: trajectories input position trajectories integer(kind=int32), intent(in) :: n_factors number of factors integer(kind=int32), intent(in) :: n_samples number of samples integer(kind=int32), intent(in) :: n_timepoints number of timepoints integer(kind=int32), intent(in) :: factor_idx factor index of the trajectory integer(kind=int32), intent(in) :: sample_idx sample index of the trajectory real(kind=real64), intent(out), dimension(max(0, n_timepoints - 1)) :: velocity Calculated velocity for the selected trajectory","tags":"","url":"proc/compute_factor_velocity_from_trajectories_helper.html"},{"title":"compute_velocity_trajectory_impl – TensorOmics","text":"public pure subroutine compute_velocity_trajectory_impl(trajectory, velocity, n_timepoints) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_timepoints) :: trajectory input position trajectory real(kind=real64), intent(out), dimension(max(0_int32, n_timepoints - 1)) :: velocity output velocity trajectory integer(kind=int32), intent(in) :: n_timepoints number of timepoints","tags":"","url":"proc/compute_velocity_trajectory_impl.html"},{"title":"compute_acceleration_from_velocity_trajectory_impl – TensorOmics","text":"public pure subroutine compute_acceleration_from_velocity_trajectory_impl(velocity, acceleration, n_timepoints) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(max(0_int32, n_timepoints - 1)) :: velocity velocity trajectory real(kind=real64), intent(out), dimension(max(0_int32, n_timepoints - 2)) :: acceleration acceleration trajectory integer(kind=int32), intent(in) :: n_timepoints number of timepoints","tags":"","url":"proc/compute_acceleration_from_velocity_trajectory_impl.html"},{"title":"compute_velocity_trajectories_impl – TensorOmics","text":"public pure subroutine compute_velocity_trajectories_impl(trajectories, velocity, n_factors, n_samples, n_timepoints) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_factors, n_samples, n_timepoints) :: trajectories input position trajectories real(kind=real64), intent(out), dimension(max(0_int32, n_timepoints - 1), n_factors, n_samples) :: velocity output velocity trajectories integer(kind=int32), intent(in) :: n_factors number of factors integer(kind=int32), intent(in) :: n_samples number of samples integer(kind=int32), intent(in) :: n_timepoints number of timepoints","tags":"","url":"proc/compute_velocity_trajectories_impl.html"},{"title":"compute_acceleration_from_velocity_impl – TensorOmics","text":"public pure subroutine compute_acceleration_from_velocity_impl(velocity, acceleration, n_factors, n_samples, n_timepoints) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(max(0_int32, n_timepoints - 1), n_factors, n_samples) :: velocity input velocity trajectories real(kind=real64), intent(out), dimension(max(0_int32, n_timepoints - 2), n_factors, n_samples) :: acceleration output acceleration trajectories integer(kind=int32), intent(in) :: n_factors number of factors integer(kind=int32), intent(in) :: n_samples number of samples integer(kind=int32), intent(in) :: n_timepoints number of timepoints","tags":"","url":"proc/compute_acceleration_from_velocity_impl.html"},{"title":"compute_velocity_acceleration_contributions_impl – TensorOmics","text":"public pure subroutine compute_velocity_acceleration_contributions_impl(trajectories, n_factors, n_samples, n_timepoints, baseline_mode, tmp_factors, tmp_dependent, tmp_contributions, contrib_velocity, velocity_contribution_series, contrib_acceleration, acceleration_contribution_series, ierr) Note Performance layout: trajectories uses (n_factors, n_samples, n_timepoints) .\nVelocity and acceleration use time-first layouts: velocity -> (max(0, n_timepoints-1), n_factors, n_samples) acceleration -> (max(0, n_timepoints-2), n_factors, n_samples) This keeps slices like velocity(:, factor, sample) contiguous,\navoids expensive tmporaries, and improves cache efficiency. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_factors, n_samples, n_timepoints) :: trajectories input position trajectories integer(kind=int32), intent(in) :: n_factors number of factors integer(kind=int32), intent(in) :: n_samples number of samples integer(kind=int32), intent(in) :: n_timepoints number of timepoints integer(kind=int32), intent(in) :: baseline_mode Mode Value Raw/zero baseline MODE_BASELINE_RAW arithmetic mean MODE_BASELINE_MEAN minimum value MODE_BASELINE_MIN real(kind=real64), intent(out), dimension(n_timepoints - 1, n_factors) :: tmp_factors workspace for factor data (used for velocity and acceleration) real(kind=real64), intent(out), dimension(n_timepoints - 1) :: tmp_dependent workspace for dependent data (used for velocity and acceleration) real(kind=real64), intent(out), dimension(n_timepoints - 1) :: tmp_contributions workspace for contribution calculations (used for velocity and acceleration) real(kind=real64), intent(out), dimension(n_factors, n_factors, n_samples) :: contrib_velocity output velocity contributions real(kind=real64), intent(out), dimension(n_timepoints, n_factors, n_factors, n_samples) :: velocity_contribution_series output velocity contribution series real(kind=real64), intent(out), dimension(n_factors, n_factors, n_samples) :: contrib_acceleration output acceleration contributions real(kind=real64), intent(out), dimension(n_timepoints, n_factors, n_factors, n_samples) :: acceleration_contribution_series output acceleration contribution series integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/compute_velocity_acceleration_contributions_impl.html"},{"title":"deserialize_char_helper_c – TensorOmics","text":"public  subroutine deserialize_char_helper_c(arr, n_strings, strlen, arr_shape, n_arr_shape_elements, filename, filename_strlen, ierr) bind(C, name=\"deserialize_char_helper_c\") Uses f42_serde_arrays_deserialize_char Arguments Type Intent Optional Attributes Name character(kind=c_char, len=1), intent(out), dimension(strlen, *), target :: arr Pre-allocated array to read the data into integer(kind=c_int), intent(in), target :: n_strings Number of strings in arr integer(kind=c_int), intent(in), target :: strlen Length of each string in arr .\nIt is VERY IMPORTANT to compute this argument from the type_code output produced by get_array_metadata . Producer input Supplied by dims_out_capacity 5_int32 integer(kind=c_int), intent(in), dimension(n_arr_shape_elements), target :: arr_shape Extents of arr , one per dimension\nIt is VERY IMPORTANT to compute this argument from the dims_out output produced by get_array_metadata . Producer input Supplied by dims_out_capacity 5_int32 integer(kind=c_int), intent(in), target :: n_arr_shape_elements number of elements in arr_shape character(kind=c_char, len=1), intent(in), dimension(filename_strlen), target :: filename Name of the file integer(kind=c_int), intent(in), target :: filename_strlen length of the strings in filename integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"proc/deserialize_char_helper_c.html"},{"title":"compute_shift_vector_field – TensorOmics","text":"public pure subroutine compute_shift_vector_field(n_tissues, n_genes, n_families, expression_vectors, family_centroids, gene_to_fam, shift_vectors, ierr) Computes the shift vectors by subtracting the corresponding family centroid from the expression vector. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_tissues Expression vector dimension integer(kind=int32), intent(in) :: n_genes Total number of genes integer(kind=int32), intent(in) :: n_families Total number of families real(kind=real64), intent(in), dimension(n_tissues, n_genes) :: expression_vectors Gene expression matrix real(kind=real64), intent(in), dimension(n_tissues, n_families) :: family_centroids Family centroid matrix integer(kind=int32), intent(in), dimension(n_genes) :: gene_to_fam Index mapping -> each index i holds the family index for the corresponding gene in expression_vectors , using 0_int32 for unassigned genes\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_families .\nThe value 0_int32 is additionally accepted. real(kind=real64), intent(out), dimension(n_tissues, 2, n_genes) :: shift_vectors Output, real matrix array. For each gene it holds two vectors: the centroid of the gene's family first (a zero vector if no family is assigned), then the shift vector integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/compute_shift_vector_field.html"},{"title":"create_zip_archive – TensorOmics","text":"public  subroutine create_zip_archive(zip_filename, keys, filenames, ierr) Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: zip_filename Name of the zip file to create character(len=*), intent(in) :: keys (:) Array of keys for manifest entries character(len=*), intent(in) :: filenames (:) Array of filenames to add to zip integer(kind=int32), intent(out) :: ierr Error code","tags":"C-binding","url":"proc/create_zip_archive.html"},{"title":"extract_zip_archive – TensorOmics","text":"public  subroutine extract_zip_archive(zip_filename, keys, filenames, ierr) Uses tox_conversions Extract a zip archive and return all key-value pairs from manifest Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: zip_filename Zip file to read character(len=:), intent(out), allocatable :: keys (:) Array of keys from manifest character(len=:), intent(out), allocatable :: filenames (:) Array of filenames from manifest integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/extract_zip_archive.html"},{"title":"delete_file – TensorOmics","text":"public  subroutine delete_file(filename, ierr) Delete a file from the disk Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: filename File to delete integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/delete_file.html"},{"title":"get_zip_entry_name – TensorOmics","text":"public  subroutine get_zip_entry_name(zip_handle, entry_index, entry_name) Uses tox_conversions Helper function to get the name of a ZIP entry entry_name is a view into libzip's own memory , not a copy: it is valid only while zip_handle is open, and must not be kept past zip_close . The one caller uses it\ninside the loop that reads the archive, which is exactly that window. Arguments Type Intent Optional Attributes Name type(c_ptr), intent(in) :: zip_handle Zip file connection integer(kind=c_int64_t), intent(in) :: entry_index Index of the entry character(len=:), intent(out), pointer :: entry_name Name of the entry, ending at libzip's NUL. Unassociated if the entry has no name.","tags":"","url":"proc/get_zip_entry_name.html"},{"title":"extract_file_from_zip – TensorOmics","text":"public  subroutine extract_file_from_zip(zip_handle, filename, ierr) Uses tox_conversions Extracts a single named entry from an open ZIP archive to a file of the same name on disk,\nstreaming it through a fixed-size buffer rather than reading it into memory whole. Arguments Type Intent Optional Attributes Name type(c_ptr), intent(in) :: zip_handle Zip connection character(len=*), intent(in) :: filename Name of the file to extract integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/extract_file_from_zip.html"},{"title":"add_data_to_zip – TensorOmics","text":"public  subroutine add_data_to_zip(zip_handle, filename, data_source, data_type, ierr) Uses tox_conversions Adds one entry to an open ZIP archive, sourced either from a file on disk\n( data_type=DATA_TYPE_FILE , data_source is a path) or from an in-memory string\n( data_type=DATA_TYPE_STRING , data_source is the literal content). Arguments Type Intent Optional Attributes Name type(c_ptr), intent(in) :: zip_handle Zip connection character(len=*), intent(in) :: filename Filename to add character(len=*), intent(in) :: data_source File path or string content integer(kind=int32), intent(in) :: data_type Type of input integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/add_data_to_zip.html"},{"title":"write_manifest – TensorOmics","text":"public  subroutine write_manifest(keys, filenames, manifest_filename, ierr) Write manifest from given key-value pairs Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: keys (:) Array of keys for manifest entries character(len=*), intent(in) :: filenames (:) Array of filenames for manifest entries character(len=*), intent(in) :: manifest_filename Name of the manifest file (should be manifest.txt) integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/write_manifest.html"},{"title":"read_manifest_generic – TensorOmics","text":"public  subroutine read_manifest_generic(manifest_filename, keys, values, ierr) Read manifest file and return key-value pairs Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: manifest_filename Filename of the manifest (should be manifest.txt) character(len=:), intent(out), allocatable :: keys (:) Array of keys from manifest character(len=:), intent(out), allocatable :: values (:) Array of values from manifest integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/read_manifest_generic.html"},{"title":"extract_and_parse_manifest – TensorOmics","text":"public  subroutine extract_and_parse_manifest(zip_handle, keys, filenames, ierr) Uses tox_conversions Extract and parse the manifest file for generic key-value pairs. Arguments Type Intent Optional Attributes Name type(c_ptr), intent(in) :: zip_handle Zip file connection character(len=:), intent(out), allocatable :: keys (:) Array of keys from manifest character(len=:), intent(out), allocatable :: filenames (:) Array of filenames from manifest integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/extract_and_parse_manifest.html"},{"title":"save_tox_data – TensorOmics","text":"public  subroutine save_tox_data(zip_filename, ierr, gene_ids, gene_ids_file, expression, expression_file, gene_to_family, gene_to_family_file, family_ids, family_ids_file, family_centroids, family_centroids_file, shift_vectors, shift_vectors_file) Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: zip_filename Zip filename integer(kind=int32), intent(out) :: ierr Error code character(len=*), intent(in), optional :: gene_ids (:) Gene ids array, will be saved if provided character(len=*), intent(in), optional :: gene_ids_file Name of the gene ids file real(kind=real64), intent(in), optional :: expression (:,:) Expression vectors array, will be saved if provided character(len=*), intent(in), optional :: expression_file Name of the expression file integer(kind=int32), intent(in), optional :: gene_to_family (:) Gene to family mapping array, will be saved if provided character(len=*), intent(in), optional :: gene_to_family_file Name of the gene to family mapping file character(len=*), intent(in), optional :: family_ids (:) Family ids array, will be saved if provided character(len=*), intent(in), optional :: family_ids_file Name of the family ids file real(kind=real64), intent(in), optional :: family_centroids (:,:) Family centroids array, will be saved if provided character(len=*), intent(in), optional :: family_centroids_file Name of the family centroids file real(kind=real64), intent(in), optional :: shift_vectors (:,:) Shift vectors array, will be saved if provided character(len=*), intent(in), optional :: shift_vectors_file Name of the shift vectors file","tags":"C-binding","url":"proc/save_tox_data.html"},{"title":"read_tox_data – TensorOmics","text":"public  subroutine read_tox_data(zip_filename, ierr, gene_ids, gene_ids_file, expression, expression_file, gene_to_family, gene_to_family_file, family_ids, family_ids_file, family_centroids, family_centroids_file, shift_vectors, shift_vectors_file) Uses f42_serde_arrays_utils iso_fortran_env tox_data_read_write Read standard tox from a zip archive Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: zip_filename Name of the zipfile integer(kind=int32), intent(out) :: ierr Error code character(len=:), intent(out), optional, allocatable :: gene_ids (:) Gene IDs array, will be populated if provided character(len=:), intent(out), optional, allocatable :: gene_ids_file Name of the gene ids file in the zip archive real(kind=real64), intent(out), optional, allocatable :: expression (:,:) Expression vectors array, will be populated if provided character(len=:), intent(out), optional, allocatable :: expression_file Name of the expression vectors file in the zip archive integer(kind=int32), intent(out), optional, allocatable :: gene_to_family (:) Gene to family mapping array, will be populated if provided character(len=:), intent(out), optional, allocatable :: gene_to_family_file Name of the gene to family mapping file in the zip archive character(len=:), intent(out), optional, allocatable :: family_ids (:) Family IDs array, will be populated if provided character(len=:), intent(out), optional, allocatable :: family_ids_file Name of the family ids file in the zip archive real(kind=real64), intent(out), optional, allocatable :: family_centroids (:,:) Family centroids array, will be populated if provided character(len=:), intent(out), optional, allocatable :: family_centroids_file Name of the family centroids file in the zip archive real(kind=real64), intent(out), optional, allocatable :: shift_vectors (:,:) Shift vectors array, will be populated if provided character(len=:), intent(out), optional, allocatable :: shift_vectors_file Name of the shift vectors file in the zip archive","tags":"","url":"proc/read_tox_data.html"},{"title":"resolve_tox_data_files – TensorOmics","text":"public  subroutine resolve_tox_data_files(zip_filename, gene_ids_file, expression_file, gene_to_family_file, family_ids_file, family_centroids_file, shift_vectors_file, ierr) Extracts zip_filename to temporary files and maps the manifest keys to them; a member\nabsent from the manifest comes back as an empty string. Not exported (returns allocatable\nstrings) -- a helper shared by get_tox_data_dims and read_tox_data_into. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: zip_filename Name of the zip file character(len=:), intent(out), allocatable :: gene_ids_file Extracted member filenames, empty when the member is absent character(len=:), intent(out), allocatable :: expression_file Extracted member filenames, empty when the member is absent character(len=:), intent(out), allocatable :: gene_to_family_file Extracted member filenames, empty when the member is absent character(len=:), intent(out), allocatable :: family_ids_file Extracted member filenames, empty when the member is absent character(len=:), intent(out), allocatable :: family_centroids_file Extracted member filenames, empty when the member is absent character(len=:), intent(out), allocatable :: shift_vectors_file Extracted member filenames, empty when the member is absent integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/resolve_tox_data_files.html"},{"title":"cleanup_tox_data_files – TensorOmics","text":"public  subroutine cleanup_tox_data_files(gene_ids_file, expression_file, gene_to_family_file, family_ids_file, family_centroids_file, shift_vectors_file) Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: gene_ids_file Extracted member filenames to remove (skipped when empty) character(len=*), intent(in) :: expression_file Extracted member filenames to remove (skipped when empty) character(len=*), intent(in) :: gene_to_family_file Extracted member filenames to remove (skipped when empty) character(len=*), intent(in) :: family_ids_file Extracted member filenames to remove (skipped when empty) character(len=*), intent(in) :: family_centroids_file Extracted member filenames to remove (skipped when empty) character(len=*), intent(in) :: shift_vectors_file Extracted member filenames to remove (skipped when empty)","tags":"","url":"proc/cleanup_tox_data_files.html"},{"title":"get_tox_data_dims – TensorOmics","text":"public  subroutine get_tox_data_dims(zip_filename, n_gene_ids, gene_id_len, n_expression_rows, n_expression_cols, n_gene_to_family, n_family_ids, family_id_len, n_family_centroids_rows, n_family_centroids_cols, n_shift_vectors_rows, n_shift_vectors_cols, ierr) Each count (and each string length) is 0 when the corresponding member is absent, so a\ncaller can size all six output buffers up front. Character members report both an element\ncount and a per-element string length. Pairs with read_tox_data_into . Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: zip_filename Name of the zip file integer(kind=int32), intent(out) :: n_gene_ids Number of gene ids, 0 if absent integer(kind=int32), intent(out) :: gene_id_len String length of each gene id, 0 if absent integer(kind=int32), intent(out) :: n_expression_rows Rows (samples) of the expression matrix, 0 if absent integer(kind=int32), intent(out) :: n_expression_cols Columns (genes) of the expression matrix, 0 if absent integer(kind=int32), intent(out) :: n_gene_to_family Number of gene-to-family entries, 0 if absent integer(kind=int32), intent(out) :: n_family_ids Number of family ids, 0 if absent integer(kind=int32), intent(out) :: family_id_len String length of each family id, 0 if absent integer(kind=int32), intent(out) :: n_family_centroids_rows Rows (samples) of the family centroids matrix, 0 if absent integer(kind=int32), intent(out) :: n_family_centroids_cols Columns (families) of the family centroids matrix, 0 if absent integer(kind=int32), intent(out) :: n_shift_vectors_rows Rows of the shift vectors matrix, 0 if absent integer(kind=int32), intent(out) :: n_shift_vectors_cols Columns of the shift vectors matrix, 0 if absent integer(kind=int32), intent(out) :: ierr Error code","tags":"C-binding","url":"proc/get_tox_data_dims.html"},{"title":"read_tox_data_into – TensorOmics","text":"public  subroutine read_tox_data_into(zip_filename, n_gene_ids, gene_id_len, gene_ids, n_expression_rows, n_expression_cols, expression, n_gene_to_family, gene_to_family, n_family_ids, family_id_len, family_ids, n_family_centroids_rows, n_family_centroids_cols, family_centroids, n_shift_vectors_rows, n_shift_vectors_cols, shift_vectors, ierr) Fills every buffer from the archive; size them from get_tox_data_dims first. A member that is absent\nhas a zero extent and is left untouched. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: zip_filename Name of the zip file integer(kind=int32), intent(in) :: n_gene_ids Number of gene ids.\nIt is VERY IMPORTANT to compute this argument from the n_gene_ids output produced by get_tox_data_dims . integer(kind=int32), intent(in) :: gene_id_len String length of each gene id.\nIt is VERY IMPORTANT to compute this argument from the gene_id_len output produced by get_tox_data_dims . character(len=gene_id_len), intent(out), dimension(n_gene_ids) :: gene_ids Gene ids integer(kind=int32), intent(in) :: n_expression_rows Rows (samples) of the expression matrix.\nIt is VERY IMPORTANT to compute this argument from the n_expression_rows output produced by get_tox_data_dims . integer(kind=int32), intent(in) :: n_expression_cols Columns (genes) of the expression matrix.\nIt is VERY IMPORTANT to compute this argument from the n_expression_cols output produced by get_tox_data_dims . real(kind=real64), intent(out), dimension(n_expression_rows, n_expression_cols) :: expression Expression vectors integer(kind=int32), intent(in) :: n_gene_to_family Number of gene-to-family entries.\nIt is VERY IMPORTANT to compute this argument from the n_gene_to_family output produced by get_tox_data_dims . integer(kind=int32), intent(out), dimension(n_gene_to_family) :: gene_to_family Gene to family mapping integer(kind=int32), intent(in) :: n_family_ids Number of family ids.\nIt is VERY IMPORTANT to compute this argument from the n_family_ids output produced by get_tox_data_dims . integer(kind=int32), intent(in) :: family_id_len String length of each family id.\nIt is VERY IMPORTANT to compute this argument from the family_id_len output produced by get_tox_data_dims . character(len=family_id_len), intent(out), dimension(n_family_ids) :: family_ids Family ids integer(kind=int32), intent(in) :: n_family_centroids_rows Rows (samples) of the family centroids matrix.\nIt is VERY IMPORTANT to compute this argument from the n_family_centroids_rows output produced by get_tox_data_dims . integer(kind=int32), intent(in) :: n_family_centroids_cols Columns (families) of the family centroids matrix.\nIt is VERY IMPORTANT to compute this argument from the n_family_centroids_cols output produced by get_tox_data_dims . real(kind=real64), intent(out), dimension(n_family_centroids_rows, n_family_centroids_cols) :: family_centroids Family centroids integer(kind=int32), intent(in) :: n_shift_vectors_rows Rows of the shift vectors matrix.\nIt is VERY IMPORTANT to compute this argument from the n_shift_vectors_rows output produced by get_tox_data_dims . integer(kind=int32), intent(in) :: n_shift_vectors_cols Columns of the shift vectors matrix.\nIt is VERY IMPORTANT to compute this argument from the n_shift_vectors_cols output produced by get_tox_data_dims . real(kind=real64), intent(out), dimension(n_shift_vectors_rows, n_shift_vectors_cols) :: shift_vectors Shift vectors integer(kind=int32), intent(out) :: ierr Error code","tags":"C-binding","url":"proc/read_tox_data_into.html"},{"title":"malloc – TensorOmics","text":"interface public  function malloc(size) bind(C, name=\"malloc\") Arguments Type Intent Optional Attributes Name integer(kind=c_size_t), value :: size Return Value type(c_ptr)","tags":"","url":"interface/malloc.html"},{"title":"zip_open – TensorOmics","text":"interface public  function zip_open(path, flags, errorp) bind(C, name=\"zip_open\") Arguments Type Intent Optional Attributes Name character(kind=c_char, len=1), dimension(*) :: path integer(kind=c_int), value :: flags integer(kind=c_int), intent(out) :: errorp Return Value type(c_ptr)","tags":"","url":"interface/zip_open.html"},{"title":"zip_close – TensorOmics","text":"interface public  function zip_close(archive) bind(C, name=\"zip_close\") Arguments Type Intent Optional Attributes Name type(c_ptr), value :: archive Return Value integer(kind=c_int)","tags":"","url":"interface/zip_close.html"},{"title":"zip_file_add – TensorOmics","text":"interface public  function zip_file_add(archive, name, source, flags) bind(C, name=\"zip_file_add\") Arguments Type Intent Optional Attributes Name type(c_ptr), value :: archive character(kind=c_char, len=1), dimension(*) :: name type(c_ptr), value :: source integer(kind=c_int), value :: flags Return Value integer(kind=c_int64_t)","tags":"","url":"interface/zip_file_add.html"},{"title":"zip_source_buffer – TensorOmics","text":"interface public  function zip_source_buffer(archive, data, len, freep) bind(C, name=\"zip_source_buffer\") Arguments Type Intent Optional Attributes Name type(c_ptr), value :: archive type(c_ptr), value :: data integer(kind=c_size_t), value :: len integer(kind=c_int), value :: freep Return Value type(c_ptr)","tags":"","url":"interface/zip_source_buffer.html"},{"title":"zip_set_file_compression – TensorOmics","text":"interface public  function zip_set_file_compression(archive, index, comp, flags) bind(C, name=\"zip_set_file_compression\") Arguments Type Intent Optional Attributes Name type(c_ptr), value :: archive integer(kind=c_int64_t), value :: index integer(kind=c_int), value :: comp integer(kind=c_int), value :: flags Return Value integer(kind=c_int)","tags":"","url":"interface/zip_set_file_compression.html"},{"title":"zip_fopen – TensorOmics","text":"interface public  function zip_fopen(archive, fname, flags) bind(C, name=\"zip_fopen\") Arguments Type Intent Optional Attributes Name type(c_ptr), value :: archive character(kind=c_char, len=1), dimension(*) :: fname integer(kind=c_int), value :: flags Return Value type(c_ptr)","tags":"","url":"interface/zip_fopen.html"},{"title":"zip_fread – TensorOmics","text":"interface public  function zip_fread(file, buf, nbytes) bind(C, name=\"zip_fread\") Arguments Type Intent Optional Attributes Name type(c_ptr), value :: file type(c_ptr), value :: buf integer(kind=c_size_t), value :: nbytes Return Value integer(kind=c_int64_t)","tags":"","url":"interface/zip_fread.html"},{"title":"zip_fclose – TensorOmics","text":"interface public  function zip_fclose(file) bind(C, name=\"zip_fclose\") Arguments Type Intent Optional Attributes Name type(c_ptr), value :: file Return Value integer(kind=c_int)","tags":"","url":"interface/zip_fclose.html"},{"title":"zip_get_num_entries – TensorOmics","text":"interface public  function zip_get_num_entries(archive, flags) bind(C, name=\"zip_get_num_entries\") Arguments Type Intent Optional Attributes Name type(c_ptr), value :: archive integer(kind=c_int), value :: flags Return Value integer(kind=c_int64_t)","tags":"","url":"interface/zip_get_num_entries.html"},{"title":"zip_get_name – TensorOmics","text":"interface public  function zip_get_name(archive, index, flags) bind(C, name=\"zip_get_name\") Arguments Type Intent Optional Attributes Name type(c_ptr), value :: archive integer(kind=c_int64_t), value :: index integer(kind=c_int), value :: flags Return Value type(c_ptr)","tags":"","url":"interface/zip_get_name.html"},{"title":"free – TensorOmics","text":"interface public  subroutine free(ptr) bind(C, name=\"free\") Arguments Type Intent Optional Attributes Name type(c_ptr), value :: ptr","tags":"","url":"interface/free.html"},{"title":"zip_source_free – TensorOmics","text":"interface public  subroutine zip_source_free(source) bind(C, name=\"zip_source_free\") Arguments Type Intent Optional Attributes Name type(c_ptr), value :: source","tags":"","url":"interface/zip_source_free.html"},{"title":"euclidean_distance_impl – TensorOmics","text":"public pure subroutine euclidean_distance_impl(vec1, vec2, n_elements, result) Calculates the L2 norm: result = sqrt(sum((vec1_i - vec2_i)**2)) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_elements) :: vec1 First expression vector real(kind=real64), intent(in), dimension(n_elements) :: vec2 Second expression vector integer(kind=int32), intent(in) :: n_elements Dimension of both vectors real(kind=real64), intent(out) :: result Output scalar distance","tags":"","url":"proc/euclidean_distance_impl.html"},{"title":"distance_to_centroid_impl – TensorOmics","text":"public pure subroutine distance_to_centroid_impl(n_genes, n_families, genes, centroids, gene_to_fam, distances, n_tissues) For each gene, extracts its expression vector and the centroid of its assigned family, then computes the Euclidean distance between them. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Total number of genes integer(kind=int32), intent(in) :: n_families Total number of gene families real(kind=real64), intent(in), dimension(n_tissues, n_genes) :: genes Gene expression matrix (n_tissues × n_genes), column-major real(kind=real64), intent(in), dimension(n_tissues, n_families) :: centroids Family centroid matrix (n_tissues × n_families), column-major, -1.0_real64 for unassigned genes integer(kind=int32), intent(in), dimension(n_genes) :: gene_to_fam Index mapping -> each index i holds the family index for the corresponding gene in genes , using 0_int32 for unassigned genes\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_families .\nThe value 0_int32 is additionally accepted. real(kind=real64), intent(out), dimension(n_genes) :: distances Output distances array integer(kind=int32), intent(in) :: n_tissues Expression vector dimension","tags":"","url":"proc/distance_to_centroid_impl.html"},{"title":"loess_smooth_2d – TensorOmics","text":"public pure subroutine loess_smooth_2d(n_total, n_target, x_ref, y_ref, indices_used, n_used, x_query, kernel_sigma, kernel_cutoff, y_out, ierr) Smooths y_ref at x_query using reference points x_ref , y_ref , and kernel parameters.\nThe user must pre-filter data and provide only valid indices in indices_used. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_total Total number of reference points. integer(kind=int32), intent(in) :: n_target Number of target points to smooth. real(kind=real64), intent(in), dimension(n_total) :: x_ref Reference x-coordinates. real(kind=real64), intent(in), dimension(n_total) :: y_ref Reference y-coordinates (length n_total). integer(kind=int32), intent(in), dimension(n_used) :: indices_used Indices of reference points used for smoothing (only valid indices).\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_total . integer(kind=int32), intent(in) :: n_used Number of indices actually used for smoothing. real(kind=real64), intent(in), dimension(n_target) :: x_query Target x-coordinates to smooth. real(kind=real64), intent(in) :: kernel_sigma Bandwidth parameter for the kernel.\nThe minimum valid value is 0.0_real64 . real(kind=real64), intent(in) :: kernel_cutoff Cutoff for the kernel, not used if zero\nThe minimum valid value is 0.0_real64 . real(kind=real64), intent(out), dimension(n_target) :: y_out Output smoothed values (length n_target). integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/loess_smooth_2d.html"},{"title":"compute_edf – TensorOmics","text":"public pure subroutine compute_edf(values, n_values, unique_values, cdf_values, n_unique, ierr) Returns the sorted unique values and their cumulative frequencies in [0,1].\nThe number of unique values can be determined by finding the last non-zero cdf_value. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_values) :: values Array of observed data values (e.g., contributions or spikes). integer(kind=int32), intent(in) :: n_values Number of values in the input array. real(kind=real64), intent(out), dimension(n_values) :: unique_values Sorted unique data values.\nThe first n_unique elements will hold the results. real(kind=real64), intent(out), dimension(n_values) :: cdf_values Corresponding cumulative frequencies between 0 and 1.\nThe first n_unique elements will hold the results. integer(kind=int32), intent(out) :: n_unique Number of unique values found (actual size of output arrays) integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/compute_edf.html"},{"title":"compute_edf_expert – TensorOmics","text":"public pure subroutine compute_edf_expert(values, n_values, values_perm, unique_values, cdf_values, n_unique, ierr) Returns the sorted unique values and their cumulative frequencies in [0,1].\nThe number of unique values can be determined by finding the last non-zero cdf_value. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_values) :: values Array of observed data values (e.g., contributions or spikes). integer(kind=int32), intent(in) :: n_values Number of values in the input array. integer(kind=int32), intent(in), dimension(n_values) :: values_perm Permutation of values in ascending order. The allocating entry point builds\nand heapsorts it for you; the expert one takes whatever order you supply.\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_values . real(kind=real64), intent(out), dimension(n_values) :: unique_values Sorted unique data values.\nThe first n_unique elements will hold the results. real(kind=real64), intent(out), dimension(n_values) :: cdf_values Corresponding cumulative frequencies between 0 and 1.\nThe first n_unique elements will hold the results. integer(kind=int32), intent(out) :: n_unique Number of unique values found (actual size of output arrays) integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/compute_edf_expert.html"},{"title":"calc_percentile – TensorOmics","text":"public pure subroutine calc_percentile(array, n_array, percentile, value, n_considered, ierr) Uses linear interpolation between adjacent values. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_array) :: array input array integer(kind=int32), intent(in) :: n_array number of elements in array real(kind=real64), intent(in) :: percentile desired percentile as a fraction in [0,1] (e.g. 0.95 for the 95th percentile)\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 . real(kind=real64), intent(out) :: value output percentile value integer(kind=int32), intent(in), optional :: n_considered How many leading entries of array_perm the percentile is taken over, for a\npercentile of a subset -- the trailing entries are ignored rather than sliced\noff, so the permutation stays the shape the sort produced. Zero, the default,\nconsiders all n_array of them.\nThe default value is 0_int32 .\nThe minimum valid value is 0_int32 .\nThe maximum valid value is n_array . integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/calc_percentile.html"},{"title":"calc_percentile_expert – TensorOmics","text":"public pure subroutine calc_percentile_expert(array, n_array, array_perm, percentile, value, n_considered, ierr) Uses linear interpolation between adjacent values. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_array) :: array input array integer(kind=int32), intent(in) :: n_array number of elements in array integer(kind=int32), intent(in), dimension(n_array) :: array_perm Permutation of array in ascending order. The allocating entry point builds and\nheapsorts it for you; the expert one takes whatever order you supply.\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_array . real(kind=real64), intent(in) :: percentile desired percentile as a fraction in [0,1] (e.g. 0.95 for the 95th percentile)\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 . real(kind=real64), intent(out) :: value output percentile value integer(kind=int32), intent(in), optional :: n_considered How many leading entries of array_perm the percentile is taken over, for a\npercentile of a subset -- the trailing entries are ignored rather than sliced\noff, so the permutation stays the shape the sort produced. Zero, the default,\nconsiders all n_array of them.\nThe default value is 0_int32 .\nThe minimum valid value is 0_int32 .\nThe maximum valid value is n_array . integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/calc_percentile_expert.html"},{"title":"compute_scaled_distance_quantile – TensorOmics","text":"public pure subroutine compute_scaled_distance_quantile(n_genes, rdi, sorted_rdi, quantile, c_const, ierr) This is NOT a null-hypothesis-testing p-value: each distance is compared against the\nobserved distribution it was drawn from, not an independently generated null distribution.\nIt instead measures how extreme an observed distance is relative to all observed distances. Implements:\nQ(d) = ( #{di in D | di >= d} + c ) / ( |D| + c ) Because distances are non-negative, a one-sided upper-tail quantile is used. Assumptions / preconditions:\n- sorted_rdi(1:n_genes) contains the empirical distribution D.\n- If invalid RDIs exist (negative), they should already be mapped to 0 in the distribution Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Number of genes being processed. real(kind=real64), intent(in), dimension(n_genes) :: rdi empirical distribution D\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(in), dimension(n_genes) :: sorted_rdi empirical distribution D with non negative values\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(out), dimension(n_genes) :: quantile Output array to store the computed quantile for each gene. real(kind=real64), intent(in) :: c_const Constant used in the computation, typically 1 integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/compute_scaled_distance_quantile.html"},{"title":"compute_scaled_distance_quantile_expert – TensorOmics","text":"public pure subroutine compute_scaled_distance_quantile_expert(n_genes, rdi, sorted_rdi, sorted_rdi_perm, quantile, c_const, ierr) This is NOT a null-hypothesis-testing p-value: each distance is compared against the\nobserved distribution it was drawn from, not an independently generated null distribution.\nIt instead measures how extreme an observed distance is relative to all observed distances. Implements:\nQ(d) = ( #{di in D | di >= d} + c ) / ( |D| + c ) Because distances are non-negative, a one-sided upper-tail quantile is used. Assumptions / preconditions:\n- sorted_rdi(1:n_genes) contains the empirical distribution D.\n- If invalid RDIs exist (negative), they should already be mapped to 0 in the distribution Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Number of genes being processed. real(kind=real64), intent(in), dimension(n_genes) :: rdi empirical distribution D\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(in), dimension(n_genes) :: sorted_rdi empirical distribution D with non negative values\nNaN is permitted for this value.\nInfinite values are permitted for this value. integer(kind=int32), intent(in), dimension(n_genes) :: sorted_rdi_perm Permutation of sorted_rdi in ascending order. The allocating entry point builds\nand heapsorts it for you; the expert one takes whatever order you supply.\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_genes . real(kind=real64), intent(out), dimension(n_genes) :: quantile Output array to store the computed quantile for each gene. real(kind=real64), intent(in) :: c_const Constant used in the computation, typically 1 integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/compute_scaled_distance_quantile_expert.html"},{"title":"tox_loess_required_workspace_c – TensorOmics","text":"public  subroutine tox_loess_required_workspace_c(n_dim, max_neighborhood_size, int_workspace_size, real_workspace_size, save_factorization, ierr) bind(C, name=\"tox_loess_required_workspace_c\") Uses tox_loess_impl Computes the required sizes for integer and real workspace arrays.\nThese sizes depend on the dimensionality of the data and the maximum neighborhood size. Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_dim Dimensionality of the data integer(kind=c_int), intent(in), target :: max_neighborhood_size Maximum neighborhood size integer(kind=c_int), intent(out), target :: int_workspace_size Required size of the integer workspace array integer(kind=c_int), intent(out), target :: real_workspace_size Required size of the real workspace array logical(kind=c_bool), intent(in), target :: save_factorization Save matrix factorization flag integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"proc/tox_loess_required_workspace_c.html"},{"title":"get_gene_index – TensorOmics","text":"public  function get_gene_index(gene_ids, gene) result(idx) Helper function to find gene index Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: gene_ids (:) gene ids array character(len=*), intent(in) :: gene gene to look for Return Value integer(kind=int32)","tags":"","url":"proc/get_gene_index.html"},{"title":"get_family_index – TensorOmics","text":"public  function get_family_index(family_ids, family) result(idx) Helper function to find family index Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: family_ids (:) family ids array character(len=*), intent(in) :: family family to look for Return Value integer(kind=int32)","tags":"","url":"proc/get_family_index.html"},{"title":"get_family_for_gene_index – TensorOmics","text":"public  subroutine get_family_for_gene_index(gene_idx, gene_to_fam, out_family_idx, ierr) returns family index for gene index Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: gene_idx gene index integer(kind=int32), intent(in) :: gene_to_fam (:) gene to family mapping integer(kind=int32), intent(out) :: out_family_idx family index integer(kind=int32), intent(out) :: ierr error code","tags":"","url":"proc/get_family_for_gene_index.html"},{"title":"get_expression_vector – TensorOmics","text":"public  subroutine get_expression_vector(gene_idx, expression_vectors, out_vector, ierr) get expression vector for a specific gene id Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: gene_idx target gene index real(kind=real64), intent(in) :: expression_vectors (:,:) expression vectors real(kind=real64), intent(out) :: out_vector (:) output vector integer(kind=int32), intent(out) :: ierr error code","tags":"","url":"proc/get_expression_vector.html"},{"title":"get_family_centroid – TensorOmics","text":"public  subroutine get_family_centroid(family_idx, family_centroids, out_centroid, ierr) get family centroid for a specific family index Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: family_idx Target index real(kind=real64), intent(in) :: family_centroids (:,:) centroid array real(kind=real64), intent(out) :: out_centroid (:) Output centroid integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/get_family_centroid.html"},{"title":"get_shift_components – TensorOmics","text":"public  subroutine get_shift_components(gene_idx, shift_vectors, d, out_start, out_shift, ierr) returns the centroid and the shift of a gene Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: gene_idx gene index to look for real(kind=real64), intent(in) :: shift_vectors (:,:) shift vectors integer(kind=int32), intent(in) :: d number of tissues real(kind=real64), intent(out) :: out_start (:) centroid of the genes family real(kind=real64), intent(out) :: out_shift (:) shift vector of the gene integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/get_shift_components.html"},{"title":"normalize_unit_length – TensorOmics","text":"public pure subroutine normalize_unit_length(vector, n_dims, ierr) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(inout), dimension(n_dims) :: vector Vector that will be normalized to unit length\nNaN is permitted for this value.\nInfinite values are permitted for this value. integer(kind=int32), intent(in) :: n_dims number of elements in vector integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/normalize_unit_length.html"},{"title":"normalization_pipeline – TensorOmics","text":"public  subroutine normalization_pipeline(n_genes, n_replicates, expr, log_transformed_expr, reps_per_tissue, n_tissues, span, degree, use_quantile, ierr) Final result is in log_transformed_expr. If fold change is needed, call calc_fchange separately. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Number of genes (rows) integer(kind=int32), intent(in) :: n_replicates Number of replicates per gene real(kind=real64), intent(in), dimension(n_replicates, n_genes) :: expr Gene Expression matrix\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(out), dimension(n_tissues, n_genes) :: log_transformed_expr Log-transformed grouped expr integer(kind=int32), intent(in), dimension(n_tissues) :: reps_per_tissue Number of replicates per tissue in expr . It describes, which slices in expr relate to which tissue,\ne.g. [2,3] means 5 total replicates per gene, the first two of which belong to the first tissue and the remaining three to the second. integer(kind=int32), intent(in) :: n_tissues Number of tissues real(kind=real64), intent(in), optional :: span LOESS span parameter.\nThe default value is 0.7_real64 . integer(kind=int32), intent(in), optional :: degree LOESS degree parameter.\nThe default value is 2_int32 . logical(kind=c_bool), intent(in), optional :: use_quantile Use quantile normalization.\nThe default value is .false. . integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/normalization_pipeline.html"},{"title":"normalization_pipeline_expert – TensorOmics","text":"public  subroutine normalization_pipeline_expert(n_genes, n_replicates, expr, log_transformed_expr, reps_per_tissue, n_tissues, tmp_expr_copy, tmp_loess_y, tmp_indices_used, tmp_yhat_global, tmp_int_workspace, int_workspace_size, tmp_real_workspace, real_workspace_size, tmp_hat_diag, tmp_loess_weights, tmp_eval_points, tmp_robust_weights, tmp_combined_weights, tmp_residuals, tmp_permutation_indices, span, degree, use_quantile, ierr) Final result is in log_transformed_expr. If fold change is needed, call calc_fchange separately. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Number of genes (rows) integer(kind=int32), intent(in) :: n_replicates Number of replicates per gene real(kind=real64), intent(in), dimension(n_replicates, n_genes) :: expr Gene Expression matrix\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(out), dimension(n_tissues, n_genes) :: log_transformed_expr Log-transformed grouped expr integer(kind=int32), intent(in), dimension(n_tissues) :: reps_per_tissue Number of replicates per tissue in expr . It describes, which slices in expr relate to which tissue,\ne.g. [2,3] means 5 total replicates per gene, the first two of which belong to the first tissue and the remaining three to the second. integer(kind=int32), intent(in) :: n_tissues Number of tissues real(kind=real64), intent(out), dimension(n_replicates, n_genes) :: tmp_expr_copy Work matrix the pipeline normalizes in place real(kind=real64), intent(out), dimension(n_genes) :: tmp_loess_y Work vector for the empirical standard deviations (Y-axis for LOESS) integer(kind=int32), intent(out), dimension(n_genes) :: tmp_indices_used Work vector mapping the fitted points back to gene indices real(kind=real64), intent(out), dimension(n_genes) :: tmp_yhat_global Work vector for the fitted standard deviations (LOESS predictions) integer(kind=int32), intent(out), dimension(int_workspace_size) :: tmp_int_workspace Integer workspace array integer(kind=int32), intent(in) :: int_workspace_size Length of integer workspace.\nIt is VERY IMPORTANT to compute this argument from the int_workspace_size output produced by tox_loess_required_workspace . Producer input Supplied by n_dim 1_int32 max_neighborhood_size n_genes save_factorization .false. real(kind=real64), intent(out), dimension(real_workspace_size) :: tmp_real_workspace Real workspace array integer(kind=int32), intent(in) :: real_workspace_size Length of real workspace.\nIt is VERY IMPORTANT to compute this argument from the real_workspace_size output produced by tox_loess_required_workspace . Producer input Supplied by n_dim 1_int32 max_neighborhood_size n_genes save_factorization .false. real(kind=real64), intent(out), dimension(n_genes) :: tmp_hat_diag Diagonal elements of the LOESS hat matrix real(kind=real64), intent(out), dimension(n_genes) :: tmp_loess_weights Per-point weights handed to the LOESS fit real(kind=real64), intent(out), dimension(n_genes, 1) :: tmp_eval_points Points the fitted curve is evaluated at real(kind=real64), intent(out), dimension(n_genes) :: tmp_robust_weights Robust bisquare weights of the LOESS fit real(kind=real64), intent(out), dimension(n_genes) :: tmp_combined_weights Combined weights of the LOESS fit real(kind=real64), intent(out), dimension(n_genes) :: tmp_residuals Residuals of the LOESS fit integer(kind=int32), intent(out), dimension(n_genes) :: tmp_permutation_indices Permutation indices of the LOESS fit real(kind=real64), intent(in), optional :: span LOESS span parameter.\nThe default value is 0.7_real64 . integer(kind=int32), intent(in), optional :: degree LOESS degree parameter.\nThe default value is 2_int32 . logical(kind=c_bool), intent(in), optional :: use_quantile Use quantile normalization.\nThe default value is .false. . integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/normalization_pipeline_expert.html"},{"title":"normalize_by_std_dev – TensorOmics","text":"public  subroutine normalize_by_std_dev(n_genes, n_replicates, expr, normalized_expr, span, degree, ierr) This procedure applies a global stabilization based on the relationship between\ngene-wise mean expression and empirical standard deviation. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Number of genes (rows) integer(kind=int32), intent(in) :: n_replicates Number of replicates per gene real(kind=real64), intent(in), dimension(n_replicates, n_genes) :: expr Gene Expression matrix\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(out), dimension(n_replicates, n_genes) :: normalized_expr Normalized expr real(kind=real64), intent(in), optional :: span LOESS span parameter.\nThe default value is 0.7_real64 . integer(kind=int32), intent(in), optional :: degree LOESS degree parameter.\nThe default value is 2_int32 . integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/normalize_by_std_dev.html"},{"title":"normalize_by_std_dev_expert – TensorOmics","text":"public  subroutine normalize_by_std_dev_expert(n_genes, n_replicates, expr, normalized_expr, tmp_loess_x, tmp_loess_y, tmp_indices_used, tmp_yhat_global, tmp_int_workspace, int_workspace_size, tmp_real_workspace, real_workspace_size, tmp_hat_diag, tmp_loess_weights, tmp_eval_points, tmp_robust_weights, tmp_combined_weights, tmp_residuals, tmp_permutation_indices, span, degree, ierr) This procedure applies a global stabilization based on the relationship between\ngene-wise mean expression and empirical standard deviation. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Number of genes (rows) integer(kind=int32), intent(in) :: n_replicates Number of replicates per gene real(kind=real64), intent(in), dimension(n_replicates, n_genes) :: expr Gene Expression matrix\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(out), dimension(n_replicates, n_genes) :: normalized_expr Normalized expr real(kind=real64), intent(out), dimension(n_genes) :: tmp_loess_x Work vector for the mean values (X-axis for LOESS) real(kind=real64), intent(out), dimension(n_genes) :: tmp_loess_y Work vector for the empirical standard deviations (Y-axis for LOESS) integer(kind=int32), intent(out), dimension(n_genes) :: tmp_indices_used Work vector mapping the fitted points back to gene indices real(kind=real64), intent(out), dimension(n_genes) :: tmp_yhat_global Work vector for the fitted standard deviations (LOESS predictions) integer(kind=int32), intent(out), dimension(int_workspace_size) :: tmp_int_workspace Integer workspace array integer(kind=int32), intent(in) :: int_workspace_size Length of integer workspace.\nIt is VERY IMPORTANT to compute this argument from the int_workspace_size output produced by tox_loess_required_workspace . Producer input Supplied by n_dim 1_int32 max_neighborhood_size n_genes save_factorization .false. real(kind=real64), intent(out), dimension(real_workspace_size) :: tmp_real_workspace Real workspace array integer(kind=int32), intent(in) :: real_workspace_size Length of real workspace.\nIt is VERY IMPORTANT to compute this argument from the real_workspace_size output produced by tox_loess_required_workspace . Producer input Supplied by n_dim 1_int32 max_neighborhood_size n_genes save_factorization .false. real(kind=real64), intent(out), dimension(n_genes) :: tmp_hat_diag Diagonal elements of the LOESS hat matrix real(kind=real64), intent(out), dimension(n_genes) :: tmp_loess_weights Per-point weights handed to the LOESS fit real(kind=real64), intent(out), dimension(n_genes, 1) :: tmp_eval_points Points the fitted curve is evaluated at real(kind=real64), intent(out), dimension(n_genes) :: tmp_robust_weights Robust bisquare weights of the LOESS fit real(kind=real64), intent(out), dimension(n_genes) :: tmp_combined_weights Combined weights of the LOESS fit real(kind=real64), intent(out), dimension(n_genes) :: tmp_residuals Residuals of the LOESS fit integer(kind=int32), intent(out), dimension(n_genes) :: tmp_permutation_indices Permutation indices of the LOESS fit real(kind=real64), intent(in), optional :: span LOESS span parameter.\nThe default value is 0.7_real64 . integer(kind=int32), intent(in), optional :: degree LOESS degree parameter.\nThe default value is 2_int32 . integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/normalize_by_std_dev_expert.html"},{"title":"root_mean_sq_normalization – TensorOmics","text":"public pure subroutine root_mean_sq_normalization(n_genes, n_replicates, expr, normalized_expr, ierr) across tissues (not classical standard deviation). Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Number of genes (rows) integer(kind=int32), intent(in) :: n_replicates Number of replicates per gene real(kind=real64), intent(in), dimension(n_replicates, n_genes) :: expr Gene Expression matrix\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(out), dimension(n_replicates, n_genes) :: normalized_expr Normalized expr integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/root_mean_sq_normalization.html"},{"title":"quantile_normalization – TensorOmics","text":"public pure subroutine quantile_normalization(n_genes, n_replicates, expr, normalized_expr, rank_means, ierr) Computes average expression per rank across tissues. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Number of genes (rows) integer(kind=int32), intent(in) :: n_replicates Number of replicates per gene real(kind=real64), intent(in), dimension(n_replicates, n_genes) :: expr Gene Expression matrix\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(out), dimension(n_replicates, n_genes) :: normalized_expr Normalized expr real(kind=real64), intent(out), dimension(n_genes) :: rank_means The mean of each rank across tissues, one per gene integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/quantile_normalization.html"},{"title":"quantile_normalization_expert – TensorOmics","text":"public pure subroutine quantile_normalization_expert(n_genes, n_replicates, expr, normalized_expr, rank_means, tmp_genes_row, tmp_perm, ierr) Computes average expression per rank across tissues. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Number of genes (rows) integer(kind=int32), intent(in) :: n_replicates Number of replicates per gene real(kind=real64), intent(in), dimension(n_replicates, n_genes) :: expr Gene Expression matrix\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(out), dimension(n_replicates, n_genes) :: normalized_expr Normalized expr real(kind=real64), intent(out), dimension(n_genes) :: rank_means The mean of each rank across tissues, one per gene real(kind=real64), intent(out), dimension(n_genes) :: tmp_genes_row Temporary vector for sorting a tissue in expr across genes integer(kind=int32), intent(out), dimension(n_genes) :: tmp_perm Permutation vector integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/quantile_normalization_expert.html"},{"title":"log2_transformation – TensorOmics","text":"public pure subroutine log2_transformation(n_genes, n_tissues, expr, transformed_expr, ierr) This subroutine performs element-wise log2(x + 1) transformation on a\nmatrix flattened in column-major order. The log2 is computed via: log(x + 1) / log(2) , which is numerically equivalent and avoids the\nnon-portable log2 intrinsic for compatibility with WebAssembly (WASM). Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Number of genes (rows) integer(kind=int32), intent(in) :: n_tissues Number of tissues real(kind=real64), intent(in), dimension(n_tissues, n_genes) :: expr Gene Expression matrix, from calc_tiss_avg NaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(out), dimension(n_tissues, n_genes) :: transformed_expr Log-transformed expr integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/log2_transformation.html"},{"title":"calc_tiss_avg – TensorOmics","text":"public pure subroutine calc_tiss_avg(n_genes, n_tissues, reps_per_tissue, expr, tissue_averages, ierr) For each tissue of tissue replicates, this subroutine computes the average\nexpression per gene. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Number of genes (rows) integer(kind=int32), intent(in) :: n_tissues Number of tissues integer(kind=int32), intent(in), dimension(n_tissues) :: reps_per_tissue Number of replicates per tissue in expr . It describes, which slices in expr relate to which tissue,\ne.g. [2,3] means 5 total replicates per gene, the first two of which belong to the first tissue and the remaining three to the second.\nThe minimum valid value is 1_int32 . real(kind=real64), intent(in), dimension(sum(reps_per_tissue), n_genes) :: expr Gene Expression matrix\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(out), dimension(n_tissues, n_genes) :: tissue_averages Tissue averages per gene integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/calc_tiss_avg.html"},{"title":"calc_fchange – TensorOmics","text":"public pure subroutine calc_fchange(n_genes, n_tissues, n_pairs, control_tissues, condition_tissues, expr, fold_changes, ierr) For each control-condition pair, this subroutine computes the log2 fold change by subtracting the expression value in the control group from the corresponding\nvalue in the condition group, for all genes. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Number of genes (rows) integer(kind=int32), intent(in) :: n_tissues Number of tissues integer(kind=int32), intent(in) :: n_pairs Number of control-condition pairs integer(kind=int32), intent(in), dimension(n_pairs) :: control_tissues Control tissue indices\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_tissues . integer(kind=int32), intent(in), dimension(n_pairs) :: condition_tissues Condition tissue indices\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_tissues . real(kind=real64), intent(in), dimension(n_tissues, n_genes) :: expr Gene Expression matrix, from calc_tiss_avg NaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(out), dimension(n_pairs, n_genes) :: fold_changes Output matrix for fold changes integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/calc_fchange.html"},{"title":"serialize_char_helper_c – TensorOmics","text":"public  subroutine serialize_char_helper_c(arr, arr_strlen, n_strings, arr_shape, n_arr_shape_elements, filename, filename_strlen, ierr) bind(C, name=\"serialize_char_helper_c\") Uses f42_serde_arrays_serialize_char Arguments Type Intent Optional Attributes Name character(kind=c_char, len=1), intent(in), dimension(arr_strlen, *), target :: arr Array to be serialized integer(kind=c_int), intent(in), target :: arr_strlen length of the strings in arr integer(kind=c_int), intent(in), target :: n_strings Number of strings in arr integer(kind=c_int), intent(in), dimension(n_arr_shape_elements), target :: arr_shape Extents of arr , one per dimension integer(kind=c_int), intent(in), target :: n_arr_shape_elements number of elements in arr_shape character(kind=c_char, len=1), intent(in), dimension(filename_strlen), target :: filename Name of the file to write to integer(kind=c_int), intent(in), target :: filename_strlen length of the strings in filename integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"proc/serialize_char_helper_c.html"},{"title":"normalize_variable_timeseries – TensorOmics","text":"public pure subroutine normalize_variable_timeseries(v, v_norm, n_points, status, ierr) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_points) :: v Original time series real(kind=real64), intent(out), dimension(n_points) :: v_norm Normalized time series integer(kind=int32), intent(in) :: n_points Vector length (number of time points) integer(kind=int32), intent(out) :: status Status code for specific warnings integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/normalize_variable_timeseries.html"},{"title":"normalize_single_trajectory – TensorOmics","text":"public pure subroutine normalize_single_trajectory(trajectory, trajectory_norm, n_factors, n_timepoints, status, ierr) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_timepoints, n_factors) :: trajectory Original trajectory for one sample real(kind=real64), intent(out), dimension(n_timepoints, n_factors) :: trajectory_norm Normalized trajectory for one sample integer(kind=int32), intent(in) :: n_factors Number of factors/variables integer(kind=int32), intent(in) :: n_timepoints Number of time points integer(kind=int32), intent(out), dimension(n_factors) :: status Status code for specific warnings, one per factor integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/normalize_single_trajectory.html"},{"title":"normalize_all_trajectories – TensorOmics","text":"public pure subroutine normalize_all_trajectories(trajectories, trajectories_norm, n_factors, n_samples, n_timepoints, status, ierr) independently across time for each sample. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_factors, n_samples, n_timepoints) :: trajectories Original trajectories real(kind=real64), intent(out), dimension(n_factors, n_samples, n_timepoints) :: trajectories_norm Normalized trajectories integer(kind=int32), intent(in) :: n_factors Number of factors integer(kind=int32), intent(in) :: n_samples Number of samples/entities integer(kind=int32), intent(in) :: n_timepoints Number of time points integer(kind=int32), intent(out), dimension(n_factors, n_samples) :: status Status code for specific warnings, one per factor per sample integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/normalize_all_trajectories.html"},{"title":"normalize_all_trajectories_expert – TensorOmics","text":"public pure subroutine normalize_all_trajectories_expert(trajectories, trajectories_norm, n_factors, n_samples, n_timepoints, tmp_series, tmp_series_norm, status, ierr) independently across time for each sample. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_factors, n_samples, n_timepoints) :: trajectories Original trajectories real(kind=real64), intent(out), dimension(n_factors, n_samples, n_timepoints) :: trajectories_norm Normalized trajectories integer(kind=int32), intent(in) :: n_factors Number of factors integer(kind=int32), intent(in) :: n_samples Number of samples/entities integer(kind=int32), intent(in) :: n_timepoints Number of time points real(kind=real64), intent(out), dimension(n_timepoints) :: tmp_series Work array: one factor's time series, gathered contiguously real(kind=real64), intent(out), dimension(n_timepoints) :: tmp_series_norm Work array: the normalized time series integer(kind=int32), intent(out), dimension(n_factors, n_samples) :: status Status code for specific warnings, one per factor per sample integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/normalize_all_trajectories_expert.html"},{"title":"compute_family_scaling_c – TensorOmics","text":"public  subroutine compute_family_scaling_c(n_genes, n_families, distances, gene_to_fam, dscale, loess_x, loess_y, indices_used, span, degree, mode, n_iters, low_sd_cutoff, excluded_low_sd, ierr) bind(C, name=\"compute_family_scaling_c\") Uses tox_get_outliers_impl tox_get_outliers Uses LOESS on the median/stddev of intra-family distances for scaling, regardless of orthologs. Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_genes Total number of genes integer(kind=c_int), intent(in), target :: n_families Total number of gene families real(kind=c_double), intent(in), dimension(n_genes), target :: distances Array of Euclidean distances for each gene\nNaN is permitted for this value.\nInfinite values are permitted for this value. integer(kind=c_int), intent(in), dimension(n_genes), target :: gene_to_fam Mapping of each gene to its family (1-based) real(kind=c_double), intent(out), dimension(n_families), target :: dscale Array of scaling factors per family (output) real(kind=c_double), intent(out), dimension(n_families), target :: loess_x Reference x-coordinates for LOESS smoothing real(kind=c_double), intent(out), dimension(n_families), target :: loess_y Reference y-coordinates for LOESS smoothing integer(kind=c_int), intent(out), dimension(n_families), target :: indices_used Indices of reference points used for smoothing real(kind=c_double), intent(in), target :: span Span parameter for LOESS smoothing, passed straight to loess_fit_plain_impl , so it is held to that\nprocedure's own range rather than to the NaN tolerance the distance data carries.\nThe default value is 0.7_real64 .\nThe minimum valid value is EPS_LOESS .\nThe maximum valid value is 1.0_real64 . integer(kind=c_int), intent(in), target :: degree Degree of the LOESS polynomial\nThe default value is 2_int32 . character(kind=c_char, len=1), intent(in), dimension(6), target :: mode Mode for LOESS fitting\nThe default value is 'robust' . Mode Value Plain LOESS fitting MODE_PLAIN Robust LOESS fitting MODE_ROBUST integer(kind=c_int), intent(in), target :: n_iters Number of iterations for robust LOESS fitting\nThe default value is 3_int32 . real(kind=c_double), intent(out), target :: low_sd_cutoff cutoff used to filter families with low std integer(kind=c_int), intent(out), dimension(n_families), target :: excluded_low_sd Mask to save those families that have low sd integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"proc/compute_family_scaling_c.html"},{"title":"compute_family_scaling_expert_c – TensorOmics","text":"public  subroutine compute_family_scaling_expert_c(n_genes, n_families, distances, gene_to_fam, dscale, loess_x, loess_y, indices_used, tmp_perm, tmp_stack_left, tmp_stack_right, tmp_int_workspace, int_workspace_size, tmp_real_workspace, real_workspace_size, tmp_diagl, tmp_weights, tmp_eval_points, tmp_robust_weights, tmp_combined_weights, tmp_residuals, tmp_permutation_indices, tmp_fitted_values, span, degree, mode, n_iters, low_sd_cutoff, excluded_low_sd, tmp_means_aux, ierr) bind(C, name=\"compute_family_scaling_expert_c\") Uses tox_get_outliers_impl tox_get_outliers Uses LOESS on the median/stddev of intra-family distances for scaling, regardless of orthologs. Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_genes Total number of genes integer(kind=c_int), intent(in), target :: n_families Total number of gene families real(kind=c_double), intent(in), dimension(n_genes), target :: distances Array of Euclidean distances for each gene\nNaN is permitted for this value.\nInfinite values are permitted for this value. integer(kind=c_int), intent(in), dimension(n_genes), target :: gene_to_fam Mapping of each gene to its family (1-based) real(kind=c_double), intent(out), dimension(n_families), target :: dscale Array of scaling factors per family (output) real(kind=c_double), intent(out), dimension(n_families), target :: loess_x Reference x-coordinates for LOESS smoothing real(kind=c_double), intent(out), dimension(n_families), target :: loess_y Reference y-coordinates for LOESS smoothing integer(kind=c_int), intent(out), dimension(n_families), target :: indices_used Indices of reference points used for smoothing integer(kind=c_int), intent(out), dimension(n_genes), target :: tmp_perm Permutation array for sorting gene distances integer(kind=c_int), intent(out), dimension(n_genes), target :: tmp_stack_left Stack array for left indices during sorting integer(kind=c_int), intent(out), dimension(n_genes), target :: tmp_stack_right Stack array for right indices during sorting integer(kind=c_int), intent(out), dimension(int_workspace_size), target :: tmp_int_workspace Integer workspace array integer(kind=c_int), intent(in), target :: int_workspace_size Length of integer workspace.\nIt is VERY IMPORTANT to compute this argument from the int_workspace_size output produced by tox_loess_required_workspace . Producer input Supplied by n_dim 1_int32 max_neighborhood_size n_families save_factorization .false. real(kind=c_double), intent(out), dimension(real_workspace_size), target :: tmp_real_workspace Real workspace array integer(kind=c_int), intent(in), target :: real_workspace_size Length of real workspace.\nIt is VERY IMPORTANT to compute this argument from the real_workspace_size output produced by tox_loess_required_workspace . Producer input Supplied by n_dim 1_int32 max_neighborhood_size n_families save_factorization .false. real(kind=c_double), intent(inout), dimension(n_families), target :: tmp_diagl Diagonal elements of the weight matrix real(kind=c_double), intent(out), dimension(n_families), target :: tmp_weights Initial weights for LOESS real(kind=c_double), intent(inout), dimension(n_families, 1), target :: tmp_eval_points Z matrix for LOESS fitting real(kind=c_double), intent(out), dimension(n_families), target :: tmp_robust_weights Residuals for robust LOESS fitting real(kind=c_double), intent(out), dimension(n_families), target :: tmp_combined_weights Working weights array real(kind=c_double), intent(out), dimension(n_families), target :: tmp_residuals Residuals array integer(kind=c_int), intent(out), dimension(n_families), target :: tmp_permutation_indices Permutation indices for robust LOESS fitting real(kind=c_double), intent(out), dimension(n_families), target :: tmp_fitted_values Output array for LOESS predictions real(kind=c_double), intent(in), target :: span Span parameter for LOESS smoothing, passed straight to loess_fit_plain_impl , so it is held to that\nprocedure's own range rather than to the NaN tolerance the distance data carries.\nThe default value is 0.7_real64 .\nThe minimum valid value is EPS_LOESS .\nThe maximum valid value is 1.0_real64 . integer(kind=c_int), intent(in), target :: degree Degree of the LOESS polynomial\nThe default value is 2_int32 . character(kind=c_char, len=1), intent(in), dimension(6), target :: mode Mode for LOESS fitting\nThe default value is 'robust' . Mode Value Plain LOESS fitting MODE_PLAIN Robust LOESS fitting MODE_ROBUST integer(kind=c_int), intent(in), target :: n_iters Number of iterations for robust LOESS fitting\nThe default value is 3_int32 . real(kind=c_double), intent(out), target :: low_sd_cutoff cutoff used to filter families with low std integer(kind=c_int), intent(out), dimension(n_families), target :: excluded_low_sd Mask to save those families that have low sd real(kind=c_double), intent(out), dimension(n_families), target :: tmp_means_aux Work array for saving raw means integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"proc/compute_family_scaling_expert_c.html"},{"title":"compute_rdi_c – TensorOmics","text":"public  subroutine compute_rdi_c(n_genes, distances, gene_to_fam, dscale, n_dscale_elements, rdi, sorted_rdi, perm, ierr) bind(C, name=\"compute_rdi_c\") Uses tox_get_outliers RDI = Euclidean distance / family scaling factor Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_genes Total number of genes real(kind=c_double), intent(in), dimension(n_genes), target :: distances Array of Euclidean distances for each gene to its centroid\nNaN is permitted for this value.\nInfinite values are permitted for this value. integer(kind=c_int), intent(in), dimension(n_genes), target :: gene_to_fam Gene-to-family mapping (1-based indexing) real(kind=c_double), intent(in), dimension(n_dscale_elements), target :: dscale Array of scaling factors for each family\nNaN is permitted for this value.\nInfinite values are permitted for this value. integer(kind=c_int), intent(in), target :: n_dscale_elements number of elements in dscale real(kind=c_double), intent(out), dimension(n_genes), target :: rdi Output array of RDI values for each gene real(kind=c_double), intent(out), dimension(n_genes), target :: sorted_rdi Work array for sorting (dimension n_genes) integer(kind=c_int), intent(out), dimension(n_genes), target :: perm Permutation array for sorting (dimension n_genes, should be pre-initialized with 1:n_genes) integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/compute_rdi_c.html"},{"title":"compute_rdi_expert_c – TensorOmics","text":"public  subroutine compute_rdi_expert_c(n_genes, distances, gene_to_fam, dscale, n_dscale_elements, rdi, sorted_rdi, perm, tmp_stack_left, tmp_stack_right, ierr) bind(C, name=\"compute_rdi_expert_c\") Uses tox_get_outliers RDI = Euclidean distance / family scaling factor Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_genes Total number of genes real(kind=c_double), intent(in), dimension(n_genes), target :: distances Array of Euclidean distances for each gene to its centroid\nNaN is permitted for this value.\nInfinite values are permitted for this value. integer(kind=c_int), intent(in), dimension(n_genes), target :: gene_to_fam Gene-to-family mapping (1-based indexing) real(kind=c_double), intent(in), dimension(n_dscale_elements), target :: dscale Array of scaling factors for each family\nNaN is permitted for this value.\nInfinite values are permitted for this value. integer(kind=c_int), intent(in), target :: n_dscale_elements number of elements in dscale real(kind=c_double), intent(out), dimension(n_genes), target :: rdi Output array of RDI values for each gene real(kind=c_double), intent(out), dimension(n_genes), target :: sorted_rdi Work array for sorting (dimension n_genes) integer(kind=c_int), intent(out), dimension(n_genes), target :: perm Permutation array for sorting (dimension n_genes, should be pre-initialized with 1:n_genes) integer(kind=c_int), intent(out), dimension(n_genes), target :: tmp_stack_left Stack array for sorting (dimension n_genes) integer(kind=c_int), intent(out), dimension(n_genes), target :: tmp_stack_right Stack array for sorting (dimension n_genes) integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/compute_rdi_expert_c.html"},{"title":"identify_outliers_c – TensorOmics","text":"public  subroutine identify_outliers_c(n_genes, rdi, sorted_rdi, perm, is_outlier, threshold, quantile, percentile, ierr) bind(C, name=\"identify_outliers_c\") Uses tox_get_outliers Expects sorted_rdi to be filtered (no negative values) and perm should be sorted in ascending order before calling.\nIf sorted_rdi contains negatives or perm is not sorted, tmp_results may be invalid. Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_genes Total number of genes real(kind=c_double), intent(in), dimension(n_genes), target :: rdi Array of RDI values for each gene\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=c_double), intent(in), dimension(n_genes), target :: sorted_rdi Sorted RDI array (must be filtered to remove negatives and sorted in ascending order before calling)\nNaN is permitted for this value.\nInfinite values are permitted for this value. integer(kind=c_int), intent(in), dimension(n_genes), target :: perm Permutation array with sorted indices logical(kind=c_bool), intent(out), dimension(n_genes), target :: is_outlier Output boolean array indicating outliers real(kind=c_double), intent(out), target :: threshold Output threshold value used for detection real(kind=c_double), intent(out), dimension(n_genes), target :: quantile Empirical one-sided upper-tail quantile (effect-size measure) for each gene, i.e. how extreme an\nobserved distance is relative to all observed distances -- NOT a null-hypothesis-testing p-value.\nReturned in the same order as the input RDI array. Because distances are non-negative, a one-sided\nupper-tail quantile is used. real(kind=c_double), intent(in), target :: percentile Percentile threshold as a fraction in [0,1] (top 5% for the default).\nThe default value is 0.95_real64 .\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 . integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/identify_outliers_c.html"},{"title":"detect_outliers_c – TensorOmics","text":"public  subroutine detect_outliers_c(n_genes, n_families, distances, gene_to_fam, is_outlier, loess_x, loess_y, loess_n, quantile, ierr, percentile) bind(C, name=\"detect_outliers_c\") Uses tox_get_outliers Orchestrates the full pipeline: per-family scaling via compute_family_scaling_impl , the RDI per gene via compute_rdi_impl , then flags outliers via identify_outliers_impl . Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_genes Total number of genes integer(kind=c_int), intent(in), target :: n_families Total number of gene families real(kind=c_double), intent(in), dimension(n_genes), target :: distances Array of Euclidean distances for each gene to its centroid\nNaN is permitted for this value.\nInfinite values are permitted for this value. integer(kind=c_int), intent(in), dimension(n_genes), target :: gene_to_fam Gene-to-family mapping (1-based indexing) logical(kind=c_bool), intent(out), dimension(n_genes), target :: is_outlier Output boolean array indicating outliers real(kind=c_double), intent(out), dimension(n_families), target :: loess_x Reference x-coordinates. real(kind=c_double), intent(out), dimension(n_families), target :: loess_y Reference y-coordinates (length n_total). integer(kind=c_int), intent(out), dimension(n_families), target :: loess_n Indices of reference points used for smoothing. real(kind=c_double), intent(out), dimension(n_genes), target :: quantile Empirical one-sided upper-tail quantile (effect-size measure) for each gene, i.e. how extreme an\nobserved distance is relative to all observed distances -- NOT a null-hypothesis-testing p-value.\nReturned in the same order as the input RDI array. Because distances are non-negative, a one-sided\nupper-tail quantile is used. integer(kind=c_int), intent(out), target :: ierr Error code real(kind=c_double), intent(in), target :: percentile Percentile threshold as a fraction in [0,1] for outlier detection.\nThe default value is 0.95_real64 .\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 .","tags":"","url":"proc/detect_outliers_c.html"},{"title":"detect_outliers_expert_c – TensorOmics","text":"public  subroutine detect_outliers_expert_c(n_genes, n_families, distances, gene_to_fam, tmp_perm, tmp_stack_left, tmp_stack_right, tmp_int_workspace, int_workspace_size, tmp_real_workspace, real_workspace_size, tmp_diagl, tmp_weights, tmp_eval_points, tmp_robust_weights, tmp_combined_weights, tmp_residuals, tmp_permutation_indices, tmp_fitted_values, tmp_means_aux, tmp_dscale, tmp_excluded_low_sd, tmp_low_sd_cutoff, tmp_rdi, tmp_sorted_rdi, tmp_threshold, is_outlier, loess_x, loess_y, loess_n, quantile, ierr, percentile) bind(C, name=\"detect_outliers_expert_c\") Uses tox_get_outliers Orchestrates the full pipeline: per-family scaling via compute_family_scaling_impl , the RDI per gene via compute_rdi_impl , then flags outliers via identify_outliers_impl . Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_genes Total number of genes integer(kind=c_int), intent(in), target :: n_families Total number of gene families real(kind=c_double), intent(in), dimension(n_genes), target :: distances Array of Euclidean distances for each gene to its centroid\nNaN is permitted for this value.\nInfinite values are permitted for this value. integer(kind=c_int), intent(in), dimension(n_genes), target :: gene_to_fam Gene-to-family mapping (1-based indexing) integer(kind=c_int), intent(out), dimension(n_genes), target :: tmp_perm Permutation array for sorting integer(kind=c_int), intent(out), dimension(n_genes), target :: tmp_stack_left Stack array for left indices during sorting integer(kind=c_int), intent(out), dimension(n_genes), target :: tmp_stack_right Stack array for right indices during sorting integer(kind=c_int), intent(out), dimension(int_workspace_size), target :: tmp_int_workspace Integer workspace array integer(kind=c_int), intent(in), target :: int_workspace_size Length of integer workspace.\nIt is VERY IMPORTANT to compute this argument from the int_workspace_size output produced by tox_loess_required_workspace . Producer input Supplied by n_dim 1_int32 max_neighborhood_size n_families save_factorization .false. real(kind=c_double), intent(out), dimension(real_workspace_size), target :: tmp_real_workspace Real workspace array integer(kind=c_int), intent(in), target :: real_workspace_size Length of real workspace.\nIt is VERY IMPORTANT to compute this argument from the real_workspace_size output produced by tox_loess_required_workspace . Producer input Supplied by n_dim 1_int32 max_neighborhood_size n_families save_factorization .false. real(kind=c_double), intent(out), dimension(n_families), target :: tmp_diagl Diagonal elements of the weight matrix real(kind=c_double), intent(out), dimension(n_families), target :: tmp_weights Initial weights for LOESS real(kind=c_double), intent(out), dimension(n_families, 1), target :: tmp_eval_points Z matrix for LOESS fitting real(kind=c_double), intent(out), dimension(n_families), target :: tmp_robust_weights Residuals for robust LOESS fitting real(kind=c_double), intent(out), dimension(n_families), target :: tmp_combined_weights Working weights array real(kind=c_double), intent(out), dimension(n_families), target :: tmp_residuals Residuals array integer(kind=c_int), intent(out), dimension(n_families), target :: tmp_permutation_indices Permutation indices for robust LOESS fitting real(kind=c_double), intent(out), dimension(n_families), target :: tmp_fitted_values Output array for LOESS predictions real(kind=c_double), intent(out), dimension(n_families), target :: tmp_means_aux Work array for saving raw means real(kind=c_double), intent(out), dimension(n_families), target :: tmp_dscale Per-family scaling factors (intermediate, consumed by the RDI step) integer(kind=c_int), intent(out), dimension(n_families), target :: tmp_excluded_low_sd Low-sd family mask (intermediate, discarded) real(kind=c_double), intent(out), target :: tmp_low_sd_cutoff Low-sd cutoff (intermediate, discarded) real(kind=c_double), intent(out), dimension(n_genes), target :: tmp_rdi RDI per gene (intermediate, consumed by the outlier step) real(kind=c_double), intent(out), dimension(n_genes), target :: tmp_sorted_rdi Sorted RDI (intermediate, consumed by the outlier step) real(kind=c_double), intent(out), target :: tmp_threshold Detection threshold (intermediate, discarded) logical(kind=c_bool), intent(out), dimension(n_genes), target :: is_outlier Output boolean array indicating outliers real(kind=c_double), intent(out), dimension(n_families), target :: loess_x Reference x-coordinates. real(kind=c_double), intent(out), dimension(n_families), target :: loess_y Reference y-coordinates (length n_total). integer(kind=c_int), intent(out), dimension(n_families), target :: loess_n Indices of reference points used for smoothing. real(kind=c_double), intent(out), dimension(n_genes), target :: quantile Empirical one-sided upper-tail quantile (effect-size measure) for each gene, i.e. how extreme an\nobserved distance is relative to all observed distances -- NOT a null-hypothesis-testing p-value.\nReturned in the same order as the input RDI array. Because distances are non-negative, a one-sided\nupper-tail quantile is used. integer(kind=c_int), intent(out), target :: ierr Error code real(kind=c_double), intent(in), target :: percentile Percentile threshold as a fraction in [0,1] for outlier detection.\nThe default value is 0.95_real64 .\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 .","tags":"","url":"proc/detect_outliers_expert_c.html"},{"title":"serialize_real_helper – TensorOmics","text":"public  subroutine serialize_real_helper(arr, n_elements, arr_shape, filename, ierr) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_elements) :: arr Array to be serialized integer(kind=int32), intent(in) :: n_elements Number of strings in arr integer(kind=int32), intent(in), dimension(:) :: arr_shape Extents of arr , one per dimension character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code","tags":"C-binding","url":"proc/serialize_real_helper.html"},{"title":"serialize_real_1d – TensorOmics","text":"public  subroutine serialize_real_1d(arr, filename, ierr) Directly serialize a 1D real array into a file Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(:), contiguous :: arr Array to be serialized character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/serialize_real_1d.html"},{"title":"serialize_real_2d – TensorOmics","text":"public  subroutine serialize_real_2d(arr, filename, ierr) Directly serialize a 2D real array into a file Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(:, :), contiguous :: arr Array to be serialized character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/serialize_real_2d.html"},{"title":"serialize_real_3d – TensorOmics","text":"public  subroutine serialize_real_3d(arr, filename, ierr) Directly serialize a 3D real array into a file Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(:, :, :), contiguous :: arr Array to be serialized character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/serialize_real_3d.html"},{"title":"serialize_real_4d – TensorOmics","text":"public  subroutine serialize_real_4d(arr, filename, ierr) Directly serialize a 4D real array into a file Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(:, :, :, :), contiguous :: arr Array to be serialized character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/serialize_real_4d.html"},{"title":"serialize_real_5d – TensorOmics","text":"public  subroutine serialize_real_5d(arr, filename, ierr) Directly serialize a 5D real array into a file Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(:, :, :, :, :), contiguous :: arr Array to be serialized character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/serialize_real_5d.html"},{"title":"compute_gene_means_c – TensorOmics","text":"public  subroutine compute_gene_means_c(n_genes, n_reps, expr, means, ierr) bind(C, name=\"compute_gene_means_c\") Uses tox_data_integration_preprocessing Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_genes Number of genes in the study integer(kind=c_int), intent(in), target :: n_reps Number of biological replicates in the study real(kind=c_double), intent(in), dimension(n_reps, n_genes), target :: expr Expression matrix\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=c_double), intent(out), dimension(n_genes), target :: means Per-gene mean expression values integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/compute_gene_means_c.html"},{"title":"compute_residuals_c – TensorOmics","text":"public  subroutine compute_residuals_c(n_genes, n_reps, expr, means, resid, ierr) bind(C, name=\"compute_residuals_c\") Uses tox_data_integration_preprocessing Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_genes Number of genes in the study integer(kind=c_int), intent(in), target :: n_reps Number of biological replicates in the study real(kind=c_double), intent(in), dimension(n_reps, n_genes), target :: expr Expression matrix\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=c_double), intent(in), dimension(n_genes), target :: means Per-gene mean expression values; NaN where every replicate of a gene was NaN\nNaN is permitted for this value. real(kind=c_double), intent(out), dimension(n_reps, n_genes), target :: resid Matrix of signed residuals integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/compute_residuals_c.html"},{"title":"pool_means_c – TensorOmics","text":"public  subroutine pool_means_c(pooled_means, pool_size, n_points, n_pool, x_star, ierr) bind(C, name=\"pool_means_c\") Uses tox_data_integration_preprocessing This takes the pool already built; pool_study_means pools the means of two studies\nfirst, if that is what is at hand. Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(pool_size), target :: pooled_means Pooled means\nNaN is permitted for this value. integer(kind=c_int), intent(in), target :: pool_size Number of means in the pool, usually n_genes_S1 + n_genes_S2 integer(kind=c_int), intent(in), target :: n_points Number of reference points to define integer(kind=c_int), intent(out), target :: n_pool Total number of included (non-NaN) pooled mean-expression values real(kind=c_double), intent(out), dimension(n_points), target :: x_star Mean-expression reference points integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/pool_means_c.html"},{"title":"pool_means_expert_c – TensorOmics","text":"public  subroutine pool_means_expert_c(pooled_means, pooled_means_perm, pool_size, n_points, n_pool, x_star, ierr) bind(C, name=\"pool_means_expert_c\") Uses tox_data_integration_preprocessing This takes the pool already built; pool_study_means pools the means of two studies\nfirst, if that is what is at hand. Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(pool_size), target :: pooled_means Pooled means\nNaN is permitted for this value. integer(kind=c_int), intent(in), dimension(pool_size), target :: pooled_means_perm Sorting permutation for pooled_means integer(kind=c_int), intent(in), target :: pool_size Number of means in the pool, usually n_genes_S1 + n_genes_S2 integer(kind=c_int), intent(in), target :: n_points Number of reference points to define integer(kind=c_int), intent(out), target :: n_pool Total number of included (non-NaN) pooled mean-expression values real(kind=c_double), intent(out), dimension(n_points), target :: x_star Mean-expression reference points integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/pool_means_expert_c.html"},{"title":"pool_study_means_c – TensorOmics","text":"public  subroutine pool_study_means_c(n_genes_S1, mean_S1, n_genes_S2, mean_S2, n_points, n_pool, x_star, ierr) bind(C, name=\"pool_study_means_c\") Uses tox_data_integration_preprocessing Concatenates the two studies' means, sorts the pool, and turns it into reference\npoints exactly as pool_means does. Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_genes_S1 Number of genes in study S1 real(kind=c_double), intent(in), dimension(n_genes_S1), target :: mean_S1 Per-gene mean expression values of study S1\nNaN is permitted for this value. integer(kind=c_int), intent(in), target :: n_genes_S2 Number of genes in study S2 real(kind=c_double), intent(in), dimension(n_genes_S2), target :: mean_S2 Per-gene mean expression values of study S2\nNaN is permitted for this value. integer(kind=c_int), intent(in), target :: n_points Number of reference points to define integer(kind=c_int), intent(out), target :: n_pool Total number of included (non-NaN) pooled mean-expression values real(kind=c_double), intent(out), dimension(n_points), target :: x_star Mean-expression reference points integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/pool_study_means_c.html"},{"title":"pool_study_means_expert_c – TensorOmics","text":"public  subroutine pool_study_means_expert_c(n_genes_S1, mean_S1, n_genes_S2, mean_S2, n_points, tmp_pooled_means, tmp_pooled_means_perm, n_pool, x_star, ierr) bind(C, name=\"pool_study_means_expert_c\") Uses tox_data_integration_preprocessing Concatenates the two studies' means, sorts the pool, and turns it into reference\npoints exactly as pool_means does. Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_genes_S1 Number of genes in study S1 real(kind=c_double), intent(in), dimension(n_genes_S1), target :: mean_S1 Per-gene mean expression values of study S1\nNaN is permitted for this value. integer(kind=c_int), intent(in), target :: n_genes_S2 Number of genes in study S2 real(kind=c_double), intent(in), dimension(n_genes_S2), target :: mean_S2 Per-gene mean expression values of study S2\nNaN is permitted for this value. integer(kind=c_int), intent(in), target :: n_points Number of reference points to define real(kind=c_double), intent(out), dimension(n_genes_S1+n_genes_S2), target :: tmp_pooled_means Work array holding the concatenated means of both studies integer(kind=c_int), intent(out), dimension(n_genes_S1+n_genes_S2), target :: tmp_pooled_means_perm Work array for the permutation that sorts tmp_pooled_means integer(kind=c_int), intent(out), target :: n_pool Total number of included (non-NaN) pooled mean-expression values real(kind=c_double), intent(out), dimension(n_points), target :: x_star Mean-expression reference points integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/pool_study_means_expert_c.html"},{"title":"construct_neighborhoods_c – TensorOmics","text":"public  subroutine construct_neighborhoods_c(n_points, x_star, n_genes_S, mean_S, n_reps_S, resid_S, neighborhood_residuals, neighborhood_indices, n_neighbors, ierr) bind(C, name=\"construct_neighborhoods_c\") Uses tox_data_integration_preprocessing Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_points Number of reference points real(kind=c_double), intent(in), dimension(n_points), target :: x_star Mean-expression reference points\nNaN is permitted for this value. integer(kind=c_int), intent(in), target :: n_genes_S Number of genes in the current study real(kind=c_double), intent(in), dimension(n_genes_S), target :: mean_S Per-gene mean expression values\nNaN is permitted for this value. integer(kind=c_int), intent(in), target :: n_reps_S Number of biological replicates in the study real(kind=c_double), intent(in), dimension(n_reps_S, n_genes_S), target :: resid_S Matrix of signed residuals\nNaN is permitted for this value. real(kind=c_double), intent(out), dimension(n_reps_S, n_neighbors, n_points), target :: neighborhood_residuals Collection of residual vectors for each neighborhood integer(kind=c_int), intent(out), dimension(n_neighbors, n_points), target :: neighborhood_indices Indices of selected neighborhood genes integer(kind=c_int), intent(in), target :: n_neighbors Number of neighbors; a gene whose mean is NaN can never be a neighbor, so this\ncannot exceed the number of genes with a defined mean\nThe minimum valid value is 1_int32 .\nThe maximum valid value is count(.not. ieee_is_nan(mean_S), kind=int32) .\nIt is recommended to compute this with calc_neighborhood_size . integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/construct_neighborhoods_c.html"},{"title":"construct_neighborhoods_expert_c – TensorOmics","text":"public  subroutine construct_neighborhoods_expert_c(n_points, x_star, n_genes_S, mean_S, n_reps_S, resid_S, tmp_distances, tmp_distances_perm, neighborhood_residuals, neighborhood_indices, n_neighbors, ierr) bind(C, name=\"construct_neighborhoods_expert_c\") Uses tox_data_integration_preprocessing Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_points Number of reference points real(kind=c_double), intent(in), dimension(n_points), target :: x_star Mean-expression reference points\nNaN is permitted for this value. integer(kind=c_int), intent(in), target :: n_genes_S Number of genes in the current study real(kind=c_double), intent(in), dimension(n_genes_S), target :: mean_S Per-gene mean expression values\nNaN is permitted for this value. integer(kind=c_int), intent(in), target :: n_reps_S Number of biological replicates in the study real(kind=c_double), intent(in), dimension(n_reps_S, n_genes_S), target :: resid_S Matrix of signed residuals\nNaN is permitted for this value. real(kind=c_double), intent(out), dimension(n_genes_S), target :: tmp_distances Distances work array integer(kind=c_int), intent(out), dimension(n_genes_S), target :: tmp_distances_perm Work array for the permutation that sorts tmp_distances real(kind=c_double), intent(out), dimension(n_reps_S, n_neighbors, n_points), target :: neighborhood_residuals Collection of residual vectors for each neighborhood integer(kind=c_int), intent(out), dimension(n_neighbors, n_points), target :: neighborhood_indices Indices of selected neighborhood genes integer(kind=c_int), intent(in), target :: n_neighbors Number of neighbors; a gene whose mean is NaN can never be a neighbor, so this\ncannot exceed the number of genes with a defined mean\nThe minimum valid value is 1_int32 .\nThe maximum valid value is count(.not. ieee_is_nan(mean_S), kind=int32) .\nIt is recommended to compute this with calc_neighborhood_size . integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/construct_neighborhoods_expert_c.html"},{"title":"c_char_as_view – TensorOmics","text":"public  function c_char_as_view(buffer) result(view) A zero-copy Fortran view of a c_char buffer, ending at the first NUL if there is one. Accepts both conventions a caller might use, which is the point of it: a C caller\nNUL-terminates ( ward then four NULs), the generated bindings blank-pad ( ward ),\nand both must select the same mode. A NUL is honoured where there is one, and where\nthere is none the whole buffer is the string -- which compares equal to the shorter\nliteral anyway, because Fortran blank-pads the shorter operand. The result is a view , not a copy: it is valid only while buffer is, and writing\nthrough buffer changes it. buffer must be contiguous, or c_loc takes the address\nof a compiler temporary and the view dangles on return. Every caller here passes an\nexplicit-shape dummy or a c_f_pointer -mapped array, both of which are contiguous. Replaced an allocating version. Nothing here allocates now, which is what lets the\nmodule sit on Conventions.impl_import_whitelist and be provably allocation-free. Arguments Type Intent Optional Attributes Name character(kind=c_char, len=1), intent(in), dimension(:), target, contiguous :: buffer the C buffer, NUL-terminated or blank-padded Return Value character(len=:), pointer the buffer read as one Fortran string, up to the first NUL","tags":"","url":"proc/c_char_as_view.html"},{"title":"c_int_as_logical – TensorOmics","text":"public elemental subroutine c_int_as_logical(c_val, f_val) Converts a c_int value to logical, elemental -> any shape Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in) :: c_val the element containing the c variant of the number logical, intent(out) :: f_val the element that will hold the logical representation of the c_int: 0 means .false. , else .true.","tags":"","url":"proc/c_int_as_logical.html"},{"title":"logical_as_c_int – TensorOmics","text":"public elemental subroutine logical_as_c_int(f_val, c_val) Converts a logical value to c_int, elemental -> any shape Arguments Type Intent Optional Attributes Name logical, intent(in) :: f_val the element containing the fortran variant of the number integer(kind=c_int), intent(out) :: c_val the element that will hold the c_int representation of the logical: 0 if .false. , else 1","tags":"","url":"proc/logical_as_c_int.html"},{"title":"c_char_as_char – TensorOmics","text":"public elemental subroutine c_char_as_char(c_val, f_val) Converts a c_char value to fortran character, elemental -> any shape Arguments Type Intent Optional Attributes Name character(kind=c_char, len=1), intent(in) :: c_val the element containing the c variant of the character character(len=1), intent(out) :: f_val the element that will hold the fortran char representation of the c_char","tags":"","url":"proc/c_char_as_char.html"},{"title":"char_as_c_char – TensorOmics","text":"public elemental subroutine char_as_c_char(f_val, c_val) Converts a character value to c_char, elemental -> any shape Arguments Type Intent Optional Attributes Name character(len=1), intent(in) :: f_val the element containing the fortran variant of the character character(kind=c_char, len=1), intent(out) :: c_val the element that will hold the c_char (ASCII) representation of the character","tags":"","url":"proc/char_as_c_char.html"},{"title":"int32_as_c_int64 – TensorOmics","text":"public elemental subroutine int32_as_c_int64(f_val, c_val) Converts int32 to c_int64_t, elemental -> any shape Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: f_val the element containing the fortran variant of the number integer(kind=c_int64_t), intent(out) :: c_val the element that will hold the c_int64_t representation","tags":"","url":"proc/int32_as_c_int64.html"},{"title":"c_int64_as_int32 – TensorOmics","text":"public elemental subroutine c_int64_as_int32(c_val, f_val) Converts c_int64_t to int32, elemental -> any shape Arguments Type Intent Optional Attributes Name integer(kind=c_int64_t), intent(in) :: c_val the element containing the c variant of the number integer(kind=int32), intent(out) :: f_val the element that will hold the int32 representation","tags":"","url":"proc/c_int64_as_int32.html"},{"title":"int32_as_c_size – TensorOmics","text":"public elemental subroutine int32_as_c_size(f_val, c_val) Converts int32 to c_size_t, elemental -> any shape Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: f_val the element containing the fortran variant of the number integer(kind=c_size_t), intent(out) :: c_val the element that will hold the c_size_t representation","tags":"","url":"proc/int32_as_c_size.html"},{"title":"c_size_as_int32 – TensorOmics","text":"public elemental subroutine c_size_as_int32(c_val, f_val) Converts c_size_t to int32, elemental -> any shape Arguments Type Intent Optional Attributes Name integer(kind=c_size_t), intent(in) :: c_val the element containing the c variant of the number integer(kind=int32), intent(out) :: f_val the element that will hold the int32 representation","tags":"","url":"proc/c_size_as_int32.html"},{"title":"c_int64_as_c_size – TensorOmics","text":"public elemental subroutine c_int64_as_c_size(c64_val, csize_val) Converts c_int64_t to c_size_t, elemental -> any shape Arguments Type Intent Optional Attributes Name integer(kind=c_int64_t), intent(in) :: c64_val the element containing the c_int64_t value integer(kind=c_size_t), intent(out) :: csize_val the element that will hold the c_size_t representation","tags":"","url":"proc/c_int64_as_c_size.html"},{"title":"c_size_as_c_int64 – TensorOmics","text":"public elemental subroutine c_size_as_c_int64(csize_val, c64_val) Converts c_size_t to c_int64_t, elemental -> any shape Arguments Type Intent Optional Attributes Name integer(kind=c_size_t), intent(in) :: csize_val the element containing the c_size_t value integer(kind=c_int64_t), intent(out) :: c64_val the element that will hold the c_int64_t representation","tags":"","url":"proc/c_size_as_c_int64.html"},{"title":"fjct_compute_jsd_c – TensorOmics","text":"public  subroutine fjct_compute_jsd_c(family_idx, gene_to_family_S1, gene_to_family_S2, n_genes_S1, n_genes_S2, neighborhood_residuals_S1, neighborhood_residuals_S2, neighborhood_genes_S1, neighborhood_genes_S2, n_reps_S1, n_reps_S2, n_neighbors, n_points, n_bins, shared_residual_range, js_divergences, included_n_reps_S1, included_n_reps_S2, total_included_n_reps, global_js_divergence, weights, ierr) bind(C, name=\"fjct_compute_jsd_c\") Uses tox_data_integration_per_family Reuses the same conditioning-on-mean-expression pipeline as the global gJCT, but restricts\nthe residual samples to the genes belonging to the family family_idx . Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: family_idx Index of the family that should be analyzed\nThe minimum valid value is 1_int32 . integer(kind=c_int), intent(in), dimension(n_genes_S1), target :: gene_to_family_S1 Mapping for study 1: Each index (gene) holds the index of its family\nThe minimum valid value is 0_int32 . integer(kind=c_int), intent(in), dimension(n_genes_S2), target :: gene_to_family_S2 Mapping for study 2: Each index (gene) holds the index of its family\nThe minimum valid value is 0_int32 . integer(kind=c_int), intent(in), target :: n_genes_S1 Number of genes in study 1 integer(kind=c_int), intent(in), target :: n_genes_S2 Number of genes in study 2 real(kind=c_double), intent(in), dimension(n_reps_S1, n_neighbors, n_points), target :: neighborhood_residuals_S1 Computed neighborhood residuals for study 1, NaN is explicitly allowed for missing values\nNaN is permitted for this value. real(kind=c_double), intent(in), dimension(n_reps_S2, n_neighbors, n_points), target :: neighborhood_residuals_S2 Computed neighborhood residuals for study 2, NaN is explicitly allowed for missing values\nNaN is permitted for this value. integer(kind=c_int), intent(in), dimension(n_neighbors, n_points), target :: neighborhood_genes_S1 Indices of the selected neighborhood genes of study 1\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_genes_S1 . integer(kind=c_int), intent(in), dimension(n_neighbors, n_points), target :: neighborhood_genes_S2 Indices of the selected neighborhood genes of study 2\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_genes_S2 . integer(kind=c_int), intent(in), target :: n_reps_S1 Number of replicates in study 1 integer(kind=c_int), intent(in), target :: n_reps_S2 Number of replicates in study 2 integer(kind=c_int), intent(in), target :: n_neighbors Number of neighbors in the studies integer(kind=c_int), intent(in), target :: n_points Number of reference points in the studies integer(kind=c_int), intent(in), target :: n_bins Number of equally sized histogram bins used for the studies real(kind=c_double), intent(in), target :: shared_residual_range Computed residual range for both studies\nThe minimum valid value is 0.0_real64 . real(kind=c_double), intent(out), dimension(n_points), target :: js_divergences Jensen-Shannon divergence per reference point, computed for studies S1 and S2 integer(kind=c_int), intent(out), dimension(n_points), target :: included_n_reps_S1 Count of non-NaN residuals (included ones) in study 1 integer(kind=c_int), intent(out), dimension(n_points), target :: included_n_reps_S2 Count of non-NaN residuals (included ones) in study 2 integer(kind=c_int), intent(out), target :: total_included_n_reps Total number of included replicates from both studies ( ) real(kind=c_double), intent(out), target :: global_js_divergence Weighted global Jensen-Shannon divergence real(kind=c_double), intent(out), dimension(n_points), target :: weights Weights used for calculating the global weighted Jensen-Shannon divergence global_js_divergence integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/fjct_compute_jsd_c.html"},{"title":"fjct_compute_jsd_expert_c – TensorOmics","text":"public  subroutine fjct_compute_jsd_expert_c(family_idx, gene_to_family_S1, gene_to_family_S2, n_genes_S1, n_genes_S2, neighborhood_residuals_S1, neighborhood_residuals_S2, neighborhood_genes_S1, neighborhood_genes_S2, n_reps_S1, n_reps_S2, n_neighbors, n_points, n_bins, shared_residual_range, js_divergences, included_n_reps_S1, included_n_reps_S2, total_included_n_reps, global_js_divergence, weights, tmp_neighbor_mask_S1, tmp_neighbor_mask_S2, tmp_pmf_S1, tmp_pmf_S2, tmp_counts, ierr) bind(C, name=\"fjct_compute_jsd_expert_c\") Uses tox_data_integration_per_family Reuses the same conditioning-on-mean-expression pipeline as the global gJCT, but restricts\nthe residual samples to the genes belonging to the family family_idx . Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: family_idx Index of the family that should be analyzed\nThe minimum valid value is 1_int32 . integer(kind=c_int), intent(in), dimension(n_genes_S1), target :: gene_to_family_S1 Mapping for study 1: Each index (gene) holds the index of its family\nThe minimum valid value is 0_int32 . integer(kind=c_int), intent(in), dimension(n_genes_S2), target :: gene_to_family_S2 Mapping for study 2: Each index (gene) holds the index of its family\nThe minimum valid value is 0_int32 . integer(kind=c_int), intent(in), target :: n_genes_S1 Number of genes in study 1 integer(kind=c_int), intent(in), target :: n_genes_S2 Number of genes in study 2 real(kind=c_double), intent(in), dimension(n_reps_S1, n_neighbors, n_points), target :: neighborhood_residuals_S1 Computed neighborhood residuals for study 1, NaN is explicitly allowed for missing values\nNaN is permitted for this value. real(kind=c_double), intent(in), dimension(n_reps_S2, n_neighbors, n_points), target :: neighborhood_residuals_S2 Computed neighborhood residuals for study 2, NaN is explicitly allowed for missing values\nNaN is permitted for this value. integer(kind=c_int), intent(in), dimension(n_neighbors, n_points), target :: neighborhood_genes_S1 Indices of the selected neighborhood genes of study 1\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_genes_S1 . integer(kind=c_int), intent(in), dimension(n_neighbors, n_points), target :: neighborhood_genes_S2 Indices of the selected neighborhood genes of study 2\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_genes_S2 . integer(kind=c_int), intent(in), target :: n_reps_S1 Number of replicates in study 1 integer(kind=c_int), intent(in), target :: n_reps_S2 Number of replicates in study 2 integer(kind=c_int), intent(in), target :: n_neighbors Number of neighbors in the studies integer(kind=c_int), intent(in), target :: n_points Number of reference points in the studies integer(kind=c_int), intent(in), target :: n_bins Number of equally sized histogram bins used for the studies real(kind=c_double), intent(in), target :: shared_residual_range Computed residual range for both studies\nThe minimum valid value is 0.0_real64 . real(kind=c_double), intent(out), dimension(n_points), target :: js_divergences Jensen-Shannon divergence per reference point, computed for studies S1 and S2 integer(kind=c_int), intent(out), dimension(n_points), target :: included_n_reps_S1 Count of non-NaN residuals (included ones) in study 1 integer(kind=c_int), intent(out), dimension(n_points), target :: included_n_reps_S2 Count of non-NaN residuals (included ones) in study 2 integer(kind=c_int), intent(out), target :: total_included_n_reps Total number of included replicates from both studies ( ) real(kind=c_double), intent(out), target :: global_js_divergence Weighted global Jensen-Shannon divergence real(kind=c_double), intent(out), dimension(n_points), target :: weights Weights used for calculating the global weighted Jensen-Shannon divergence global_js_divergence logical(kind=c_bool), intent(out), dimension(n_neighbors, n_points), target :: tmp_neighbor_mask_S1 Work array for the mask selecting study 1's neighbors that belong to family_idx logical(kind=c_bool), intent(out), dimension(n_neighbors, n_points), target :: tmp_neighbor_mask_S2 Work array for the mask selecting study 2's neighbors that belong to family_idx real(kind=c_double), intent(out), dimension(n_points, n_bins), target :: tmp_pmf_S1 Work array for study 1's normalized histogram counts real(kind=c_double), intent(out), dimension(n_points, n_bins), target :: tmp_pmf_S2 Work array for study 2's normalized histogram counts integer(kind=c_int), intent(out), dimension(n_points, n_bins), target :: tmp_counts Work array for the histogram counts integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/fjct_compute_jsd_expert_c.html"},{"title":"fjct_compute_masked_jsd_c – TensorOmics","text":"public  subroutine fjct_compute_masked_jsd_c(neighborhood_residuals_S1, neighborhood_residuals_S2, n_reps_S1, n_reps_S2, n_neighbors, n_points, neighbor_mask_S1, neighbor_mask_S2, n_bins, shared_residual_range, js_divergences, included_n_reps_S1, included_n_reps_S2, total_included_n_reps, global_js_divergence, weights, pmf_S1, pmf_S2, ierr) bind(C, name=\"fjct_compute_masked_jsd_c\") Uses tox_data_integration_per_family Reuses the same conditioning-on-mean-expression pipeline as the global gJCT, but restricts the\nresidual samples to the neighbors selected by neighbor_mask_S1 / neighbor_mask_S2 . Typically\nthose are all neighbors belonging to one gene family, which is what fjct_compute_jsd builds\nthe masks for from a family index. Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_reps_S1, n_neighbors, n_points), target :: neighborhood_residuals_S1 Computed neighborhood residuals for study 1, NaN is explicitly allowed for missing values\nNaN is permitted for this value. real(kind=c_double), intent(in), dimension(n_reps_S2, n_neighbors, n_points), target :: neighborhood_residuals_S2 Computed neighborhood residuals for study 2, NaN is explicitly allowed for missing values\nNaN is permitted for this value. integer(kind=c_int), intent(in), target :: n_reps_S1 Number of replicates in study 1 integer(kind=c_int), intent(in), target :: n_reps_S2 Number of replicates in study 2 integer(kind=c_int), intent(in), target :: n_neighbors Number of neighbors in the studies integer(kind=c_int), intent(in), target :: n_points Number of reference points in the studies logical(kind=c_bool), intent(in), dimension(n_neighbors, n_points), target :: neighbor_mask_S1 Mask selecting the neighbors of study 1 to include logical(kind=c_bool), intent(in), dimension(n_neighbors, n_points), target :: neighbor_mask_S2 Mask selecting the neighbors of study 2 to include integer(kind=c_int), intent(in), target :: n_bins Number of equally sized histogram bins used for the studies real(kind=c_double), intent(in), target :: shared_residual_range Computed residual range for both studies\nThe minimum valid value is 0.0_real64 . real(kind=c_double), intent(out), dimension(n_points), target :: js_divergences Jensen-Shannon divergence per reference point, computed for studies S1 and S2 integer(kind=c_int), intent(out), dimension(n_points), target :: included_n_reps_S1 Count of non-NaN residuals (included ones) in study 1 integer(kind=c_int), intent(out), dimension(n_points), target :: included_n_reps_S2 Count of non-NaN residuals (included ones) in study 2 integer(kind=c_int), intent(out), target :: total_included_n_reps Total number of included replicates from both studies ( ) real(kind=c_double), intent(out), target :: global_js_divergence Weighted global Jensen-Shannon divergence real(kind=c_double), intent(out), dimension(n_points), target :: weights Weights used for calculating the global weighted Jensen-Shannon divergence global_js_divergence real(kind=c_double), intent(out), dimension(n_points, n_bins), target :: pmf_S1 Normalized histogram counts for study 1 real(kind=c_double), intent(out), dimension(n_points, n_bins), target :: pmf_S2 Normalized histogram counts for study 2 integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/fjct_compute_masked_jsd_c.html"},{"title":"fjct_compute_masked_jsd_expert_c – TensorOmics","text":"public  subroutine fjct_compute_masked_jsd_expert_c(neighborhood_residuals_S1, neighborhood_residuals_S2, n_reps_S1, n_reps_S2, n_neighbors, n_points, neighbor_mask_S1, neighbor_mask_S2, n_bins, shared_residual_range, js_divergences, included_n_reps_S1, included_n_reps_S2, total_included_n_reps, global_js_divergence, weights, pmf_S1, pmf_S2, tmp_counts, ierr) bind(C, name=\"fjct_compute_masked_jsd_expert_c\") Uses tox_data_integration_per_family Reuses the same conditioning-on-mean-expression pipeline as the global gJCT, but restricts the\nresidual samples to the neighbors selected by neighbor_mask_S1 / neighbor_mask_S2 . Typically\nthose are all neighbors belonging to one gene family, which is what fjct_compute_jsd builds\nthe masks for from a family index. Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_reps_S1, n_neighbors, n_points), target :: neighborhood_residuals_S1 Computed neighborhood residuals for study 1, NaN is explicitly allowed for missing values\nNaN is permitted for this value. real(kind=c_double), intent(in), dimension(n_reps_S2, n_neighbors, n_points), target :: neighborhood_residuals_S2 Computed neighborhood residuals for study 2, NaN is explicitly allowed for missing values\nNaN is permitted for this value. integer(kind=c_int), intent(in), target :: n_reps_S1 Number of replicates in study 1 integer(kind=c_int), intent(in), target :: n_reps_S2 Number of replicates in study 2 integer(kind=c_int), intent(in), target :: n_neighbors Number of neighbors in the studies integer(kind=c_int), intent(in), target :: n_points Number of reference points in the studies logical(kind=c_bool), intent(in), dimension(n_neighbors, n_points), target :: neighbor_mask_S1 Mask selecting the neighbors of study 1 to include logical(kind=c_bool), intent(in), dimension(n_neighbors, n_points), target :: neighbor_mask_S2 Mask selecting the neighbors of study 2 to include integer(kind=c_int), intent(in), target :: n_bins Number of equally sized histogram bins used for the studies real(kind=c_double), intent(in), target :: shared_residual_range Computed residual range for both studies\nThe minimum valid value is 0.0_real64 . real(kind=c_double), intent(out), dimension(n_points), target :: js_divergences Jensen-Shannon divergence per reference point, computed for studies S1 and S2 integer(kind=c_int), intent(out), dimension(n_points), target :: included_n_reps_S1 Count of non-NaN residuals (included ones) in study 1 integer(kind=c_int), intent(out), dimension(n_points), target :: included_n_reps_S2 Count of non-NaN residuals (included ones) in study 2 integer(kind=c_int), intent(out), target :: total_included_n_reps Total number of included replicates from both studies ( ) real(kind=c_double), intent(out), target :: global_js_divergence Weighted global Jensen-Shannon divergence real(kind=c_double), intent(out), dimension(n_points), target :: weights Weights used for calculating the global weighted Jensen-Shannon divergence global_js_divergence real(kind=c_double), intent(out), dimension(n_points, n_bins), target :: pmf_S1 Normalized histogram counts for study 1 real(kind=c_double), intent(out), dimension(n_points, n_bins), target :: pmf_S2 Normalized histogram counts for study 2 integer(kind=c_int), intent(out), dimension(n_points, n_bins), target :: tmp_counts Work array for the histogram counts integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/fjct_compute_masked_jsd_expert_c.html"},{"title":"fjct_compute_contribution_scores_c – TensorOmics","text":"public  subroutine fjct_compute_contribution_scores_c(global_js_divergences, total_included_n_reps_per_f, k_families, support_weights, contribution_scores, ierr) bind(C, name=\"fjct_compute_contribution_scores_c\") Uses tox_data_integration_per_family Combines how divergent the family is between the studies ( global_js_divergences ), and how much residual support the family has overall ( total_included_n_reps_per_f ), using the outputs of fjct_compute_jsd , collected for the analyzed sub-neighborhoods. Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(k_families), target :: global_js_divergences Per-sub-neighborhood weighted global JSD\nThe minimum valid value is 0.0_real64 . integer(kind=c_int), intent(in), dimension(k_families), target :: total_included_n_reps_per_f Per-sub-neighborhood total_included_n_reps The minimum valid value is 0_int32 . integer(kind=c_int), intent(in), target :: k_families Number of sub-neighborhoods analyzed real(kind=c_double), intent(out), dimension(k_families), target :: support_weights Per-sub-neighborhood calculated support weight (ratio between its total_included_n_reps and sum(total_included_n_reps_per_f) , zero if there were no replicates included at all) real(kind=c_double), intent(out), dimension(k_families), target :: contribution_scores Per-sub-neighborhood calculated contribution ( ) integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/fjct_compute_contribution_scores_c.html"},{"title":"compute_family_scaling – TensorOmics","text":"public  subroutine compute_family_scaling(n_genes, n_families, distances, gene_to_fam, dscale, loess_x, loess_y, indices_used, span, degree, mode, n_iters, low_sd_cutoff, excluded_low_sd, ierr) Uses LOESS on the median/stddev of intra-family distances for scaling, regardless of orthologs. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Total number of genes integer(kind=int32), intent(in) :: n_families Total number of gene families real(kind=real64), intent(in), dimension(n_genes) :: distances Array of Euclidean distances for each gene\nNaN is permitted for this value.\nInfinite values are permitted for this value. integer(kind=int32), intent(in), dimension(n_genes) :: gene_to_fam Mapping of each gene to its family (1-based) real(kind=real64), intent(out), dimension(n_families) :: dscale Array of scaling factors per family (output) real(kind=real64), intent(out), dimension(n_families) :: loess_x Reference x-coordinates for LOESS smoothing real(kind=real64), intent(out), dimension(n_families) :: loess_y Reference y-coordinates for LOESS smoothing integer(kind=int32), intent(out), dimension(n_families) :: indices_used Indices of reference points used for smoothing real(kind=real64), intent(in), optional :: span Span parameter for LOESS smoothing, passed straight to loess_fit_plain_impl , so it is held to that\nprocedure's own range rather than to the NaN tolerance the distance data carries.\nThe default value is 0.7_real64 .\nThe minimum valid value is EPS_LOESS .\nThe maximum valid value is 1.0_real64 . integer(kind=int32), intent(in), optional :: degree Degree of the LOESS polynomial\nThe default value is 2_int32 . integer(kind=int32), intent(in), optional :: mode Mode for LOESS fitting\nThe default value is 1_int32 . Mode Value Plain LOESS fitting MODE_PLAIN Robust LOESS fitting MODE_ROBUST integer(kind=int32), intent(in), optional :: n_iters Number of iterations for robust LOESS fitting\nThe default value is 3_int32 . real(kind=real64), intent(out) :: low_sd_cutoff cutoff used to filter families with low std integer(kind=int32), intent(out), dimension(n_families) :: excluded_low_sd Mask to save those families that have low sd integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/compute_family_scaling.html"},{"title":"compute_family_scaling_expert – TensorOmics","text":"public  subroutine compute_family_scaling_expert(n_genes, n_families, distances, gene_to_fam, dscale, loess_x, loess_y, indices_used, tmp_perm, tmp_stack_left, tmp_stack_right, tmp_int_workspace, int_workspace_size, tmp_real_workspace, real_workspace_size, tmp_diagl, tmp_weights, tmp_eval_points, tmp_robust_weights, tmp_combined_weights, tmp_residuals, tmp_permutation_indices, tmp_fitted_values, span, degree, mode, n_iters, low_sd_cutoff, excluded_low_sd, tmp_means_aux, ierr) Uses LOESS on the median/stddev of intra-family distances for scaling, regardless of orthologs. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Total number of genes integer(kind=int32), intent(in) :: n_families Total number of gene families real(kind=real64), intent(in), dimension(n_genes) :: distances Array of Euclidean distances for each gene\nNaN is permitted for this value.\nInfinite values are permitted for this value. integer(kind=int32), intent(in), dimension(n_genes) :: gene_to_fam Mapping of each gene to its family (1-based) real(kind=real64), intent(out), dimension(n_families) :: dscale Array of scaling factors per family (output) real(kind=real64), intent(out), dimension(n_families) :: loess_x Reference x-coordinates for LOESS smoothing real(kind=real64), intent(out), dimension(n_families) :: loess_y Reference y-coordinates for LOESS smoothing integer(kind=int32), intent(out), dimension(n_families) :: indices_used Indices of reference points used for smoothing integer(kind=int32), intent(out), dimension(n_genes) :: tmp_perm Permutation array for sorting gene distances integer(kind=int32), intent(out), dimension(n_genes) :: tmp_stack_left Stack array for left indices during sorting integer(kind=int32), intent(out), dimension(n_genes) :: tmp_stack_right Stack array for right indices during sorting integer(kind=int32), intent(out), dimension(int_workspace_size) :: tmp_int_workspace Integer workspace array integer(kind=int32), intent(in) :: int_workspace_size Length of integer workspace.\nIt is VERY IMPORTANT to compute this argument from the int_workspace_size output produced by tox_loess_required_workspace . Producer input Supplied by n_dim 1_int32 max_neighborhood_size n_families save_factorization .false. real(kind=real64), intent(out), dimension(real_workspace_size) :: tmp_real_workspace Real workspace array integer(kind=int32), intent(in) :: real_workspace_size Length of real workspace.\nIt is VERY IMPORTANT to compute this argument from the real_workspace_size output produced by tox_loess_required_workspace . Producer input Supplied by n_dim 1_int32 max_neighborhood_size n_families save_factorization .false. real(kind=real64), intent(inout), dimension(n_families) :: tmp_diagl Diagonal elements of the weight matrix real(kind=real64), intent(out), dimension(n_families) :: tmp_weights Initial weights for LOESS real(kind=real64), intent(inout), dimension(n_families, 1) :: tmp_eval_points Z matrix for LOESS fitting real(kind=real64), intent(out), dimension(n_families) :: tmp_robust_weights Residuals for robust LOESS fitting real(kind=real64), intent(out), dimension(n_families) :: tmp_combined_weights Working weights array real(kind=real64), intent(out), dimension(n_families) :: tmp_residuals Residuals array integer(kind=int32), intent(out), dimension(n_families) :: tmp_permutation_indices Permutation indices for robust LOESS fitting real(kind=real64), intent(out), dimension(n_families) :: tmp_fitted_values Output array for LOESS predictions real(kind=real64), intent(in), optional :: span Span parameter for LOESS smoothing, passed straight to loess_fit_plain_impl , so it is held to that\nprocedure's own range rather than to the NaN tolerance the distance data carries.\nThe default value is 0.7_real64 .\nThe minimum valid value is EPS_LOESS .\nThe maximum valid value is 1.0_real64 . integer(kind=int32), intent(in), optional :: degree Degree of the LOESS polynomial\nThe default value is 2_int32 . integer(kind=int32), intent(in), optional :: mode Mode for LOESS fitting\nThe default value is 1_int32 . Mode Value Plain LOESS fitting MODE_PLAIN Robust LOESS fitting MODE_ROBUST integer(kind=int32), intent(in), optional :: n_iters Number of iterations for robust LOESS fitting\nThe default value is 3_int32 . real(kind=real64), intent(out) :: low_sd_cutoff cutoff used to filter families with low std integer(kind=int32), intent(out), dimension(n_families) :: excluded_low_sd Mask to save those families that have low sd real(kind=real64), intent(out), dimension(n_families) :: tmp_means_aux Work array for saving raw means integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/compute_family_scaling_expert.html"},{"title":"compute_rdi – TensorOmics","text":"public pure subroutine compute_rdi(n_genes, distances, gene_to_fam, dscale, rdi, sorted_rdi, perm, ierr) RDI = Euclidean distance / family scaling factor Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Total number of genes real(kind=real64), intent(in), dimension(n_genes) :: distances Array of Euclidean distances for each gene to its centroid\nNaN is permitted for this value.\nInfinite values are permitted for this value. integer(kind=int32), intent(in), dimension(n_genes) :: gene_to_fam Gene-to-family mapping (1-based indexing) real(kind=real64), intent(in), dimension(:) :: dscale Array of scaling factors for each family\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(out), dimension(n_genes) :: rdi Output array of RDI values for each gene real(kind=real64), intent(out), dimension(n_genes) :: sorted_rdi Work array for sorting (dimension n_genes) integer(kind=int32), intent(out), dimension(n_genes) :: perm Permutation array for sorting (dimension n_genes, should be pre-initialized with 1:n_genes) integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/compute_rdi.html"},{"title":"compute_rdi_expert – TensorOmics","text":"public pure subroutine compute_rdi_expert(n_genes, distances, gene_to_fam, dscale, rdi, sorted_rdi, perm, tmp_stack_left, tmp_stack_right, ierr) RDI = Euclidean distance / family scaling factor Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Total number of genes real(kind=real64), intent(in), dimension(n_genes) :: distances Array of Euclidean distances for each gene to its centroid\nNaN is permitted for this value.\nInfinite values are permitted for this value. integer(kind=int32), intent(in), dimension(n_genes) :: gene_to_fam Gene-to-family mapping (1-based indexing) real(kind=real64), intent(in), dimension(:) :: dscale Array of scaling factors for each family\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(out), dimension(n_genes) :: rdi Output array of RDI values for each gene real(kind=real64), intent(out), dimension(n_genes) :: sorted_rdi Work array for sorting (dimension n_genes) integer(kind=int32), intent(out), dimension(n_genes) :: perm Permutation array for sorting (dimension n_genes, should be pre-initialized with 1:n_genes) integer(kind=int32), intent(out), dimension(n_genes) :: tmp_stack_left Stack array for sorting (dimension n_genes) integer(kind=int32), intent(out), dimension(n_genes) :: tmp_stack_right Stack array for sorting (dimension n_genes) integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/compute_rdi_expert.html"},{"title":"identify_outliers – TensorOmics","text":"public pure subroutine identify_outliers(n_genes, rdi, sorted_rdi, perm, is_outlier, threshold, quantile, percentile, ierr) Expects sorted_rdi to be filtered (no negative values) and perm should be sorted in ascending order before calling.\nIf sorted_rdi contains negatives or perm is not sorted, tmp_results may be invalid. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Total number of genes real(kind=real64), intent(in), dimension(n_genes) :: rdi Array of RDI values for each gene\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(in), dimension(n_genes) :: sorted_rdi Sorted RDI array (must be filtered to remove negatives and sorted in ascending order before calling)\nNaN is permitted for this value.\nInfinite values are permitted for this value. integer(kind=int32), intent(in), dimension(n_genes) :: perm Permutation array with sorted indices logical(kind=c_bool), intent(out), dimension(n_genes) :: is_outlier Output boolean array indicating outliers real(kind=real64), intent(out) :: threshold Output threshold value used for detection real(kind=real64), intent(out), dimension(n_genes) :: quantile Empirical one-sided upper-tail quantile (effect-size measure) for each gene, i.e. how extreme an\nobserved distance is relative to all observed distances -- NOT a null-hypothesis-testing p-value.\nReturned in the same order as the input RDI array. Because distances are non-negative, a one-sided\nupper-tail quantile is used. real(kind=real64), intent(in), optional :: percentile Percentile threshold as a fraction in [0,1] (top 5% for the default).\nThe default value is 0.95_real64 .\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 . integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/identify_outliers.html"},{"title":"detect_outliers – TensorOmics","text":"public  subroutine detect_outliers(n_genes, n_families, distances, gene_to_fam, is_outlier, loess_x, loess_y, loess_n, quantile, ierr, percentile) Orchestrates the full pipeline: per-family scaling via compute_family_scaling_impl , the RDI per gene via compute_rdi_impl , then flags outliers via identify_outliers_impl . Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Total number of genes integer(kind=int32), intent(in) :: n_families Total number of gene families real(kind=real64), intent(in), dimension(n_genes) :: distances Array of Euclidean distances for each gene to its centroid\nNaN is permitted for this value.\nInfinite values are permitted for this value. integer(kind=int32), intent(in), dimension(n_genes) :: gene_to_fam Gene-to-family mapping (1-based indexing) logical(kind=c_bool), intent(out), dimension(n_genes) :: is_outlier Output boolean array indicating outliers real(kind=real64), intent(out), dimension(n_families) :: loess_x Reference x-coordinates. real(kind=real64), intent(out), dimension(n_families) :: loess_y Reference y-coordinates (length n_total). integer(kind=int32), intent(out), dimension(n_families) :: loess_n Indices of reference points used for smoothing. real(kind=real64), intent(out), dimension(n_genes) :: quantile Empirical one-sided upper-tail quantile (effect-size measure) for each gene, i.e. how extreme an\nobserved distance is relative to all observed distances -- NOT a null-hypothesis-testing p-value.\nReturned in the same order as the input RDI array. Because distances are non-negative, a one-sided\nupper-tail quantile is used. integer(kind=int32), intent(out) :: ierr Error code real(kind=real64), intent(in), optional :: percentile Percentile threshold as a fraction in [0,1] for outlier detection.\nThe default value is 0.95_real64 .\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 .","tags":"","url":"proc/detect_outliers.html"},{"title":"detect_outliers_expert – TensorOmics","text":"public  subroutine detect_outliers_expert(n_genes, n_families, distances, gene_to_fam, tmp_perm, tmp_stack_left, tmp_stack_right, tmp_int_workspace, int_workspace_size, tmp_real_workspace, real_workspace_size, tmp_diagl, tmp_weights, tmp_eval_points, tmp_robust_weights, tmp_combined_weights, tmp_residuals, tmp_permutation_indices, tmp_fitted_values, tmp_means_aux, tmp_dscale, tmp_excluded_low_sd, tmp_low_sd_cutoff, tmp_rdi, tmp_sorted_rdi, tmp_threshold, is_outlier, loess_x, loess_y, loess_n, quantile, ierr, percentile) Orchestrates the full pipeline: per-family scaling via compute_family_scaling_impl , the RDI per gene via compute_rdi_impl , then flags outliers via identify_outliers_impl . Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Total number of genes integer(kind=int32), intent(in) :: n_families Total number of gene families real(kind=real64), intent(in), dimension(n_genes) :: distances Array of Euclidean distances for each gene to its centroid\nNaN is permitted for this value.\nInfinite values are permitted for this value. integer(kind=int32), intent(in), dimension(n_genes) :: gene_to_fam Gene-to-family mapping (1-based indexing) integer(kind=int32), intent(out), dimension(n_genes) :: tmp_perm Permutation array for sorting integer(kind=int32), intent(out), dimension(n_genes) :: tmp_stack_left Stack array for left indices during sorting integer(kind=int32), intent(out), dimension(n_genes) :: tmp_stack_right Stack array for right indices during sorting integer(kind=int32), intent(out), dimension(int_workspace_size) :: tmp_int_workspace Integer workspace array integer(kind=int32), intent(in) :: int_workspace_size Length of integer workspace.\nIt is VERY IMPORTANT to compute this argument from the int_workspace_size output produced by tox_loess_required_workspace . Producer input Supplied by n_dim 1_int32 max_neighborhood_size n_families save_factorization .false. real(kind=real64), intent(out), dimension(real_workspace_size) :: tmp_real_workspace Real workspace array integer(kind=int32), intent(in) :: real_workspace_size Length of real workspace.\nIt is VERY IMPORTANT to compute this argument from the real_workspace_size output produced by tox_loess_required_workspace . Producer input Supplied by n_dim 1_int32 max_neighborhood_size n_families save_factorization .false. real(kind=real64), intent(out), dimension(n_families) :: tmp_diagl Diagonal elements of the weight matrix real(kind=real64), intent(out), dimension(n_families) :: tmp_weights Initial weights for LOESS real(kind=real64), intent(out), dimension(n_families, 1) :: tmp_eval_points Z matrix for LOESS fitting real(kind=real64), intent(out), dimension(n_families) :: tmp_robust_weights Residuals for robust LOESS fitting real(kind=real64), intent(out), dimension(n_families) :: tmp_combined_weights Working weights array real(kind=real64), intent(out), dimension(n_families) :: tmp_residuals Residuals array integer(kind=int32), intent(out), dimension(n_families) :: tmp_permutation_indices Permutation indices for robust LOESS fitting real(kind=real64), intent(out), dimension(n_families) :: tmp_fitted_values Output array for LOESS predictions real(kind=real64), intent(out), dimension(n_families) :: tmp_means_aux Work array for saving raw means real(kind=real64), intent(out), dimension(n_families) :: tmp_dscale Per-family scaling factors (intermediate, consumed by the RDI step) integer(kind=int32), intent(out), dimension(n_families) :: tmp_excluded_low_sd Low-sd family mask (intermediate, discarded) real(kind=real64), intent(out) :: tmp_low_sd_cutoff Low-sd cutoff (intermediate, discarded) real(kind=real64), intent(out), dimension(n_genes) :: tmp_rdi RDI per gene (intermediate, consumed by the outlier step) real(kind=real64), intent(out), dimension(n_genes) :: tmp_sorted_rdi Sorted RDI (intermediate, consumed by the outlier step) real(kind=real64), intent(out) :: tmp_threshold Detection threshold (intermediate, discarded) logical(kind=c_bool), intent(out), dimension(n_genes) :: is_outlier Output boolean array indicating outliers real(kind=real64), intent(out), dimension(n_families) :: loess_x Reference x-coordinates. real(kind=real64), intent(out), dimension(n_families) :: loess_y Reference y-coordinates (length n_total). integer(kind=int32), intent(out), dimension(n_families) :: loess_n Indices of reference points used for smoothing. real(kind=real64), intent(out), dimension(n_genes) :: quantile Empirical one-sided upper-tail quantile (effect-size measure) for each gene, i.e. how extreme an\nobserved distance is relative to all observed distances -- NOT a null-hypothesis-testing p-value.\nReturned in the same order as the input RDI array. Because distances are non-negative, a one-sided\nupper-tail quantile is used. integer(kind=int32), intent(out) :: ierr Error code real(kind=real64), intent(in), optional :: percentile Percentile threshold as a fraction in [0,1] for outlier detection.\nThe default value is 0.95_real64 .\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 .","tags":"","url":"proc/detect_outliers_expert.html"},{"title":"calc_neighborhood_size – TensorOmics","text":"public pure function calc_neighborhood_size(n_pool, n_points, n_genes_S, mean_S, desired_size) result(n_neighbors) The desired_size works as upper limit, as the actual neighborhood size might be lower\ndue to few genes with non-NaN mean. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_pool Total number of pooled mean-expression values across both studies integer(kind=int32), intent(in) :: n_points Number of reference points integer(kind=int32), intent(in) :: n_genes_S Number of genes in the current study real(kind=real64), intent(in) :: mean_S (n_genes_S) Per-gene mean expression values\nNaN is permitted for this value. integer(kind=int32), intent(in), optional :: desired_size Optional desired neighborhood size\nThe default value is 1000 . Return Value integer(kind=int32) Calculated neighborhood size","tags":"C-binding","url":"proc/calc_neighborhood_size.html"},{"title":"compute_gene_means_impl – TensorOmics","text":"public pure subroutine compute_gene_means_impl(n_genes, n_reps, expr, means) Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Number of genes in the study integer(kind=int32), intent(in) :: n_reps Number of biological replicates in the study real(kind=real64), intent(in) :: expr (n_reps,n_genes) Expression matrix\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(out) :: means (n_genes) Per-gene mean expression values","tags":"","url":"proc/compute_gene_means_impl.html"},{"title":"compute_residuals_impl – TensorOmics","text":"public pure subroutine compute_residuals_impl(n_genes, n_reps, expr, means, resid) Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Number of genes in the study integer(kind=int32), intent(in) :: n_reps Number of biological replicates in the study real(kind=real64), intent(in) :: expr (n_reps,n_genes) Expression matrix\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(in) :: means (n_genes) Per-gene mean expression values; NaN where every replicate of a gene was NaN\nNaN is permitted for this value. real(kind=real64), intent(out) :: resid (n_reps,n_genes) Matrix of signed residuals","tags":"","url":"proc/compute_residuals_impl.html"},{"title":"pool_means_impl – TensorOmics","text":"public pure subroutine pool_means_impl(pooled_means, pooled_means_perm, pool_size, n_points, n_pool, x_star) This takes the pool already built; pool_study_means pools the means of two studies\nfirst, if that is what is at hand. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: pooled_means (pool_size) Pooled means\nNaN is permitted for this value. integer(kind=int32), intent(in) :: pooled_means_perm (pool_size) Sorting permutation for pooled_means integer(kind=int32), intent(in), target :: pool_size Number of means in the pool, usually n_genes_S1 + n_genes_S2 integer(kind=int32), intent(in) :: n_points Number of reference points to define integer(kind=int32), intent(out) :: n_pool Total number of included (non-NaN) pooled mean-expression values real(kind=real64), intent(out) :: x_star (n_points) Mean-expression reference points","tags":"","url":"proc/pool_means_impl.html"},{"title":"pool_study_means_impl – TensorOmics","text":"public pure subroutine pool_study_means_impl(n_genes_S1, mean_S1, n_genes_S2, mean_S2, n_points, tmp_pooled_means, tmp_pooled_means_perm, n_pool, x_star) Concatenates the two studies' means, sorts the pool, and turns it into reference\npoints exactly as pool_means does. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes_S1 Number of genes in study S1 real(kind=real64), intent(in) :: mean_S1 (n_genes_S1) Per-gene mean expression values of study S1\nNaN is permitted for this value. integer(kind=int32), intent(in) :: n_genes_S2 Number of genes in study S2 real(kind=real64), intent(in) :: mean_S2 (n_genes_S2) Per-gene mean expression values of study S2\nNaN is permitted for this value. integer(kind=int32), intent(in) :: n_points Number of reference points to define real(kind=real64), intent(out) :: tmp_pooled_means (n_genes_S1+n_genes_S2) Work array holding the concatenated means of both studies integer(kind=int32), intent(out) :: tmp_pooled_means_perm (n_genes_S1+n_genes_S2) Work array for the permutation that sorts tmp_pooled_means integer(kind=int32), intent(out) :: n_pool Total number of included (non-NaN) pooled mean-expression values real(kind=real64), intent(out) :: x_star (n_points) Mean-expression reference points","tags":"","url":"proc/pool_study_means_impl.html"},{"title":"construct_neighborhoods_impl – TensorOmics","text":"public pure subroutine construct_neighborhoods_impl(n_points, x_star, n_genes_S, mean_S, n_reps_S, resid_S, tmp_distances, tmp_distances_perm, neighborhood_residuals, neighborhood_indices, n_neighbors) Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_points Number of reference points real(kind=real64), intent(in) :: x_star (n_points) Mean-expression reference points\nNaN is permitted for this value. integer(kind=int32), intent(in) :: n_genes_S Number of genes in the current study real(kind=real64), intent(in) :: mean_S (n_genes_S) Per-gene mean expression values\nNaN is permitted for this value. integer(kind=int32), intent(in) :: n_reps_S Number of biological replicates in the study real(kind=real64), intent(in) :: resid_S (n_reps_S,n_genes_S) Matrix of signed residuals\nNaN is permitted for this value. real(kind=real64), intent(out) :: tmp_distances (n_genes_S) Distances work array integer(kind=int32), intent(out) :: tmp_distances_perm (n_genes_S) Work array for the permutation that sorts tmp_distances real(kind=real64), intent(out) :: neighborhood_residuals (n_reps_S,n_neighbors,n_points) Collection of residual vectors for each neighborhood integer(kind=int32), intent(out) :: neighborhood_indices (n_neighbors,n_points) Indices of selected neighborhood genes integer(kind=int32), intent(in) :: n_neighbors Number of neighbors; a gene whose mean is NaN can never be a neighbor, so this\ncannot exceed the number of genes with a defined mean\nThe minimum valid value is 1_int32 .\nThe maximum valid value is count(.not. ieee_is_nan(mean_S), kind=int32) .\nIt is recommended to compute this with calc_neighborhood_size .","tags":"","url":"proc/construct_neighborhoods_impl.html"},{"title":"rand_range – TensorOmics","text":"public  function rand_range(min, max) result(rand_num) Returns a random real number min <= rand_num < max . If min > max , it will be max <= rand_num < min . If min == max , it will be min . Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: min Lower bound real(kind=real64), intent(in) :: max Upper bound Return Value real(kind=real64)","tags":"","url":"proc/rand_range.html"},{"title":"init_random – TensorOmics","text":"public  subroutine init_random(seed) Initialize Fortran's random number generator Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in), optional :: seed optional random seed, default: 42 Note This subroutine uses the intrinsic random_seed subroutine that expects default kind integer.\nTo map int32 to default kind, it is being clamped by modulo to be in range.","tags":"","url":"proc/init_random.html"},{"title":"shuffle_vector_real – TensorOmics","text":"public  subroutine shuffle_vector_real(vec) Shuffle a vector in-place, using Fisher-Yates shuffle Arguments Type Intent Optional Attributes Name real(kind=real64), intent(inout), dimension(:) :: vec Output permutation array","tags":"","url":"proc/shuffle_vector_real.html"},{"title":"shuffle_vector_int – TensorOmics","text":"public  subroutine shuffle_vector_int(vec) Shuffle a vector in-place, using Fisher-Yates shuffle Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(inout), dimension(:) :: vec Output permutation array","tags":"","url":"proc/shuffle_vector_int.html"},{"title":"shuffle_vector – TensorOmics","text":"public interface shuffle_vector Generic in-place Fisher-Yates shuffle, dispatches on the vector's element type. Module Procedures public  subroutine shuffle_vector_real (vec) Author Franz-Eric Sill License MIT Shuffle a vector in-place, using Fisher-Yates shuffle Arguments Type Intent Optional Attributes Name real(kind=real64), intent(inout), dimension(:) :: vec Output permutation array public  subroutine shuffle_vector_int (vec) Author Franz-Eric Sill License MIT Shuffle a vector in-place, using Fisher-Yates shuffle Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(inout), dimension(:) :: vec Output permutation array","tags":"","url":"interface/shuffle_vector.html"},{"title":"deserialize_int_helper – TensorOmics","text":"public  subroutine deserialize_int_helper(arr, n_elements, arr_shape, filename, ierr) Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(out), dimension(n_elements) :: arr Pre-allocated array to read the data into integer(kind=int32), intent(in) :: n_elements Size of arr integer(kind=int32), intent(in), dimension(:) :: arr_shape Extents of arr , one per dimension\nIt is VERY IMPORTANT to compute this argument from the dims_out output produced by get_array_metadata . Producer input Supplied by dims_out_capacity 5_int32 character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code","tags":"C-binding","url":"proc/deserialize_int_helper.html"},{"title":"deserialize_int_1d – TensorOmics","text":"public  subroutine deserialize_int_1d(arr, filename, ierr) Directly deserialize a 1D integer array from a file Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(out), dimension(:), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/deserialize_int_1d.html"},{"title":"deserialize_int_2d – TensorOmics","text":"public  subroutine deserialize_int_2d(arr, filename, ierr) Directly deserialize a 2D integer array from a file Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(out), dimension(:, :), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/deserialize_int_2d.html"},{"title":"deserialize_int_3d – TensorOmics","text":"public  subroutine deserialize_int_3d(arr, filename, ierr) Directly deserialize a 3D integer array from a file Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(out), dimension(:, :, :), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/deserialize_int_3d.html"},{"title":"deserialize_int_4d – TensorOmics","text":"public  subroutine deserialize_int_4d(arr, filename, ierr) Directly deserialize a 4D integer array from a file Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(out), dimension(:, :, :, :), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/deserialize_int_4d.html"},{"title":"deserialize_int_5d – TensorOmics","text":"public  subroutine deserialize_int_5d(arr, filename, ierr) Directly deserialize a 5D integer array from a file Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(out), dimension(:, :, :, :, :), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/deserialize_int_5d.html"},{"title":"mean_vector_impl – TensorOmics","text":"public pure subroutine mean_vector_impl(expression_vectors, n_axes, n_genes, gene_indices, n_selected_genes, centroid) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_axes, n_genes) :: expression_vectors The input matrix of all gene expression vectors (n_axes x n_genes). integer(kind=int32), intent(in) :: n_axes Number of axes (tissues/dimensions). integer(kind=int32), intent(in) :: n_genes Total number of genes in the input matrix. integer(kind=int32), intent(in), dimension(n_selected_genes) :: gene_indices An array containing the column indices of the selected genes in 'expression_vectors'.\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_genes . integer(kind=int32), intent(in) :: n_selected_genes The number of genes in the current family to be averaged.\nThe minimum valid value is 0_int32 .\nThe maximum valid value is n_genes . real(kind=real64), intent(out), dimension(n_axes) :: centroid The output vector representing the computed centroid.","tags":"","url":"proc/mean_vector_impl.html"},{"title":"group_centroid_impl – TensorOmics","text":"public pure subroutine group_centroid_impl(expression_vectors, n_axes, n_genes, gene_to_family, n_families, centroid_matrix, mode, tmp_group_indices, ortholog_set) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_axes, n_genes) :: expression_vectors The input matrix of all gene expression vectors (n_axes x n_genes). integer(kind=int32), intent(in) :: n_axes Number of axes (tissues/dimensions). integer(kind=int32), intent(in) :: n_genes Total number of genes in the 'expression_vectors' matrix. integer(kind=int32), intent(in), dimension(n_genes) :: gene_to_family Index mapping -> each index i holds the family index for the corresponding gene in expression_vectors , using 0_int32 for unassigned genes\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_families .\nThe value 0_int32 is additionally accepted. integer(kind=int32), intent(in) :: n_families Total number of gene families to compute centroids for. real(kind=real64), intent(out), dimension(n_axes, n_families) :: centroid_matrix The output matrix (n_axes x n_families) to store the computed centroids. integer(kind=int32), intent(in) :: mode used mode for grouping Mode Value Procedure Group orthologs MODE_GROUP_ORTHOLOGS group_centroid_orthologs Group all MODE_GROUP_ALL group_centroid_all integer(kind=int32), intent(out), dimension(n_genes) :: tmp_group_indices Work array for storing the indices of one family's genes. logical(kind=c_bool), intent(in), optional, dimension(n_genes) :: ortholog_set A logical array indicating if a gene is part of a specific subset (e.g., orthologs).\nThis optional argument needs to be passed if used mode ( mode ) is MODE_GROUP_ORTHOLOGS .","tags":"","url":"proc/group_centroid_impl.html"},{"title":"omics_vector_RAP_projection_impl – TensorOmics","text":"public pure subroutine omics_vector_RAP_projection_impl(vecs, n_axes, n_vecs, vecs_selection_mask, n_selected_vecs, axes_selection_mask, n_selected_axes, projections) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_axes, n_vecs) :: vecs matrix with expression vectors integer(kind=int32), intent(in) :: n_axes number of axes integer(kind=int32), intent(in) :: n_vecs number of vectors per axis logical(kind=c_bool), intent(in), dimension(n_vecs) :: vecs_selection_mask .true. for vectors where projection is to be computed integer(kind=int32), intent(in) :: n_selected_vecs count of .true. values in vecs_selection_mask logical(kind=c_bool), intent(in), dimension(n_axes) :: axes_selection_mask .true. for axes to be included in RAP integer(kind=int32), intent(in) :: n_selected_axes count of .true. values in axes_selection_mask real(kind=real64), intent(out), dimension(n_selected_axes, n_selected_vecs) :: projections projected vectors","tags":"","url":"proc/omics_vector_rap_projection_impl.html"},{"title":"omics_field_RAP_projection_impl – TensorOmics","text":"public pure subroutine omics_field_RAP_projection_impl(fields, n_axes, n_fields, fields_selection_mask, n_selected_fields, axes_selection_mask, n_selected_axes, projections) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_axes, 2, n_fields) :: fields matrix with vector fields; each field holds two vectors, the origin first and the target second integer(kind=int32), intent(in) :: n_axes number of axes integer(kind=int32), intent(in) :: n_fields number of vectors per axis logical(kind=c_bool), intent(in), dimension(n_fields) :: fields_selection_mask .true. for vectors where projection is to be computed integer(kind=int32), intent(in) :: n_selected_fields count of .true. values in fields_selection_mask logical(kind=c_bool), intent(in), dimension(n_axes) :: axes_selection_mask .true. for axes to be included in RAP integer(kind=int32), intent(in) :: n_selected_axes count of .true. values in axes_selection_mask real(kind=real64), intent(out), dimension(n_selected_axes, n_selected_fields) :: projections projected vectors","tags":"","url":"proc/omics_field_rap_projection_impl.html"},{"title":"project_selected_vecs_onto_rap_helper – TensorOmics","text":"public pure subroutine project_selected_vecs_onto_rap_helper(selected_vecs, n_selected_axes, n_selected_vecs) Projects selected vectors onto its RAP Arguments Type Intent Optional Attributes Name real(kind=real64), intent(inout), dimension(n_selected_axes, n_selected_vecs) :: selected_vecs matrix with vectors for selected axes integer(kind=int32), intent(in) :: n_selected_axes number of selected axes integer(kind=int32), intent(in) :: n_selected_vecs number of selected vectors per axis","tags":"","url":"proc/project_selected_vecs_onto_rap_helper.html"},{"title":"clock_hand_angle_between_vectors_impl – TensorOmics","text":"public pure subroutine clock_hand_angle_between_vectors_impl(v1, v2, n_dims, orientation_reference, signed_angle, ierr) The unsigned angle is acos(v1 . v2) ; orientation_reference supplies the sign by saying\nwhich way round the plane the two vectors span counts as positive. Reports ERR_INVALID_INPUT when the reference is orthogonal to the rotation and so orients nothing. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_dims) :: v1 First normalized vector in RAP space real(kind=real64), intent(in), dimension(n_dims) :: v2 Second normalized vector in RAP space integer(kind=int32), intent(in) :: n_dims Dimension of both vectors real(kind=real64), intent(in), dimension(n_dims) :: orientation_reference Orients the plane the rotation happens in, so the angle can carry a sign. A\nrotation from one vector to another has no inherent direction above two\ndimensions -- and in RAP space not even in two, since the axes are tissues or\nfactors and carry no handedness -- so the caller states which way round counts\nas positive. The sign is that of this vector's component along the rotation. real(kind=real64), intent(out) :: signed_angle Signed angle between vectors in radians [-pi, pi] integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/clock_hand_angle_between_vectors_impl.html"},{"title":"clock_hand_angle_between_vectors_helper – TensorOmics","text":"public pure subroutine clock_hand_angle_between_vectors_helper(v1, v2, n_dims, orientation_reference, signed_angle, undefined_sign) Compute the signed clock hand angle between two RAP-projected and normalized vectors. The unsigned angle is acos(v1 . v2) . The sign is the caller's convention: the rotation\nfrom v1 to v2 sweeps through the plane the two span, and orientation_reference says\nwhich way round that plane is positive. Concretely, the sign is that of orientation_reference . (v2 - (v1 . v2) v1) -- the reference measured against the part\nof v2 perpendicular to v1 , which is the direction the rotation actually moves in. In two dimensions this reduces to the familiar determinant when the reference is v1 turned a quarter turn; there is simply no such canonical quarter turn in higher ones. undefined_sign reports the one case with no answer: the reference is orthogonal to the\nrotation, so it orients nothing. Parallel v1 / v2 are not that case -- the angle is\nthen 0 or pi and the sign does not matter, so the unsigned angle is returned as is. Shared compute core: the single-vector angle, reused per field by clock_hand_angles_for_shift_vectors_impl . Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_dims) :: v1 First normalized vector in RAP space real(kind=real64), intent(in), dimension(n_dims) :: v2 Second normalized vector in RAP space integer(kind=int32), intent(in) :: n_dims Dimension of both vectors real(kind=real64), intent(in), dimension(n_dims) :: orientation_reference Orients the plane the rotation happens in, so the angle can carry a sign. A\nrotation from one vector to another has no inherent direction above two\ndimensions -- and in RAP space not even in two, since the axes are tissues or\nfactors and carry no handedness -- so the caller states which way round counts\nas positive. The sign is that of this vector's component along the rotation. real(kind=real64), intent(out) :: signed_angle Signed angle between vectors in radians [-pi, pi] logical(kind=c_bool), intent(out) :: undefined_sign .true. when the reference orients nothing, so no sign could be given","tags":"","url":"proc/clock_hand_angle_between_vectors_helper.html"},{"title":"clock_hand_angles_for_shift_vectors_impl – TensorOmics","text":"public pure subroutine clock_hand_angles_for_shift_vectors_impl(fields, n_dims, n_fields, fields_selection_mask, n_selected_fields, orientation_reference, signed_angles, ierr) Each selected field is angled by the rule of clock_hand_angle_between_vectors_impl ,\nwith one orientation_reference shared by the whole batch. A single field whose rotation\nthe reference fails to orient fails the call. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_dims, 2, n_fields) :: fields matrix with vector fields; each field holds two vectors, the origin first and the target second integer(kind=int32), intent(in) :: n_dims Dimension of each vector in RAP space integer(kind=int32), intent(in) :: n_fields Number of vector pairs logical(kind=c_bool), intent(in), dimension(n_fields) :: fields_selection_mask .true. for vector pairs where angle should be computed integer(kind=int32), intent(in) :: n_selected_fields Count of .true. values in fields_selection_mask real(kind=real64), intent(in), dimension(n_dims) :: orientation_reference Orients the plane the rotation happens in, so the angle can carry a sign. A\nrotation from one vector to another has no inherent direction above two\ndimensions -- and in RAP space not even in two, since the axes are tissues or\nfactors and carry no handedness -- so the caller states which way round counts\nas positive. The sign is that of this vector's component along the rotation. real(kind=real64), intent(out), dimension(n_selected_fields) :: signed_angles Signed rotation angles between vector pairs in radians [-π, π] integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/clock_hand_angles_for_shift_vectors_impl.html"},{"title":"compute_relative_axis_contributions_impl – TensorOmics","text":"public pure subroutine compute_relative_axis_contributions_impl(vec, n_axes, contributions, ierr) Shared utility: the shift-vector and expression-vector entry points below both drive it. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_axes) :: vec RAP-projected and normalized vector (expression or shift) integer(kind=int32), intent(in) :: n_axes Number of axes (length of vec and contributions) real(kind=real64), intent(out), dimension(n_axes) :: contributions Fractional contribution of each axis (output), values in [0,1], sum to 1 integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/compute_relative_axis_contributions_impl.html"},{"title":"relative_axes_changes_from_shift_vector_impl – TensorOmics","text":"public pure subroutine relative_axes_changes_from_shift_vector_impl(vec, n_axes, contributions, ierr) Wrapper for shift vectors (e.g. difference between two RAP-projected vectors) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_axes) :: vec RAP-projected and normalized shift vector integer(kind=int32), intent(in) :: n_axes Number of axes real(kind=real64), intent(out), dimension(n_axes) :: contributions Fractional contribution of each axis (output), values in [0,1], sum to 1 integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/relative_axes_changes_from_shift_vector_impl.html"},{"title":"relative_axes_expression_from_expression_vector_impl – TensorOmics","text":"public pure subroutine relative_axes_expression_from_expression_vector_impl(vec, n_axes, contributions, ierr) Wrapper for single RAP-projected expression vectors Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_axes) :: vec RAP-projected and normalized expression vector integer(kind=int32), intent(in) :: n_axes Number of axes real(kind=real64), intent(out), dimension(n_axes) :: contributions Fractional contribution of each axis (output), values in [0,1], sum to 1 integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/relative_axes_expression_from_expression_vector_impl.html"},{"title":"serialize_int_helper_c – TensorOmics","text":"public  subroutine serialize_int_helper_c(arr, n_elements, arr_shape, n_arr_shape_elements, filename, filename_strlen, ierr) bind(C, name=\"serialize_int_helper_c\") Uses f42_serde_arrays_serialize_int Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), dimension(*), target :: arr Array to be serialized integer(kind=c_int), intent(in), target :: n_elements Number of strings in arr integer(kind=c_int), intent(in), dimension(n_arr_shape_elements), target :: arr_shape Extents of arr , one per dimension integer(kind=c_int), intent(in), target :: n_arr_shape_elements number of elements in arr_shape character(kind=c_char, len=1), intent(in), dimension(filename_strlen), target :: filename Name of the file to write to integer(kind=c_int), intent(in), target :: filename_strlen length of the strings in filename integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"proc/serialize_int_helper_c.html"},{"title":"build_kd_index – TensorOmics","text":"public pure subroutine build_kd_index(points, n_dimensions, n_points, kd_indices, dimension_order, ierr) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_dimensions, n_points) :: points Data points integer(kind=int32), intent(in) :: n_dimensions Number of dimensions integer(kind=int32), intent(in) :: n_points Number of points integer(kind=int32), intent(out), dimension(n_points) :: kd_indices Output index array (k-d tree order) integer(kind=int32), intent(in), dimension(n_dimensions) :: dimension_order Dimension order (by variance)\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_dimensions . integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/build_kd_index.html"},{"title":"build_kd_index_expert – TensorOmics","text":"public pure subroutine build_kd_index_expert(points, n_dimensions, n_points, kd_indices, dimension_order, tmp_workspace, tmp_value_buffer, tmp_permutation, tmp_recursion_stack, ierr) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_dimensions, n_points) :: points Data points integer(kind=int32), intent(in) :: n_dimensions Number of dimensions integer(kind=int32), intent(in) :: n_points Number of points integer(kind=int32), intent(out), dimension(n_points) :: kd_indices Output index array (k-d tree order) integer(kind=int32), intent(in), dimension(n_dimensions) :: dimension_order Dimension order (by variance)\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_dimensions . integer(kind=int32), intent(out), dimension(n_points) :: tmp_workspace Workspace array real(kind=real64), intent(out), dimension(n_points) :: tmp_value_buffer Workspace for sorting integer(kind=int32), intent(out), dimension(n_points) :: tmp_permutation Workspace for sorting integer(kind=int32), intent(out), dimension(3, n_points) :: tmp_recursion_stack Stack for l, r, depth integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/build_kd_index_expert.html"},{"title":"build_spherical_kd – TensorOmics","text":"public pure subroutine build_spherical_kd(points, n_dimensions, n_points, kd_indices, dimension_order, ierr) This is a thin, semantically-named wrapper: partitioning is identical to build_kd_index_impl (plain per-axis median splits);\ncallers are responsible for ensuring points are actually unit-normalized beforehand. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_dimensions, n_points) :: points Data points integer(kind=int32), intent(in) :: n_dimensions Number of dimensions integer(kind=int32), intent(in) :: n_points Number of points integer(kind=int32), intent(out), dimension(n_points) :: kd_indices Output index array (k-d tree order) integer(kind=int32), intent(in), dimension(n_dimensions) :: dimension_order Dimension order (by variance)\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_dimensions . integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/build_spherical_kd.html"},{"title":"build_spherical_kd_expert – TensorOmics","text":"public pure subroutine build_spherical_kd_expert(points, n_dimensions, n_points, kd_indices, dimension_order, tmp_workspace, tmp_value_buffer, tmp_permutation, tmp_recursion_stack, ierr) This is a thin, semantically-named wrapper: partitioning is identical to build_kd_index_impl (plain per-axis median splits);\ncallers are responsible for ensuring points are actually unit-normalized beforehand. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_dimensions, n_points) :: points Data points integer(kind=int32), intent(in) :: n_dimensions Number of dimensions integer(kind=int32), intent(in) :: n_points Number of points integer(kind=int32), intent(out), dimension(n_points) :: kd_indices Output index array (k-d tree order) integer(kind=int32), intent(in), dimension(n_dimensions) :: dimension_order Dimension order (by variance)\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_dimensions . integer(kind=int32), intent(out), dimension(n_points) :: tmp_workspace Workspace array real(kind=real64), intent(out), dimension(n_points) :: tmp_value_buffer Workspace for sorting integer(kind=int32), intent(out), dimension(n_points) :: tmp_permutation Workspace for sorting integer(kind=int32), intent(out), dimension(3, n_points) :: tmp_recursion_stack Stack for l, r, depth integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/build_spherical_kd_expert.html"},{"title":"compute_tissue_versatility_c – TensorOmics","text":"public  subroutine compute_tissue_versatility_c(n_axes, n_vectors, expression_vectors, vectors_selection_mask, n_selected_vectors, axes_selection_mask, n_selected_axes, tissue_versatilities, tissue_angles_deg, ierr) bind(C, name=\"compute_tissue_versatility_c\") Uses tox_tissue_versatility The metric is based on the angle between each gene expression vector and the space diagonal.\nVersatility is normalized to [0, 1], where 0 means uniform expression and 1 means expression in only one axis. The masks follow the n_selected_ convention, so the generated wrapper validates that each\nselection count matches its mask; n_selected_axes (not an array extent) carries its own floor. Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_axes Number of axes (tissues/dimensions) integer(kind=c_int), intent(in), target :: n_vectors Number of expression vectors (genes) real(kind=c_double), intent(in), dimension(n_axes, n_vectors), target :: expression_vectors 2D array (n_axes, n_vectors), each column is a gene expression vector logical(kind=c_bool), intent(in), dimension(n_vectors), target :: vectors_selection_mask Logical array (n_vectors), .TRUE. for vectors to process integer(kind=c_int), intent(in), target :: n_selected_vectors Number of selected expression vectors (count of .TRUE. in vectors_selection_mask) logical(kind=c_bool), intent(in), dimension(n_axes), target :: axes_selection_mask Logical array (n_axes), .TRUE. for axes to include in calculation integer(kind=c_int), intent(in), target :: n_selected_axes Number of selected axes (count of .TRUE. in axes_selection_mask)\nThe minimum valid value is 1_int32 . real(kind=c_double), intent(out), dimension(n_selected_vectors), target :: tissue_versatilities Output, real array, length = n_selected_vectors, stores the calculated tissue versatilities real(kind=c_double), intent(out), dimension(n_selected_vectors), target :: tissue_angles_deg Output, real array, length = n_selected_vectors, stores the calculated angles in degrees integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/compute_tissue_versatility_c.html"},{"title":"calc_neighborhood_size_c – TensorOmics","text":"public  subroutine calc_neighborhood_size_c(n_pool, n_points, n_genes_S, mean_S, desired_size, n_neighbors, ierr) bind(C, name=\"calc_neighborhood_size_c\") Uses tox_data_integration_preprocessing_impl The desired_size works as upper limit, as the actual neighborhood size might be lower\ndue to few genes with non-NaN mean. Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_pool Total number of pooled mean-expression values across both studies integer(kind=c_int), intent(in), target :: n_points Number of reference points integer(kind=c_int), intent(in), target :: n_genes_S Number of genes in the current study real(kind=c_double), intent(in), dimension(n_genes_S), target :: mean_S Per-gene mean expression values\nNaN is permitted for this value. integer(kind=c_int), intent(in), target :: desired_size Optional desired neighborhood size\nThe default value is 1000 . integer(kind=c_int), intent(out), target :: n_neighbors Calculated neighborhood size integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"proc/calc_neighborhood_size_c.html"},{"title":"fjct_compute_jsd – TensorOmics","text":"public pure subroutine fjct_compute_jsd(family_idx, gene_to_family_S1, gene_to_family_S2, n_genes_S1, n_genes_S2, neighborhood_residuals_S1, neighborhood_residuals_S2, neighborhood_genes_S1, neighborhood_genes_S2, n_reps_S1, n_reps_S2, n_neighbors, n_points, n_bins, shared_residual_range, js_divergences, included_n_reps_S1, included_n_reps_S2, total_included_n_reps, global_js_divergence, weights, ierr) Reuses the same conditioning-on-mean-expression pipeline as the global gJCT, but restricts\nthe residual samples to the genes belonging to the family family_idx . Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: family_idx Index of the family that should be analyzed\nThe minimum valid value is 1_int32 . integer(kind=int32), intent(in), dimension(n_genes_S1) :: gene_to_family_S1 Mapping for study 1: Each index (gene) holds the index of its family\nThe minimum valid value is 0_int32 . integer(kind=int32), intent(in), dimension(n_genes_S2) :: gene_to_family_S2 Mapping for study 2: Each index (gene) holds the index of its family\nThe minimum valid value is 0_int32 . integer(kind=int32), intent(in) :: n_genes_S1 Number of genes in study 1 integer(kind=int32), intent(in) :: n_genes_S2 Number of genes in study 2 real(kind=real64), intent(in), dimension(n_reps_S1, n_neighbors, n_points) :: neighborhood_residuals_S1 Computed neighborhood residuals for study 1, NaN is explicitly allowed for missing values\nNaN is permitted for this value. real(kind=real64), intent(in), dimension(n_reps_S2, n_neighbors, n_points) :: neighborhood_residuals_S2 Computed neighborhood residuals for study 2, NaN is explicitly allowed for missing values\nNaN is permitted for this value. integer(kind=int32), intent(in), dimension(n_neighbors, n_points) :: neighborhood_genes_S1 Indices of the selected neighborhood genes of study 1\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_genes_S1 . integer(kind=int32), intent(in), dimension(n_neighbors, n_points) :: neighborhood_genes_S2 Indices of the selected neighborhood genes of study 2\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_genes_S2 . integer(kind=int32), intent(in) :: n_reps_S1 Number of replicates in study 1 integer(kind=int32), intent(in) :: n_reps_S2 Number of replicates in study 2 integer(kind=int32), intent(in) :: n_neighbors Number of neighbors in the studies integer(kind=int32), intent(in) :: n_points Number of reference points in the studies integer(kind=int32), intent(in) :: n_bins Number of equally sized histogram bins used for the studies real(kind=real64), intent(in) :: shared_residual_range Computed residual range for both studies\nThe minimum valid value is 0.0_real64 . real(kind=real64), intent(out), dimension(n_points) :: js_divergences Jensen-Shannon divergence per reference point, computed for studies S1 and S2 integer(kind=int32), intent(out), dimension(n_points) :: included_n_reps_S1 Count of non-NaN residuals (included ones) in study 1 integer(kind=int32), intent(out), dimension(n_points) :: included_n_reps_S2 Count of non-NaN residuals (included ones) in study 2 integer(kind=int32), intent(out) :: total_included_n_reps Total number of included replicates from both studies ( ) real(kind=real64), intent(out) :: global_js_divergence Weighted global Jensen-Shannon divergence real(kind=real64), intent(out), dimension(n_points) :: weights Weights used for calculating the global weighted Jensen-Shannon divergence global_js_divergence integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/fjct_compute_jsd.html"},{"title":"fjct_compute_jsd_expert – TensorOmics","text":"public pure subroutine fjct_compute_jsd_expert(family_idx, gene_to_family_S1, gene_to_family_S2, n_genes_S1, n_genes_S2, neighborhood_residuals_S1, neighborhood_residuals_S2, neighborhood_genes_S1, neighborhood_genes_S2, n_reps_S1, n_reps_S2, n_neighbors, n_points, n_bins, shared_residual_range, js_divergences, included_n_reps_S1, included_n_reps_S2, total_included_n_reps, global_js_divergence, weights, tmp_neighbor_mask_S1, tmp_neighbor_mask_S2, tmp_pmf_S1, tmp_pmf_S2, tmp_counts, ierr) Reuses the same conditioning-on-mean-expression pipeline as the global gJCT, but restricts\nthe residual samples to the genes belonging to the family family_idx . Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: family_idx Index of the family that should be analyzed\nThe minimum valid value is 1_int32 . integer(kind=int32), intent(in), dimension(n_genes_S1) :: gene_to_family_S1 Mapping for study 1: Each index (gene) holds the index of its family\nThe minimum valid value is 0_int32 . integer(kind=int32), intent(in), dimension(n_genes_S2) :: gene_to_family_S2 Mapping for study 2: Each index (gene) holds the index of its family\nThe minimum valid value is 0_int32 . integer(kind=int32), intent(in) :: n_genes_S1 Number of genes in study 1 integer(kind=int32), intent(in) :: n_genes_S2 Number of genes in study 2 real(kind=real64), intent(in), dimension(n_reps_S1, n_neighbors, n_points) :: neighborhood_residuals_S1 Computed neighborhood residuals for study 1, NaN is explicitly allowed for missing values\nNaN is permitted for this value. real(kind=real64), intent(in), dimension(n_reps_S2, n_neighbors, n_points) :: neighborhood_residuals_S2 Computed neighborhood residuals for study 2, NaN is explicitly allowed for missing values\nNaN is permitted for this value. integer(kind=int32), intent(in), dimension(n_neighbors, n_points) :: neighborhood_genes_S1 Indices of the selected neighborhood genes of study 1\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_genes_S1 . integer(kind=int32), intent(in), dimension(n_neighbors, n_points) :: neighborhood_genes_S2 Indices of the selected neighborhood genes of study 2\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_genes_S2 . integer(kind=int32), intent(in) :: n_reps_S1 Number of replicates in study 1 integer(kind=int32), intent(in) :: n_reps_S2 Number of replicates in study 2 integer(kind=int32), intent(in) :: n_neighbors Number of neighbors in the studies integer(kind=int32), intent(in) :: n_points Number of reference points in the studies integer(kind=int32), intent(in) :: n_bins Number of equally sized histogram bins used for the studies real(kind=real64), intent(in) :: shared_residual_range Computed residual range for both studies\nThe minimum valid value is 0.0_real64 . real(kind=real64), intent(out), dimension(n_points) :: js_divergences Jensen-Shannon divergence per reference point, computed for studies S1 and S2 integer(kind=int32), intent(out), dimension(n_points) :: included_n_reps_S1 Count of non-NaN residuals (included ones) in study 1 integer(kind=int32), intent(out), dimension(n_points) :: included_n_reps_S2 Count of non-NaN residuals (included ones) in study 2 integer(kind=int32), intent(out) :: total_included_n_reps Total number of included replicates from both studies ( ) real(kind=real64), intent(out) :: global_js_divergence Weighted global Jensen-Shannon divergence real(kind=real64), intent(out), dimension(n_points) :: weights Weights used for calculating the global weighted Jensen-Shannon divergence global_js_divergence logical(kind=c_bool), intent(out), dimension(n_neighbors, n_points) :: tmp_neighbor_mask_S1 Work array for the mask selecting study 1's neighbors that belong to family_idx logical(kind=c_bool), intent(out), dimension(n_neighbors, n_points) :: tmp_neighbor_mask_S2 Work array for the mask selecting study 2's neighbors that belong to family_idx real(kind=real64), intent(out), dimension(n_points, n_bins) :: tmp_pmf_S1 Work array for study 1's normalized histogram counts real(kind=real64), intent(out), dimension(n_points, n_bins) :: tmp_pmf_S2 Work array for study 2's normalized histogram counts integer(kind=int32), intent(out), dimension(n_points, n_bins) :: tmp_counts Work array for the histogram counts integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/fjct_compute_jsd_expert.html"},{"title":"fjct_compute_masked_jsd – TensorOmics","text":"public pure subroutine fjct_compute_masked_jsd(neighborhood_residuals_S1, neighborhood_residuals_S2, n_reps_S1, n_reps_S2, n_neighbors, n_points, neighbor_mask_S1, neighbor_mask_S2, n_bins, shared_residual_range, js_divergences, included_n_reps_S1, included_n_reps_S2, total_included_n_reps, global_js_divergence, weights, pmf_S1, pmf_S2, ierr) Reuses the same conditioning-on-mean-expression pipeline as the global gJCT, but restricts the\nresidual samples to the neighbors selected by neighbor_mask_S1 / neighbor_mask_S2 . Typically\nthose are all neighbors belonging to one gene family, which is what fjct_compute_jsd builds\nthe masks for from a family index. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_reps_S1, n_neighbors, n_points) :: neighborhood_residuals_S1 Computed neighborhood residuals for study 1, NaN is explicitly allowed for missing values\nNaN is permitted for this value. real(kind=real64), intent(in), dimension(n_reps_S2, n_neighbors, n_points) :: neighborhood_residuals_S2 Computed neighborhood residuals for study 2, NaN is explicitly allowed for missing values\nNaN is permitted for this value. integer(kind=int32), intent(in) :: n_reps_S1 Number of replicates in study 1 integer(kind=int32), intent(in) :: n_reps_S2 Number of replicates in study 2 integer(kind=int32), intent(in) :: n_neighbors Number of neighbors in the studies integer(kind=int32), intent(in) :: n_points Number of reference points in the studies logical(kind=c_bool), intent(in), dimension(n_neighbors, n_points) :: neighbor_mask_S1 Mask selecting the neighbors of study 1 to include logical(kind=c_bool), intent(in), dimension(n_neighbors, n_points) :: neighbor_mask_S2 Mask selecting the neighbors of study 2 to include integer(kind=int32), intent(in) :: n_bins Number of equally sized histogram bins used for the studies real(kind=real64), intent(in) :: shared_residual_range Computed residual range for both studies\nThe minimum valid value is 0.0_real64 . real(kind=real64), intent(out), dimension(n_points) :: js_divergences Jensen-Shannon divergence per reference point, computed for studies S1 and S2 integer(kind=int32), intent(out), dimension(n_points) :: included_n_reps_S1 Count of non-NaN residuals (included ones) in study 1 integer(kind=int32), intent(out), dimension(n_points) :: included_n_reps_S2 Count of non-NaN residuals (included ones) in study 2 integer(kind=int32), intent(out) :: total_included_n_reps Total number of included replicates from both studies ( ) real(kind=real64), intent(out) :: global_js_divergence Weighted global Jensen-Shannon divergence real(kind=real64), intent(out), dimension(n_points) :: weights Weights used for calculating the global weighted Jensen-Shannon divergence global_js_divergence real(kind=real64), intent(out), dimension(n_points, n_bins) :: pmf_S1 Normalized histogram counts for study 1 real(kind=real64), intent(out), dimension(n_points, n_bins) :: pmf_S2 Normalized histogram counts for study 2 integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/fjct_compute_masked_jsd.html"},{"title":"fjct_compute_masked_jsd_expert – TensorOmics","text":"public pure subroutine fjct_compute_masked_jsd_expert(neighborhood_residuals_S1, neighborhood_residuals_S2, n_reps_S1, n_reps_S2, n_neighbors, n_points, neighbor_mask_S1, neighbor_mask_S2, n_bins, shared_residual_range, js_divergences, included_n_reps_S1, included_n_reps_S2, total_included_n_reps, global_js_divergence, weights, pmf_S1, pmf_S2, tmp_counts, ierr) Reuses the same conditioning-on-mean-expression pipeline as the global gJCT, but restricts the\nresidual samples to the neighbors selected by neighbor_mask_S1 / neighbor_mask_S2 . Typically\nthose are all neighbors belonging to one gene family, which is what fjct_compute_jsd builds\nthe masks for from a family index. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_reps_S1, n_neighbors, n_points) :: neighborhood_residuals_S1 Computed neighborhood residuals for study 1, NaN is explicitly allowed for missing values\nNaN is permitted for this value. real(kind=real64), intent(in), dimension(n_reps_S2, n_neighbors, n_points) :: neighborhood_residuals_S2 Computed neighborhood residuals for study 2, NaN is explicitly allowed for missing values\nNaN is permitted for this value. integer(kind=int32), intent(in) :: n_reps_S1 Number of replicates in study 1 integer(kind=int32), intent(in) :: n_reps_S2 Number of replicates in study 2 integer(kind=int32), intent(in) :: n_neighbors Number of neighbors in the studies integer(kind=int32), intent(in) :: n_points Number of reference points in the studies logical(kind=c_bool), intent(in), dimension(n_neighbors, n_points) :: neighbor_mask_S1 Mask selecting the neighbors of study 1 to include logical(kind=c_bool), intent(in), dimension(n_neighbors, n_points) :: neighbor_mask_S2 Mask selecting the neighbors of study 2 to include integer(kind=int32), intent(in) :: n_bins Number of equally sized histogram bins used for the studies real(kind=real64), intent(in) :: shared_residual_range Computed residual range for both studies\nThe minimum valid value is 0.0_real64 . real(kind=real64), intent(out), dimension(n_points) :: js_divergences Jensen-Shannon divergence per reference point, computed for studies S1 and S2 integer(kind=int32), intent(out), dimension(n_points) :: included_n_reps_S1 Count of non-NaN residuals (included ones) in study 1 integer(kind=int32), intent(out), dimension(n_points) :: included_n_reps_S2 Count of non-NaN residuals (included ones) in study 2 integer(kind=int32), intent(out) :: total_included_n_reps Total number of included replicates from both studies ( ) real(kind=real64), intent(out) :: global_js_divergence Weighted global Jensen-Shannon divergence real(kind=real64), intent(out), dimension(n_points) :: weights Weights used for calculating the global weighted Jensen-Shannon divergence global_js_divergence real(kind=real64), intent(out), dimension(n_points, n_bins) :: pmf_S1 Normalized histogram counts for study 1 real(kind=real64), intent(out), dimension(n_points, n_bins) :: pmf_S2 Normalized histogram counts for study 2 integer(kind=int32), intent(out), dimension(n_points, n_bins) :: tmp_counts Work array for the histogram counts integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/fjct_compute_masked_jsd_expert.html"},{"title":"fjct_compute_contribution_scores – TensorOmics","text":"public pure subroutine fjct_compute_contribution_scores(global_js_divergences, total_included_n_reps_per_f, k_families, support_weights, contribution_scores, ierr) Combines how divergent the family is between the studies ( global_js_divergences ), and how much residual support the family has overall ( total_included_n_reps_per_f ), using the outputs of fjct_compute_jsd , collected for the analyzed sub-neighborhoods. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(k_families) :: global_js_divergences Per-sub-neighborhood weighted global JSD\nThe minimum valid value is 0.0_real64 . integer(kind=int32), intent(in), dimension(k_families) :: total_included_n_reps_per_f Per-sub-neighborhood total_included_n_reps The minimum valid value is 0_int32 . integer(kind=int32), intent(in) :: k_families Number of sub-neighborhoods analyzed real(kind=real64), intent(out), dimension(k_families) :: support_weights Per-sub-neighborhood calculated support weight (ratio between its total_included_n_reps and sum(total_included_n_reps_per_f) , zero if there were no replicates included at all) real(kind=real64), intent(out), dimension(k_families) :: contribution_scores Per-sub-neighborhood calculated contribution ( ) integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/fjct_compute_contribution_scores.html"},{"title":"build_bst_index – TensorOmics","text":"public pure subroutine build_bst_index(values, n_values, sorted_indices, ierr) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_values) :: values Input real array to be indexed integer(kind=int32), intent(in) :: n_values Number of elements in values array integer(kind=int32), intent(out), dimension(n_values) :: sorted_indices Output permutation index integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/build_bst_index.html"},{"title":"bst_range_query – TensorOmics","text":"public pure subroutine bst_range_query(values, n_values, lower_bound, upper_bound, output_indices, n_matches, ierr) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_values) :: values Input real array integer(kind=int32), intent(in) :: n_values Number of elements real(kind=real64), intent(in) :: lower_bound Lower bound of range (inclusive)\nThe maximum valid value is upper_bound . real(kind=real64), intent(in) :: upper_bound Upper bound of range (inclusive) integer(kind=int32), intent(out), dimension(n_values) :: output_indices Output array of matching indices.\nThe first n_matches elements will hold the results. integer(kind=int32), intent(out) :: n_matches Number of matches found integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/bst_range_query.html"},{"title":"bst_range_query_expert – TensorOmics","text":"public pure subroutine bst_range_query_expert(values, values_perm, n_values, lower_bound, upper_bound, output_indices, n_matches, ierr) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_values) :: values Input real array integer(kind=int32), intent(in), dimension(n_values) :: values_perm Permutation of values in ascending order -- the BST index. The allocating entry\npoint builds and heapsorts it for you; the expert one takes whatever order you\nsupply, so a caller that already holds one from build_bst_index can reuse it across queries.\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_values . integer(kind=int32), intent(in) :: n_values Number of elements real(kind=real64), intent(in) :: lower_bound Lower bound of range (inclusive)\nThe maximum valid value is upper_bound . real(kind=real64), intent(in) :: upper_bound Upper bound of range (inclusive) integer(kind=int32), intent(out), dimension(n_values) :: output_indices Output array of matching indices.\nThe first n_matches elements will hold the results. integer(kind=int32), intent(out) :: n_matches Number of matches found integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/bst_range_query_expert.html"},{"title":"normalize_unit_length_impl – TensorOmics","text":"public pure subroutine normalize_unit_length_impl(vector, n_dims, ierr) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(inout), dimension(n_dims) :: vector Vector that will be normalized to unit length\nNaN is permitted for this value.\nInfinite values are permitted for this value. integer(kind=int32), intent(in) :: n_dims number of elements in vector integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/normalize_unit_length_impl.html"},{"title":"normalization_pipeline_impl – TensorOmics","text":"public  subroutine normalization_pipeline_impl(n_genes, n_replicates, expr, log_transformed_expr, reps_per_tissue, n_tissues, tmp_expr_copy, tmp_loess_y, tmp_indices_used, tmp_yhat_global, tmp_int_workspace, int_workspace_size, tmp_real_workspace, real_workspace_size, tmp_hat_diag, tmp_loess_weights, tmp_eval_points, tmp_robust_weights, tmp_combined_weights, tmp_residuals, tmp_permutation_indices, span, degree, use_quantile, ierr) Final result is in log_transformed_expr. If fold change is needed, call calc_fchange separately. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Number of genes (rows) integer(kind=int32), intent(in) :: n_replicates Number of replicates per gene real(kind=real64), intent(in), dimension(n_replicates, n_genes) :: expr Gene Expression matrix\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(out), dimension(n_tissues, n_genes), target :: log_transformed_expr Log-transformed grouped expr integer(kind=int32), intent(in), dimension(n_tissues) :: reps_per_tissue Number of replicates per tissue in expr . It describes, which slices in expr relate to which tissue,\ne.g. [2,3] means 5 total replicates per gene, the first two of which belong to the first tissue and the remaining three to the second. integer(kind=int32), intent(in) :: n_tissues Number of tissues real(kind=real64), intent(out), dimension(n_replicates, n_genes) :: tmp_expr_copy Work matrix the pipeline normalizes in place real(kind=real64), intent(out), dimension(n_genes), target :: tmp_loess_y Work vector for the empirical standard deviations (Y-axis for LOESS) integer(kind=int32), intent(out), dimension(n_genes) :: tmp_indices_used Work vector mapping the fitted points back to gene indices real(kind=real64), intent(out), dimension(n_genes), target :: tmp_yhat_global Work vector for the fitted standard deviations (LOESS predictions) integer(kind=int32), intent(out), dimension(int_workspace_size) :: tmp_int_workspace Integer workspace array integer(kind=int32), intent(in) :: int_workspace_size Length of integer workspace.\nIt is VERY IMPORTANT to compute this argument from the int_workspace_size output produced by tox_loess_required_workspace . Producer input Supplied by n_dim 1_int32 max_neighborhood_size n_genes save_factorization .false. real(kind=real64), intent(out), dimension(real_workspace_size) :: tmp_real_workspace Real workspace array integer(kind=int32), intent(in) :: real_workspace_size Length of real workspace.\nIt is VERY IMPORTANT to compute this argument from the real_workspace_size output produced by tox_loess_required_workspace . Producer input Supplied by n_dim 1_int32 max_neighborhood_size n_genes save_factorization .false. real(kind=real64), intent(out), dimension(n_genes) :: tmp_hat_diag Diagonal elements of the LOESS hat matrix real(kind=real64), intent(out), dimension(n_genes) :: tmp_loess_weights Per-point weights handed to the LOESS fit real(kind=real64), intent(out), dimension(n_genes, 1) :: tmp_eval_points Points the fitted curve is evaluated at real(kind=real64), intent(out), dimension(n_genes) :: tmp_robust_weights Robust bisquare weights of the LOESS fit real(kind=real64), intent(out), dimension(n_genes) :: tmp_combined_weights Combined weights of the LOESS fit real(kind=real64), intent(out), dimension(n_genes) :: tmp_residuals Residuals of the LOESS fit integer(kind=int32), intent(out), dimension(n_genes) :: tmp_permutation_indices Permutation indices of the LOESS fit real(kind=real64), intent(in), optional :: span LOESS span parameter.\nThe default value is 0.7_real64 . integer(kind=int32), intent(in), optional :: degree LOESS degree parameter.\nThe default value is 2_int32 . logical(kind=c_bool), intent(in), optional :: use_quantile Use quantile normalization.\nThe default value is .false. . integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/normalization_pipeline_impl.html"},{"title":"normalize_by_std_dev_impl – TensorOmics","text":"public  subroutine normalize_by_std_dev_impl(n_genes, n_replicates, expr, normalized_expr, tmp_loess_x, tmp_loess_y, tmp_indices_used, tmp_yhat_global, tmp_int_workspace, int_workspace_size, tmp_real_workspace, real_workspace_size, tmp_hat_diag, tmp_loess_weights, tmp_eval_points, tmp_robust_weights, tmp_combined_weights, tmp_residuals, tmp_permutation_indices, span, degree, ierr) This procedure applies a global stabilization based on the relationship between\ngene-wise mean expression and empirical standard deviation. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Number of genes (rows) integer(kind=int32), intent(in) :: n_replicates Number of replicates per gene real(kind=real64), intent(in), dimension(n_replicates, n_genes) :: expr Gene Expression matrix\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(out), dimension(n_replicates, n_genes) :: normalized_expr Normalized expr real(kind=real64), intent(out), dimension(n_genes) :: tmp_loess_x Work vector for the mean values (X-axis for LOESS) real(kind=real64), intent(out), dimension(n_genes) :: tmp_loess_y Work vector for the empirical standard deviations (Y-axis for LOESS) integer(kind=int32), intent(out), dimension(n_genes) :: tmp_indices_used Work vector mapping the fitted points back to gene indices real(kind=real64), intent(out), dimension(n_genes) :: tmp_yhat_global Work vector for the fitted standard deviations (LOESS predictions) integer(kind=int32), intent(out), dimension(int_workspace_size) :: tmp_int_workspace Integer workspace array integer(kind=int32), intent(in) :: int_workspace_size Length of integer workspace.\nIt is VERY IMPORTANT to compute this argument from the int_workspace_size output produced by tox_loess_required_workspace . Producer input Supplied by n_dim 1_int32 max_neighborhood_size n_genes save_factorization .false. real(kind=real64), intent(out), dimension(real_workspace_size) :: tmp_real_workspace Real workspace array integer(kind=int32), intent(in) :: real_workspace_size Length of real workspace.\nIt is VERY IMPORTANT to compute this argument from the real_workspace_size output produced by tox_loess_required_workspace . Producer input Supplied by n_dim 1_int32 max_neighborhood_size n_genes save_factorization .false. real(kind=real64), intent(out), dimension(n_genes) :: tmp_hat_diag Diagonal elements of the LOESS hat matrix real(kind=real64), intent(out), dimension(n_genes) :: tmp_loess_weights Per-point weights handed to the LOESS fit real(kind=real64), intent(out), dimension(n_genes, 1) :: tmp_eval_points Points the fitted curve is evaluated at real(kind=real64), intent(out), dimension(n_genes) :: tmp_robust_weights Robust bisquare weights of the LOESS fit real(kind=real64), intent(out), dimension(n_genes) :: tmp_combined_weights Combined weights of the LOESS fit real(kind=real64), intent(out), dimension(n_genes) :: tmp_residuals Residuals of the LOESS fit integer(kind=int32), intent(out), dimension(n_genes) :: tmp_permutation_indices Permutation indices of the LOESS fit real(kind=real64), intent(in), optional :: span LOESS span parameter.\nThe default value is 0.7_real64 . integer(kind=int32), intent(in), optional :: degree LOESS degree parameter.\nThe default value is 2_int32 . integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/normalize_by_std_dev_impl.html"},{"title":"normalize_by_std_dev_inplace_helper – TensorOmics","text":"public  subroutine normalize_by_std_dev_inplace_helper(n_genes, n_replicates, expr, tmp_loess_x, tmp_loess_y, tmp_indices_used, tmp_yhat_global, tmp_int_workspace, int_workspace_size, tmp_real_workspace, real_workspace_size, tmp_hat_diag, tmp_loess_weights, tmp_eval_points, tmp_robust_weights, tmp_combined_weights, tmp_residuals, tmp_permutation_indices, span, degree, ierr) Normalizes each gene's expression vector using LOESS-stabilized standard deviation.\nThis procedure applies a global stabilization based on the relationship between\ngene-wise mean expression and empirical standard deviation. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Number of genes (rows) integer(kind=int32), intent(in) :: n_replicates Number of replicates per gene real(kind=real64), intent(inout), dimension(n_replicates, n_genes) :: expr Gene Expression matrix real(kind=real64), intent(out), dimension(n_genes) :: tmp_loess_x Mean values (X-axis for LOESS) real(kind=real64), intent(out), dimension(n_genes) :: tmp_loess_y Empirical standard deviation values (Y-axis for LOESS) integer(kind=int32), intent(out), dimension(n_genes) :: tmp_indices_used Mapping back to gene indices real(kind=real64), intent(out), dimension(n_genes) :: tmp_yhat_global Fitted standard deviation values (LOESS predictions) integer(kind=int32), intent(out), dimension(int_workspace_size) :: tmp_int_workspace Integer workspace array integer(kind=int32), intent(in) :: int_workspace_size Length of integer workspace real(kind=real64), intent(out), dimension(real_workspace_size) :: tmp_real_workspace Real workspace array integer(kind=int32), intent(in) :: real_workspace_size Length of real workspace real(kind=real64), intent(out), dimension(n_genes) :: tmp_hat_diag Diagonal elements of the LOESS hat matrix real(kind=real64), intent(out), dimension(n_genes) :: tmp_loess_weights Per-point weights handed to the LOESS fit real(kind=real64), intent(out), dimension(n_genes, 1) :: tmp_eval_points Points the fitted curve is evaluated at real(kind=real64), intent(out), dimension(n_genes) :: tmp_robust_weights Robust bisquare weights of the LOESS fit real(kind=real64), intent(out), dimension(n_genes) :: tmp_combined_weights Combined weights of the LOESS fit real(kind=real64), intent(out), dimension(n_genes) :: tmp_residuals Residuals of the LOESS fit integer(kind=int32), intent(out), dimension(n_genes) :: tmp_permutation_indices Permutation indices of the LOESS fit real(kind=real64), intent(in), optional :: span LOESS span parameter.\nThe default value is 0.7_real64 . integer(kind=int32), intent(in), optional :: degree LOESS degree parameter.\nThe default value is 2_int32 . integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/normalize_by_std_dev_inplace_helper.html"},{"title":"root_mean_sq_normalization_impl – TensorOmics","text":"public pure subroutine root_mean_sq_normalization_impl(n_genes, n_replicates, expr, normalized_expr) across tissues (not classical standard deviation). Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Number of genes (rows) integer(kind=int32), intent(in) :: n_replicates Number of replicates per gene real(kind=real64), intent(in), dimension(n_replicates, n_genes) :: expr Gene Expression matrix\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(out), dimension(n_replicates, n_genes) :: normalized_expr Normalized expr","tags":"","url":"proc/root_mean_sq_normalization_impl.html"},{"title":"root_mean_sq_normalization_inplace_helper – TensorOmics","text":"public pure subroutine root_mean_sq_normalization_inplace_helper(n_genes, n_replicates, expr) Normalizes each gene's expression vector using sqrt(mean(x&#94;2)) across tissues (not classical standard deviation). Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Number of genes (rows) integer(kind=int32), intent(in) :: n_replicates Number of replicates per gene real(kind=real64), intent(inout), dimension(n_replicates, n_genes) :: expr Gene Expression matrix","tags":"","url":"proc/root_mean_sq_normalization_inplace_helper.html"},{"title":"quantile_normalization_impl – TensorOmics","text":"public pure subroutine quantile_normalization_impl(n_genes, n_replicates, expr, normalized_expr, rank_means, tmp_genes_row, tmp_perm) Computes average expression per rank across tissues. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Number of genes (rows) integer(kind=int32), intent(in) :: n_replicates Number of replicates per gene real(kind=real64), intent(in), dimension(n_replicates, n_genes) :: expr Gene Expression matrix\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(out), dimension(n_replicates, n_genes) :: normalized_expr Normalized expr real(kind=real64), intent(out), dimension(n_genes) :: rank_means The mean of each rank across tissues, one per gene real(kind=real64), intent(out), dimension(n_genes) :: tmp_genes_row Temporary vector for sorting a tissue in expr across genes integer(kind=int32), intent(out), dimension(n_genes) :: tmp_perm Permutation vector","tags":"","url":"proc/quantile_normalization_impl.html"},{"title":"quantile_normalization_inplace_helper – TensorOmics","text":"public pure subroutine quantile_normalization_inplace_helper(n_genes, n_replicates, expr, rank_means, tmp_genes_row, tmp_perm) Uses f42_sort_impl Quantile normalization of a gene expression matrix (F42-compliant).\nComputes average expression per rank across tissues. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Number of genes (rows) integer(kind=int32), intent(in) :: n_replicates Number of replicates per gene real(kind=real64), intent(inout), dimension(n_replicates, n_genes) :: expr Gene Expression matrix real(kind=real64), intent(out), dimension(n_genes) :: rank_means The mean of each rank across tissues, one per gene real(kind=real64), intent(out), dimension(n_genes) :: tmp_genes_row Temporary vector for sorting a tissue in expr across genes integer(kind=int32), intent(out), dimension(n_genes) :: tmp_perm Permutation vector","tags":"","url":"proc/quantile_normalization_inplace_helper.html"},{"title":"log2_transformation_impl – TensorOmics","text":"public pure subroutine log2_transformation_impl(n_genes, n_tissues, expr, transformed_expr, ierr) This subroutine performs element-wise log2(x + 1) transformation on a\nmatrix flattened in column-major order. The log2 is computed via: log(x + 1) / log(2) , which is numerically equivalent and avoids the\nnon-portable log2 intrinsic for compatibility with WebAssembly (WASM). Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Number of genes (rows) integer(kind=int32), intent(in) :: n_tissues Number of tissues real(kind=real64), intent(in), dimension(n_tissues, n_genes) :: expr Gene Expression matrix, from calc_tiss_avg NaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(out), dimension(n_tissues, n_genes) :: transformed_expr Log-transformed expr integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/log2_transformation_impl.html"},{"title":"log2_transformation_inplace_helper – TensorOmics","text":"public pure subroutine log2_transformation_inplace_helper(n_genes, n_tissues, expr, ierr) Apply log2(x + 1) transformation to each element of the input matrix.\nThis subroutine performs element-wise log2(x + 1) transformation on a\nmatrix flattened in column-major order. The log2 is computed via: log(x + 1) / log(2) , which is numerically equivalent and avoids the\nnon-portable log2 intrinsic for compatibility with WebAssembly (WASM). Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Number of genes (rows) integer(kind=int32), intent(in) :: n_tissues Number of tissues real(kind=real64), intent(inout), dimension(n_tissues, n_genes) :: expr Gene Expression matrix, from calc_tiss_avg integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/log2_transformation_inplace_helper.html"},{"title":"calc_tiss_avg_impl – TensorOmics","text":"public pure subroutine calc_tiss_avg_impl(n_genes, n_tissues, reps_per_tissue, expr, tissue_averages) For each tissue of tissue replicates, this subroutine computes the average\nexpression per gene. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Number of genes (rows) integer(kind=int32), intent(in) :: n_tissues Number of tissues integer(kind=int32), intent(in), dimension(n_tissues) :: reps_per_tissue Number of replicates per tissue in expr . It describes, which slices in expr relate to which tissue,\ne.g. [2,3] means 5 total replicates per gene, the first two of which belong to the first tissue and the remaining three to the second.\nThe minimum valid value is 1_int32 . real(kind=real64), intent(in), dimension(sum(reps_per_tissue), n_genes) :: expr Gene Expression matrix\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(out), dimension(n_tissues, n_genes) :: tissue_averages Tissue averages per gene","tags":"","url":"proc/calc_tiss_avg_impl.html"},{"title":"calc_tiss_avg_helper – TensorOmics","text":"public pure subroutine calc_tiss_avg_helper(n_genes, n_tissues, reps_per_tissue, expr, tissue_averages) (no input validation) Calculate tissue averages by averaging replicates within each group.\nFor each group of tissue replicates, this subroutine computes the average\nexpression per gene. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Number of genes (rows) integer(kind=int32), intent(in) :: n_tissues Number of tissues integer(kind=int32), intent(in), dimension(n_tissues) :: reps_per_tissue Number of replicates per tissue in expr . It describes, which slices in expr relate to which tissue,\ne.g. [2,3] means 5 total replicates per gene, the first two of which belong to the first tissue and the remaining three to the second. real(kind=real64), intent(in), dimension(sum(reps_per_tissue), n_genes) :: expr Gene Expression matrix real(kind=real64), intent(out), dimension(n_tissues, n_genes) :: tissue_averages Tissue averages per gene","tags":"","url":"proc/calc_tiss_avg_helper.html"},{"title":"calc_fchange_impl – TensorOmics","text":"public pure subroutine calc_fchange_impl(n_genes, n_tissues, n_pairs, control_tissues, condition_tissues, expr, fold_changes) For each control-condition pair, this subroutine computes the log2 fold change by subtracting the expression value in the control group from the corresponding\nvalue in the condition group, for all genes. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Number of genes (rows) integer(kind=int32), intent(in) :: n_tissues Number of tissues integer(kind=int32), intent(in) :: n_pairs Number of control-condition pairs integer(kind=int32), intent(in), dimension(n_pairs) :: control_tissues Control tissue indices\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_tissues . integer(kind=int32), intent(in), dimension(n_pairs) :: condition_tissues Condition tissue indices\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_tissues . real(kind=real64), intent(in), dimension(n_tissues, n_genes) :: expr Gene Expression matrix, from calc_tiss_avg NaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(out), dimension(n_pairs, n_genes) :: fold_changes Output matrix for fold changes","tags":"","url":"proc/calc_fchange_impl.html"},{"title":"get_array_metadata_c – TensorOmics","text":"public  subroutine get_array_metadata_c(filename, filename_strlen, dims_out, dims_out_capacity, ndims, type_code, ierr) bind(C, name=\"get_array_metadata_c\") Uses f42_serde_arrays_utils Arguments Type Intent Optional Attributes Name character(kind=c_char, len=1), intent(in), dimension(filename_strlen), target :: filename Name of the file integer(kind=c_int), intent(in), target :: filename_strlen length of the strings in filename integer(kind=c_int), intent(out), dimension(dims_out_capacity), target :: dims_out Array to store output dimensions\nThe first ndims elements will hold the results. integer(kind=c_int), intent(in), target :: dims_out_capacity Capacity of the dims_out array integer(kind=c_int), intent(out), target :: ndims number of dimensions integer(kind=c_int), intent(out), target :: type_code Type code of the serialized array Type Code integer -1_int32 real -2_int32 complex -4_int32 logical -3_int32 character string length integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"proc/get_array_metadata_c.html"},{"title":"loess_degenerate_fit – TensorOmics","text":"public pure subroutine loess_degenerate_fit(n, x, y, degree, fitted_values, handled, ierr) The prologue of both LOESS fitting implementations. A single point, an x range below EPS_LOESS , or fewer distinct x values than the polynomial degree needs cannot\nproduce a meaningful fit; rather than hand netlib an input it cannot answer, the fitted\nvalues are the observations themselves and the call reports handled , so the implementation is\nskipped. This is policy, not validation, which is why it lives here and not in the\nimplementations: they fit, and assume they were given something fittable. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n Total number of data points real(kind=real64), intent(in), dimension(n) :: x Predictor variable array real(kind=real64), intent(in), dimension(n) :: y Response variable array integer(kind=int32), intent(in) :: degree Degree of the LOESS polynomial real(kind=real64), intent(out), dimension(n) :: fitted_values Fitted values, written only when the fit was answered here logical(kind=c_bool), intent(out) :: handled .true. when the data was degenerate and fitted_values already holds the answer integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/loess_degenerate_fit.html"},{"title":"tox_loess_required_workspace – TensorOmics","text":"public  subroutine tox_loess_required_workspace(n_dim, max_neighborhood_size, int_workspace_size, real_workspace_size, save_factorization) Computes the required sizes for integer and real workspace arrays.\nThese sizes depend on the dimensionality of the data and the maximum neighborhood size. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_dim Dimensionality of the data integer(kind=int32), intent(in) :: max_neighborhood_size Maximum neighborhood size integer(kind=int32), intent(out) :: int_workspace_size Required size of the integer workspace array integer(kind=int32), intent(out) :: real_workspace_size Required size of the real workspace array logical(kind=c_bool), intent(in) :: save_factorization Save matrix factorization flag","tags":"C-binding","url":"proc/tox_loess_required_workspace.html"},{"title":"loess_fit_plain_impl – TensorOmics","text":"public  subroutine loess_fit_plain_impl(n, x, y, weights, eval_points, span, degree, max_neighborhood_size, compute_influence, save_factorization, tmp_int_workspace, int_workspace_size, tmp_real_workspace, real_workspace_size, tmp_hat_diag, fitted_values, ierr) Data too degenerate to fit is answered directly, by the observations themselves; see loess_degenerate_fit .\nFits a LOESS model to the data using the specified smoothing parameter and outputs the smoothed\nresponse array. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n Total number of data points real(kind=real64), intent(in) :: x (n) Predictor variable array real(kind=real64), intent(in) :: y (n) Response variable array real(kind=real64), intent(in) :: weights (n) Weight array for data points real(kind=real64), intent(in) :: eval_points (n,1) Evaluation points (x values at which the fitted curve is computed) real(kind=real64), intent(in) :: span Smoothing parameter for LOESS\nThe minimum valid value is EPS_LOESS .\nThe maximum valid value is 1.0_real64 . integer(kind=int32), intent(in) :: degree Degree of the LOESS polynomial\nThe minimum valid value is 0_int32 .\nThe maximum valid value is 2_int32 . integer(kind=int32), intent(in) :: max_neighborhood_size Maximum neighborhood size logical(kind=c_bool), intent(in), optional :: compute_influence Influence calculation flag\nThe default value is .false. . logical(kind=c_bool), intent(in), optional :: save_factorization Save matrix factorization flag\nThe default value is .false. . integer(kind=int32), intent(out) :: tmp_int_workspace (int_workspace_size) Integer workspace array integer(kind=int32), intent(in) :: int_workspace_size Required size of the integer workspace array\nIt is VERY IMPORTANT to compute this argument from the int_workspace_size output produced by tox_loess_required_workspace .\nThe minimum valid value is 10000_int32 . Producer input Supplied by n_dim 1_int32 real(kind=real64), intent(out) :: tmp_real_workspace (real_workspace_size) Real workspace array integer(kind=int32), intent(in) :: real_workspace_size Required size of the real workspace array\nIt is VERY IMPORTANT to compute this argument from the real_workspace_size output produced by tox_loess_required_workspace .\nThe minimum valid value is 100000_int32 . Producer input Supplied by n_dim 1_int32 real(kind=real64), intent(out) :: tmp_hat_diag (n) Diagonal elements of the hat matrix real(kind=real64), intent(out) :: fitted_values (n) Fitted (smoothed) values of y at the evaluation points integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/loess_fit_plain_impl.html"},{"title":"loess_fit_robust_impl – TensorOmics","text":"public  subroutine loess_fit_robust_impl(n, x, y, weights, eval_points, span, degree, max_neighborhood_size, compute_influence, save_factorization, n_iters, tmp_int_workspace, int_workspace_size, tmp_real_workspace, real_workspace_size, tmp_hat_diag, tmp_robust_weights, tmp_combined_weights, tmp_residuals, tmp_permutation_indices, fitted_values, ierr) Data too degenerate to fit is answered directly, by the observations themselves; see loess_degenerate_fit .\nFits a LOESS model to the data using robust iterations to handle outliers.\nThe robust fitting process iterates n_iters times, each iteration:\n - Combines original weights with robust weights (down-weights from previous iteration)\n - Runs LOESS fitting with combined weights\n - Computes residuals (y - fitted values)\n - Updates robust weights using bisquare function (suppresses large residuals) Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n Total number of data points real(kind=real64), intent(in) :: x (n) Predictor variable array real(kind=real64), intent(in) :: y (n) Response variable array real(kind=real64), intent(in) :: weights (n) Weight array for data points real(kind=real64), intent(in) :: eval_points (n,1) Evaluation points (x values at which the fitted curve is computed) real(kind=real64), intent(in) :: span Smoothing parameter for LOESS\nThe minimum valid value is EPS_LOESS .\nThe maximum valid value is 1.0_real64 . integer(kind=int32), intent(in) :: degree Degree of the LOESS polynomial\nThe minimum valid value is 0_int32 .\nThe maximum valid value is 2_int32 . integer(kind=int32), intent(in) :: max_neighborhood_size Maximum neighborhood size logical(kind=c_bool), intent(in), optional :: compute_influence Influence calculation flag\nThe default value is .false. . logical(kind=c_bool), intent(in), optional :: save_factorization Save matrix factorization flag\nThe default value is .false. . integer(kind=int32), intent(in), optional :: n_iters Number of robust iterations\nThe minimum valid value is 1_int32 .\nThe default value is 3_int32 . integer(kind=int32), intent(out) :: tmp_int_workspace (int_workspace_size) Integer workspace array integer(kind=int32), intent(in) :: int_workspace_size Required size of the integer workspace array\nIt is VERY IMPORTANT to compute this argument from the int_workspace_size output produced by tox_loess_required_workspace .\nThe minimum valid value is 10000_int32 . Producer input Supplied by n_dim 1_int32 real(kind=real64), intent(out) :: tmp_real_workspace (real_workspace_size) Real workspace array integer(kind=int32), intent(in) :: real_workspace_size Required size of the real workspace array\nIt is VERY IMPORTANT to compute this argument from the real_workspace_size output produced by tox_loess_required_workspace .\nThe minimum valid value is 100000_int32 . Producer input Supplied by n_dim 1_int32 real(kind=real64), intent(out) :: tmp_hat_diag (n) Diagonal elements of the hat matrix real(kind=real64), intent(out) :: tmp_robust_weights (n) Robust bisquare weights (updated each iteration, initialized to 1.0) real(kind=real64), intent(out) :: tmp_combined_weights (n) Combined weights: product of user weights and robust weights (weights(i) * robust_weights(i)) real(kind=real64), intent(out) :: tmp_residuals (n) Residuals (y - fitted_values), used to compute bisquare robust weights integer(kind=int32), intent(out) :: tmp_permutation_indices (n) Permutation indices array (from NetLib bisquare weight computation) real(kind=real64), intent(out) :: fitted_values (n) Fitted (smoothed) values of y at the evaluation points integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/loess_fit_robust_impl.html"},{"title":"loess_decomposition – TensorOmics","text":"public interface loess_decomposition Subroutines public  subroutine lowesd(iv19_code, int_workspace, int_workspace_size, real_workspace_size, real_workspace, n_dim, n, span, degree, max_neighborhood_size, save_factorization) Perform LOESS decomposition.\nThis subroutine computes the decomposition of the LOESS model.\nIt initializes the integer and real workspace arrays based on the input parameters. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: iv19_code Packed netlib iv(19) model-selection code (family/surface/statistics digits); see loess_fit_plain for the fixed value used by this codebase. integer(kind=int32), intent(out) :: int_workspace (int_workspace_size) Integer workspace array, laid out and populated here; nothing in it is read integer(kind=int32), intent(in) :: int_workspace_size Length of the integer workspace array integer(kind=int32), intent(in) :: real_workspace_size Length of the real workspace array real(kind=real64), intent(out) :: real_workspace (real_workspace_size) Real workspace array, whose first entries are set here; nothing in it is read integer(kind=int32), intent(in) :: n_dim Dimensionality of the data integer(kind=int32), intent(in) :: n Number of data points real(kind=real64), intent(in) :: span Smoothing parameter for LOESS integer(kind=int32), intent(in) :: degree Degree of the LOESS polynomial integer(kind=int32), intent(in) :: max_neighborhood_size Maximum neighborhood size logical, intent(in) :: save_factorization Save matrix factorization flag","tags":"","url":"interface/loess_decomposition.html"},{"title":"loess_fitting – TensorOmics","text":"public interface loess_fitting Subroutines public  subroutine lowesb(x, y, weights, hat_diag, compute_influence, int_workspace, int_workspace_size, real_workspace_size, real_workspace) Perform LOESS fitting.\nThis subroutine fits the LOESS model to the data.\nIt uses the input predictor and response variables to compute the diagonal elements of the hat matrix. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: x (*) Predictor variable array real(kind=real64), intent(in) :: y (*) Response variable array real(kind=real64), intent(in) :: weights (*) Weight array for data points real(kind=real64), intent(out) :: hat_diag (*) Diagonal elements of the hat matrix logical, intent(in) :: compute_influence Influence calculation flag integer(kind=int32), intent(inout) :: int_workspace (int_workspace_size) Integer workspace array integer(kind=int32), intent(in) :: int_workspace_size Length of the integer workspace array integer(kind=int32), intent(in) :: real_workspace_size Length of the real workspace array real(kind=real64), intent(inout) :: real_workspace (real_workspace_size) Real workspace array","tags":"","url":"interface/loess_fitting.html"},{"title":"loess_evaluation – TensorOmics","text":"public interface loess_evaluation Subroutines public  subroutine lowese(int_workspace, int_workspace_size, real_workspace_size, real_workspace, n, eval_points, fitted_values) Perform LOESS evaluation.\nThis subroutine evaluates the LOESS model.\nIt computes the smoothed response variable array based on the input predictor variables. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: int_workspace (int_workspace_size) Integer workspace array, read as laid out by the decomposition and the fit integer(kind=int32), intent(in) :: int_workspace_size Length of the integer workspace array integer(kind=int32), intent(in) :: real_workspace_size Length of the real workspace array real(kind=real64), intent(in) :: real_workspace (real_workspace_size) Real workspace array, read as left by the fit integer(kind=int32), intent(in) :: n Number of data points real(kind=real64), intent(in) :: eval_points (n,1) x-values at which to evaluate the fitted LOESS curve (evaluation points) real(kind=real64), intent(out) :: fitted_values (n) Smoothed response variable array","tags":"","url":"interface/loess_evaluation.html"},{"title":"loess_robust_weights – TensorOmics","text":"public interface loess_robust_weights Subroutines public  subroutine lowesw(residuals, n, robust_weights, permutation_indices) Compute robust weights for LOESS.\nThis subroutine computes the robust weights for the LOESS model.\nIt uses the residuals to update the weights for robust fitting. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: residuals (n) Residuals array integer(kind=int32), intent(in) :: n Number of data points real(kind=real64), intent(out) :: robust_weights (n) Robust weights array integer(kind=int32), intent(out) :: permutation_indices (n) Permutation indices array","tags":"","url":"interface/loess_robust_weights.html"},{"title":"create_err_code – TensorOmics","text":"public pure function create_err_code(error, arg_pos) result(ierr) Creates the error code for an error and a specific argument position (if argument related) The position numbers the dummy arguments of the Fortran procedure that reports it. The C\nbinding inserts array-size and string-length arguments of its own; those are not counted,\nso a position always reads against the Fortran signature at every layer. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: error ERR_* error code from module constants integer(kind=int32), intent(in), optional :: arg_pos Position of the validated argument that triggered the error, default: 0 -> not argument related Return Value integer(kind=int32)","tags":"","url":"proc/create_err_code.html"},{"title":"get_err_code – TensorOmics","text":"public pure function get_err_code(ierr) result(error) Extracts the error from the error code Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: ierr Error code Return Value integer(kind=int32)","tags":"","url":"proc/get_err_code.html"},{"title":"get_err_arg_pos – TensorOmics","text":"public pure function get_err_arg_pos(ierr) result(arg_pos) Extracts the argument position from the error code Zero means the error is not argument related -- either it never was, or it crossed out of\nthe procedure that raised it into one whose dummy list cannot express it. See clear_err_arg_pos . Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: ierr Error code Return Value integer(kind=int32)","tags":"","url":"proc/get_err_arg_pos.html"},{"title":"is_err – TensorOmics","text":"public pure function is_err(ierr) result(not_ok) check if the error code indicates error Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: ierr Error code Return Value logical","tags":"","url":"proc/is_err.html"},{"title":"is_ok – TensorOmics","text":"public pure function is_ok(ierr) result(ok) check if the error code indicates success Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: ierr Error code Return Value logical","tags":"","url":"proc/is_ok.html"},{"title":"map_err_arg_pos – TensorOmics","text":"public pure subroutine map_err_arg_pos(ierr, old, new) Maps a specific argument position in the encoded Error code to a new one. Helpful for nested subroutine calls. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(inout) :: ierr Error code integer(kind=int32), intent(in) :: old Argument position that should be mapped integer(kind=int32), intent(in) :: new New argument position","tags":"","url":"proc/map_err_arg_pos.html"},{"title":"clear_err_arg_pos – TensorOmics","text":"public pure subroutine clear_err_arg_pos(ierr) Drops the argument position from an error code, keeping the error itself. An ierr that crosses out of a procedure into a caller with a different dummy list\ncarries a position naming an argument the caller does not have -- and it may not even\nbe the callee's own position, since it propagates unchanged from whatever private\nhelper set it. Nothing can translate that, so the honest report is \"not argument\nrelated\". Use map_err_arg_pos instead where the two\ndummy lists really are known to correspond. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(inout) :: ierr Error code","tags":"","url":"proc/clear_err_arg_pos.html"},{"title":"set_ok – TensorOmics","text":"public elemental subroutine set_ok(ierr) set the error code to OK, use at beginning of procedures Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/set_ok.html"},{"title":"set_err – TensorOmics","text":"public pure subroutine set_err(ierr, error, arg_pos) set the error code to specific error Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(inout) :: ierr Error code integer(kind=int32), intent(in) :: error ERR_* error code from module constants integer(kind=int32), intent(in), optional :: arg_pos Position of the validated argument that triggered the error, default: 0 -> not argument related","tags":"","url":"proc/set_err.html"},{"title":"set_err_once – TensorOmics","text":"public pure subroutine set_err_once(ierr, error, arg_pos) set the error code only if it is currently OK, use to prevent overwriting first error Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(inout) :: ierr Error code integer(kind=int32), intent(in) :: error ERR_* error code from module constants integer(kind=int32), intent(in), optional :: arg_pos Position of the validated argument that triggered the error, default: 0 -> not argument related","tags":"","url":"proc/set_err_once.html"},{"title":"check_io_stat – TensorOmics","text":"public pure subroutine check_io_stat(ios, ierr) Checks if allocation is successful Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: ios integer(kind=int32), intent(inout) :: ierr Error code","tags":"","url":"proc/check_io_stat.html"},{"title":"validate_dimension_size – TensorOmics","text":"public pure subroutine validate_dimension_size(n, ierr, arg_pos) Validates that a dimension size is non-negative and non-zero.\nSets ERR_INVALID_INPUT if n<0 , ERR_EMPTY_INPUT if n==0 . Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in), optional :: n dimension size to be validated integer(kind=int32), intent(inout) :: ierr Error code integer(kind=int32), intent(in), optional :: arg_pos Position of the validated argument that triggered the error, default: 0 -> not argument related","tags":"","url":"proc/validate_dimension_size.html"},{"title":"validate_type_code – TensorOmics","text":"public  subroutine validate_type_code(actual, expected, unit, ierr, arg_pos) validate that the actual type error matches the expected type error\nCloses the connected unit in case of an error Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: actual Actual type error read from file integer(kind=int32), intent(in) :: expected Expected type error integer(kind=int32), intent(in) :: unit Unit connection integer(kind=int32), intent(inout) :: ierr Error code integer(kind=int32), intent(in), optional :: arg_pos Position of the validated argument that triggered the error, default: 0 -> not argument related","tags":"","url":"proc/validate_type_code.html"},{"title":"validate_in_range_int – TensorOmics","text":"public pure subroutine validate_in_range_int(val, ierr, arg_pos, min, max, sentinel) Validates min<=e<=max for all elements e of an array Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in), optional :: val value to be validated integer(kind=int32), intent(inout) :: ierr Error code integer(kind=int32), intent(in), optional :: arg_pos Position of the validated argument that triggered the error, default: 0 -> not argument related integer(kind=int32), intent(in), optional :: min lower bound for a value, default is lowest 32-bit integer -> -huge(1_int32) integer(kind=int32), intent(in), optional :: max upper bound for a value, default is largest 32-bit integer -> huge(1_int32) integer(kind=int32), intent(in), optional :: sentinel Optional sentinel value to allow additionally","tags":"","url":"proc/validate_in_range_int.html"},{"title":"validate_all_in_range_int – TensorOmics","text":"public pure subroutine validate_all_in_range_int(array, n_elements, ierr, arg_pos, min, max, sentinel) Validates min<=e<=max for all elements e of an array Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in), optional, dimension(n_elements) :: array Array to be validated integer(kind=int32), intent(in) :: n_elements Size of array integer(kind=int32), intent(inout) :: ierr Error code integer(kind=int32), intent(in), optional :: arg_pos Position of the validated argument that triggered the error, default: 0 -> not argument related integer(kind=int32), intent(in), optional :: min lower bound for a value, default is lowest 32-bit integer -> -huge(1_int32) integer(kind=int32), intent(in), optional :: max upper bound for a value, default is largest 32-bit integer -> huge(1_int32) integer(kind=int32), intent(in), optional :: sentinel Optional sentinel value to allow additionally","tags":"","url":"proc/validate_all_in_range_int.html"},{"title":"validate_in_range_real – TensorOmics","text":"public pure subroutine validate_in_range_real(val, ierr, arg_pos, min, max, sentinel, allow_nan, allow_infinite) Validates min<=e<=max AND e/=NaN for all elements e of an array. Note This validation is inclusive: min<=val<=max To achieve exclusive bounds, use above/below from f42_math_impl,\nlike: validate_in_range_real(x, ierr, min=above(0.0_real64), max=below(100.0_real64)) for `0 Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), optional :: val value to be validated integer(kind=int32), intent(inout) :: ierr Error code integer(kind=int32), intent(in), optional :: arg_pos Position of the validated argument that triggered the error, default: 0 -> not argument related real(kind=real64), intent(in), optional :: min lower bound for a value, default is lowest 64-bit float -> -huge(1.0_real64) real(kind=real64), intent(in), optional :: max upper bound for a value, default is largest 64-bit float -> huge(1.0_real64) real(kind=real64), intent(in), optional :: sentinel Optional sentinel value to allow additionally logical(kind=c_bool), intent(in), optional :: allow_nan Permit NaN, opting out of the default finiteness check. Default .false. logical(kind=c_bool), intent(in), optional :: allow_infinite Permit +/-infinity, opting out of the default finiteness check. Default .false.","tags":"","url":"proc/validate_in_range_real.html"},{"title":"validate_all_in_range_real – TensorOmics","text":"public pure subroutine validate_all_in_range_real(array, n_elements, ierr, arg_pos, min, max, sentinel, allow_nan, allow_infinite) Validates min<=e<=max AND e/=NaN for all elements e of an array Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), optional, dimension(n_elements) :: array Array to be validated integer(kind=int32), intent(in) :: n_elements Size of array integer(kind=int32), intent(inout) :: ierr Error code integer(kind=int32), intent(in), optional :: arg_pos Position of the validated argument that triggered the error, default: 0 -> not argument related real(kind=real64), intent(in), optional :: min lower bound for a value, default is lowest 64-bit float -> -huge(1.0_real64) real(kind=real64), intent(in), optional :: max upper bound for a value, default is largest 64-bit float -> huge(1.0_real64) real(kind=real64), intent(in), optional :: sentinel Optional sentinel value to allow additionally logical(kind=c_bool), intent(in), optional :: allow_nan Permit NaN, opting out of the default finiteness check. Default .false. logical(kind=c_bool), intent(in), optional :: allow_infinite Permit +/-infinity, opting out of the default finiteness check. Default .false.","tags":"","url":"proc/validate_all_in_range_real.html"},{"title":"validate_distance_matrix – TensorOmics","text":"public pure subroutine validate_distance_matrix(distances, n, ierr, arg_pos, min, max) Strictly validates a distance matrix of euclidean distances.\nThis means that distance X->X is exactly zero (no tolerance)\nand X->Y is exactly the same as Y->X (no tolerance). Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), optional, dimension(n, n) :: distances Matrix to be validated integer(kind=int32), intent(in) :: n Number of columns and rows of distances integer(kind=int32), intent(inout) :: ierr Error code integer(kind=int32), intent(in), optional :: arg_pos Position of the validated argument that triggered the error, default: 0 -> not argument related real(kind=real64), intent(in), optional :: min lower bound for a distance value, default is zero to have only positives real(kind=real64), intent(in), optional :: max upper bound for a distance value, default is largest 64-bit float -> huge(1.0_real64)","tags":"","url":"proc/validate_distance_matrix.html"},{"title":"determine_shared_residual_range_c – TensorOmics","text":"public  subroutine determine_shared_residual_range_c(abs_residual_pool, pool_size, shared_residual_range, residual_range_quantile, ierr) bind(C, name=\"determine_shared_residual_range_c\") Uses tox_data_integration_jsd This takes the pool already built; determine_study_shared_residual_range builds it from\nthe neighborhood residuals of two studies first, if that is what is at hand. Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(pool_size), target :: abs_residual_pool The absolute residual values of the concatenated S1,S2 residuals\nNaN is permitted for this value. integer(kind=c_int), intent(in), target :: pool_size Size of pool of residuals abs_residual_pool , usually (n_reps_S1 + n_reps_2)*n_neighbors*n_points real(kind=c_double), intent(out), target :: shared_residual_range Computed residual range (R) real(kind=c_double), intent(in), target :: residual_range_quantile Quantile in [0,1] for determining the residual range\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 .\nThe default value is 0.95 . integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/determine_shared_residual_range_c.html"},{"title":"determine_shared_residual_range_expert_c – TensorOmics","text":"public  subroutine determine_shared_residual_range_expert_c(abs_residual_pool, abs_residual_pool_perm, pool_size, shared_residual_range, residual_range_quantile, ierr) bind(C, name=\"determine_shared_residual_range_expert_c\") Uses tox_data_integration_jsd This takes the pool already built; determine_study_shared_residual_range builds it from\nthe neighborhood residuals of two studies first, if that is what is at hand. Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(pool_size), target :: abs_residual_pool The absolute residual values of the concatenated S1,S2 residuals\nNaN is permitted for this value. integer(kind=c_int), intent(in), dimension(pool_size), target :: abs_residual_pool_perm The permutation vector that sorts abs_residual_pool The minimum valid value is 1_int32 .\nThe maximum valid value is pool_size . integer(kind=c_int), intent(in), target :: pool_size Size of pool of residuals abs_residual_pool , usually (n_reps_S1 + n_reps_2)*n_neighbors*n_points real(kind=c_double), intent(out), target :: shared_residual_range Computed residual range (R) real(kind=c_double), intent(in), target :: residual_range_quantile Quantile in [0,1] for determining the residual range\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 .\nThe default value is 0.95 . integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/determine_shared_residual_range_expert_c.html"},{"title":"determine_study_shared_residual_range_c – TensorOmics","text":"public  subroutine determine_study_shared_residual_range_c(neighborhood_residuals_S1, neighborhood_residuals_S2, n_reps_S1, n_reps_S2, n_neighbors, n_points, shared_residual_range, residual_range_quantile, ierr) bind(C, name=\"determine_study_shared_residual_range_c\") Uses tox_data_integration_jsd Pools the absolute residuals of both studies, sorts them, and takes the quantile exactly\nas determine_shared_residual_range does. Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_reps_S1, n_neighbors, n_points), target :: neighborhood_residuals_S1 Computed neighborhood residuals for study 1, NaN is explicitly allowed for missing values\nNaN is permitted for this value. real(kind=c_double), intent(in), dimension(n_reps_S2, n_neighbors, n_points), target :: neighborhood_residuals_S2 Computed neighborhood residuals for study 2, NaN is explicitly allowed for missing values\nNaN is permitted for this value. integer(kind=c_int), intent(in), target :: n_reps_S1 Number of replicates in study 1 integer(kind=c_int), intent(in), target :: n_reps_S2 Number of replicates in study 2 integer(kind=c_int), intent(in), target :: n_neighbors Number of neighbors in the studies integer(kind=c_int), intent(in), target :: n_points Number of reference points in the studies real(kind=c_double), intent(out), target :: shared_residual_range Computed residual range (R) real(kind=c_double), intent(in), target :: residual_range_quantile Quantile in [0,1] for determining the residual range\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 .\nThe default value is 0.95 . integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/determine_study_shared_residual_range_c.html"},{"title":"determine_study_shared_residual_range_expert_c – TensorOmics","text":"public  subroutine determine_study_shared_residual_range_expert_c(neighborhood_residuals_S1, neighborhood_residuals_S2, n_reps_S1, n_reps_S2, n_neighbors, n_points, tmp_abs_residual_pool, tmp_abs_residual_pool_perm, shared_residual_range, residual_range_quantile, ierr) bind(C, name=\"determine_study_shared_residual_range_expert_c\") Uses tox_data_integration_jsd Pools the absolute residuals of both studies, sorts them, and takes the quantile exactly\nas determine_shared_residual_range does. Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_reps_S1, n_neighbors, n_points), target :: neighborhood_residuals_S1 Computed neighborhood residuals for study 1, NaN is explicitly allowed for missing values\nNaN is permitted for this value. real(kind=c_double), intent(in), dimension(n_reps_S2, n_neighbors, n_points), target :: neighborhood_residuals_S2 Computed neighborhood residuals for study 2, NaN is explicitly allowed for missing values\nNaN is permitted for this value. integer(kind=c_int), intent(in), target :: n_reps_S1 Number of replicates in study 1 integer(kind=c_int), intent(in), target :: n_reps_S2 Number of replicates in study 2 integer(kind=c_int), intent(in), target :: n_neighbors Number of neighbors in the studies integer(kind=c_int), intent(in), target :: n_points Number of reference points in the studies real(kind=c_double), intent(out), dimension((n_reps_S1 + n_reps_S2)*n_neighbors*n_points), target :: tmp_abs_residual_pool Work array holding the pooled absolute residuals of both studies integer(kind=c_int), intent(out), dimension((n_reps_S1 + n_reps_S2)*n_neighbors*n_points), target :: tmp_abs_residual_pool_perm Work array for the permutation that sorts tmp_abs_residual_pool real(kind=c_double), intent(out), target :: shared_residual_range Computed residual range (R) real(kind=c_double), intent(in), target :: residual_range_quantile Quantile in [0,1] for determining the residual range\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 .\nThe default value is 0.95 . integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/determine_study_shared_residual_range_expert_c.html"},{"title":"build_residual_histograms_c – TensorOmics","text":"public  subroutine build_residual_histograms_c(neighborhood_residuals, n_reps, n_neighbors, n_points, shared_residual_range, n_bins, counts, pmf, included_n_reps, neighbor_mask, ierr) bind(C, name=\"build_residual_histograms_c\") Uses tox_data_integration_jsd The probability mass function pmf(residual, bin) is actually a matrix. Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_reps, n_neighbors, n_points), target :: neighborhood_residuals Computed neighborhood residuals for a study, NaN is explicitly allowed for missing values\nNaN is permitted for this value. integer(kind=c_int), intent(in), target :: n_reps Number of replicates of the study integer(kind=c_int), intent(in), target :: n_neighbors Number of reference points (k) integer(kind=c_int), intent(in), target :: n_points Number of reference points in the study real(kind=c_double), intent(in), target :: shared_residual_range Computed residual range (R)\nThe minimum valid value is 0.0_real64 . integer(kind=c_int), intent(in), target :: n_bins Number of equally sized histogram bins in range [-R,R] integer(kind=c_int), intent(out), dimension(n_points, n_bins), target :: counts Absolute counts of a residual per bin real(kind=c_double), intent(out), dimension(n_points, n_bins), target :: pmf counts normalized to 0 <= counts(:, i) <= 1 and sum(counts(:, i)) == 1 integer(kind=c_int), intent(out), dimension(n_points), target :: included_n_reps Stores the count of non-NaN replicates (included ones) logical(kind=c_bool), intent(in), optional, dimension(n_neighbors, n_points) :: neighbor_mask Optional mask to exclude specific neighbors (e.g. for family-wise analysis) integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/build_residual_histograms_c.html"},{"title":"compute_divergence_per_reference_point_c – TensorOmics","text":"public  subroutine compute_divergence_per_reference_point_c(pmf_S1, pmf_S2, n_points, n_bins, js_divergences, ierr) bind(C, name=\"compute_divergence_per_reference_point_c\") Uses tox_data_integration_jsd Takes the probabilities pmf produced by build_residual_histograms . Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_points, n_bins), target :: pmf_S1 Computed normalized histogram counts for study 1\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 . real(kind=c_double), intent(in), dimension(n_points, n_bins), target :: pmf_S2 Computed normalized histogram counts for study 2\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 . integer(kind=c_int), intent(in), target :: n_points Number of reference points (k) integer(kind=c_int), intent(in), target :: n_bins Number of equally sized histogram bins in range [-R,R] real(kind=c_double), intent(out), dimension(n_points), target :: js_divergences Jensen-Shannon divergence per reference point integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/compute_divergence_per_reference_point_c.html"},{"title":"compute_weighted_global_divergence_c – TensorOmics","text":"public  subroutine compute_weighted_global_divergence_c(js_divergences, n_points, included_n_reps_S1, included_n_reps_S2, global_js_divergence, weights, ierr) bind(C, name=\"compute_weighted_global_divergence_c\") Uses tox_data_integration_jsd Takes the divergences produced by compute_divergence_per_reference_point . Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_points), target :: js_divergences Jensen-Shannon divergence per reference point, computed for studies S1 and S2\nThe minimum valid value is 0.0_real64 . integer(kind=c_int), intent(in), target :: n_points Number of reference points (k) integer(kind=c_int), intent(in), dimension(n_points), target :: included_n_reps_S1 Count of non-NaN residuals (included ones) in study 1\nThe minimum valid value is 0_int32 . integer(kind=c_int), intent(in), dimension(n_points), target :: included_n_reps_S2 Count of non-NaN residuals (included ones) in study 2\nThe minimum valid value is 0_int32 . real(kind=c_double), intent(out), target :: global_js_divergence Weighted global Jensen-Shannon divergence real(kind=c_double), intent(out), dimension(n_points), target :: weights Weights used for calculating the global weighted Jensen-Shannon divergence global_js_divergence integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"proc/compute_weighted_global_divergence_c.html"},{"title":"read_expression_vectors_tsv – TensorOmics","text":"public  subroutine read_expression_vectors_tsv(file_list, gene_ids, expression_vectors, n_header_rows, gene_col, value_cols, start_row, ierr, delimiter) Uses ieee_arithmetic f42_xxh3_hashmap Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: file_list (:) List of files to read from character(len=*), intent(in) :: gene_ids (:) Array of gene IDS real(kind=real64), intent(inout) :: expression_vectors (:,:) Array of expression vectors integer(kind=int32), intent(in) :: n_header_rows Number of header rows to skip integer(kind=int32), intent(in) :: gene_col Index of column with gene_ids integer(kind=int32), intent(in) :: value_cols (:) Indicies of columns containing values integer(kind=int32), intent(in) :: start_row Row in the expression vectors to start in integer(kind=int32), intent(out) :: ierr Error code character(len=1), intent(in), optional :: delimiter optional delimiter\nThe default value is char(9) .","tags":"C-binding","url":"proc/read_expression_vectors_tsv.html"},{"title":"read_gene_ids_from_tsv_file – TensorOmics","text":"public  subroutine read_gene_ids_from_tsv_file(filename, gene_ids, n_header_rows, gene_col, ierr) Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: filename Name of the file character(len=*), intent(out) :: gene_ids (:) gene ids array integer(kind=int32), intent(in) :: n_header_rows number of headers to skip integer(kind=int32), intent(in) :: gene_col Index of the column containing gene ids integer(kind=int32), intent(out) :: ierr Error code","tags":"C-binding","url":"proc/read_gene_ids_from_tsv_file.html"},{"title":"read_orthofinder_file – TensorOmics","text":"public  subroutine read_orthofinder_file(filename, gene_ids, family_ids, gene_to_fam, ierr) Uses f42_xxh3_hashmap Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: filename Name of the file character(len=*), intent(in) :: gene_ids (:) gene ids array character(len=*), intent(out) :: family_ids (:) family ids array integer(kind=int32), intent(out) :: gene_to_fam (:) gene to family mapping integer(kind=int32), intent(out) :: ierr Error code","tags":"C-binding","url":"proc/read_orthofinder_file.html"},{"title":"split_string – TensorOmics","text":"public  subroutine split_string(input, output, ierr, delimiter) Helper subroutine to split strings Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: input Input string to split character(len=:), intent(out), allocatable :: output (:) Output of parts integer(kind=int32), intent(out) :: ierr Error code character(len=1), intent(in), optional :: delimiter delimiter, default is space","tags":"","url":"proc/split_string.html"},{"title":"get_unassigned_mask – TensorOmics","text":"public  subroutine get_unassigned_mask(gene_to_fam, mask, n_genes_kept) Uses iso_fortran_env Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: gene_to_fam (:) gene to family mapping logical(kind=c_bool), intent(out) :: mask (size(gene_to_fam)) mask for mapping integer(kind=int32), intent(out) :: n_genes_kept number of genes kept","tags":"C-binding","url":"proc/get_unassigned_mask.html"},{"title":"apply_unassigned_mask – TensorOmics","text":"public  subroutine apply_unassigned_mask(gene_ids, expression_vectors, gene_to_fam, mask, n_genes_kept, ierr) Applies a precomputed mask to filter out unassigned genes Arguments Type Intent Optional Attributes Name character(len=*), intent(inout), allocatable :: gene_ids (:) gene ids array real(kind=real64), intent(inout), allocatable :: expression_vectors (:,:) expression vectors array integer(kind=int32), intent(inout), allocatable :: gene_to_fam (:) gene to family mapping logical(kind=c_bool), intent(in) :: mask (:) mask for mapping integer(kind=int32), intent(out) :: n_genes_kept number of genes kept integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"proc/apply_unassigned_mask.html"},{"title":"tox_loess – TensorOmics","text":"LOESS local polynomial regression smoothing, over the netlib dloess / lowesd family. Two fits: loess_fit_plain and loess_fit_robust , the latter reweighting against outliers over\na number of iterations. There is deliberately no combined entry point dispatching on a mode --\na caller chooses the routine, and supplies the weights and the evaluation points it wants. A sample too degenerate to fit (fewer distinct points than the degree needs) is answered\ndirectly from the observations rather than handed to netlib, which cannot fit one and dies\ninside its decomposition instead of reporting. Nothing about that is visible to a caller\nbeyond the result. tox_loess_required_workspace sizes the workspace for a caller that wants to own it; the\nmode and iteration constants and EPS_LOESS are here for the same reason. The netlib\nroutines themselves are not re-documented beyond their calling convention. Generated from tox_loess_impl ; do not edit -- regenerate instead. Uses iso_fortran_env iso_c_binding f42_safeguard tox_errors tox_loess_impl Subroutines public  subroutine loess_fit_plain (n, x, y, weights, eval_points, span, degree, max_neighborhood_size, compute_influence, save_factorization, fitted_values, ierr) Validates its inputs, prepares what loess_fit_plain_impl needs, then calls it. The entry point to reach for first; see loess_fit_plain_expert to prepare it yourself. Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n Total number of data points real(kind=real64), intent(in), dimension(n) :: x Predictor variable array real(kind=real64), intent(in), dimension(n) :: y Response variable array real(kind=real64), intent(in), dimension(n) :: weights Weight array for data points real(kind=real64), intent(in), dimension(n, 1) :: eval_points Evaluation points (x values at which the fitted curve is computed) real(kind=real64), intent(in) :: span Smoothing parameter for LOESS\nThe minimum valid value is EPS_LOESS .\nThe maximum valid value is 1.0_real64 . integer(kind=int32), intent(in) :: degree Degree of the LOESS polynomial\nThe minimum valid value is 0_int32 .\nThe maximum valid value is 2_int32 . integer(kind=int32), intent(in) :: max_neighborhood_size Maximum neighborhood size logical(kind=c_bool), intent(in), optional :: compute_influence Influence calculation flag\nThe default value is .false. . logical(kind=c_bool), intent(in), optional :: save_factorization Save matrix factorization flag\nThe default value is .false. . real(kind=real64), intent(out), dimension(n) :: fitted_values Fitted (smoothed) values of y at the evaluation points integer(kind=int32), intent(out) :: ierr Error code public  subroutine loess_fit_plain_expert (n, x, y, weights, eval_points, span, degree, max_neighborhood_size, compute_influence, save_factorization, tmp_int_workspace, int_workspace_size, tmp_real_workspace, real_workspace_size, tmp_hat_diag, fitted_values, ierr) Validates its inputs, then calls loess_fit_plain_impl with what you supply. The expert entry point: it allocates nothing and prepares nothing; loess_fit_plain does both. Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n Total number of data points real(kind=real64), intent(in), dimension(n) :: x Predictor variable array real(kind=real64), intent(in), dimension(n) :: y Response variable array real(kind=real64), intent(in), dimension(n) :: weights Weight array for data points real(kind=real64), intent(in), dimension(n, 1) :: eval_points Evaluation points (x values at which the fitted curve is computed) real(kind=real64), intent(in) :: span Smoothing parameter for LOESS\nThe minimum valid value is EPS_LOESS .\nThe maximum valid value is 1.0_real64 . integer(kind=int32), intent(in) :: degree Degree of the LOESS polynomial\nThe minimum valid value is 0_int32 .\nThe maximum valid value is 2_int32 . integer(kind=int32), intent(in) :: max_neighborhood_size Maximum neighborhood size logical(kind=c_bool), intent(in), optional :: compute_influence Influence calculation flag\nThe default value is .false. . logical(kind=c_bool), intent(in), optional :: save_factorization Save matrix factorization flag\nThe default value is .false. . integer(kind=int32), intent(out), dimension(int_workspace_size) :: tmp_int_workspace Integer workspace array integer(kind=int32), intent(in) :: int_workspace_size Required size of the integer workspace array\nIt is VERY IMPORTANT to compute this argument from the int_workspace_size output produced by tox_loess_required_workspace .\nThe minimum valid value is 10000_int32 . Read more… real(kind=real64), intent(out), dimension(real_workspace_size) :: tmp_real_workspace Real workspace array integer(kind=int32), intent(in) :: real_workspace_size Required size of the real workspace array\nIt is VERY IMPORTANT to compute this argument from the real_workspace_size output produced by tox_loess_required_workspace .\nThe minimum valid value is 100000_int32 . Read more… real(kind=real64), intent(out), dimension(n) :: tmp_hat_diag Diagonal elements of the hat matrix real(kind=real64), intent(out), dimension(n) :: fitted_values Fitted (smoothed) values of y at the evaluation points integer(kind=int32), intent(out) :: ierr Error code public  subroutine loess_fit_robust (n, x, y, weights, eval_points, span, degree, max_neighborhood_size, compute_influence, save_factorization, n_iters, fitted_values, ierr) Validates its inputs, prepares what loess_fit_robust_impl needs, then calls it. The entry point to reach for first; see loess_fit_robust_expert to prepare it yourself. Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n Total number of data points real(kind=real64), intent(in), dimension(n) :: x Predictor variable array real(kind=real64), intent(in), dimension(n) :: y Response variable array real(kind=real64), intent(in), dimension(n) :: weights Weight array for data points real(kind=real64), intent(in), dimension(n, 1) :: eval_points Evaluation points (x values at which the fitted curve is computed) real(kind=real64), intent(in) :: span Smoothing parameter for LOESS\nThe minimum valid value is EPS_LOESS .\nThe maximum valid value is 1.0_real64 . integer(kind=int32), intent(in) :: degree Degree of the LOESS polynomial\nThe minimum valid value is 0_int32 .\nThe maximum valid value is 2_int32 . integer(kind=int32), intent(in) :: max_neighborhood_size Maximum neighborhood size logical(kind=c_bool), intent(in), optional :: compute_influence Influence calculation flag\nThe default value is .false. . logical(kind=c_bool), intent(in), optional :: save_factorization Save matrix factorization flag\nThe default value is .false. . integer(kind=int32), intent(in), optional :: n_iters Number of robust iterations\nThe minimum valid value is 1_int32 .\nThe default value is 3_int32 . real(kind=real64), intent(out), dimension(n) :: fitted_values Fitted (smoothed) values of y at the evaluation points integer(kind=int32), intent(out) :: ierr Error code public  subroutine loess_fit_robust_expert (n, x, y, weights, eval_points, span, degree, max_neighborhood_size, compute_influence, save_factorization, n_iters, tmp_int_workspace, int_workspace_size, tmp_real_workspace, real_workspace_size, tmp_hat_diag, tmp_robust_weights, tmp_combined_weights, tmp_residuals, tmp_permutation_indices, fitted_values, ierr) Validates its inputs, then calls loess_fit_robust_impl with what you supply. The expert entry point: it allocates nothing and prepares nothing; loess_fit_robust does both. Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n Total number of data points real(kind=real64), intent(in), dimension(n) :: x Predictor variable array real(kind=real64), intent(in), dimension(n) :: y Response variable array real(kind=real64), intent(in), dimension(n) :: weights Weight array for data points real(kind=real64), intent(in), dimension(n, 1) :: eval_points Evaluation points (x values at which the fitted curve is computed) real(kind=real64), intent(in) :: span Smoothing parameter for LOESS\nThe minimum valid value is EPS_LOESS .\nThe maximum valid value is 1.0_real64 . integer(kind=int32), intent(in) :: degree Degree of the LOESS polynomial\nThe minimum valid value is 0_int32 .\nThe maximum valid value is 2_int32 . integer(kind=int32), intent(in) :: max_neighborhood_size Maximum neighborhood size logical(kind=c_bool), intent(in), optional :: compute_influence Influence calculation flag\nThe default value is .false. . logical(kind=c_bool), intent(in), optional :: save_factorization Save matrix factorization flag\nThe default value is .false. . integer(kind=int32), intent(in), optional :: n_iters Number of robust iterations\nThe minimum valid value is 1_int32 .\nThe default value is 3_int32 . integer(kind=int32), intent(out), dimension(int_workspace_size) :: tmp_int_workspace Integer workspace array integer(kind=int32), intent(in) :: int_workspace_size Required size of the integer workspace array\nIt is VERY IMPORTANT to compute this argument from the int_workspace_size output produced by tox_loess_required_workspace .\nThe minimum valid value is 10000_int32 . Read more… real(kind=real64), intent(out), dimension(real_workspace_size) :: tmp_real_workspace Real workspace array integer(kind=int32), intent(in) :: real_workspace_size Required size of the real workspace array\nIt is VERY IMPORTANT to compute this argument from the real_workspace_size output produced by tox_loess_required_workspace .\nThe minimum valid value is 100000_int32 . Read more… real(kind=real64), intent(out), dimension(n) :: tmp_hat_diag Diagonal elements of the hat matrix real(kind=real64), intent(out), dimension(n) :: tmp_robust_weights Robust bisquare weights (updated each iteration, initialized to 1.0) real(kind=real64), intent(out), dimension(n) :: tmp_combined_weights Combined weights: product of user weights and robust weights (weights(i) * robust_weights(i)) real(kind=real64), intent(out), dimension(n) :: tmp_residuals Residuals (y - fitted_values), used to compute bisquare robust weights integer(kind=int32), intent(out), dimension(n) :: tmp_permutation_indices Permutation indices array (from NetLib bisquare weight computation) real(kind=real64), intent(out), dimension(n) :: fitted_values Fitted (smoothed) values of y at the evaluation points integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"module/tox_loess.html"},{"title":"tox_euclidean_distance – TensorOmics","text":"Euclidean distances in gene expression space. euclidean_distance between two expression vectors, and distance_to_centroid from every\ngene of a family to that family's centroid -- the distance the outlier detection and the\nrelative-distance index are built on. Generated from tox_euclidean_distance_impl ; do not edit -- regenerate instead. Uses iso_fortran_env tox_euclidean_distance_impl tox_errors Subroutines public pure subroutine euclidean_distance (vec1, vec2, n_elements, result, ierr) Validates its inputs, then calls euclidean_distance_impl . Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_elements) :: vec1 First expression vector real(kind=real64), intent(in), dimension(n_elements) :: vec2 Second expression vector integer(kind=int32), intent(in) :: n_elements Dimension of both vectors real(kind=real64), intent(out) :: result Output scalar distance integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure. public pure subroutine distance_to_centroid (n_genes, n_families, genes, centroids, gene_to_fam, distances, n_tissues, ierr) Validates its inputs, then calls distance_to_centroid_impl . Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Total number of genes integer(kind=int32), intent(in) :: n_families Total number of gene families real(kind=real64), intent(in), dimension(n_tissues, n_genes) :: genes Gene expression matrix (n_tissues × n_genes), column-major real(kind=real64), intent(in), dimension(n_tissues, n_families) :: centroids Family centroid matrix (n_tissues × n_families), column-major, -1.0_real64 for unassigned genes integer(kind=int32), intent(in), dimension(n_genes) :: gene_to_fam Index mapping -> each index i holds the family index for the corresponding gene in genes , using 0_int32 for unassigned genes\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_families .\nThe value 0_int32 is additionally accepted. real(kind=real64), intent(out), dimension(n_genes) :: distances Output distances array integer(kind=int32), intent(in) :: n_tissues Expression vector dimension integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"module/tox_euclidean_distance.html"},{"title":"f42_binary_search_tree_impl – TensorOmics","text":"Flat-index-based Binary Search Tree (BST) utilities for 1D range queries.\nThis module provides routines to build a BST index (via sorting), access sorted values,\nand perform range queries over a real-valued array using the sorted index. Uses f42_sort_impl iso_fortran_env tox_errors Functions public  function get_sorted_value (values, sorted_indices, position, ierr) result(sorted_value) Author Aaron Schröder License MIT Get the value at the sorted position. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: values (:) Input real array integer(kind=int32), intent(in) :: sorted_indices (:) Permutation index array integer(kind=int32), intent(in) :: position Sorted position (1-based) integer(kind=int32), intent(out) :: ierr Error code Return Value real(kind=real64) Subroutines public pure subroutine build_bst_index_impl (values, n_values, sorted_indices) Author Aaron Schröder License MIT Build the BST index by sorting indices using values in x Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: values (n_values) Input real array to be indexed integer(kind=int32), intent(in) :: n_values Number of elements in values array integer(kind=int32), intent(out) :: sorted_indices (n_values) Output permutation index public pure subroutine bst_range_query_impl (values, values_perm, n_values, lower_bound, upper_bound, output_indices, n_matches) Author Aaron Schröder License MIT Perform a 1D range query over the sorted index Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: values (n_values) Input real array integer(kind=int32), intent(in) :: values_perm (n_values) Permutation of values in ascending order -- the BST index. The allocating entry\npoint builds and heapsorts it for you; the expert one takes whatever order you\nsupply, so a caller that already holds one from build_bst_index can reuse it across queries.\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_values . integer(kind=int32), intent(in) :: n_values Number of elements real(kind=real64), intent(in) :: lower_bound Lower bound of range (inclusive)\nThe maximum valid value is upper_bound . real(kind=real64), intent(in) :: upper_bound Upper bound of range (inclusive) integer(kind=int32), intent(out) :: output_indices (n_values) Output array of matching indices.\nThe first n_matches elements will hold the results. integer(kind=int32), intent(out) :: n_matches Number of matches found","tags":"","url":"module/f42_binary_search_tree_impl.html"},{"title":"tox_shift_vectors_c – TensorOmics","text":"The shift vector field: where each gene sits relative to its family's centroid. One vector per gene, from the centroid of the family it belongs to to the gene itself. It is\nthe input the relative-axis plane tools project and measure angles in, and what the\nparalog-pattern detection reads a gene's direction and magnitude off. Uses f42_safeguard iso_c_binding tox_errors Subroutines public  subroutine compute_shift_vector_field_c (n_tissues, n_genes, n_families, expression_vectors, family_centroids, gene_to_fam, shift_vectors, ierr) bind(C, name=\"compute_shift_vector_field_c\") C-wrapper for compute_shift_vector_field Read more… Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_tissues Expression vector dimension integer(kind=c_int), intent(in), target :: n_genes Total number of genes integer(kind=c_int), intent(in), target :: n_families Total number of families real(kind=c_double), intent(in), dimension(n_tissues, n_genes), target :: expression_vectors Gene expression matrix real(kind=c_double), intent(in), dimension(n_tissues, n_families), target :: family_centroids Family centroid matrix integer(kind=c_int), intent(in), dimension(n_genes), target :: gene_to_fam Index mapping -> each index i holds the family index for the corresponding gene in expression_vectors , using 0_int32 for unassigned genes\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_families .\nThe value 0_int32 is additionally accepted. real(kind=c_double), intent(out), dimension(n_tissues, 2, n_genes), target :: shift_vectors Output, real matrix array. For each gene it holds two vectors: the centroid of the gene's family first (a zero vector if no family is assigned), then the shift vector integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"module/tox_shift_vectors_c.html"},{"title":"f42_stats_c – TensorOmics","text":"Descriptive statistics: percentiles, empirical distribution functions, and 2-D LOESS smoothing. One of the modules the f42_utils family gathers. Uses f42_safeguard iso_c_binding tox_errors Subroutines public  subroutine loess_smooth_2d_c (n_total, n_target, x_ref, y_ref, indices_used, n_used, x_query, kernel_sigma, kernel_cutoff, y_out, ierr) bind(C, name=\"loess_smooth_2d_c\") C-wrapper for loess_smooth_2d Read more… Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_total Total number of reference points. integer(kind=c_int), intent(in), target :: n_target Number of target points to smooth. real(kind=c_double), intent(in), dimension(n_total), target :: x_ref Reference x-coordinates. real(kind=c_double), intent(in), dimension(n_total), target :: y_ref Reference y-coordinates (length n_total). integer(kind=c_int), intent(in), dimension(n_used), target :: indices_used Indices of reference points used for smoothing (only valid indices).\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_total . integer(kind=c_int), intent(in), target :: n_used Number of indices actually used for smoothing. real(kind=c_double), intent(in), dimension(n_target), target :: x_query Target x-coordinates to smooth. real(kind=c_double), intent(in), target :: kernel_sigma Bandwidth parameter for the kernel.\nThe minimum valid value is 0.0_real64 . real(kind=c_double), intent(in), target :: kernel_cutoff Cutoff for the kernel, not used if zero\nThe minimum valid value is 0.0_real64 . real(kind=c_double), intent(out), dimension(n_target), target :: y_out Output smoothed values (length n_target). integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure. public  subroutine compute_edf_c (values, n_values, unique_values, cdf_values, n_unique, ierr) bind(C, name=\"compute_edf_c\") C-wrapper for compute_edf Read more… Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_values), target :: values Array of observed data values (e.g., contributions or spikes). integer(kind=c_int), intent(in), target :: n_values Number of values in the input array. real(kind=c_double), intent(out), dimension(n_values), target :: unique_values Sorted unique data values.\nThe first n_unique elements will hold the results. real(kind=c_double), intent(out), dimension(n_values), target :: cdf_values Corresponding cumulative frequencies between 0 and 1.\nThe first n_unique elements will hold the results. integer(kind=c_int), intent(out), target :: n_unique Number of unique values found (actual size of output arrays) integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure. public  subroutine compute_edf_expert_c (values, n_values, values_perm, unique_values, cdf_values, n_unique, ierr) bind(C, name=\"compute_edf_expert_c\") C-wrapper for compute_edf_expert Read more… Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_values), target :: values Array of observed data values (e.g., contributions or spikes). integer(kind=c_int), intent(in), target :: n_values Number of values in the input array. integer(kind=c_int), intent(in), dimension(n_values), target :: values_perm Permutation of values in ascending order. The allocating entry point builds\nand heapsorts it for you; the expert one takes whatever order you supply.\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_values . real(kind=c_double), intent(out), dimension(n_values), target :: unique_values Sorted unique data values.\nThe first n_unique elements will hold the results. real(kind=c_double), intent(out), dimension(n_values), target :: cdf_values Corresponding cumulative frequencies between 0 and 1.\nThe first n_unique elements will hold the results. integer(kind=c_int), intent(out), target :: n_unique Number of unique values found (actual size of output arrays) integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure. public  subroutine calc_percentile_c (array, n_array, percentile, value, n_considered, ierr) bind(C, name=\"calc_percentile_c\") C-wrapper for calc_percentile Read more… Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_array), target :: array input array integer(kind=c_int), intent(in), target :: n_array number of elements in array real(kind=c_double), intent(in), target :: percentile desired percentile as a fraction in [0,1] (e.g. 0.95 for the 95th percentile)\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 . real(kind=c_double), intent(out), target :: value output percentile value integer(kind=c_int), intent(in), target :: n_considered How many leading entries of array_perm the percentile is taken over, for a\npercentile of a subset -- the trailing entries are ignored rather than sliced\noff, so the permutation stays the shape the sort produced. Zero, the default,\nconsiders all n_array of them.\nThe default value is 0_int32 .\nThe minimum valid value is 0_int32 .\nThe maximum valid value is n_array . integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure. public  subroutine calc_percentile_expert_c (array, n_array, array_perm, percentile, value, n_considered, ierr) bind(C, name=\"calc_percentile_expert_c\") C-wrapper for calc_percentile_expert Read more… Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_array), target :: array input array integer(kind=c_int), intent(in), target :: n_array number of elements in array integer(kind=c_int), intent(in), dimension(n_array), target :: array_perm Permutation of array in ascending order. The allocating entry point builds and\nheapsorts it for you; the expert one takes whatever order you supply.\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_array . real(kind=c_double), intent(in), target :: percentile desired percentile as a fraction in [0,1] (e.g. 0.95 for the 95th percentile)\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 . real(kind=c_double), intent(out), target :: value output percentile value integer(kind=c_int), intent(in), target :: n_considered How many leading entries of array_perm the percentile is taken over, for a\npercentile of a subset -- the trailing entries are ignored rather than sliced\noff, so the permutation stays the shape the sort produced. Zero, the default,\nconsiders all n_array of them.\nThe default value is 0_int32 .\nThe minimum valid value is 0_int32 .\nThe maximum valid value is n_array . integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure. public  subroutine compute_scaled_distance_quantile_c (n_genes, rdi, sorted_rdi, quantile, c_const, ierr) bind(C, name=\"compute_scaled_distance_quantile_c\") C-wrapper for compute_scaled_distance_quantile Read more… Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_genes Number of genes being processed. real(kind=c_double), intent(in), dimension(n_genes), target :: rdi empirical distribution D\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=c_double), intent(in), dimension(n_genes), target :: sorted_rdi empirical distribution D with non negative values\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=c_double), intent(out), dimension(n_genes), target :: quantile Output array to store the computed quantile for each gene. real(kind=c_double), intent(in), target :: c_const Constant used in the computation, typically 1 integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure. public  subroutine compute_scaled_distance_quantile_expert_c (n_genes, rdi, sorted_rdi, sorted_rdi_perm, quantile, c_const, ierr) bind(C, name=\"compute_scaled_distance_quantile_expert_c\") C-wrapper for compute_scaled_distance_quantile_expert Read more… Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_genes Number of genes being processed. real(kind=c_double), intent(in), dimension(n_genes), target :: rdi empirical distribution D\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=c_double), intent(in), dimension(n_genes), target :: sorted_rdi empirical distribution D with non negative values\nNaN is permitted for this value.\nInfinite values are permitted for this value. integer(kind=c_int), intent(in), dimension(n_genes), target :: sorted_rdi_perm Permutation of sorted_rdi in ascending order. The allocating entry point builds\nand heapsorts it for you; the expert one takes whatever order you supply.\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_genes . real(kind=c_double), intent(out), dimension(n_genes), target :: quantile Output array to store the computed quantile for each gene. real(kind=c_double), intent(in), target :: c_const Constant used in the computation, typically 1 integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"module/f42_stats_c.html"},{"title":"tox_trajectory_normalization_impl – TensorOmics","text":"Min-max normalization of factor trajectories over time. Each factor's time series is rescaled to [0,1] independently, per sample -- so trajectories\nof very different magnitudes can be compared by shape. normalize_single_trajectory does one; normalize_all_trajectories does a whole tensor of them in one call. Uses iso_fortran_env f42_math_impl tox_errors Subroutines public pure subroutine normalize_variable_timeseries_impl (v, v_norm, n_points, status) Author Aaron Schröder License MIT Normalize a single variable across time using min-max scaling Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: v (n_points) Original time series real(kind=real64), intent(out) :: v_norm (n_points) Normalized time series integer(kind=int32), intent(in) :: n_points Vector length (number of time points) integer(kind=int32), intent(out) :: status Status code for specific warnings public pure subroutine normalize_single_trajectory_impl (trajectory, trajectory_norm, n_factors, n_timepoints, status) Author Aaron Schröder License MIT Normalize all factors in a single trajectory independently across time Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: trajectory (n_timepoints,n_factors) Original trajectory for one sample real(kind=real64), intent(out) :: trajectory_norm (n_timepoints,n_factors) Normalized trajectory for one sample integer(kind=int32), intent(in) :: n_factors Number of factors/variables integer(kind=int32), intent(in) :: n_timepoints Number of time points integer(kind=int32), intent(out), dimension(n_factors) :: status Status code for specific warnings, one per factor public pure subroutine normalize_all_trajectories_impl (trajectories, trajectories_norm, n_factors, n_samples, n_timepoints, tmp_series, tmp_series_norm, status) Author Aaron Schröder License MIT Normalize all trajectories across multiple entities Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: trajectories (n_factors,n_samples,n_timepoints) Original trajectories real(kind=real64), intent(out) :: trajectories_norm (n_factors,n_samples,n_timepoints) Normalized trajectories integer(kind=int32), intent(in) :: n_factors Number of factors integer(kind=int32), intent(in) :: n_samples Number of samples/entities integer(kind=int32), intent(in) :: n_timepoints Number of time points real(kind=real64), intent(out) :: tmp_series (n_timepoints) Work array: one factor's time series, gathered contiguously real(kind=real64), intent(out) :: tmp_series_norm (n_timepoints) Work array: the normalized time series integer(kind=int32), intent(out), dimension(n_factors, n_samples) :: status Status code for specific warnings, one per factor per sample","tags":"","url":"module/tox_trajectory_normalization_impl.html"},{"title":"tox_euclidean_distance_c – TensorOmics","text":"Euclidean distances in gene expression space. euclidean_distance between two expression vectors, and distance_to_centroid from every\ngene of a family to that family's centroid -- the distance the outlier detection and the\nrelative-distance index are built on. Uses f42_safeguard iso_c_binding tox_errors Subroutines public  subroutine euclidean_distance_c (vec1, vec2, n_elements, result, ierr) bind(C, name=\"euclidean_distance_c\") C-wrapper for euclidean_distance Read more… Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_elements), target :: vec1 First expression vector real(kind=c_double), intent(in), dimension(n_elements), target :: vec2 Second expression vector integer(kind=c_int), intent(in), target :: n_elements Dimension of both vectors real(kind=c_double), intent(out), target :: result Output scalar distance integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure. public  subroutine distance_to_centroid_c (n_genes, n_families, genes, centroids, gene_to_fam, distances, n_tissues, ierr) bind(C, name=\"distance_to_centroid_c\") C-wrapper for distance_to_centroid Read more… Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_genes Total number of genes integer(kind=c_int), intent(in), target :: n_families Total number of gene families real(kind=c_double), intent(in), dimension(n_tissues, n_genes), target :: genes Gene expression matrix (n_tissues × n_genes), column-major real(kind=c_double), intent(in), dimension(n_tissues, n_families), target :: centroids Family centroid matrix (n_tissues × n_families), column-major, -1.0_real64 for unassigned genes integer(kind=c_int), intent(in), dimension(n_genes), target :: gene_to_fam Index mapping -> each index i holds the family index for the corresponding gene in genes , using 0_int32 for unassigned genes\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_families .\nThe value 0_int32 is additionally accepted. real(kind=c_double), intent(out), dimension(n_genes), target :: distances Output distances array integer(kind=c_int), intent(in), target :: n_tissues Expression vector dimension integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"module/tox_euclidean_distance_c.html"},{"title":"f42_kd_tree_impl – TensorOmics","text":"k-d tree spatial index over fixed-dimensional point sets.\nBuilds a k-d tree by recursively partitioning kd_indices around the median point along a\ncaller-supplied, cycling dimension order, using a stack-based (non-recursive) traversal so it\nis safe to call from pure procedures. The tree is stored implicitly as an in-place-permuted\nindex array rather than as linked nodes. Uses f42_sort_impl iso_fortran_env tox_errors Subroutines public pure subroutine build_kd_index_impl (points, n_dimensions, n_points, kd_indices, dimension_order, tmp_workspace, tmp_value_buffer, tmp_permutation, tmp_recursion_stack) Author Aaron Schröder License MIT Build a k-d tree index using a stack-based, non-recursive approach Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_dimensions, n_points) :: points Data points integer(kind=int32), intent(in) :: n_dimensions Number of dimensions integer(kind=int32), intent(in) :: n_points Number of points integer(kind=int32), intent(out), dimension(n_points) :: kd_indices Output index array (k-d tree order) integer(kind=int32), intent(in), dimension(n_dimensions) :: dimension_order Dimension order (by variance)\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_dimensions . integer(kind=int32), intent(out), dimension(n_points) :: tmp_workspace Workspace array real(kind=real64), intent(out), dimension(n_points) :: tmp_value_buffer Workspace for sorting integer(kind=int32), intent(out), dimension(n_points) :: tmp_permutation Workspace for sorting integer(kind=int32), intent(out), dimension(3, n_points) :: tmp_recursion_stack Stack for l, r, depth public pure subroutine partial_sort_by_dimension_helper (points, n_points, n_dimensions, kd_indices, left_idx, right_idx, dim, tmp_workspace, tmp_value_buffer, tmp_permutation) Author Aaron Schröder License MIT Sorts kd_indices(left_idx:right_idx) by points(dimension, kd_indices(:)). Internal to the\nindex build, which has already validated everything this reads. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_dimensions, n_points) :: points Input points array integer(kind=int32), intent(in) :: n_points size of points integer(kind=int32), intent(in) :: n_dimensions Number of dimensions integer(kind=int32), intent(out), dimension(:) :: kd_indices Index array to modify integer(kind=int32), intent(in) :: left_idx Left index of subarray integer(kind=int32), intent(in) :: right_idx Right index of subarray integer(kind=int32), intent(in) :: dim Dimension to sort by integer(kind=int32), intent(out), dimension(:) :: tmp_workspace Workspace array real(kind=real64), intent(out), dimension(:) :: tmp_value_buffer Buffer for dimension values integer(kind=int32), intent(out), dimension(:) :: tmp_permutation Permutation array public pure subroutine build_spherical_kd_impl (points, n_dimensions, n_points, kd_indices, dimension_order, tmp_workspace, tmp_value_buffer, tmp_permutation, tmp_recursion_stack) Author Aaron Schröder License MIT Build a k-d tree index over points on the unit sphere (unit vectors) Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_dimensions, n_points) :: points Data points integer(kind=int32), intent(in) :: n_dimensions Number of dimensions integer(kind=int32), intent(in) :: n_points Number of points integer(kind=int32), intent(out), dimension(n_points) :: kd_indices Output index array (k-d tree order) integer(kind=int32), intent(in), dimension(n_dimensions) :: dimension_order Dimension order (by variance)\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_dimensions . integer(kind=int32), intent(out), dimension(n_points) :: tmp_workspace Workspace array real(kind=real64), intent(out), dimension(n_points) :: tmp_value_buffer Workspace for sorting integer(kind=int32), intent(out), dimension(n_points) :: tmp_permutation Workspace for sorting integer(kind=int32), intent(out), dimension(3, n_points) :: tmp_recursion_stack Stack for l, r, depth public pure subroutine get_kd_point (points, kd_indices, position, point_values, ierr) Author Aaron Schröder License MIT Retrieves the coordinate vector of the point stored at a given position of a built k-d\nindex, i.e. point_values = points(:, kd_indices(position)) . Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(:, :) :: points Input points integer(kind=int32), intent(in), dimension(:) :: kd_indices KD index array\nThe minimum valid value is 1_int32 .\nThe maximum valid value is size(points, dim=2, kind=int32) . integer(kind=int32), intent(in) :: position Position in index\nThe minimum valid value is 1_int32 .\nThe maximum valid value is size(kd_indices, kind=int32) . real(kind=real64), intent(out), dimension(size(points, dim=1, kind=int32)) :: point_values Output point values integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"module/f42_kd_tree_impl.html"},{"title":"tox_tissue_versatility_impl – TensorOmics","text":"Normalized tissue (axis) versatility: how uniformly a gene is expressed across tissues. An angle-based metric. A gene expressed equally across every selected axis points along the\ndiagonal of that subspace and scores maximally versatile; one confined to a single tissue\npoints along that axis and scores minimally. Normalized, so scores over different numbers of\nselected axes are comparable. Uses f42_safeguard iso_fortran_env iso_c_binding f42_math_impl Subroutines public pure subroutine compute_tissue_versatility_impl (n_axes, n_vectors, expression_vectors, vectors_selection_mask, n_selected_vectors, axes_selection_mask, n_selected_axes, tissue_versatilities, tissue_angles_deg) Author Vivian Bass License MIT Computes normalized tissue versatility for selected expression vectors. Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_axes Number of axes (tissues/dimensions) integer(kind=int32), intent(in) :: n_vectors Number of expression vectors (genes) real(kind=real64), intent(in), dimension(n_axes, n_vectors) :: expression_vectors 2D array (n_axes, n_vectors), each column is a gene expression vector logical(kind=c_bool), intent(in), dimension(n_vectors) :: vectors_selection_mask Logical array (n_vectors), .TRUE. for vectors to process integer(kind=int32), intent(in) :: n_selected_vectors Number of selected expression vectors (count of .TRUE. in vectors_selection_mask) logical(kind=c_bool), intent(in), dimension(n_axes) :: axes_selection_mask Logical array (n_axes), .TRUE. for axes to include in calculation integer(kind=int32), intent(in) :: n_selected_axes Number of selected axes (count of .TRUE. in axes_selection_mask)\nThe minimum valid value is 1_int32 . real(kind=real64), intent(out), dimension(n_selected_vectors) :: tissue_versatilities Output, real array, length = n_selected_vectors, stores the calculated tissue versatilities real(kind=real64), intent(out), dimension(n_selected_vectors) :: tissue_angles_deg Output, real array, length = n_selected_vectors, stores the calculated angles in degrees","tags":"","url":"module/tox_tissue_versatility_impl.html"},{"title":"f42_serde_arrays_serialize_char – TensorOmics","text":"Module for serializing character arrays into files Uses iso_fortran_env f42_serde_arrays_utils tox_errors Subroutines public  subroutine serialize_char_helper (arr, n_strings, arr_shape, filename, ierr) Author Aaron Schröder License MIT Category C-binding Subroutine to serialize a flat character array into a file Read more… Arguments Type Intent Optional Attributes Name character(len=*), intent(in), dimension(n_strings) :: arr Array to be serialized integer(kind=int32), intent(in) :: n_strings Number of strings in arr integer(kind=int32), intent(in), dimension(:) :: arr_shape Extents of arr , one per dimension character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code public  subroutine serialize_char_1d (arr, filename, ierr) Author Aaron Schröder License MIT Directly serialize a 1D character array into a file Arguments Type Intent Optional Attributes Name character(len=*), intent(in), dimension(:), contiguous :: arr Array to be serialized character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code public  subroutine serialize_char_2d (arr, filename, ierr) Author Aaron Schröder License MIT Directly serialize a 2D character array into a file Arguments Type Intent Optional Attributes Name character(len=*), intent(in), dimension(:, :), contiguous :: arr Array to be serialized character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code public  subroutine serialize_char_3d (arr, filename, ierr) Author Aaron Schröder License MIT Directly serialize a 3D character array into a file Arguments Type Intent Optional Attributes Name character(len=*), intent(in), dimension(:, :, :), contiguous :: arr Array to be serialized character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code public  subroutine serialize_char_4d (arr, filename, ierr) Author Aaron Schröder License MIT Directly serialize a 4D character array into a file Arguments Type Intent Optional Attributes Name character(len=*), intent(in), dimension(:, :, :, :), contiguous :: arr Array to be serialized character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code public  subroutine serialize_char_5d (arr, filename, ierr) Author Aaron Schröder License MIT Directly serialize a 5D character array into a file Arguments Type Intent Optional Attributes Name character(len=*), intent(in), dimension(:, :, :, :, :), contiguous :: arr Array to be serialized character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"module/f42_serde_arrays_serialize_char.html"},{"title":"tox_data_integration_stats_impl – TensorOmics","text":"Jensen-Shannon-Divergence (JSD) Compatibility Test (gJCT) Permutation Test A permutation test estimating an empirical p-value for the weighted global JSD. Under the null\nhypothesis that both studies are exchangeable, S1/S2 residuals are repeatedly shuffled within\neach reference point's pooled neighborhood and the JSD is recomputed, giving a null\ndistribution against which the observed value is compared. Work copies are shuffled, never the caller's arrays. Uses iso_fortran_env iso_c_binding tox_data_integration_jsd_impl f42_safeguard f42_random_impl Subroutines public  subroutine gjct_permutation_test_impl (neighborhood_residuals_S1, neighborhood_residuals_S2, n_reps_S1, n_reps_S2, n_neighbors, n_points, global_jsd_observed, n_bins, shared_residual_range, n_permutations, jsd_null, p_value, tmp_residuals_S1, tmp_residuals_S2, tmp_pool, tmp_pmf_S1, tmp_pmf_S2, tmp_counts, tmp_included_n_reps_S1, tmp_included_n_reps_S2, tmp_js_divergences, tmp_weights, random_seed, neighbor_mask_S1, neighbor_mask_S2) Author Franz-Eric Sill License MIT Estimate how likely the observed divergence is to occur by chance Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_reps_S1, n_neighbors, n_points) :: neighborhood_residuals_S1 Computed neighborhood residuals for study 1, NaN is explicitly allowed for missing values\nNaN is permitted for this value. real(kind=real64), intent(in), dimension(n_reps_S2, n_neighbors, n_points) :: neighborhood_residuals_S2 Computed neighborhood residuals for study 2, NaN is explicitly allowed for missing values\nNaN is permitted for this value. integer(kind=int32), intent(in) :: n_reps_S1 Number of replicates in study 1 integer(kind=int32), intent(in) :: n_reps_S2 Number of replicates in study 2 integer(kind=int32), intent(in) :: n_neighbors Number of neighbors in the studies integer(kind=int32), intent(in) :: n_points Number of reference points in the studies real(kind=real64), intent(in) :: global_jsd_observed Observed global JSD value for both studies integer(kind=int32), intent(in) :: n_bins Number of equally sized histogram bins used for the studies real(kind=real64), intent(in) :: shared_residual_range Computed residual range for both studies\nThe minimum valid value is 0.0_real64 . integer(kind=int32), intent(in) :: n_permutations Number of permutations to perform real(kind=real64), intent(out), dimension(n_permutations) :: jsd_null Vector of global divergence values obtained under the null hypothesis real(kind=real64), intent(out) :: p_value Empirical p-value of the permutation test: real(kind=real64), intent(out), dimension(n_reps_S1, n_neighbors, n_points), target :: tmp_residuals_S1 Work copy of study 1's residuals, shuffled in place real(kind=real64), intent(out), dimension(n_reps_S2, n_neighbors, n_points), target :: tmp_residuals_S2 Work copy of study 2's residuals, shuffled in place real(kind=real64), intent(out), dimension(n_reps_S1 + n_reps_S2, n_neighbors), target :: tmp_pool Working array for shuffling the concatenated residuals from both studies per reference point real(kind=real64), intent(out), dimension(n_points, n_bins) :: tmp_pmf_S1 Working array for study 1's normalized histogram counts real(kind=real64), intent(out), dimension(n_points, n_bins) :: tmp_pmf_S2 Working array for study 2's normalized histogram counts integer(kind=int32), intent(out), dimension(n_points, n_bins) :: tmp_counts Working array for the histogram counts integer(kind=int32), intent(out), dimension(n_points) :: tmp_included_n_reps_S1 Working array for study 1's included replicate counts integer(kind=int32), intent(out), dimension(n_points) :: tmp_included_n_reps_S2 Working array for study 2's included replicate counts real(kind=real64), intent(out), dimension(n_points) :: tmp_js_divergences Working array for the per-reference-point divergences real(kind=real64), intent(out), dimension(n_points) :: tmp_weights Working array for the divergence weights integer(kind=int32), intent(in), optional :: random_seed Seed to use for shuffling logical(kind=c_bool), intent(in), optional, dimension(n_neighbors, n_points) :: neighbor_mask_S1 Optional mask to exclude specific neighbors from study 1 (e.g. for family-wise analysis) logical(kind=c_bool), intent(in), optional, dimension(n_neighbors, n_points) :: neighbor_mask_S2 Optional mask to exclude specific neighbors from study 2 (e.g. for family-wise analysis) public  subroutine shuffle_reference_point_helper (reference_point_S1, reference_point_S2, n_reps_S1, n_reps_S2, n_neighbors, pool_flat) Author Franz-Eric Sill License MIT Shuffle the residuals of one reference point between the two studies Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(inout), dimension(n_reps_S1*n_neighbors) :: reference_point_S1 Residuals for one reference point in study 1, will be shuffled in-place real(kind=real64), intent(inout), dimension(n_reps_S2*n_neighbors) :: reference_point_S2 Residuals for one reference point in study 2, will be shuffled in-place integer(kind=int32), intent(in) :: n_reps_S1 Number of replicates in study 1 integer(kind=int32), intent(in) :: n_reps_S2 Number of replicates in study 2 integer(kind=int32), intent(in) :: n_neighbors Number of neighbors in the studies real(kind=real64), intent(out), dimension((n_reps_S1 + n_reps_S2)*n_neighbors) :: pool_flat Working array for shuffling the concatenated residuals from both studies per reference point","tags":"","url":"module/tox_data_integration_stats_impl.html"},{"title":"tox_relative_axis_plane_tools_c – TensorOmics","text":"Relative axis planes (RAPs): planes through higher-dimensional gene expression space, and\nwhat can be read off a vector once it is projected onto one. A RAP is picked by selecting axes (tissues) from the full expression space. vector_RAP_projection projects a single vector onto it and field_RAP_projection a whole\nfield of them. Within the plane, clock_hand_angle_between_vectors measures the signed angle\nbetween two vectors -- signed by an orientation reference, so the sign means the same thing in\nevery dimension -- and clock_hand_angles_for_shift_vectors does that for a whole shift\nvector field at once. relative_axes_changes_from_shift_vector and relative_axes_expression_from_expression_vector give the per-axis breakdown instead of the angle: how much of a change, or of an expression\nlevel, falls on each selected axis. Uses f42_safeguard iso_c_binding tox_errors Subroutines public  subroutine omics_vector_RAP_projection_c (vecs, n_axes, n_vecs, vecs_selection_mask, n_selected_vecs, axes_selection_mask, n_selected_axes, projections, ierr) bind(C, name=\"omics_vector_RAP_projection_c\") C-wrapper for omics_vector_RAP_projection Read more… Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_axes, n_vecs), target :: vecs matrix with expression vectors integer(kind=c_int), intent(in), target :: n_axes number of axes integer(kind=c_int), intent(in), target :: n_vecs number of vectors per axis logical(kind=c_bool), intent(in), dimension(n_vecs), target :: vecs_selection_mask .true. for vectors where projection is to be computed integer(kind=c_int), intent(in), target :: n_selected_vecs count of .true. values in vecs_selection_mask logical(kind=c_bool), intent(in), dimension(n_axes), target :: axes_selection_mask .true. for axes to be included in RAP integer(kind=c_int), intent(in), target :: n_selected_axes count of .true. values in axes_selection_mask real(kind=c_double), intent(out), dimension(n_selected_axes, n_selected_vecs), target :: projections projected vectors integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure. public  subroutine omics_field_RAP_projection_c (fields, n_axes, n_fields, fields_selection_mask, n_selected_fields, axes_selection_mask, n_selected_axes, projections, ierr) bind(C, name=\"omics_field_RAP_projection_c\") C-wrapper for omics_field_RAP_projection Read more… Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_axes, 2, n_fields), target :: fields matrix with vector fields; each field holds two vectors, the origin first and the target second integer(kind=c_int), intent(in), target :: n_axes number of axes integer(kind=c_int), intent(in), target :: n_fields number of vectors per axis logical(kind=c_bool), intent(in), dimension(n_fields), target :: fields_selection_mask .true. for vectors where projection is to be computed integer(kind=c_int), intent(in), target :: n_selected_fields count of .true. values in fields_selection_mask logical(kind=c_bool), intent(in), dimension(n_axes), target :: axes_selection_mask .true. for axes to be included in RAP integer(kind=c_int), intent(in), target :: n_selected_axes count of .true. values in axes_selection_mask real(kind=c_double), intent(out), dimension(n_selected_axes, n_selected_fields), target :: projections projected vectors integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure. public  subroutine clock_hand_angle_between_vectors_c (v1, v2, n_dims, orientation_reference, signed_angle, ierr) bind(C, name=\"clock_hand_angle_between_vectors_c\") C-wrapper for clock_hand_angle_between_vectors Read more… Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_dims), target :: v1 First normalized vector in RAP space real(kind=c_double), intent(in), dimension(n_dims), target :: v2 Second normalized vector in RAP space integer(kind=c_int), intent(in), target :: n_dims Dimension of both vectors real(kind=c_double), intent(in), dimension(n_dims), target :: orientation_reference Orients the plane the rotation happens in, so the angle can carry a sign. A\nrotation from one vector to another has no inherent direction above two\ndimensions -- and in RAP space not even in two, since the axes are tissues or\nfactors and carry no handedness -- so the caller states which way round counts\nas positive. The sign is that of this vector's component along the rotation. real(kind=c_double), intent(out), target :: signed_angle Signed angle between vectors in radians [-pi, pi] integer(kind=c_int), intent(out), target :: ierr Error code public  subroutine clock_hand_angles_for_shift_vectors_c (fields, n_dims, n_fields, fields_selection_mask, n_selected_fields, orientation_reference, signed_angles, ierr) bind(C, name=\"clock_hand_angles_for_shift_vectors_c\") C-wrapper for clock_hand_angles_for_shift_vectors Read more… Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_dims, 2, n_fields), target :: fields matrix with vector fields; each field holds two vectors, the origin first and the target second integer(kind=c_int), intent(in), target :: n_dims Dimension of each vector in RAP space integer(kind=c_int), intent(in), target :: n_fields Number of vector pairs logical(kind=c_bool), intent(in), dimension(n_fields), target :: fields_selection_mask .true. for vector pairs where angle should be computed integer(kind=c_int), intent(in), target :: n_selected_fields Count of .true. values in fields_selection_mask real(kind=c_double), intent(in), dimension(n_dims), target :: orientation_reference Orients the plane the rotation happens in, so the angle can carry a sign. A\nrotation from one vector to another has no inherent direction above two\ndimensions -- and in RAP space not even in two, since the axes are tissues or\nfactors and carry no handedness -- so the caller states which way round counts\nas positive. The sign is that of this vector's component along the rotation. real(kind=c_double), intent(out), dimension(n_selected_fields), target :: signed_angles Signed rotation angles between vector pairs in radians [-π, π] integer(kind=c_int), intent(out), target :: ierr Error code public  subroutine compute_relative_axis_contributions_c (vec, n_axes, contributions, ierr) bind(C, name=\"compute_relative_axis_contributions_c\") C-wrapper for compute_relative_axis_contributions Read more… Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_axes), target :: vec RAP-projected and normalized vector (expression or shift) integer(kind=c_int), intent(in), target :: n_axes Number of axes (length of vec and contributions) real(kind=c_double), intent(out), dimension(n_axes), target :: contributions Fractional contribution of each axis (output), values in [0,1], sum to 1 integer(kind=c_int), intent(out), target :: ierr Error code public  subroutine relative_axes_changes_from_shift_vector_c (vec, n_axes, contributions, ierr) bind(C, name=\"relative_axes_changes_from_shift_vector_c\") C-wrapper for relative_axes_changes_from_shift_vector Read more… Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_axes), target :: vec RAP-projected and normalized shift vector integer(kind=c_int), intent(in), target :: n_axes Number of axes real(kind=c_double), intent(out), dimension(n_axes), target :: contributions Fractional contribution of each axis (output), values in [0,1], sum to 1 integer(kind=c_int), intent(out), target :: ierr Error code public  subroutine relative_axes_expression_from_expression_vector_c (vec, n_axes, contributions, ierr) bind(C, name=\"relative_axes_expression_from_expression_vector_c\") C-wrapper for relative_axes_expression_from_expression_vector Read more… Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_axes), target :: vec RAP-projected and normalized expression vector integer(kind=c_int), intent(in), target :: n_axes Number of axes real(kind=c_double), intent(out), dimension(n_axes), target :: contributions Fractional contribution of each axis (output), values in [0,1], sum to 1 integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"module/tox_relative_axis_plane_tools_c.html"},{"title":"f42_serde_utils – TensorOmics","text":"Module for de-/serialization utilities. Uses iso_fortran_env Variables Type Visibility Attributes Name Initial integer(kind=int32), public, parameter :: INTEGER_TYPE_CODE = -1_int32 Type code for integer type integer(kind=int32), public, parameter :: REAL_TYPE_CODE = -2_int32 Type code for real type integer(kind=int32), public, parameter :: LOGICAL_TYPE_CODE = -3_int32 Type code for logical type integer(kind=int32), public, parameter :: COMPLEX_TYPE_CODE = -4_int32 Type code for complex type","tags":"","url":"module/f42_serde_utils.html"},{"title":"tox_gene_centroids – TensorOmics","text":"Expression centroids of gene families. mean_vector is the centroid of a set of expression vectors. group_centroid_orthologs and group_centroid_all take the centroid of a family: over its orthologs only, or over\nevery gene in it -- two routines rather than one taking a flag, so which set a result is\nover is visible at the call site. Generated from tox_gene_centroids_impl ; do not edit -- regenerate instead. Uses iso_fortran_env iso_c_binding tox_gene_centroids_impl f42_safeguard tox_errors Subroutines public pure subroutine mean_vector (expression_vectors, n_axes, n_genes, gene_indices, n_selected_genes, centroid, ierr) Validates its inputs, then calls mean_vector_impl . Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_axes, n_genes) :: expression_vectors The input matrix of all gene expression vectors (n_axes x n_genes). integer(kind=int32), intent(in) :: n_axes Number of axes (tissues/dimensions). integer(kind=int32), intent(in) :: n_genes Total number of genes in the input matrix. integer(kind=int32), intent(in), dimension(n_selected_genes) :: gene_indices An array containing the column indices of the selected genes in 'expression_vectors'.\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_genes . integer(kind=int32), intent(in) :: n_selected_genes The number of genes in the current family to be averaged.\nThe minimum valid value is 0_int32 .\nThe maximum valid value is n_genes . real(kind=real64), intent(out), dimension(n_axes) :: centroid The output vector representing the computed centroid. integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure. public pure subroutine group_centroid_orthologs (expression_vectors, n_axes, n_genes, gene_to_family, n_families, centroid_matrix, ortholog_set, ierr) Validates its inputs, prepares what group_centroid_impl needs, then calls it. The entry point to reach for first; see group_centroid_orthologs_expert to prepare it yourself. Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_axes, n_genes) :: expression_vectors The input matrix of all gene expression vectors (n_axes x n_genes). integer(kind=int32), intent(in) :: n_axes Number of axes (tissues/dimensions). integer(kind=int32), intent(in) :: n_genes Total number of genes in the 'expression_vectors' matrix. integer(kind=int32), intent(in), dimension(n_genes) :: gene_to_family Index mapping -> each index i holds the family index for the corresponding gene in expression_vectors , using 0_int32 for unassigned genes\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_families .\nThe value 0_int32 is additionally accepted. integer(kind=int32), intent(in) :: n_families Total number of gene families to compute centroids for. real(kind=real64), intent(out), dimension(n_axes, n_families) :: centroid_matrix The output matrix (n_axes x n_families) to store the computed centroids. logical(kind=c_bool), intent(in), dimension(n_genes) :: ortholog_set A logical array indicating if a gene is part of a specific subset (e.g., orthologs). integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure. public pure subroutine group_centroid_orthologs_expert (expression_vectors, n_axes, n_genes, gene_to_family, n_families, centroid_matrix, tmp_group_indices, ortholog_set, ierr) Validates its inputs, then calls group_centroid_impl with what you supply. The expert entry point: it allocates nothing and prepares nothing; group_centroid_orthologs does both. Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_axes, n_genes) :: expression_vectors The input matrix of all gene expression vectors (n_axes x n_genes). integer(kind=int32), intent(in) :: n_axes Number of axes (tissues/dimensions). integer(kind=int32), intent(in) :: n_genes Total number of genes in the 'expression_vectors' matrix. integer(kind=int32), intent(in), dimension(n_genes) :: gene_to_family Index mapping -> each index i holds the family index for the corresponding gene in expression_vectors , using 0_int32 for unassigned genes\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_families .\nThe value 0_int32 is additionally accepted. integer(kind=int32), intent(in) :: n_families Total number of gene families to compute centroids for. real(kind=real64), intent(out), dimension(n_axes, n_families) :: centroid_matrix The output matrix (n_axes x n_families) to store the computed centroids. integer(kind=int32), intent(out), dimension(n_genes) :: tmp_group_indices Work array for storing the indices of one family's genes. logical(kind=c_bool), intent(in), dimension(n_genes) :: ortholog_set A logical array indicating if a gene is part of a specific subset (e.g., orthologs). integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure. public pure subroutine group_centroid_all (expression_vectors, n_axes, n_genes, gene_to_family, n_families, centroid_matrix, ierr) Validates its inputs, prepares what group_centroid_impl needs, then calls it. The entry point to reach for first; see group_centroid_all_expert to prepare it yourself. Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_axes, n_genes) :: expression_vectors The input matrix of all gene expression vectors (n_axes x n_genes). integer(kind=int32), intent(in) :: n_axes Number of axes (tissues/dimensions). integer(kind=int32), intent(in) :: n_genes Total number of genes in the 'expression_vectors' matrix. integer(kind=int32), intent(in), dimension(n_genes) :: gene_to_family Index mapping -> each index i holds the family index for the corresponding gene in expression_vectors , using 0_int32 for unassigned genes\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_families .\nThe value 0_int32 is additionally accepted. integer(kind=int32), intent(in) :: n_families Total number of gene families to compute centroids for. real(kind=real64), intent(out), dimension(n_axes, n_families) :: centroid_matrix The output matrix (n_axes x n_families) to store the computed centroids. integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure. public pure subroutine group_centroid_all_expert (expression_vectors, n_axes, n_genes, gene_to_family, n_families, centroid_matrix, tmp_group_indices, ierr) Validates its inputs, then calls group_centroid_impl with what you supply. The expert entry point: it allocates nothing and prepares nothing; group_centroid_all does both. Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_axes, n_genes) :: expression_vectors The input matrix of all gene expression vectors (n_axes x n_genes). integer(kind=int32), intent(in) :: n_axes Number of axes (tissues/dimensions). integer(kind=int32), intent(in) :: n_genes Total number of genes in the 'expression_vectors' matrix. integer(kind=int32), intent(in), dimension(n_genes) :: gene_to_family Index mapping -> each index i holds the family index for the corresponding gene in expression_vectors , using 0_int32 for unassigned genes\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_families .\nThe value 0_int32 is additionally accepted. integer(kind=int32), intent(in) :: n_families Total number of gene families to compute centroids for. real(kind=real64), intent(out), dimension(n_axes, n_families) :: centroid_matrix The output matrix (n_axes x n_families) to store the computed centroids. integer(kind=int32), intent(out), dimension(n_genes) :: tmp_group_indices Work array for storing the indices of one family's genes. integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"module/tox_gene_centroids.html"},{"title":"tox_paralog_analysis_impl – TensorOmics","text":"Paralog-subset expression patterns -- dosage effect and subfunctionalization -- relative to an ancestral ortholog. Candidate paralog subsets are enumerated as bitmask-encoded gene sets, built up one gene at a time\nstarting from single genes. At every extension step the candidate is scored against the pattern-specific\ncriterion (small angle plus magnitude gain for dosage effect, or bounded residual distance for\nsubfunctionalization); subsets that can no longer satisfy the criterion are pruned instead of being\nextended further, which keeps the combinatorial subset search tractable. There is a routine per pattern rather than one taking a pattern flag: detect_dosage_effect and detect_subfunctionalization find the subsets, and filter_paralogs_by_pattern_dosage_effect / _subfunctionalization reduce a set of genes to\nthose matching. Which criterion a result was scored against is therefore visible at the call\nsite, and each routine takes only the thresholds its own pattern needs. Uses iso_fortran_env iso_c_binding f42_math_impl f42_vector_impl f42_safeguard tox_errors Variables Type Visibility Attributes Name Initial integer(kind=int32), public, parameter :: MODE_DOSAGE_PATTERN = 0_int32 Code for detecting dosage effect in detect_patterns_impl integer(kind=int32), public, parameter :: MODE_SUBFUNC_PATTERN = 1_int32 Code for detecting subfunctionalization in detect_patterns_impl Functions public pure function mask_get_first_successor_idx (bit_mask) result(idx) Author Franz-Eric Sill License MIT Helper function that returns the index after the last active gene in bit_mask , so the first succeeding gene. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in), dimension(:) :: bit_mask chunked mask to mark active genes Return Value integer(kind=int32) index of last active gene public pure function mask_check_state (bit_mask, i_gene) result(state) Author Franz-Eric Sill License MIT Category C-binding Checks the state of a bit/paralog in bit_mask -> .true. if 1 else .false. Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in), dimension(:) :: bit_mask chunked mask to mark active paralogs integer(kind=int32), intent(in) :: i_gene index of paralog to be marked active Return Value logical check result Subroutines public pure subroutine detect_neofunctionalization_impl (ancestors, n_families, genes, n_axes, gene_to_fam, n_genes, thresholds, neofunc) Author Franz-Eric Sill License MIT Identifies neofunctionalization for genes by checking whether the difference of expression to its ancestor exceeds the threshold for the respective axis Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_axes, n_families) :: ancestors RAP projected unit length expression vector of ancestral ortholog\nThe minimum valid value is -1.0_real64 .\nThe maximum valid value is 1.0_real64 . integer(kind=int32), intent(in) :: n_families number of vectors in ancestors real(kind=real64), intent(in), dimension(n_axes, n_genes) :: genes RAP projected unit length expression vectors of genes\nThe minimum valid value is -1.0_real64 .\nThe maximum valid value is 1.0_real64 . integer(kind=int32), intent(in) :: n_axes size of ancestors vector and vectors in genes integer(kind=int32), intent(in), dimension(n_genes) :: gene_to_fam Index mapping -> each index i holds the family index for the corresponding gene in genes , using 0_int32 for unassigned genes\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_families .\nThe value 0_int32 is additionally accepted. integer(kind=int32), intent(in) :: n_genes number of vectors in genes real(kind=real64), intent(in), dimension(n_axes) :: thresholds threshold per axis that defines significant change in expression, may be a percentile of all genes' changes per axis\nThe minimum valid value is -1.0_real64 .\nThe maximum valid value is 1.0_real64 . logical(kind=c_bool), intent(out), dimension(n_genes, n_axes) :: neofunc .true. if neofunctionalization has been detected for the respective axes, always .false. for unassigned genes public pure subroutine detect_patterns_impl (ancestor, genes, n_genes, n_dims, pattern_mode, filtered_paralogs_mask, n_mask_chunks, n_results, max_subset_size, work_arr_paralog_subsets, n_paralog_subsets, tmp_active_mask, tmp_paralog_vector, max_angle, gain_gamma, rdi_threshold, paralog_norms, sorted_paralog_norms_perm, tmp_work_array, ierr) Author Franz-Eric Sill License MIT Identifies subsets of paralogs matching this pattern Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_dims) :: ancestor expression vector of ancestral ortholog real(kind=real64), intent(in), dimension(n_dims, n_genes) :: genes expression vectors of genes integer(kind=int32), intent(in) :: n_genes number of vectors in genes integer(kind=int32), intent(in) :: n_dims size of ancestor vector and vectors in genes integer(kind=int32), intent(in) :: pattern_mode used pattern for detection Read more… integer(kind=int32), intent(in), dimension(n_mask_chunks) :: filtered_paralogs_mask bit mask with the genes' indices kept by this pattern set to 1, else 0. Build it with the matching filter_paralogs_by_pattern_* routine integer(kind=int32), intent(in) :: n_mask_chunks number of 32 bit chunks a mask needs to encode n_genes genes. Use subroutine mask_chunk_count for calculation\nThe minimum valid value is (n_genes + 31) / 32 . integer(kind=int32), intent(out) :: n_results number of resulting subsets. They are stored as the first n_results elements of work_arr_paralog_subsets integer(kind=int32), intent(in) :: max_subset_size maximum subset size of checked gene subsets. Too large a value is capped to the\nmaximum valid size. The bindings cap it automatically while sizing the work\narray; a Fortran caller caps it by calling calc_work_arr_paralog_subsets_size first.\nZero is in range and means there is no subset to check -- the sizing routine reports\nit whenever the filtered families hold a single gene each. It reports a work array\nof zero slots along with it, which this routine does not accept, so a caller that\ngets zero back has nothing to detect and should not call here at all.\nThe minimum valid value is 0_int32 . integer(kind=int32), intent(out), dimension(n_mask_chunks, n_paralog_subsets) :: work_arr_paralog_subsets working array to hold bitmask encoded subsets for detection. Read more… integer(kind=int32), intent(in) :: n_paralog_subsets number of gene subsets that can be stored in work_arr_paralog_subsets .\nIt is VERY IMPORTANT to compute this argument from the work_array_size output produced by calc_work_arr_paralog_subsets_size . integer(kind=int32), intent(out), dimension(n_mask_chunks) :: tmp_active_mask working array to hold the extended subsets real(kind=real64), intent(out), dimension(n_dims) :: tmp_paralog_vector vector used for pruning subsets real(kind=real64), intent(in), optional :: max_angle maximum angle in radians 0<=angle<=Pi that a subset candidate must not exceed, otherwise pruned\nThis optional argument needs to be passed if used mode ( pattern_mode ) is MODE_DOSAGE_PATTERN .\nThe default value is 4.0_real64*atan(1.0_real64) .\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is PI . real(kind=real64), intent(in), optional :: gain_gamma positive magnitude gain for dosage effect\nThis optional argument needs to be passed if used mode ( pattern_mode ) is MODE_DOSAGE_PATTERN .\nThe default value is 0.1_real64 .\nThe minimum valid value is above(0.0_real64) . real(kind=real64), intent(in), optional :: rdi_threshold max allowed residual distance from ancestor This optional argument needs to be passed if used mode ( pattern_mode ) is MODE_SUBFUNC_PATTERN .\nThe minimum valid value is 0.0_real64 . real(kind=real64), intent(in), optional, dimension(n_genes) :: paralog_norms euclidean norms of the genes, used for subset pruning ( norm from f42_vector_impl computes them)\nThis optional argument needs to be passed if used mode ( pattern_mode ) is MODE_SUBFUNC_PATTERN .\nThe minimum valid value is 0.0_real64 . integer(kind=int32), intent(in), optional, dimension(n_genes) :: sorted_paralog_norms_perm ascending permutation of the norms, for subset pruning: the smallest norm among the genes that could extend a subset must not fall below the subset's angle to the ancestor\nThis optional argument needs to be passed if used mode ( pattern_mode ) is MODE_SUBFUNC_PATTERN .\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_genes . real(kind=real64), intent(out), optional, dimension(n_genes) :: tmp_work_array work array for checking the minimum value after a given index efficiently\nThis optional argument needs to be passed if used mode ( pattern_mode ) is MODE_SUBFUNC_PATTERN . integer(kind=int32), intent(out) :: ierr Error code public pure subroutine generate_subsets_helper (candidate_mask, filtered_paralogs_mask, n_mask_chunks, pattern, ancestor, genes, n_genes, n_dims, tmp_paralog_vector, work_arr_paralog_subsets, n_paralog_subsets, n_results, n_active_masks, n_new_active_masks, dosage_max_angle, dosage_gain_gamma, subfunc_rdi_threshold, subfunc_paralog_norms, subfunc_sorted_paralog_norms_perm, tmp_subfunc_work_array, ierr) Author Franz-Eric Sill License MIT Generates subsets for candidate_mask by extending it with one valid gene.\nSubsets with bad gene constellation will be pruned,\nothers will be added to the work array, either as new active subset that will be extended in coming iterations or as result. Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(inout), dimension(n_mask_chunks) :: candidate_mask working array to hold a subset that is a potential result candidate integer(kind=int32), intent(in), dimension(n_mask_chunks) :: filtered_paralogs_mask bit mask that will have indices of genes kept by pattern set to 1, else 0 integer(kind=int32), intent(in) :: n_mask_chunks number of 32 bit chunks a mask needs to encode n_genes genes integer(kind=int32), intent(in) :: pattern used pattern for detection Read more… real(kind=real64), intent(in), dimension(n_dims) :: ancestor expression vector of ancestral ortholog real(kind=real64), intent(in), dimension(n_dims, n_genes) :: genes expression vectors of genes integer(kind=int32), intent(in) :: n_genes number of vectors in genes integer(kind=int32), intent(in) :: n_dims size of ancestor vector and vectors in genes real(kind=real64), intent(inout), dimension(n_dims) :: tmp_paralog_vector vector used for pruning subsets integer(kind=int32), intent(out), dimension(n_mask_chunks, n_paralog_subsets) :: work_arr_paralog_subsets working array to hold bitmask encoded subsets for detection. integer(kind=int32), intent(in) :: n_paralog_subsets number of gene subsets that can be stored in work_arr_paralog_subsets . USE calc_work_arr_paralog_subsets_size TO DETERMINE THIS NUMBER integer(kind=int32), intent(inout) :: n_results number of results in work_arr_paralog_subsets integer(kind=int32), intent(in) :: n_active_masks number of active subsets in work_arr_paralog_subsets integer(kind=int32), intent(inout) :: n_new_active_masks number of new active subsets in work_arr_paralog_subsets real(kind=real64), intent(in), optional :: dosage_max_angle maximum angle in radians that a subset candidate must not exceed, otherwise pruned, default is Pi real(kind=real64), intent(in), optional :: dosage_gain_gamma positive magnitude gain for dosage, default 0.1 real(kind=real64), intent(in), optional :: subfunc_rdi_threshold max allowed residual distance from ancestor real(kind=real64), intent(in), optional, dimension(n_genes) :: subfunc_paralog_norms euclidean norms of the genes, used for subset pruning ( norm from f42_vector_impl computes them) integer(kind=int32), intent(in), optional, dimension(n_genes) :: subfunc_sorted_paralog_norms_perm ascending permutation of the norms, for subset pruning: the smallest norm among the genes that could extend a subset must not fall below the subset's angle to the ancestor real(kind=real64), intent(out), optional, dimension(n_genes) :: tmp_subfunc_work_array work array for checking the minimum value after a given index efficiently integer(kind=int32), intent(out) :: ierr Error code public pure subroutine fill_array_with_minvals_for_each_idx (out_arr, src_arr, sorted_src_arr_perm, src_arr_len, ierr) Author Franz-Eric Sill License MIT Helper for subfunctionalization pruning. It initializes a working array with each index i holding the min value in subarray src_arr(i:src_arr_len) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(out), optional, dimension(src_arr_len) :: out_arr output array, e.g. source [50, 75, 0, 100, 25] would lead to out_arr [0, 0, 0, 25, 25] real(kind=real64), intent(in), optional, dimension(src_arr_len) :: src_arr array that holds the original values integer(kind=int32), intent(in), optional, dimension(src_arr_len) :: sorted_src_arr_perm sorted permutation vector, so each index holds the index of the value in src_arr as if src_arr was soted ascending integer(kind=int32), intent(in) :: src_arr_len number elements in src_arr integer(kind=int32), intent(out) :: ierr Error code public pure subroutine take_active_mask_helper (subsets, n_mask_chunks, n_subsets, n_results, n_active_masks, n_new_active_masks, active_mask, ierr) Author Franz-Eric Sill License MIT For memory efficiency this subroutine helps holding different kinds of masks in a single array.\nTo achieve this, subsets has this structure: [...results, ...active_masks, ...new_active_masks]\nThis routine removes an active mask from the subsets array and returns it in active_mask . Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(inout), dimension(n_mask_chunks, n_subsets) :: subsets working array to hold bitmask encoded subsets for detection. integer(kind=int32), intent(in) :: n_mask_chunks number of 32 bit chunks in a mask integer(kind=int32), intent(in) :: n_subsets number of subsets that can be hold integer(kind=int32), intent(in) :: n_results number of results in subsets integer(kind=int32), intent(inout) :: n_active_masks number of active masks in subsets integer(kind=int32), intent(in) :: n_new_active_masks number of new active masks in subsets integer(kind=int32), intent(out), dimension(n_mask_chunks) :: active_mask taken active mask from subsets , will be remove from subsets integer(kind=int32), intent(out) :: ierr Error code public pure subroutine add_to_results_helper (subsets, n_mask_chunks, n_subsets, n_results, n_active_masks, n_new_active_masks, result, ierr) Author Franz-Eric Sill License MIT For memory efficiency this subroutine helps holding different kinds of masks in a single array.\nTo achieve this, subsets has this structure: [...results, ...active_masks, ...new_active_masks]\nThis routine adds a result mask to subsets array. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(inout), dimension(n_mask_chunks, n_subsets) :: subsets working array to hold bitmask encoded subsets for detection. integer(kind=int32), intent(in) :: n_mask_chunks number of 32 bit chunks in a mask integer(kind=int32), intent(in) :: n_subsets number of subsets that can be hold integer(kind=int32), intent(inout) :: n_results number of results in subsets integer(kind=int32), intent(in) :: n_active_masks number of active masks in subsets integer(kind=int32), intent(in) :: n_new_active_masks number of new active masks in subsets integer(kind=int32), intent(in), dimension(n_mask_chunks) :: result result to add to subsets integer(kind=int32), intent(out) :: ierr Error code public pure subroutine add_new_active_mask_helper (subsets, n_mask_chunks, n_subsets, n_results, n_active_masks, n_new_active_masks, new_active_mask, ierr) Author Franz-Eric Sill License MIT For memory efficiency this subroutine helps holding different kinds of masks in a single array.\nTo achieve this, subsets has this structure: [...results, ...active_masks, ...new_active_masks]\nThis routine adds a new active mask to the subsets array. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(out), dimension(n_mask_chunks, n_subsets) :: subsets working array to hold bitmask encoded subsets for detection. integer(kind=int32), intent(in) :: n_mask_chunks number of 32 bit chunks in a mask integer(kind=int32), intent(in) :: n_subsets number of subsets that can be hold integer(kind=int32), intent(in) :: n_results number of results in subsets integer(kind=int32), intent(in) :: n_active_masks number of active masks in subsets integer(kind=int32), intent(inout) :: n_new_active_masks number of new active masks in subsets integer(kind=int32), intent(in), dimension(n_mask_chunks) :: new_active_mask new active mask to add to subsets integer(kind=int32), intent(out) :: ierr Error code public pure subroutine mask_chunk_count (n_genes, count) Author Franz-Eric Sill License MIT Category C-binding Determines the needed chunk count for subset bit masks (an integer has only 32 bits) Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes number of genes integer(kind=int32), intent(out) :: count number of 32 bit chunks a mask needs to encode n_genes genes Read more… public pure subroutine filter_paralogs_by_pattern_impl (pattern_mode, gene_angles, threshold, n_genes, n_families, gene_to_fam, masks, n_mask_chunks, ierr) Author Franz-Eric Sill License MIT Prefilters the genes for a pattern, so genes that cannot match it are not tried as subset extensions Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: pattern_mode used pattern for detection Read more… real(kind=real64), intent(in), dimension(n_genes) :: gene_angles vector, holding the angles between ancestor and genes (0<=angle<=Pi)\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is PI . real(kind=real64), intent(in) :: threshold filter threshold integer(kind=int32), intent(in) :: n_genes number of genes integer(kind=int32), intent(in) :: n_families number of families\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_genes . integer(kind=int32), intent(in), dimension(n_genes) :: gene_to_fam a mapping of gene index to family index, so gene i is related to gene_angles(i) and part of family j=gene_to_fam(i) .\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_families . integer(kind=int32), intent(out), dimension(n_mask_chunks, n_families) :: masks bit mask that will have the indices of genes kept by this pattern set to 1, else 0 integer(kind=int32), intent(in) :: n_mask_chunks number of 32 bit chunks a mask needs to encode n_genes genes\nThe minimum valid value is (n_genes + 31) / 32 . integer(kind=int32), intent(out) :: ierr Error code public pure subroutine calc_work_arr_paralog_subsets_size (max_subset_size, n_genes, work_array_size, filtered_paralogs_mask, n_mask_chunks, ierr) Author Franz-Eric Sill License MIT Category C-binding Calculates the needed size for the paralog-subsets work array Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(inout) :: max_subset_size maximum size that a subset must not exceed. Zero is in range and means there is\nnothing to size a work array for, which is reported back as a size of zero.\nThe minimum valid value is 0_int32 . Read more… integer(kind=int32), intent(in) :: n_genes number of genes integer(kind=int32), intent(out) :: work_array_size The calculated needed work array size in absolute worst case scenario. Look into source for details. integer(kind=int32), intent(in), dimension(n_mask_chunks) :: filtered_paralogs_mask Output mask with all genes disabled that did not pass the filter integer(kind=int32), intent(in) :: n_mask_chunks number of 32 bit chunks a mask needs to encode n_genes genes integer(kind=int32), intent(out) :: ierr Error code public pure subroutine mask_set_state (bit_mask, i_gene, state, ierr) Author Franz-Eric Sill License MIT Sets the state of a bit/gene in bit_mask Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(out), dimension(:) :: bit_mask chunked mask to mark active paralogs integer(kind=int32), intent(in) :: i_gene index of paralog to be marked active logical(kind=c_bool), intent(in) :: state state the bit should be set to integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"module/tox_paralog_analysis_impl.html"},{"title":"tox_loess_c – TensorOmics","text":"LOESS local polynomial regression smoothing, over the netlib dloess / lowesd family. Two fits: loess_fit_plain and loess_fit_robust , the latter reweighting against outliers over\na number of iterations. There is deliberately no combined entry point dispatching on a mode --\na caller chooses the routine, and supplies the weights and the evaluation points it wants. A sample too degenerate to fit (fewer distinct points than the degree needs) is answered\ndirectly from the observations rather than handed to netlib, which cannot fit one and dies\ninside its decomposition instead of reporting. Nothing about that is visible to a caller\nbeyond the result. tox_loess_required_workspace sizes the workspace for a caller that wants to own it; the\nmode and iteration constants and EPS_LOESS are here for the same reason. The netlib\nroutines themselves are not re-documented beyond their calling convention. Uses f42_safeguard iso_c_binding tox_errors Subroutines public  subroutine loess_fit_plain_c (n, x, y, weights, eval_points, span, degree, max_neighborhood_size, compute_influence, save_factorization, fitted_values, ierr) bind(C, name=\"loess_fit_plain_c\") C-wrapper for loess_fit_plain Read more… Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n Total number of data points real(kind=c_double), intent(in), dimension(n), target :: x Predictor variable array real(kind=c_double), intent(in), dimension(n), target :: y Response variable array real(kind=c_double), intent(in), dimension(n), target :: weights Weight array for data points real(kind=c_double), intent(in), dimension(n, 1), target :: eval_points Evaluation points (x values at which the fitted curve is computed) real(kind=c_double), intent(in), target :: span Smoothing parameter for LOESS\nThe minimum valid value is EPS_LOESS .\nThe maximum valid value is 1.0_real64 . integer(kind=c_int), intent(in), target :: degree Degree of the LOESS polynomial\nThe minimum valid value is 0_int32 .\nThe maximum valid value is 2_int32 . integer(kind=c_int), intent(in), target :: max_neighborhood_size Maximum neighborhood size logical(kind=c_bool), intent(in), target :: compute_influence Influence calculation flag\nThe default value is .false. . logical(kind=c_bool), intent(in), target :: save_factorization Save matrix factorization flag\nThe default value is .false. . real(kind=c_double), intent(out), dimension(n), target :: fitted_values Fitted (smoothed) values of y at the evaluation points integer(kind=c_int), intent(out), target :: ierr Error code public  subroutine loess_fit_plain_expert_c (n, x, y, weights, eval_points, span, degree, max_neighborhood_size, compute_influence, save_factorization, tmp_int_workspace, int_workspace_size, tmp_real_workspace, real_workspace_size, tmp_hat_diag, fitted_values, ierr) bind(C, name=\"loess_fit_plain_expert_c\") C-wrapper for loess_fit_plain_expert Read more… Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n Total number of data points real(kind=c_double), intent(in), dimension(n), target :: x Predictor variable array real(kind=c_double), intent(in), dimension(n), target :: y Response variable array real(kind=c_double), intent(in), dimension(n), target :: weights Weight array for data points real(kind=c_double), intent(in), dimension(n, 1), target :: eval_points Evaluation points (x values at which the fitted curve is computed) real(kind=c_double), intent(in), target :: span Smoothing parameter for LOESS\nThe minimum valid value is EPS_LOESS .\nThe maximum valid value is 1.0_real64 . integer(kind=c_int), intent(in), target :: degree Degree of the LOESS polynomial\nThe minimum valid value is 0_int32 .\nThe maximum valid value is 2_int32 . integer(kind=c_int), intent(in), target :: max_neighborhood_size Maximum neighborhood size logical(kind=c_bool), intent(in), target :: compute_influence Influence calculation flag\nThe default value is .false. . logical(kind=c_bool), intent(in), target :: save_factorization Save matrix factorization flag\nThe default value is .false. . integer(kind=c_int), intent(out), dimension(int_workspace_size), target :: tmp_int_workspace Integer workspace array integer(kind=c_int), intent(in), target :: int_workspace_size Required size of the integer workspace array\nIt is VERY IMPORTANT to compute this argument from the int_workspace_size output produced by tox_loess_required_workspace .\nThe minimum valid value is 10000_int32 . Read more… real(kind=c_double), intent(out), dimension(real_workspace_size), target :: tmp_real_workspace Real workspace array integer(kind=c_int), intent(in), target :: real_workspace_size Required size of the real workspace array\nIt is VERY IMPORTANT to compute this argument from the real_workspace_size output produced by tox_loess_required_workspace .\nThe minimum valid value is 100000_int32 . Read more… real(kind=c_double), intent(out), dimension(n), target :: tmp_hat_diag Diagonal elements of the hat matrix real(kind=c_double), intent(out), dimension(n), target :: fitted_values Fitted (smoothed) values of y at the evaluation points integer(kind=c_int), intent(out), target :: ierr Error code public  subroutine loess_fit_robust_c (n, x, y, weights, eval_points, span, degree, max_neighborhood_size, compute_influence, save_factorization, n_iters, fitted_values, ierr) bind(C, name=\"loess_fit_robust_c\") C-wrapper for loess_fit_robust Read more… Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n Total number of data points real(kind=c_double), intent(in), dimension(n), target :: x Predictor variable array real(kind=c_double), intent(in), dimension(n), target :: y Response variable array real(kind=c_double), intent(in), dimension(n), target :: weights Weight array for data points real(kind=c_double), intent(in), dimension(n, 1), target :: eval_points Evaluation points (x values at which the fitted curve is computed) real(kind=c_double), intent(in), target :: span Smoothing parameter for LOESS\nThe minimum valid value is EPS_LOESS .\nThe maximum valid value is 1.0_real64 . integer(kind=c_int), intent(in), target :: degree Degree of the LOESS polynomial\nThe minimum valid value is 0_int32 .\nThe maximum valid value is 2_int32 . integer(kind=c_int), intent(in), target :: max_neighborhood_size Maximum neighborhood size logical(kind=c_bool), intent(in), target :: compute_influence Influence calculation flag\nThe default value is .false. . logical(kind=c_bool), intent(in), target :: save_factorization Save matrix factorization flag\nThe default value is .false. . integer(kind=c_int), intent(in), target :: n_iters Number of robust iterations\nThe minimum valid value is 1_int32 .\nThe default value is 3_int32 . real(kind=c_double), intent(out), dimension(n), target :: fitted_values Fitted (smoothed) values of y at the evaluation points integer(kind=c_int), intent(out), target :: ierr Error code public  subroutine loess_fit_robust_expert_c (n, x, y, weights, eval_points, span, degree, max_neighborhood_size, compute_influence, save_factorization, n_iters, tmp_int_workspace, int_workspace_size, tmp_real_workspace, real_workspace_size, tmp_hat_diag, tmp_robust_weights, tmp_combined_weights, tmp_residuals, tmp_permutation_indices, fitted_values, ierr) bind(C, name=\"loess_fit_robust_expert_c\") C-wrapper for loess_fit_robust_expert Read more… Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n Total number of data points real(kind=c_double), intent(in), dimension(n), target :: x Predictor variable array real(kind=c_double), intent(in), dimension(n), target :: y Response variable array real(kind=c_double), intent(in), dimension(n), target :: weights Weight array for data points real(kind=c_double), intent(in), dimension(n, 1), target :: eval_points Evaluation points (x values at which the fitted curve is computed) real(kind=c_double), intent(in), target :: span Smoothing parameter for LOESS\nThe minimum valid value is EPS_LOESS .\nThe maximum valid value is 1.0_real64 . integer(kind=c_int), intent(in), target :: degree Degree of the LOESS polynomial\nThe minimum valid value is 0_int32 .\nThe maximum valid value is 2_int32 . integer(kind=c_int), intent(in), target :: max_neighborhood_size Maximum neighborhood size logical(kind=c_bool), intent(in), target :: compute_influence Influence calculation flag\nThe default value is .false. . logical(kind=c_bool), intent(in), target :: save_factorization Save matrix factorization flag\nThe default value is .false. . integer(kind=c_int), intent(in), target :: n_iters Number of robust iterations\nThe minimum valid value is 1_int32 .\nThe default value is 3_int32 . integer(kind=c_int), intent(out), dimension(int_workspace_size), target :: tmp_int_workspace Integer workspace array integer(kind=c_int), intent(in), target :: int_workspace_size Required size of the integer workspace array\nIt is VERY IMPORTANT to compute this argument from the int_workspace_size output produced by tox_loess_required_workspace .\nThe minimum valid value is 10000_int32 . Read more… real(kind=c_double), intent(out), dimension(real_workspace_size), target :: tmp_real_workspace Real workspace array integer(kind=c_int), intent(in), target :: real_workspace_size Required size of the real workspace array\nIt is VERY IMPORTANT to compute this argument from the real_workspace_size output produced by tox_loess_required_workspace .\nThe minimum valid value is 100000_int32 . Read more… real(kind=c_double), intent(out), dimension(n), target :: tmp_hat_diag Diagonal elements of the hat matrix real(kind=c_double), intent(out), dimension(n), target :: tmp_robust_weights Robust bisquare weights (updated each iteration, initialized to 1.0) real(kind=c_double), intent(out), dimension(n), target :: tmp_combined_weights Combined weights: product of user weights and robust weights (weights(i) * robust_weights(i)) real(kind=c_double), intent(out), dimension(n), target :: tmp_residuals Residuals (y - fitted_values), used to compute bisquare robust weights integer(kind=c_int), intent(out), dimension(n), target :: tmp_permutation_indices Permutation indices array (from NetLib bisquare weight computation) real(kind=c_double), intent(out), dimension(n), target :: fitted_values Fitted (smoothed) values of y at the evaluation points integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"module/tox_loess_c.html"},{"title":"tox_clustering_c – TensorOmics","text":"Clustering for tensor omics: k-means over factors and trajectories, and hierarchical\n(agglomerative) linkage clustering over a precomputed distance matrix. k_means_clustering partitions points in n dimensions; cluster_factor_trajectories_k_means applies the same to whole time series, treating each factor's trajectory as one point. linkage_clustering takes the distances already computed and merges under the linkage\ncriterion asked for, so the same matrix can be re-clustered without recomputing it. Uses f42_safeguard tox_conversions iso_c_binding tox_errors Subroutines public  subroutine cluster_factor_trajectories_k_means_c (n_clusters, trajectories, n_factors, n_samples, n_timepoints, centroids, labels, label_counts, max_iterations, ierr) bind(C, name=\"cluster_factor_trajectories_k_means_c\") C-wrapper for cluster_factor_trajectories_k_means Read more… Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_clusters number ( k ) of clusters\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_samples*n_timepoints . real(kind=c_double), intent(in), dimension(n_factors, n_samples, n_timepoints), target :: trajectories matrix with data points to cluster integer(kind=c_int), intent(in), target :: n_factors number of factors integer(kind=c_int), intent(in), target :: n_samples number of samples integer(kind=c_int), intent(in), target :: n_timepoints number of timepoints real(kind=c_double), intent(inout), dimension(n_factors, n_clusters), target :: centroids matrix with initial centroids of the clusters, could be random data or actual points or unassigned garbage.\nThe centroids should be unique. This is not checked in this routine. Read more… integer(kind=c_int), intent(out), dimension(n_samples*n_timepoints), target :: labels array of labels, each index corresponds to the respective point's index, so first label is first point's label. Read more… integer(kind=c_int), intent(out), dimension(n_clusters), target :: label_counts holds the number of points having the respective label assigned integer(kind=c_int), intent(in), target :: max_iterations number of maximum iterations of the clustering integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure. public  subroutine k_means_clustering_c (n_clusters, data_points, n_points, n_dims, centroids, labels, label_counts, max_iterations, ierr) bind(C, name=\"k_means_clustering_c\") C-wrapper for k_means_clustering Read more… Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_clusters number ( k ) of clusters\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_points . real(kind=c_double), intent(in), dimension(n_dims, n_points), target :: data_points matrix with data points to cluster integer(kind=c_int), intent(in), target :: n_points number of points to cluster integer(kind=c_int), intent(in), target :: n_dims number of elements a point has real(kind=c_double), intent(inout), dimension(n_dims, n_clusters), target :: centroids matrix with initial centroids of the clusters, could be random data or actual points or unassigned garbage.\nThe centroids should be unique. This is not checked in this routine. Read more… integer(kind=c_int), intent(out), dimension(n_points), target :: labels array of labels, each index corresponds to the respective point's index, so first label is first point's label. Read more… integer(kind=c_int), intent(out), dimension(n_clusters), target :: label_counts holds the number of points having the respective label assigned integer(kind=c_int), intent(in), target :: max_iterations number of maximum iterations of the clustering.\nThe default value is 300_int32 . integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure. public  subroutine linkage_clustering_c (distances, n_points, merge_i, merge_j, heights, cluster_sizes, method, ierr) bind(C, name=\"linkage_clustering_c\") C-wrapper for linkage_clustering Read more… Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(inout), dimension(n_points, n_points), target :: distances symmetric distance matrix, holding the positive distances between points. Distance of X->X is always zero. Read more… integer(kind=c_int), intent(in), target :: n_points number of points to cluster integer(kind=c_int), intent(out), dimension(n_points - 1), target :: merge_i holds cluster labels of the merged node pair at iteration k -> positives relate to leafs/data point indices, negatives to inner nodes integer(kind=c_int), intent(out), dimension(n_points - 1), target :: merge_j holds cluster labels of the merged node pair at iteration k -> positives relate to leafs/data point indices, negatives to inner nodes real(kind=c_double), intent(out), dimension(n_points - 1), target :: heights height of the shorter branch of the merge, e.g. if (A,B)+(C) merges to ((A,B),C), the branch to (A,B) is shorter integer(kind=c_int), intent(out), dimension(n_points - 1), target :: cluster_sizes size of cluster at iteration k character(kind=c_char, len=1), intent(in), dimension(8), target :: method used algorithm\nThe minimum valid value is 0_int32 .\nThe maximum valid value is 2_int32 . Read more… integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"module/tox_clustering_c.html"},{"title":"tox_data_integration_preprocessing – TensorOmics","text":"Jensen-Shannon-Divergence (JSD) Compatibility Test (gJCT) Preprocessing The step that turns expression vectors into the neighborhood residuals the rest of the test\nconsumes: gene-wise means, the signed deviation of each replicate from them, and the\nneighborhoods of reference points those residuals are grouped into so the comparison is\nconditioned on expression level rather than pooled across it. calc_neighborhood_size sizes a neighborhood for a caller that allocates its own. Generated from tox_data_integration_preprocessing_impl ; do not edit -- regenerate instead. Uses iso_fortran_env tox_data_integration_preprocessing_impl iso_c_binding f42_safeguard f42_sort_impl ieee_arithmetic tox_errors Subroutines public pure subroutine compute_gene_means (n_genes, n_reps, expr, means, ierr) Validates its inputs, then calls compute_gene_means_impl . Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Number of genes in the study integer(kind=int32), intent(in) :: n_reps Number of biological replicates in the study real(kind=real64), intent(in), dimension(n_reps, n_genes) :: expr Expression matrix\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(out), dimension(n_genes) :: means Per-gene mean expression values integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure. public pure subroutine compute_residuals (n_genes, n_reps, expr, means, resid, ierr) Validates its inputs, then calls compute_residuals_impl . Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Number of genes in the study integer(kind=int32), intent(in) :: n_reps Number of biological replicates in the study real(kind=real64), intent(in), dimension(n_reps, n_genes) :: expr Expression matrix\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(in), dimension(n_genes) :: means Per-gene mean expression values; NaN where every replicate of a gene was NaN\nNaN is permitted for this value. real(kind=real64), intent(out), dimension(n_reps, n_genes) :: resid Matrix of signed residuals integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure. public pure subroutine pool_means (pooled_means, pool_size, n_points, n_pool, x_star, ierr) Validates its inputs, prepares what pool_means_impl needs, then calls it. The entry point to reach for first; see pool_means_expert to prepare it yourself. Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(pool_size) :: pooled_means Pooled means\nNaN is permitted for this value. integer(kind=int32), intent(in) :: pool_size Number of means in the pool, usually n_genes_S1 + n_genes_S2 integer(kind=int32), intent(in) :: n_points Number of reference points to define integer(kind=int32), intent(out) :: n_pool Total number of included (non-NaN) pooled mean-expression values real(kind=real64), intent(out), dimension(n_points) :: x_star Mean-expression reference points integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure. public pure subroutine pool_means_expert (pooled_means, pooled_means_perm, pool_size, n_points, n_pool, x_star, ierr) Validates its inputs, then calls pool_means_impl with what you supply. The expert entry point: it allocates nothing and prepares nothing; pool_means does both. Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(pool_size) :: pooled_means Pooled means\nNaN is permitted for this value. integer(kind=int32), intent(in), dimension(pool_size) :: pooled_means_perm Sorting permutation for pooled_means integer(kind=int32), intent(in) :: pool_size Number of means in the pool, usually n_genes_S1 + n_genes_S2 integer(kind=int32), intent(in) :: n_points Number of reference points to define integer(kind=int32), intent(out) :: n_pool Total number of included (non-NaN) pooled mean-expression values real(kind=real64), intent(out), dimension(n_points) :: x_star Mean-expression reference points integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure. public pure subroutine pool_study_means (n_genes_S1, mean_S1, n_genes_S2, mean_S2, n_points, n_pool, x_star, ierr) Validates its inputs, prepares what pool_study_means_impl needs, then calls it. The entry point to reach for first; see pool_study_means_expert to prepare it yourself. Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes_S1 Number of genes in study S1 real(kind=real64), intent(in), dimension(n_genes_S1) :: mean_S1 Per-gene mean expression values of study S1\nNaN is permitted for this value. integer(kind=int32), intent(in) :: n_genes_S2 Number of genes in study S2 real(kind=real64), intent(in), dimension(n_genes_S2) :: mean_S2 Per-gene mean expression values of study S2\nNaN is permitted for this value. integer(kind=int32), intent(in) :: n_points Number of reference points to define integer(kind=int32), intent(out) :: n_pool Total number of included (non-NaN) pooled mean-expression values real(kind=real64), intent(out), dimension(n_points) :: x_star Mean-expression reference points integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure. public pure subroutine pool_study_means_expert (n_genes_S1, mean_S1, n_genes_S2, mean_S2, n_points, tmp_pooled_means, tmp_pooled_means_perm, n_pool, x_star, ierr) Validates its inputs, then calls pool_study_means_impl with what you supply. The expert entry point: it allocates nothing and prepares nothing; pool_study_means does both. Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes_S1 Number of genes in study S1 real(kind=real64), intent(in), dimension(n_genes_S1) :: mean_S1 Per-gene mean expression values of study S1\nNaN is permitted for this value. integer(kind=int32), intent(in) :: n_genes_S2 Number of genes in study S2 real(kind=real64), intent(in), dimension(n_genes_S2) :: mean_S2 Per-gene mean expression values of study S2\nNaN is permitted for this value. integer(kind=int32), intent(in) :: n_points Number of reference points to define real(kind=real64), intent(out), dimension(n_genes_S1+n_genes_S2) :: tmp_pooled_means Work array holding the concatenated means of both studies integer(kind=int32), intent(out), dimension(n_genes_S1+n_genes_S2) :: tmp_pooled_means_perm Work array for the permutation that sorts tmp_pooled_means integer(kind=int32), intent(out) :: n_pool Total number of included (non-NaN) pooled mean-expression values real(kind=real64), intent(out), dimension(n_points) :: x_star Mean-expression reference points integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure. public pure subroutine construct_neighborhoods (n_points, x_star, n_genes_S, mean_S, n_reps_S, resid_S, neighborhood_residuals, neighborhood_indices, n_neighbors, ierr) Validates its inputs, prepares what construct_neighborhoods_impl needs, then calls it. The entry point to reach for first; see construct_neighborhoods_expert to prepare it yourself. Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_points Number of reference points real(kind=real64), intent(in), dimension(n_points) :: x_star Mean-expression reference points\nNaN is permitted for this value. integer(kind=int32), intent(in) :: n_genes_S Number of genes in the current study real(kind=real64), intent(in), dimension(n_genes_S) :: mean_S Per-gene mean expression values\nNaN is permitted for this value. integer(kind=int32), intent(in) :: n_reps_S Number of biological replicates in the study real(kind=real64), intent(in), dimension(n_reps_S, n_genes_S) :: resid_S Matrix of signed residuals\nNaN is permitted for this value. real(kind=real64), intent(out), dimension(n_reps_S, n_neighbors, n_points) :: neighborhood_residuals Collection of residual vectors for each neighborhood integer(kind=int32), intent(out), dimension(n_neighbors, n_points) :: neighborhood_indices Indices of selected neighborhood genes integer(kind=int32), intent(in) :: n_neighbors Number of neighbors; a gene whose mean is NaN can never be a neighbor, so this\ncannot exceed the number of genes with a defined mean\nThe minimum valid value is 1_int32 .\nThe maximum valid value is count(.not. ieee_is_nan(mean_S), kind=int32) .\nIt is recommended to compute this with calc_neighborhood_size . integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure. public pure subroutine construct_neighborhoods_expert (n_points, x_star, n_genes_S, mean_S, n_reps_S, resid_S, tmp_distances, tmp_distances_perm, neighborhood_residuals, neighborhood_indices, n_neighbors, ierr) Validates its inputs, then calls construct_neighborhoods_impl with what you supply. The expert entry point: it allocates nothing and prepares nothing; construct_neighborhoods does both. Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_points Number of reference points real(kind=real64), intent(in), dimension(n_points) :: x_star Mean-expression reference points\nNaN is permitted for this value. integer(kind=int32), intent(in) :: n_genes_S Number of genes in the current study real(kind=real64), intent(in), dimension(n_genes_S) :: mean_S Per-gene mean expression values\nNaN is permitted for this value. integer(kind=int32), intent(in) :: n_reps_S Number of biological replicates in the study real(kind=real64), intent(in), dimension(n_reps_S, n_genes_S) :: resid_S Matrix of signed residuals\nNaN is permitted for this value. real(kind=real64), intent(out), dimension(n_genes_S) :: tmp_distances Distances work array integer(kind=int32), intent(out), dimension(n_genes_S) :: tmp_distances_perm Work array for the permutation that sorts tmp_distances real(kind=real64), intent(out), dimension(n_reps_S, n_neighbors, n_points) :: neighborhood_residuals Collection of residual vectors for each neighborhood integer(kind=int32), intent(out), dimension(n_neighbors, n_points) :: neighborhood_indices Indices of selected neighborhood genes integer(kind=int32), intent(in) :: n_neighbors Number of neighbors; a gene whose mean is NaN can never be a neighbor, so this\ncannot exceed the number of genes with a defined mean\nThe minimum valid value is 1_int32 .\nThe maximum valid value is count(.not. ieee_is_nan(mean_S), kind=int32) .\nIt is recommended to compute this with calc_neighborhood_size . integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"module/tox_data_integration_preprocessing.html"},{"title":"tox_data_integration_stats_c – TensorOmics","text":"Jensen-Shannon-Divergence (JSD) Compatibility Test (gJCT) Permutation Test A permutation test estimating an empirical p-value for the weighted global JSD. Under the null\nhypothesis that both studies are exchangeable, S1/S2 residuals are repeatedly shuffled within\neach reference point's pooled neighborhood and the JSD is recomputed, giving a null\ndistribution against which the observed value is compared. Work copies are shuffled, never the caller's arrays. Uses f42_safeguard iso_c_binding tox_errors Subroutines public  subroutine gjct_permutation_test_c (neighborhood_residuals_S1, neighborhood_residuals_S2, n_reps_S1, n_reps_S2, n_neighbors, n_points, global_jsd_observed, n_bins, shared_residual_range, n_permutations, jsd_null, p_value, random_seed, neighbor_mask_S1, neighbor_mask_S2, ierr) bind(C, name=\"gjct_permutation_test_c\") C-wrapper for gjct_permutation_test Read more… Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_reps_S1, n_neighbors, n_points), target :: neighborhood_residuals_S1 Computed neighborhood residuals for study 1, NaN is explicitly allowed for missing values\nNaN is permitted for this value. real(kind=c_double), intent(in), dimension(n_reps_S2, n_neighbors, n_points), target :: neighborhood_residuals_S2 Computed neighborhood residuals for study 2, NaN is explicitly allowed for missing values\nNaN is permitted for this value. integer(kind=c_int), intent(in), target :: n_reps_S1 Number of replicates in study 1 integer(kind=c_int), intent(in), target :: n_reps_S2 Number of replicates in study 2 integer(kind=c_int), intent(in), target :: n_neighbors Number of neighbors in the studies integer(kind=c_int), intent(in), target :: n_points Number of reference points in the studies real(kind=c_double), intent(in), target :: global_jsd_observed Observed global JSD value for both studies integer(kind=c_int), intent(in), target :: n_bins Number of equally sized histogram bins used for the studies real(kind=c_double), intent(in), target :: shared_residual_range Computed residual range for both studies\nThe minimum valid value is 0.0_real64 . integer(kind=c_int), intent(in), target :: n_permutations Number of permutations to perform real(kind=c_double), intent(out), dimension(n_permutations), target :: jsd_null Vector of global divergence values obtained under the null hypothesis real(kind=c_double), intent(out), target :: p_value Empirical p-value of the permutation test: integer(kind=c_int), intent(in), optional :: random_seed Seed to use for shuffling logical(kind=c_bool), intent(in), optional, dimension(n_neighbors, n_points) :: neighbor_mask_S1 Optional mask to exclude specific neighbors from study 1 (e.g. for family-wise analysis) logical(kind=c_bool), intent(in), optional, dimension(n_neighbors, n_points) :: neighbor_mask_S2 Optional mask to exclude specific neighbors from study 2 (e.g. for family-wise analysis) integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure. public  subroutine gjct_permutation_test_expert_c (neighborhood_residuals_S1, neighborhood_residuals_S2, n_reps_S1, n_reps_S2, n_neighbors, n_points, global_jsd_observed, n_bins, shared_residual_range, n_permutations, jsd_null, p_value, tmp_residuals_S1, tmp_residuals_S2, tmp_pool, tmp_pmf_S1, tmp_pmf_S2, tmp_counts, tmp_included_n_reps_S1, tmp_included_n_reps_S2, tmp_js_divergences, tmp_weights, random_seed, neighbor_mask_S1, neighbor_mask_S2, ierr) bind(C, name=\"gjct_permutation_test_expert_c\") C-wrapper for gjct_permutation_test_expert Read more… Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_reps_S1, n_neighbors, n_points), target :: neighborhood_residuals_S1 Computed neighborhood residuals for study 1, NaN is explicitly allowed for missing values\nNaN is permitted for this value. real(kind=c_double), intent(in), dimension(n_reps_S2, n_neighbors, n_points), target :: neighborhood_residuals_S2 Computed neighborhood residuals for study 2, NaN is explicitly allowed for missing values\nNaN is permitted for this value. integer(kind=c_int), intent(in), target :: n_reps_S1 Number of replicates in study 1 integer(kind=c_int), intent(in), target :: n_reps_S2 Number of replicates in study 2 integer(kind=c_int), intent(in), target :: n_neighbors Number of neighbors in the studies integer(kind=c_int), intent(in), target :: n_points Number of reference points in the studies real(kind=c_double), intent(in), target :: global_jsd_observed Observed global JSD value for both studies integer(kind=c_int), intent(in), target :: n_bins Number of equally sized histogram bins used for the studies real(kind=c_double), intent(in), target :: shared_residual_range Computed residual range for both studies\nThe minimum valid value is 0.0_real64 . integer(kind=c_int), intent(in), target :: n_permutations Number of permutations to perform real(kind=c_double), intent(out), dimension(n_permutations), target :: jsd_null Vector of global divergence values obtained under the null hypothesis real(kind=c_double), intent(out), target :: p_value Empirical p-value of the permutation test: real(kind=c_double), intent(out), dimension(n_reps_S1, n_neighbors, n_points), target :: tmp_residuals_S1 Work copy of study 1's residuals, shuffled in place real(kind=c_double), intent(out), dimension(n_reps_S2, n_neighbors, n_points), target :: tmp_residuals_S2 Work copy of study 2's residuals, shuffled in place real(kind=c_double), intent(out), dimension(n_reps_S1 + n_reps_S2, n_neighbors), target :: tmp_pool Working array for shuffling the concatenated residuals from both studies per reference point real(kind=c_double), intent(out), dimension(n_points, n_bins), target :: tmp_pmf_S1 Working array for study 1's normalized histogram counts real(kind=c_double), intent(out), dimension(n_points, n_bins), target :: tmp_pmf_S2 Working array for study 2's normalized histogram counts integer(kind=c_int), intent(out), dimension(n_points, n_bins), target :: tmp_counts Working array for the histogram counts integer(kind=c_int), intent(out), dimension(n_points), target :: tmp_included_n_reps_S1 Working array for study 1's included replicate counts integer(kind=c_int), intent(out), dimension(n_points), target :: tmp_included_n_reps_S2 Working array for study 2's included replicate counts real(kind=c_double), intent(out), dimension(n_points), target :: tmp_js_divergences Working array for the per-reference-point divergences real(kind=c_double), intent(out), dimension(n_points), target :: tmp_weights Working array for the divergence weights integer(kind=c_int), intent(in), optional :: random_seed Seed to use for shuffling logical(kind=c_bool), intent(in), optional, dimension(n_neighbors, n_points) :: neighbor_mask_S1 Optional mask to exclude specific neighbors from study 1 (e.g. for family-wise analysis) logical(kind=c_bool), intent(in), optional, dimension(n_neighbors, n_points) :: neighbor_mask_S2 Optional mask to exclude specific neighbors from study 2 (e.g. for family-wise analysis) integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"module/tox_data_integration_stats_c.html"},{"title":"tox_data_integration_per_family_impl – TensorOmics","text":"Jensen-Shannon-Divergence (JSD) Compatibility Test (gJCT) JSD Calculation per family The JSD value for a sub-neighborhood -- typically the genes of one family -- obtained by\ndriving the same pipeline over a masked set of neighbors. Answers whether two studies are\ncompatible for this family , which the global figure can hide either way. Uses iso_fortran_env iso_c_binding tox_data_integration_jsd_impl f42_math_impl f42_safeguard Subroutines public pure subroutine fjct_compute_jsd_impl (family_idx, gene_to_family_S1, gene_to_family_S2, n_genes_S1, n_genes_S2, neighborhood_residuals_S1, neighborhood_residuals_S2, neighborhood_genes_S1, neighborhood_genes_S2, n_reps_S1, n_reps_S2, n_neighbors, n_points, n_bins, shared_residual_range, js_divergences, included_n_reps_S1, included_n_reps_S2, total_included_n_reps, global_js_divergence, weights, tmp_neighbor_mask_S1, tmp_neighbor_mask_S2, tmp_pmf_S1, tmp_pmf_S2, tmp_counts) Author Franz-Eric Sill License MIT Compute the family-level compatibility score between two studies for a single gene family Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: family_idx Index of the family that should be analyzed\nThe minimum valid value is 1_int32 . integer(kind=int32), intent(in), dimension(n_genes_S1) :: gene_to_family_S1 Mapping for study 1: Each index (gene) holds the index of its family\nThe minimum valid value is 0_int32 . integer(kind=int32), intent(in), dimension(n_genes_S2) :: gene_to_family_S2 Mapping for study 2: Each index (gene) holds the index of its family\nThe minimum valid value is 0_int32 . integer(kind=int32), intent(in) :: n_genes_S1 Number of genes in study 1 integer(kind=int32), intent(in) :: n_genes_S2 Number of genes in study 2 real(kind=real64), intent(in), dimension(n_reps_S1, n_neighbors, n_points) :: neighborhood_residuals_S1 Computed neighborhood residuals for study 1, NaN is explicitly allowed for missing values\nNaN is permitted for this value. real(kind=real64), intent(in), dimension(n_reps_S2, n_neighbors, n_points) :: neighborhood_residuals_S2 Computed neighborhood residuals for study 2, NaN is explicitly allowed for missing values\nNaN is permitted for this value. integer(kind=int32), intent(in), dimension(n_neighbors, n_points) :: neighborhood_genes_S1 Indices of the selected neighborhood genes of study 1\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_genes_S1 . integer(kind=int32), intent(in), dimension(n_neighbors, n_points) :: neighborhood_genes_S2 Indices of the selected neighborhood genes of study 2\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_genes_S2 . integer(kind=int32), intent(in) :: n_reps_S1 Number of replicates in study 1 integer(kind=int32), intent(in) :: n_reps_S2 Number of replicates in study 2 integer(kind=int32), intent(in) :: n_neighbors Number of neighbors in the studies integer(kind=int32), intent(in) :: n_points Number of reference points in the studies integer(kind=int32), intent(in) :: n_bins Number of equally sized histogram bins used for the studies real(kind=real64), intent(in) :: shared_residual_range Computed residual range for both studies\nThe minimum valid value is 0.0_real64 . real(kind=real64), intent(out), dimension(n_points) :: js_divergences Jensen-Shannon divergence per reference point, computed for studies S1 and S2 integer(kind=int32), intent(out), dimension(n_points) :: included_n_reps_S1 Count of non-NaN residuals (included ones) in study 1 integer(kind=int32), intent(out), dimension(n_points) :: included_n_reps_S2 Count of non-NaN residuals (included ones) in study 2 integer(kind=int32), intent(out) :: total_included_n_reps Total number of included replicates from both studies ( ) real(kind=real64), intent(out) :: global_js_divergence Weighted global Jensen-Shannon divergence real(kind=real64), intent(out), dimension(n_points) :: weights Weights used for calculating the global weighted Jensen-Shannon divergence global_js_divergence logical(kind=c_bool), intent(out), dimension(n_neighbors, n_points) :: tmp_neighbor_mask_S1 Work array for the mask selecting study 1's neighbors that belong to family_idx logical(kind=c_bool), intent(out), dimension(n_neighbors, n_points) :: tmp_neighbor_mask_S2 Work array for the mask selecting study 2's neighbors that belong to family_idx real(kind=real64), intent(out), dimension(n_points, n_bins) :: tmp_pmf_S1 Work array for study 1's normalized histogram counts real(kind=real64), intent(out), dimension(n_points, n_bins) :: tmp_pmf_S2 Work array for study 2's normalized histogram counts integer(kind=int32), intent(out), dimension(n_points, n_bins) :: tmp_counts Work array for the histogram counts public pure subroutine fjct_compute_masked_jsd_impl (neighborhood_residuals_S1, neighborhood_residuals_S2, n_reps_S1, n_reps_S2, n_neighbors, n_points, neighbor_mask_S1, neighbor_mask_S2, n_bins, shared_residual_range, js_divergences, included_n_reps_S1, included_n_reps_S2, total_included_n_reps, global_js_divergence, weights, pmf_S1, pmf_S2, tmp_counts) Author Franz-Eric Sill License MIT Compute the compatibility score between two studies for a single masked sub-neighborhood Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_reps_S1, n_neighbors, n_points) :: neighborhood_residuals_S1 Computed neighborhood residuals for study 1, NaN is explicitly allowed for missing values\nNaN is permitted for this value. real(kind=real64), intent(in), dimension(n_reps_S2, n_neighbors, n_points) :: neighborhood_residuals_S2 Computed neighborhood residuals for study 2, NaN is explicitly allowed for missing values\nNaN is permitted for this value. integer(kind=int32), intent(in) :: n_reps_S1 Number of replicates in study 1 integer(kind=int32), intent(in) :: n_reps_S2 Number of replicates in study 2 integer(kind=int32), intent(in) :: n_neighbors Number of neighbors in the studies integer(kind=int32), intent(in) :: n_points Number of reference points in the studies logical(kind=c_bool), intent(in), dimension(n_neighbors, n_points) :: neighbor_mask_S1 Mask selecting the neighbors of study 1 to include logical(kind=c_bool), intent(in), dimension(n_neighbors, n_points) :: neighbor_mask_S2 Mask selecting the neighbors of study 2 to include integer(kind=int32), intent(in) :: n_bins Number of equally sized histogram bins used for the studies real(kind=real64), intent(in) :: shared_residual_range Computed residual range for both studies\nThe minimum valid value is 0.0_real64 . real(kind=real64), intent(out), dimension(n_points) :: js_divergences Jensen-Shannon divergence per reference point, computed for studies S1 and S2 integer(kind=int32), intent(out), dimension(n_points) :: included_n_reps_S1 Count of non-NaN residuals (included ones) in study 1 integer(kind=int32), intent(out), dimension(n_points) :: included_n_reps_S2 Count of non-NaN residuals (included ones) in study 2 integer(kind=int32), intent(out) :: total_included_n_reps Total number of included replicates from both studies ( ) real(kind=real64), intent(out) :: global_js_divergence Weighted global Jensen-Shannon divergence real(kind=real64), intent(out), dimension(n_points) :: weights Weights used for calculating the global weighted Jensen-Shannon divergence global_js_divergence real(kind=real64), intent(out), dimension(n_points, n_bins) :: pmf_S1 Normalized histogram counts for study 1 real(kind=real64), intent(out), dimension(n_points, n_bins) :: pmf_S2 Normalized histogram counts for study 2 integer(kind=int32), intent(out), dimension(n_points, n_bins) :: tmp_counts Work array for the histogram counts public pure subroutine fjct_compute_contribution_scores_impl (global_js_divergences, total_included_n_reps_per_f, k_families, support_weights, contribution_scores) Author Franz-Eric Sill License MIT Compute the per-sub-neighborhood contribution score Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(k_families) :: global_js_divergences Per-sub-neighborhood weighted global JSD\nThe minimum valid value is 0.0_real64 . integer(kind=int32), intent(in), dimension(k_families) :: total_included_n_reps_per_f Per-sub-neighborhood total_included_n_reps The minimum valid value is 0_int32 . integer(kind=int32), intent(in) :: k_families Number of sub-neighborhoods analyzed real(kind=real64), intent(out), dimension(k_families) :: support_weights Per-sub-neighborhood calculated support weight (ratio between its total_included_n_reps and sum(total_included_n_reps_per_f) , zero if there were no replicates included at all) real(kind=real64), intent(out), dimension(k_families) :: contribution_scores Per-sub-neighborhood calculated contribution ( )","tags":"","url":"module/tox_data_integration_per_family_impl.html"},{"title":"tox_trajectory_normalization_c – TensorOmics","text":"Min-max normalization of factor trajectories over time. Each factor's time series is rescaled to [0,1] independently, per sample -- so trajectories\nof very different magnitudes can be compared by shape. normalize_single_trajectory does one; normalize_all_trajectories does a whole tensor of them in one call. Uses f42_safeguard iso_c_binding tox_errors Subroutines public  subroutine normalize_variable_timeseries_c (v, v_norm, n_points, status, ierr) bind(C, name=\"normalize_variable_timeseries_c\") C-wrapper for normalize_variable_timeseries Read more… Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_points), target :: v Original time series real(kind=c_double), intent(out), dimension(n_points), target :: v_norm Normalized time series integer(kind=c_int), intent(in), target :: n_points Vector length (number of time points) integer(kind=c_int), intent(out), target :: status Status code for specific warnings integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure. public  subroutine normalize_single_trajectory_c (trajectory, trajectory_norm, n_factors, n_timepoints, status, ierr) bind(C, name=\"normalize_single_trajectory_c\") C-wrapper for normalize_single_trajectory Read more… Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_timepoints, n_factors), target :: trajectory Original trajectory for one sample real(kind=c_double), intent(out), dimension(n_timepoints, n_factors), target :: trajectory_norm Normalized trajectory for one sample integer(kind=c_int), intent(in), target :: n_factors Number of factors/variables integer(kind=c_int), intent(in), target :: n_timepoints Number of time points integer(kind=c_int), intent(out), dimension(n_factors), target :: status Status code for specific warnings, one per factor integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure. public  subroutine normalize_all_trajectories_c (trajectories, trajectories_norm, n_factors, n_samples, n_timepoints, status, ierr) bind(C, name=\"normalize_all_trajectories_c\") C-wrapper for normalize_all_trajectories Read more… Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_factors, n_samples, n_timepoints), target :: trajectories Original trajectories real(kind=c_double), intent(out), dimension(n_factors, n_samples, n_timepoints), target :: trajectories_norm Normalized trajectories integer(kind=c_int), intent(in), target :: n_factors Number of factors integer(kind=c_int), intent(in), target :: n_samples Number of samples/entities integer(kind=c_int), intent(in), target :: n_timepoints Number of time points integer(kind=c_int), intent(out), dimension(n_factors, n_samples), target :: status Status code for specific warnings, one per factor per sample integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure. public  subroutine normalize_all_trajectories_expert_c (trajectories, trajectories_norm, n_factors, n_samples, n_timepoints, tmp_series, tmp_series_norm, status, ierr) bind(C, name=\"normalize_all_trajectories_expert_c\") C-wrapper for normalize_all_trajectories_expert Read more… Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_factors, n_samples, n_timepoints), target :: trajectories Original trajectories real(kind=c_double), intent(out), dimension(n_factors, n_samples, n_timepoints), target :: trajectories_norm Normalized trajectories integer(kind=c_int), intent(in), target :: n_factors Number of factors integer(kind=c_int), intent(in), target :: n_samples Number of samples/entities integer(kind=c_int), intent(in), target :: n_timepoints Number of time points real(kind=c_double), intent(out), dimension(n_timepoints), target :: tmp_series Work array: one factor's time series, gathered contiguously real(kind=c_double), intent(out), dimension(n_timepoints), target :: tmp_series_norm Work array: the normalized time series integer(kind=c_int), intent(out), dimension(n_factors, n_samples), target :: status Status code for specific warnings, one per factor per sample integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"module/tox_trajectory_normalization_c.html"},{"title":"f42_kd_tree_c – TensorOmics","text":"k-d tree spatial index over fixed-dimensional point sets.\nBuilds a k-d tree by recursively partitioning kd_indices around the median point along a\ncaller-supplied, cycling dimension order, using a stack-based (non-recursive) traversal so it\nis safe to call from pure procedures. The tree is stored implicitly as an in-place-permuted\nindex array rather than as linked nodes. Uses f42_safeguard iso_c_binding tox_errors Subroutines public  subroutine build_kd_index_c (points, n_dimensions, n_points, kd_indices, dimension_order, ierr) bind(C, name=\"build_kd_index_c\") C-wrapper for build_kd_index Read more… Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_dimensions, n_points), target :: points Data points integer(kind=c_int), intent(in), target :: n_dimensions Number of dimensions integer(kind=c_int), intent(in), target :: n_points Number of points integer(kind=c_int), intent(out), dimension(n_points), target :: kd_indices Output index array (k-d tree order) integer(kind=c_int), intent(in), dimension(n_dimensions), target :: dimension_order Dimension order (by variance)\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_dimensions . integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure. public  subroutine build_kd_index_expert_c (points, n_dimensions, n_points, kd_indices, dimension_order, tmp_workspace, tmp_value_buffer, tmp_permutation, tmp_recursion_stack, ierr) bind(C, name=\"build_kd_index_expert_c\") C-wrapper for build_kd_index_expert Read more… Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_dimensions, n_points), target :: points Data points integer(kind=c_int), intent(in), target :: n_dimensions Number of dimensions integer(kind=c_int), intent(in), target :: n_points Number of points integer(kind=c_int), intent(out), dimension(n_points), target :: kd_indices Output index array (k-d tree order) integer(kind=c_int), intent(in), dimension(n_dimensions), target :: dimension_order Dimension order (by variance)\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_dimensions . integer(kind=c_int), intent(out), dimension(n_points), target :: tmp_workspace Workspace array real(kind=c_double), intent(out), dimension(n_points), target :: tmp_value_buffer Workspace for sorting integer(kind=c_int), intent(out), dimension(n_points), target :: tmp_permutation Workspace for sorting integer(kind=c_int), intent(out), dimension(3, n_points), target :: tmp_recursion_stack Stack for l, r, depth integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure. public  subroutine build_spherical_kd_c (points, n_dimensions, n_points, kd_indices, dimension_order, ierr) bind(C, name=\"build_spherical_kd_c\") C-wrapper for build_spherical_kd Read more… Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_dimensions, n_points), target :: points Data points integer(kind=c_int), intent(in), target :: n_dimensions Number of dimensions integer(kind=c_int), intent(in), target :: n_points Number of points integer(kind=c_int), intent(out), dimension(n_points), target :: kd_indices Output index array (k-d tree order) integer(kind=c_int), intent(in), dimension(n_dimensions), target :: dimension_order Dimension order (by variance)\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_dimensions . integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure. public  subroutine build_spherical_kd_expert_c (points, n_dimensions, n_points, kd_indices, dimension_order, tmp_workspace, tmp_value_buffer, tmp_permutation, tmp_recursion_stack, ierr) bind(C, name=\"build_spherical_kd_expert_c\") C-wrapper for build_spherical_kd_expert Read more… Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_dimensions, n_points), target :: points Data points integer(kind=c_int), intent(in), target :: n_dimensions Number of dimensions integer(kind=c_int), intent(in), target :: n_points Number of points integer(kind=c_int), intent(out), dimension(n_points), target :: kd_indices Output index array (k-d tree order) integer(kind=c_int), intent(in), dimension(n_dimensions), target :: dimension_order Dimension order (by variance)\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_dimensions . integer(kind=c_int), intent(out), dimension(n_points), target :: tmp_workspace Workspace array real(kind=c_double), intent(out), dimension(n_points), target :: tmp_value_buffer Workspace for sorting integer(kind=c_int), intent(out), dimension(n_points), target :: tmp_permutation Workspace for sorting integer(kind=c_int), intent(out), dimension(3, n_points), target :: tmp_recursion_stack Stack for l, r, depth integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"module/f42_kd_tree_c.html"},{"title":"tox_paralog_analysis_c – TensorOmics","text":"Paralog-subset expression patterns -- dosage effect and subfunctionalization -- relative to an ancestral ortholog. Candidate paralog subsets are enumerated as bitmask-encoded gene sets, built up one gene at a time\nstarting from single genes. At every extension step the candidate is scored against the pattern-specific\ncriterion (small angle plus magnitude gain for dosage effect, or bounded residual distance for\nsubfunctionalization); subsets that can no longer satisfy the criterion are pruned instead of being\nextended further, which keeps the combinatorial subset search tractable. There is a routine per pattern rather than one taking a pattern flag: detect_dosage_effect and detect_subfunctionalization find the subsets, and filter_paralogs_by_pattern_dosage_effect / _subfunctionalization reduce a set of genes to\nthose matching. Which criterion a result was scored against is therefore visible at the call\nsite, and each routine takes only the thresholds its own pattern needs. Uses f42_safeguard iso_c_binding tox_errors Subroutines public  subroutine detect_neofunctionalization_c (ancestors, n_families, genes, n_axes, gene_to_fam, n_genes, thresholds, neofunc, ierr) bind(C, name=\"detect_neofunctionalization_c\") C-wrapper for detect_neofunctionalization Read more… Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_axes, n_families), target :: ancestors RAP projected unit length expression vector of ancestral ortholog\nThe minimum valid value is -1.0_real64 .\nThe maximum valid value is 1.0_real64 . integer(kind=c_int), intent(in), target :: n_families number of vectors in ancestors real(kind=c_double), intent(in), dimension(n_axes, n_genes), target :: genes RAP projected unit length expression vectors of genes\nThe minimum valid value is -1.0_real64 .\nThe maximum valid value is 1.0_real64 . integer(kind=c_int), intent(in), target :: n_axes size of ancestors vector and vectors in genes integer(kind=c_int), intent(in), dimension(n_genes), target :: gene_to_fam Index mapping -> each index i holds the family index for the corresponding gene in genes , using 0_int32 for unassigned genes\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_families .\nThe value 0_int32 is additionally accepted. integer(kind=c_int), intent(in), target :: n_genes number of vectors in genes real(kind=c_double), intent(in), dimension(n_axes), target :: thresholds threshold per axis that defines significant change in expression, may be a percentile of all genes' changes per axis\nThe minimum valid value is -1.0_real64 .\nThe maximum valid value is 1.0_real64 . logical(kind=c_bool), intent(out), dimension(n_genes, n_axes), target :: neofunc .true. if neofunctionalization has been detected for the respective axes, always .false. for unassigned genes integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure. public  subroutine detect_dosage_effect_c (ancestor, genes, n_genes, n_dims, filtered_paralogs_mask, n_mask_chunks, n_results, max_subset_size, work_arr_paralog_subsets, n_paralog_subsets, max_angle, gain_gamma, ierr) bind(C, name=\"detect_dosage_effect_c\") C-wrapper for detect_dosage_effect Read more… Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_dims), target :: ancestor expression vector of ancestral ortholog real(kind=c_double), intent(in), dimension(n_dims, n_genes), target :: genes expression vectors of genes integer(kind=c_int), intent(in), target :: n_genes number of vectors in genes integer(kind=c_int), intent(in), target :: n_dims size of ancestor vector and vectors in genes integer(kind=c_int), intent(in), dimension(n_mask_chunks), target :: filtered_paralogs_mask bit mask with the genes' indices kept by this pattern set to 1, else 0. Build it with the matching filter_paralogs_by_pattern_* routine integer(kind=c_int), intent(in), target :: n_mask_chunks number of 32 bit chunks a mask needs to encode n_genes genes. Use subroutine mask_chunk_count for calculation\nThe minimum valid value is (n_genes + 31) / 32 . integer(kind=c_int), intent(out), target :: n_results number of resulting subsets. They are stored as the first n_results elements of work_arr_paralog_subsets integer(kind=c_int), intent(in), target :: max_subset_size maximum subset size of checked gene subsets. Too large a value is capped to the\nmaximum valid size. The bindings cap it automatically while sizing the work\narray; a Fortran caller caps it by calling calc_work_arr_paralog_subsets_size first.\nZero is in range and means there is no subset to check -- the sizing routine reports\nit whenever the filtered families hold a single gene each. It reports a work array\nof zero slots along with it, which this routine does not accept, so a caller that\ngets zero back has nothing to detect and should not call here at all.\nThe minimum valid value is 0_int32 . integer(kind=c_int), intent(out), dimension(n_mask_chunks, n_paralog_subsets), target :: work_arr_paralog_subsets working array to hold bitmask encoded subsets for detection. Read more… integer(kind=c_int), intent(in), target :: n_paralog_subsets number of gene subsets that can be stored in work_arr_paralog_subsets .\nIt is VERY IMPORTANT to compute this argument from the work_array_size output produced by calc_work_arr_paralog_subsets_size . real(kind=c_double), intent(in), target :: max_angle maximum angle in radians 0<=angle<=Pi that a subset candidate must not exceed, otherwise pruned\nThe default value is 4.0_real64*atan(1.0_real64) .\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is PI . real(kind=c_double), intent(in), target :: gain_gamma positive magnitude gain for dosage effect\nThe default value is 0.1_real64 .\nThe minimum valid value is above(0.0_real64) . integer(kind=c_int), intent(out), target :: ierr Error code public  subroutine detect_dosage_effect_expert_c (ancestor, genes, n_genes, n_dims, filtered_paralogs_mask, n_mask_chunks, n_results, max_subset_size, work_arr_paralog_subsets, n_paralog_subsets, tmp_active_mask, tmp_paralog_vector, max_angle, gain_gamma, ierr) bind(C, name=\"detect_dosage_effect_expert_c\") C-wrapper for detect_dosage_effect_expert Read more… Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_dims), target :: ancestor expression vector of ancestral ortholog real(kind=c_double), intent(in), dimension(n_dims, n_genes), target :: genes expression vectors of genes integer(kind=c_int), intent(in), target :: n_genes number of vectors in genes integer(kind=c_int), intent(in), target :: n_dims size of ancestor vector and vectors in genes integer(kind=c_int), intent(in), dimension(n_mask_chunks), target :: filtered_paralogs_mask bit mask with the genes' indices kept by this pattern set to 1, else 0. Build it with the matching filter_paralogs_by_pattern_* routine integer(kind=c_int), intent(in), target :: n_mask_chunks number of 32 bit chunks a mask needs to encode n_genes genes. Use subroutine mask_chunk_count for calculation\nThe minimum valid value is (n_genes + 31) / 32 . integer(kind=c_int), intent(out), target :: n_results number of resulting subsets. They are stored as the first n_results elements of work_arr_paralog_subsets integer(kind=c_int), intent(in), target :: max_subset_size maximum subset size of checked gene subsets. Too large a value is capped to the\nmaximum valid size. The bindings cap it automatically while sizing the work\narray; a Fortran caller caps it by calling calc_work_arr_paralog_subsets_size first.\nZero is in range and means there is no subset to check -- the sizing routine reports\nit whenever the filtered families hold a single gene each. It reports a work array\nof zero slots along with it, which this routine does not accept, so a caller that\ngets zero back has nothing to detect and should not call here at all.\nThe minimum valid value is 0_int32 . integer(kind=c_int), intent(out), dimension(n_mask_chunks, n_paralog_subsets), target :: work_arr_paralog_subsets working array to hold bitmask encoded subsets for detection. Read more… integer(kind=c_int), intent(in), target :: n_paralog_subsets number of gene subsets that can be stored in work_arr_paralog_subsets .\nIt is VERY IMPORTANT to compute this argument from the work_array_size output produced by calc_work_arr_paralog_subsets_size . integer(kind=c_int), intent(out), dimension(n_mask_chunks), target :: tmp_active_mask working array to hold the extended subsets real(kind=c_double), intent(out), dimension(n_dims), target :: tmp_paralog_vector vector used for pruning subsets real(kind=c_double), intent(in), target :: max_angle maximum angle in radians 0<=angle<=Pi that a subset candidate must not exceed, otherwise pruned\nThe default value is 4.0_real64*atan(1.0_real64) .\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is PI . real(kind=c_double), intent(in), target :: gain_gamma positive magnitude gain for dosage effect\nThe default value is 0.1_real64 .\nThe minimum valid value is above(0.0_real64) . integer(kind=c_int), intent(out), target :: ierr Error code public  subroutine detect_subfunctionalization_c (ancestor, genes, n_genes, n_dims, filtered_paralogs_mask, n_mask_chunks, n_results, max_subset_size, work_arr_paralog_subsets, n_paralog_subsets, rdi_threshold, paralog_norms, sorted_paralog_norms_perm, ierr) bind(C, name=\"detect_subfunctionalization_c\") C-wrapper for detect_subfunctionalization Read more… Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_dims), target :: ancestor expression vector of ancestral ortholog real(kind=c_double), intent(in), dimension(n_dims, n_genes), target :: genes expression vectors of genes integer(kind=c_int), intent(in), target :: n_genes number of vectors in genes integer(kind=c_int), intent(in), target :: n_dims size of ancestor vector and vectors in genes integer(kind=c_int), intent(in), dimension(n_mask_chunks), target :: filtered_paralogs_mask bit mask with the genes' indices kept by this pattern set to 1, else 0. Build it with the matching filter_paralogs_by_pattern_* routine integer(kind=c_int), intent(in), target :: n_mask_chunks number of 32 bit chunks a mask needs to encode n_genes genes. Use subroutine mask_chunk_count for calculation\nThe minimum valid value is (n_genes + 31) / 32 . integer(kind=c_int), intent(out), target :: n_results number of resulting subsets. They are stored as the first n_results elements of work_arr_paralog_subsets integer(kind=c_int), intent(in), target :: max_subset_size maximum subset size of checked gene subsets. Too large a value is capped to the\nmaximum v