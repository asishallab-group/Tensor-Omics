s Name character(len=*), intent(in), contiguous :: array (:) Character input array to sort integer(kind=int32), intent(inout), contiguous :: perm (:) Permutation vector that will be sorted public pure subroutine quicksort_real (array, perm, n, tmp_stack_left, tmp_stack_right) Author Vivian Bass License MIT Internal quicksort implementation for real arrays.\nSorts indirectly using the permutation vector perm . Manual stack replaces recursion. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: array (n) Real input array to sort integer(kind=int32), intent(inout) :: perm (n) Permutation vector that will be sorted integer(kind=int32), intent(in) :: n Size of the array integer(kind=int32), intent(out) :: tmp_stack_left (n) Manual stack of left indices for quicksort recursion integer(kind=int32), intent(out) :: tmp_stack_right (n) Manual stack of right indices for quicksort recursion public pure subroutine quicksort_int (array, perm, n, tmp_stack_left, tmp_stack_right) Author Vivian Bass License MIT Internal quicksort implementation for integer arrays.\nIndirectly sorts array using perm , same algorithm as quicksort_real . Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: array (n) Integer input array to sort integer(kind=int32), intent(inout) :: perm (n) Permutation vector that will be sorted integer(kind=int32), intent(in) :: n Size of the array integer(kind=int32), intent(out) :: tmp_stack_left (n) Manual stack of left indices for quicksort recursion integer(kind=int32), intent(out) :: tmp_stack_right (n) Manual stack of right indices for quicksort recursion public pure subroutine quicksort_char (array, perm, n, tmp_stack_left, tmp_stack_right) Author Vivian Bass License MIT Internal quicksort implementation for character arrays.\nLexicographic quicksort using string comparison, indirect via perm . Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: array (n) Character input array to sort integer(kind=int32), intent(inout) :: perm (n) Permutation vector that will be sorted integer(kind=int32), intent(in) :: n Size of the array integer(kind=int32), intent(out) :: tmp_stack_left (n) Manual stack of left indices for quicksort recursion integer(kind=int32), intent(out) :: tmp_stack_right (n) Manual stack of right indices for quicksort recursion public pure subroutine heapsort_real (array, perm, n_arr, n_perm) Author Mohamed Akdi License MIT Sorts indirectly using the permutation vector perm . Uses heapify_real to maintain heap property. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: array (n_arr) Real input array to sort integer(kind=int32), intent(inout) :: perm (n_perm) Permutation vector that will be sorted integer(kind=int32), intent(in) :: n_arr Size of arr integer(kind=int32), intent(in) :: n_perm Size of perm public pure subroutine heapify_real (array, perm, heap_size, root) Author Mohamed Akdi License MIT Iterative heapify (non-recursive, pure)\nRestore the max-heap property for the subtree rooted at root .\nHeap layout (1-based): left child = 2 i, right child = 2 i+1.\nWe reorder the permutation vector perm (indices) rather than moving\narray values. Guard accesses by checking child indices before indexing. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), contiguous :: array (:) Real input array to sort integer(kind=int32), intent(inout), contiguous :: perm (:) Permutation vector that will be sorted integer(kind=int32), intent(in) :: heap_size Size of the heap integer(kind=int32), intent(in) :: root Root index public pure subroutine heapsort_integer (array, perm, n_arr, n_perm) Author Mohamed Akdi License MIT Internal heapsort implementation for integer arrays.\nIndirectly sorts array using perm , same algorithm as heapsort_real . Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: array (n_arr) Integer input array to sort integer(kind=int32), intent(inout) :: perm (n_perm) Permutation vector that will be sorted integer(kind=int32), intent(in) :: n_arr Size of arr integer(kind=int32), intent(in) :: n_perm Size of perm public pure subroutine heapify_integer (array, perm, heap_size, root) Author Mohamed Akdi License MIT Iterative heapify (non-recursive, pure)\nRestore the max-heap property for the subtree rooted at root .\nHeap layout (1-based): left child = 2 i, right child = 2 i+1.\nWe reorder the permutation vector perm (indices) rather than moving\narray values. Guard accesses by checking child indices before indexing. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in), contiguous :: array (:) Integer input array to sort integer(kind=int32), intent(inout), contiguous :: perm (:) Permutation vector that will be sorted integer(kind=int32), intent(in) :: heap_size Size of the heap integer(kind=int32), intent(in) :: root Root index public pure subroutine heapsort_character (array, perm, n_arr, n_perm) Author Mohamed Akdi License MIT Internal heapsort implementation for character arrays.\nLexicographic heapsort using string comparison, indirect via perm . Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: array (n_arr) Character input array to sort integer(kind=int32), intent(inout) :: perm (n_perm) Permutation vector that will be sorted integer(kind=int32), intent(in) :: n_arr Size of arr integer(kind=int32), intent(in) :: n_perm Size of perm public pure subroutine heapify_character (array, perm, heap_size, root) Author Mohamed Akdi License MIT Iterative heapify (non-recursive, pure)\nRestore the max-heap property for the subtree rooted at root .\nHeap layout (1-based): left child = 2 i, right child = 2 i+1.\nWe reorder the permutation vector perm (indices) rather than moving\narray values. Guard accesses by checking child indices before indexing. Arguments Type Intent Optional Attributes Name character(len=*), intent(in), contiguous :: array (:) Character input array to sort integer(kind=int32), intent(inout), contiguous :: perm (:) Permutation vector that will be sorted integer(kind=int32), intent(in) :: heap_size Size of the heap integer(kind=int32), intent(in) :: root Root index public pure subroutine swap_int (a, b) Author Vivian Bass License MIT Swap two integer values in-place. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(inout) :: a First integer to swap integer(kind=int32), intent(inout) :: b Second integer to swap public pure subroutine swap_real (a, b) Author Franz-Eric Sill License MIT Swap two real values in-place. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(inout) :: a First real to swap real(kind=real64), intent(inout) :: b Second real to swap public pure subroutine which (mask, n, idx_out, m_max, m_out, ierr) Author Vivian Bass License MIT Finds the indices of the true values in a logical mask. Arguments Type Intent Optional Attributes Name logical(kind=c_bool), intent(in) :: mask (n) Logical array of size n. integer(kind=int32), intent(in) :: n Size of the mask. integer(kind=int32), intent(out) :: idx_out (m_max) Integer array to store the indices of true values. integer(kind=int32), intent(in) :: m_max Maximum size of idx_out . integer(kind=int32), intent(out) :: m_out Actual size of idx_out (number of true values found). integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"module/f42_sort_impl.html"},{"title":"f42_utils_impl – TensorOmics","text":"General-purpose utilities for data analysis: elementary mathematics, indirect sorting and\nsearching, randomness, vector geometry, and descriptive statistics. It holds nothing itself and only gathers the modules below, so one use reaches every\nutility and which module a given one is defined in stays out of the way. Uses f42_stats_impl f42_vector_impl f42_math_impl f42_sort_impl f42_random_impl","tags":"","url":"module/f42_utils_impl.html"},{"title":"f42_serde_arrays_serialize_real_c – TensorOmics","text":"Module for serializing real arrays into files Uses f42_safeguard iso_c_binding tox_errors Subroutines public  subroutine serialize_real_helper_c (arr, n_elements, arr_shape, n_arr_shape_elements, filename, filename_strlen, ierr) bind(C, name=\"serialize_real_helper_c\") C-wrapper for serialize_real_helper Read more… Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(*), target :: arr Array to be serialized integer(kind=c_int), intent(in), target :: n_elements Number of strings in arr integer(kind=c_int), intent(in), dimension(n_arr_shape_elements), target :: arr_shape Extents of arr , one per dimension integer(kind=c_int), intent(in), target :: n_arr_shape_elements number of elements in arr_shape character(kind=c_char, len=1), intent(in), dimension(filename_strlen), target :: filename Name of the file to write to integer(kind=c_int), intent(in), target :: filename_strlen length of the strings in filename integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"module/f42_serde_arrays_serialize_real_c.html"},{"title":"tox_tissue_versatility – TensorOmics","text":"Normalized tissue (axis) versatility: how uniformly a gene is expressed across tissues. An angle-based metric. A gene expressed equally across every selected axis points along the\ndiagonal of that subspace and scores maximally versatile; one confined to a single tissue\npoints along that axis and scores minimally. Normalized, so scores over different numbers of\nselected axes are comparable. Generated from tox_tissue_versatility_impl ; do not edit -- regenerate instead. Uses iso_fortran_env iso_c_binding tox_tissue_versatility_impl f42_safeguard tox_errors Subroutines public pure subroutine compute_tissue_versatility (n_axes, n_vectors, expression_vectors, vectors_selection_mask, n_selected_vectors, axes_selection_mask, n_selected_axes, tissue_versatilities, tissue_angles_deg, ierr) Validates its inputs, then calls compute_tissue_versatility_impl . Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_axes Number of axes (tissues/dimensions) integer(kind=int32), intent(in) :: n_vectors Number of expression vectors (genes) real(kind=real64), intent(in), dimension(n_axes, n_vectors) :: expression_vectors 2D array (n_axes, n_vectors), each column is a gene expression vector logical(kind=c_bool), intent(in), dimension(n_vectors) :: vectors_selection_mask Logical array (n_vectors), .TRUE. for vectors to process integer(kind=int32), intent(in) :: n_selected_vectors Number of selected expression vectors (count of .TRUE. in vectors_selection_mask) logical(kind=c_bool), intent(in), dimension(n_axes) :: axes_selection_mask Logical array (n_axes), .TRUE. for axes to include in calculation integer(kind=int32), intent(in) :: n_selected_axes Number of selected axes (count of .TRUE. in axes_selection_mask)\nThe minimum valid value is 1_int32 . real(kind=real64), intent(out), dimension(n_selected_vectors) :: tissue_versatilities Output, real array, length = n_selected_vectors, stores the calculated tissue versatilities real(kind=real64), intent(out), dimension(n_selected_vectors) :: tissue_angles_deg Output, real array, length = n_selected_vectors, stores the calculated angles in degrees integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"module/tox_tissue_versatility.html"},{"title":"f42_safeguard – TensorOmics","text":"This module ensures equivalence of used c types in this framework during compile time.\nThus, it needs to be used by every module to be compiled first, and it is highly recommended to compile the framework manually. Uses iso_fortran_env iso_c_binding Variables Type Visibility Attributes Name Initial logical, public, parameter :: THIS_FAILS_IF_C_INT_DOES_NOT_MATCH_INT32 = 1 Compile-time guard: fails to compile if c_int is not kind-identical to int32 . logical, public, parameter :: THIS_FAILS_IF_C_DOUBLE_DOES_NOT_MATCH_REAL64 = 1 Compile-time guard: fails to compile if c_double is not kind-identical to real64 . logical, public, parameter :: THIS_FAILS_IF_C_DOUBLE_COMPLEX_DOES_NOT_MATCH_REAL64 = 1 Compile-time guard: fails to compile if the real component kind of c_double_complex is not kind-identical to real64 . logical, public, parameter :: THIS_FAILS_IF_C_CHAR_DOES_NOT_MATCH_DEFAULT = 1 Compile-time guard: fails to compile if c_char is not the default character kind. logical, public, parameter :: THIS_FAILS_IF_C_BOOL_IS_NOT_AVAILABLE = 1 This one earns its place differently from the three above. Those assert an equality the\nframework would otherwise have to convert across. This one asserts the equality that lets\nthe framework say nothing at all: an implementation writes a plain character(len=*) , and\nthe C layer takes a character(len=n) pointer view of a character(kind=c_char, len=1) buffer -- the same storage only if the two kinds are the same. They are on every platform\nwe build for, and the standard does not promise it; c_char is defined as the kind for\nC's char , or -1 where there is none. A distinct character kind really does exist\n( selected_char_kind(\"ISO_10646\") is 4 on gfortran), so this is a real property rather\nthan a tautology. Asserting it is what makes writing character(kind=c_char) throughout\nthe framework unnecessary rather than merely unusual.\nThe kinds below are asserted to EXIST, not to equal anything. The framework declares with\nthem and takes them as they come -- it never needs c_bool to be one byte, only to be a\nlogical kind C agrees with, which bind(C) then guarantees. iso_c_binding gives a C kind\nthe value -1 where the platform has no interoperable counterpart, and a negative kind is a\ncompile error at every declaration that names it. That is 152 confusing errors for c_bool , in files that did nothing wrong, instead of one here that says which kind is\nmissing. All four are in the kinds test, which they could not be while this module still had\ndependencies: tox_errors holds some of the 152 c_bool declarations and compiled first,\nso an override failed there with a kind error and the guard never got the chance. Dropping\nthis module's own use s of tox_conversions and f42_config put it back at the front of\nthe build and made every guard reachable.\nCompile-time guard: fails to compile if C has no _Bool this platform can express. logical, public, parameter :: THIS_FAILS_IF_C_SIZE_T_IS_NOT_AVAILABLE = 1 Compile-time guard: fails to compile if C has no size_t this platform can express. logical, public, parameter :: THIS_FAILS_IF_C_INT64_T_IS_NOT_AVAILABLE = 1 Compile-time guard: fails to compile if C has no int64_t this platform can express. logical, public, parameter :: THIS_FAILS_IF_C_SIGNED_CHAR_IS_NOT_AVAILABLE = 1 Compile-time guard: fails to compile if C has no signed char this platform can express.","tags":"","url":"module/f42_safeguard.html"},{"title":"f42_serde_arrays_serialize_complex – TensorOmics","text":"Module for serializing complex arrays into files Uses iso_fortran_env f42_serde_arrays_utils tox_errors Subroutines public  subroutine serialize_complex_helper (arr, n_elements, arr_shape, filename, ierr) Author Aaron Schröder License MIT Category C-binding Subroutine to serialize a flat complex array into a file Read more… Arguments Type Intent Optional Attributes Name complex(kind=real64), intent(in), dimension(n_elements) :: arr Array to be serialized integer(kind=int32), intent(in) :: n_elements Number of strings in arr integer(kind=int32), intent(in), dimension(:) :: arr_shape Extents of arr , one per dimension character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code public  subroutine serialize_complex_1d (arr, filename, ierr) Author Aaron Schröder License MIT Directly serialize a 1D complex array into a file Arguments Type Intent Optional Attributes Name complex(kind=real64), intent(in), dimension(:), contiguous :: arr Array to be serialized character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code public  subroutine serialize_complex_2d (arr, filename, ierr) Author Aaron Schröder License MIT Directly serialize a 2D complex array into a file Arguments Type Intent Optional Attributes Name complex(kind=real64), intent(in), dimension(:, :), contiguous :: arr Array to be serialized character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code public  subroutine serialize_complex_3d (arr, filename, ierr) Author Aaron Schröder License MIT Directly serialize a 3D complex array into a file Arguments Type Intent Optional Attributes Name complex(kind=real64), intent(in), dimension(:, :, :), contiguous :: arr Array to be serialized character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code public  subroutine serialize_complex_4d (arr, filename, ierr) Author Aaron Schröder License MIT Directly serialize a 4D complex array into a file Arguments Type Intent Optional Attributes Name complex(kind=real64), intent(in), dimension(:, :, :, :), contiguous :: arr Array to be serialized character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code public  subroutine serialize_complex_5d (arr, filename, ierr) Author Aaron Schröder License MIT Directly serialize a 5D complex array into a file Arguments Type Intent Optional Attributes Name complex(kind=real64), intent(in), dimension(:, :, :, :, :), contiguous :: arr Array to be serialized character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"module/f42_serde_arrays_serialize_complex.html"},{"title":"tox_shift_vectors_impl – TensorOmics","text":"The shift vector field: where each gene sits relative to its family's centroid. One vector per gene, from the centroid of the family it belongs to to the gene itself. It is\nthe input the relative-axis plane tools project and measure angles in, and what the\nparalog-pattern detection reads a gene's direction and magnitude off. Uses iso_fortran_env Subroutines public pure subroutine compute_shift_vector_field_impl (n_tissues, n_genes, n_families, expression_vectors, family_centroids, gene_to_fam, shift_vectors) Author Alexander Schwarzpaul License MIT Compute the shift vector field for all genes. Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_tissues Expression vector dimension integer(kind=int32), intent(in) :: n_genes Total number of genes integer(kind=int32), intent(in) :: n_families Total number of families real(kind=real64), intent(in) :: expression_vectors (n_tissues,n_genes) Gene expression matrix real(kind=real64), intent(in) :: family_centroids (n_tissues,n_families) Family centroid matrix integer(kind=int32), intent(in) :: gene_to_fam (n_genes) Index mapping -> each index i holds the family index for the corresponding gene in expression_vectors , using 0_int32 for unassigned genes\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_families .\nThe value 0_int32 is additionally accepted. real(kind=real64), intent(out) :: shift_vectors (n_tissues,2,n_genes) Output, real matrix array. For each gene it holds two vectors: the centroid of the gene's family first (a zero vector if no family is assigned), then the shift vector","tags":"","url":"module/tox_shift_vectors_impl.html"},{"title":"tox_clustering – TensorOmics","text":"Clustering for tensor omics: k-means over factors and trajectories, and hierarchical\n(agglomerative) linkage clustering over a precomputed distance matrix. k_means_clustering partitions points in n dimensions; cluster_factor_trajectories_k_means applies the same to whole time series, treating each factor's trajectory as one point. linkage_clustering takes the distances already computed and merges under the linkage\ncriterion asked for, so the same matrix can be re-clustered without recomputing it. Generated from tox_clustering_impl ; do not edit -- regenerate instead. Uses tox_clustering_impl iso_fortran_env tox_errors Subroutines public pure subroutine cluster_factor_trajectories_k_means (n_clusters, trajectories, n_factors, n_samples, n_timepoints, centroids, labels, label_counts, max_iterations, ierr) Validates its inputs, then calls cluster_factor_trajectories_k_means_impl . Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_clusters number ( k ) of clusters\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_samples*n_timepoints . real(kind=real64), intent(in), dimension(n_factors, n_samples, n_timepoints) :: trajectories matrix with data points to cluster integer(kind=int32), intent(in) :: n_factors number of factors integer(kind=int32), intent(in) :: n_samples number of samples integer(kind=int32), intent(in) :: n_timepoints number of timepoints real(kind=real64), intent(inout), dimension(n_factors, n_clusters) :: centroids matrix with initial centroids of the clusters, could be random data or actual points or unassigned garbage.\nThe centroids should be unique. This is not checked in this routine. Read more… integer(kind=int32), intent(out), dimension(n_samples*n_timepoints) :: labels array of labels, each index corresponds to the respective point's index, so first label is first point's label. Read more… integer(kind=int32), intent(out), dimension(n_clusters) :: label_counts holds the number of points having the respective label assigned integer(kind=int32), intent(in) :: max_iterations number of maximum iterations of the clustering integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure. public pure subroutine k_means_clustering (n_clusters, data_points, n_points, n_dims, centroids, labels, label_counts, max_iterations, ierr) Validates its inputs, then calls k_means_clustering_impl . Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_clusters number ( k ) of clusters\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_points . real(kind=real64), intent(in), dimension(n_dims, n_points) :: data_points matrix with data points to cluster integer(kind=int32), intent(in) :: n_points number of points to cluster integer(kind=int32), intent(in) :: n_dims number of elements a point has real(kind=real64), intent(inout), dimension(n_dims, n_clusters) :: centroids matrix with initial centroids of the clusters, could be random data or actual points or unassigned garbage.\nThe centroids should be unique. This is not checked in this routine. Read more… integer(kind=int32), intent(out), dimension(n_points) :: labels array of labels, each index corresponds to the respective point's index, so first label is first point's label. Read more… integer(kind=int32), intent(out), dimension(n_clusters) :: label_counts holds the number of points having the respective label assigned integer(kind=int32), intent(in), optional :: max_iterations number of maximum iterations of the clustering.\nThe default value is 300_int32 . integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure. public pure subroutine linkage_clustering (distances, n_points, merge_i, merge_j, heights, cluster_sizes, method, ierr) Validates its inputs, then calls linkage_clustering_impl . Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(inout), dimension(n_points, n_points) :: distances symmetric distance matrix, holding the positive distances between points. Distance of X->X is always zero. Read more… integer(kind=int32), intent(in) :: n_points number of points to cluster integer(kind=int32), intent(out), dimension(n_points - 1) :: merge_i holds cluster labels of the merged node pair at iteration k -> positives relate to leafs/data point indices, negatives to inner nodes integer(kind=int32), intent(out), dimension(n_points - 1) :: merge_j holds cluster labels of the merged node pair at iteration k -> positives relate to leafs/data point indices, negatives to inner nodes real(kind=real64), intent(out), dimension(n_points - 1) :: heights height of the shorter branch of the merge, e.g. if (A,B)+(C) merges to ((A,B),C), the branch to (A,B) is shorter integer(kind=int32), intent(out), dimension(n_points - 1) :: cluster_sizes size of cluster at iteration k integer(kind=int32), intent(in) :: method used algorithm\nThe minimum valid value is 0_int32 .\nThe maximum valid value is 2_int32 . Read more… integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"module/tox_clustering.html"},{"title":"tox_data_integration_impl – TensorOmics","text":"Jensen-Shannon-Divergence (JSD) Compatibility Test (JCT) In multi-study omics analyses, it is often unclear whether biological replicates originating from different studies can be safely treated as sampling the same biological condition.\nEven when studies nominally target the same tissue and condition, differences in sample handling, sequencing technologies, preprocessing pipelines, or cohort,\ncomposition can introduce batch effects that are not easily detectable from mean expression levels alone. This ambiguity has direct consequences for downstream analyses in Tensor Omics. Integrating incompatible replicate sets can: distort expression spaces, affect distance-based analyses, bias machine learning models, while unnecessarily separating compatible datasets reduces statistical power. To address this, we introduce a Jensen-Shannon-Divergence based compatibility test (JSD-Comp-Test)\nthat empirically evaluates whether two sets of biological replicates exhibit comparable replicate-level variability.\nRather than comparing mean expression values, the method focuses on the distribution of signed residuals (replicate deviations from the gene-wise mean),\nconditioned on mean expression levels to account for heteroscedasticity, which is a well-known property of omics data. The test is split over four modules -- preprocessing, JSD calculation, per-family JSD\ncalculation and the permutation test -- which this one gathers, so a caller reaches the whole\npipeline through it and the split stays out of the way. Uses tox_data_integration_jsd_impl tox_data_integration_preprocessing_impl tox_data_integration_per_family_impl tox_data_integration_stats_impl","tags":"","url":"module/tox_data_integration_impl.html"},{"title":"f42_serde_arrays_deserialize_logical_c – TensorOmics","text":"Module for deserializing logical arrays from files Uses f42_safeguard iso_c_binding tox_errors Subroutines public  subroutine deserialize_logical_helper_c (arr, n_elements, arr_shape, n_arr_shape_elements, filename, filename_strlen, ierr) bind(C, name=\"deserialize_logical_helper_c\") C-wrapper for deserialize_logical_helper Read more… Arguments Type Intent Optional Attributes Name logical(kind=c_bool), intent(out), dimension(*), target :: arr Pre-allocated array to read the data into integer(kind=c_int), intent(in), target :: n_elements Size of arr integer(kind=c_int), intent(in), dimension(n_arr_shape_elements), target :: arr_shape Extents of arr , one per dimension\nIt is VERY IMPORTANT to compute this argument from the dims_out output produced by get_array_metadata . Read more… integer(kind=c_int), intent(in), target :: n_arr_shape_elements number of elements in arr_shape character(kind=c_char, len=1), intent(in), dimension(filename_strlen), target :: filename Name of the file integer(kind=c_int), intent(in), target :: filename_strlen length of the strings in filename integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"module/f42_serde_arrays_deserialize_logical_c.html"},{"title":"f42_binary_search_tree_c – TensorOmics","text":"Flat-index-based Binary Search Tree (BST) utilities for 1D range queries.\nThis module provides routines to build a BST index (via sorting), access sorted values,\nand perform range queries over a real-valued array using the sorted index. Uses f42_safeguard iso_c_binding tox_errors Subroutines public  subroutine build_bst_index_c (values, n_values, sorted_indices, ierr) bind(C, name=\"build_bst_index_c\") C-wrapper for build_bst_index Read more… Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_values), target :: values Input real array to be indexed integer(kind=c_int), intent(in), target :: n_values Number of elements in values array integer(kind=c_int), intent(out), dimension(n_values), target :: sorted_indices Output permutation index integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure. public  subroutine bst_range_query_c (values, n_values, lower_bound, upper_bound, output_indices, n_matches, ierr) bind(C, name=\"bst_range_query_c\") C-wrapper for bst_range_query Read more… Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_values), target :: values Input real array integer(kind=c_int), intent(in), target :: n_values Number of elements real(kind=c_double), intent(in), target :: lower_bound Lower bound of range (inclusive)\nThe maximum valid value is upper_bound . real(kind=c_double), intent(in), target :: upper_bound Upper bound of range (inclusive) integer(kind=c_int), intent(out), dimension(n_values), target :: output_indices Output array of matching indices.\nThe first n_matches elements will hold the results. integer(kind=c_int), intent(out), target :: n_matches Number of matches found integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure. public  subroutine bst_range_query_expert_c (values, values_perm, n_values, lower_bound, upper_bound, output_indices, n_matches, ierr) bind(C, name=\"bst_range_query_expert_c\") C-wrapper for bst_range_query_expert Read more… Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_values), target :: values Input real array integer(kind=c_int), intent(in), dimension(n_values), target :: values_perm Permutation of values in ascending order -- the BST index. The allocating entry\npoint builds and heapsorts it for you; the expert one takes whatever order you\nsupply, so a caller that already holds one from build_bst_index can reuse it across queries.\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_values . integer(kind=c_int), intent(in), target :: n_values Number of elements real(kind=c_double), intent(in), target :: lower_bound Lower bound of range (inclusive)\nThe maximum valid value is upper_bound . real(kind=c_double), intent(in), target :: upper_bound Upper bound of range (inclusive) integer(kind=c_int), intent(out), dimension(n_values), target :: output_indices Output array of matching indices.\nThe first n_matches elements will hold the results. integer(kind=c_int), intent(out), target :: n_matches Number of matches found integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"module/f42_binary_search_tree_c.html"},{"title":"tox_data_archive_c – TensorOmics","text":"Zip-archive backed persistence for TensorOmics data sets. Wraps libzip (via C bindings declared in the interface block below) to create/extract zip\narchives whose members are tox_data_read_write -serialized arrays, indexed by a\nplain-text manifest.txt mapping logical keys (e.g. gene_ids , expression ) to member\nfilenames. save_tox_data and read_tox_data are the standard entry points for the\nfixed TensorOmics data set schema; create_zip_archive / extract_zip_archive and the *_manifest* routines below are the generic key/filename building blocks they are built on. Uses f42_safeguard iso_c_binding tox_errors Subroutines public  subroutine create_zip_archive_c (zip_filename, zip_filename_strlen, keys, keys_strlen, n_keys_elements, filenames, filenames_strlen, n_filenames_elements, ierr) bind(C, name=\"create_zip_archive_c\") C-wrapper for create_zip_archive Read more… Arguments Type Intent Optional Attributes Name character(kind=c_char, len=1), intent(in), dimension(zip_filename_strlen), target :: zip_filename Name of the zip file to create integer(kind=c_int), intent(in), target :: zip_filename_strlen length of the strings in zip_filename character(kind=c_char, len=1), intent(in), dimension(keys_strlen, n_keys_elements), target :: keys Array of keys for manifest entries integer(kind=c_int), intent(in), target :: keys_strlen length of the strings in keys integer(kind=c_int), intent(in), target :: n_keys_elements number of elements in keys character(kind=c_char, len=1), intent(in), dimension(filenames_strlen, n_filenames_elements), target :: filenames Array of filenames to add to zip integer(kind=c_int), intent(in), target :: filenames_strlen length of the strings in filenames integer(kind=c_int), intent(in), target :: n_filenames_elements number of elements in filenames integer(kind=c_int), intent(out), target :: ierr Error code public  subroutine save_tox_data_c (zip_filename, zip_filename_strlen, ierr, gene_ids, gene_ids_strlen, n_gene_ids_elements, gene_ids_file, gene_ids_file_strlen, expression, n_expression_elements_dim_1, n_expression_elements_dim_2, expression_file, expression_file_strlen, gene_to_family, n_gene_to_family_elements, gene_to_family_file, gene_to_family_file_strlen, family_ids, family_ids_strlen, n_family_ids_elements, family_ids_file, family_ids_file_strlen, family_centroids, n_family_centroids_elements_dim_1, n_family_centroids_elements_dim_2, family_centroids_file, family_centroids_file_strlen, shift_vectors, n_shift_vectors_elements_dim_1, n_shift_vectors_elements_dim_2, shift_vectors_file, shift_vectors_file_strlen) bind(C, name=\"save_tox_data_c\") C-wrapper for save_tox_data Read more… Arguments Type Intent Optional Attributes Name character(kind=c_char, len=1), intent(in), dimension(zip_filename_strlen), target :: zip_filename Zip filename integer(kind=c_int), intent(in), target :: zip_filename_strlen length of the strings in zip_filename integer(kind=c_int), intent(out), target :: ierr Error code character(kind=c_char, len=1), intent(in), optional, dimension(gene_ids_strlen, n_gene_ids_elements), target :: gene_ids Gene ids array, will be saved if provided integer(kind=c_int), intent(in), target :: gene_ids_strlen length of the strings in gene_ids integer(kind=c_int), intent(in), target :: n_gene_ids_elements number of elements in gene_ids character(kind=c_char, len=1), intent(in), optional, dimension(gene_ids_file_strlen), target :: gene_ids_file Name of the gene ids file integer(kind=c_int), intent(in), target :: gene_ids_file_strlen length of the strings in gene_ids_file real(kind=c_double), intent(in), optional, dimension(n_expression_elements_dim_1, n_expression_elements_dim_2) :: expression Expression vectors array, will be saved if provided integer(kind=c_int), intent(in), target :: n_expression_elements_dim_1 Read more… integer(kind=c_int), intent(in), target :: n_expression_elements_dim_2 Read more… character(kind=c_char, len=1), intent(in), optional, dimension(expression_file_strlen), target :: expression_file Name of the expression file integer(kind=c_int), intent(in), target :: expression_file_strlen length of the strings in expression_file integer(kind=c_int), intent(in), optional, dimension(n_gene_to_family_elements) :: gene_to_family Gene to family mapping array, will be saved if provided integer(kind=c_int), intent(in), target :: n_gene_to_family_elements number of elements in gene_to_family character(kind=c_char, len=1), intent(in), optional, dimension(gene_to_family_file_strlen), target :: gene_to_family_file Name of the gene to family mapping file integer(kind=c_int), intent(in), target :: gene_to_family_file_strlen length of the strings in gene_to_family_file character(kind=c_char, len=1), intent(in), optional, dimension(family_ids_strlen, n_family_ids_elements), target :: family_ids Family ids array, will be saved if provided integer(kind=c_int), intent(in), target :: family_ids_strlen length of the strings in family_ids integer(kind=c_int), intent(in), target :: n_family_ids_elements number of elements in family_ids character(kind=c_char, len=1), intent(in), optional, dimension(family_ids_file_strlen), target :: family_ids_file Name of the family ids file integer(kind=c_int), intent(in), target :: family_ids_file_strlen length of the strings in family_ids_file real(kind=c_double), intent(in), optional, dimension(n_family_centroids_elements_dim_1, n_family_centroids_elements_dim_2) :: family_centroids Family centroids array, will be saved if provided integer(kind=c_int), intent(in), target :: n_family_centroids_elements_dim_1 Read more… integer(kind=c_int), intent(in), target :: n_family_centroids_elements_dim_2 Read more… character(kind=c_char, len=1), intent(in), optional, dimension(family_centroids_file_strlen), target :: family_centroids_file Name of the family centroids file integer(kind=c_int), intent(in), target :: family_centroids_file_strlen length of the strings in family_centroids_file real(kind=c_double), intent(in), optional, dimension(n_shift_vectors_elements_dim_1, n_shift_vectors_elements_dim_2) :: shift_vectors Shift vectors array, will be saved if provided integer(kind=c_int), intent(in), target :: n_shift_vectors_elements_dim_1 Read more… integer(kind=c_int), intent(in), target :: n_shift_vectors_elements_dim_2 Read more… character(kind=c_char, len=1), intent(in), optional, dimension(shift_vectors_file_strlen), target :: shift_vectors_file Name of the shift vectors file integer(kind=c_int), intent(in), target :: shift_vectors_file_strlen length of the strings in shift_vectors_file public  subroutine get_tox_data_dims_c (zip_filename, zip_filename_strlen, n_gene_ids, gene_id_len, n_expression_rows, n_expression_cols, n_gene_to_family, n_family_ids, family_id_len, n_family_centroids_rows, n_family_centroids_cols, n_shift_vectors_rows, n_shift_vectors_cols, ierr) bind(C, name=\"get_tox_data_dims_c\") C-wrapper for get_tox_data_dims Read more… Arguments Type Intent Optional Attributes Name character(kind=c_char, len=1), intent(in), dimension(zip_filename_strlen), target :: zip_filename Name of the zip file integer(kind=c_int), intent(in), target :: zip_filename_strlen length of the strings in zip_filename integer(kind=c_int), intent(out), target :: n_gene_ids Number of gene ids, 0 if absent integer(kind=c_int), intent(out), target :: gene_id_len String length of each gene id, 0 if absent integer(kind=c_int), intent(out), target :: n_expression_rows Rows (samples) of the expression matrix, 0 if absent integer(kind=c_int), intent(out), target :: n_expression_cols Columns (genes) of the expression matrix, 0 if absent integer(kind=c_int), intent(out), target :: n_gene_to_family Number of gene-to-family entries, 0 if absent integer(kind=c_int), intent(out), target :: n_family_ids Number of family ids, 0 if absent integer(kind=c_int), intent(out), target :: family_id_len String length of each family id, 0 if absent integer(kind=c_int), intent(out), target :: n_family_centroids_rows Rows (samples) of the family centroids matrix, 0 if absent integer(kind=c_int), intent(out), target :: n_family_centroids_cols Columns (families) of the family centroids matrix, 0 if absent integer(kind=c_int), intent(out), target :: n_shift_vectors_rows Rows of the shift vectors matrix, 0 if absent integer(kind=c_int), intent(out), target :: n_shift_vectors_cols Columns of the shift vectors matrix, 0 if absent integer(kind=c_int), intent(out), target :: ierr Error code public  subroutine read_tox_data_into_c (zip_filename, zip_filename_strlen, n_gene_ids, gene_id_len, gene_ids, n_expression_rows, n_expression_cols, expression, n_gene_to_family, gene_to_family, n_family_ids, family_id_len, family_ids, n_family_centroids_rows, n_family_centroids_cols, family_centroids, n_shift_vectors_rows, n_shift_vectors_cols, shift_vectors, ierr) bind(C, name=\"read_tox_data_into_c\") C-wrapper for read_tox_data_into Read more… Arguments Type Intent Optional Attributes Name character(kind=c_char, len=1), intent(in), dimension(zip_filename_strlen), target :: zip_filename Name of the zip file integer(kind=c_int), intent(in), target :: zip_filename_strlen length of the strings in zip_filename integer(kind=c_int), intent(in), target :: n_gene_ids Number of gene ids.\nIt is VERY IMPORTANT to compute this argument from the n_gene_ids output produced by get_tox_data_dims . integer(kind=c_int), intent(in), target :: gene_id_len String length of each gene id.\nIt is VERY IMPORTANT to compute this argument from the gene_id_len output produced by get_tox_data_dims . character(kind=c_char, len=1), intent(out), dimension(gene_id_len, n_gene_ids), target :: gene_ids Gene ids integer(kind=c_int), intent(in), target :: n_expression_rows Rows (samples) of the expression matrix.\nIt is VERY IMPORTANT to compute this argument from the n_expression_rows output produced by get_tox_data_dims . integer(kind=c_int), intent(in), target :: n_expression_cols Columns (genes) of the expression matrix.\nIt is VERY IMPORTANT to compute this argument from the n_expression_cols output produced by get_tox_data_dims . real(kind=c_double), intent(out), dimension(n_expression_rows, n_expression_cols), target :: expression Expression vectors integer(kind=c_int), intent(in), target :: n_gene_to_family Number of gene-to-family entries.\nIt is VERY IMPORTANT to compute this argument from the n_gene_to_family output produced by get_tox_data_dims . integer(kind=c_int), intent(out), dimension(n_gene_to_family), target :: gene_to_family Gene to family mapping integer(kind=c_int), intent(in), target :: n_family_ids Number of family ids.\nIt is VERY IMPORTANT to compute this argument from the n_family_ids output produced by get_tox_data_dims . integer(kind=c_int), intent(in), target :: family_id_len String length of each family id.\nIt is VERY IMPORTANT to compute this argument from the family_id_len output produced by get_tox_data_dims . character(kind=c_char, len=1), intent(out), dimension(family_id_len, n_family_ids), target :: family_ids Family ids integer(kind=c_int), intent(in), target :: n_family_centroids_rows Rows (samples) of the family centroids matrix.\nIt is VERY IMPORTANT to compute this argument from the n_family_centroids_rows output produced by get_tox_data_dims . integer(kind=c_int), intent(in), target :: n_family_centroids_cols Columns (families) of the family centroids matrix.\nIt is VERY IMPORTANT to compute this argument from the n_family_centroids_cols output produced by get_tox_data_dims . real(kind=c_double), intent(out), dimension(n_family_centroids_rows, n_family_centroids_cols), target :: family_centroids Family centroids integer(kind=c_int), intent(in), target :: n_shift_vectors_rows Rows of the shift vectors matrix.\nIt is VERY IMPORTANT to compute this argument from the n_shift_vectors_rows output produced by get_tox_data_dims . integer(kind=c_int), intent(in), target :: n_shift_vectors_cols Columns of the shift vectors matrix.\nIt is VERY IMPORTANT to compute this argument from the n_shift_vectors_cols output produced by get_tox_data_dims . real(kind=c_double), intent(out), dimension(n_shift_vectors_rows, n_shift_vectors_cols), target :: shift_vectors Shift vectors integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"module/tox_data_archive_c.html"},{"title":"f42_serde_arrays_utils – TensorOmics","text":"Module for array utilities. Defines the shared on-disk binary layout used by all typed array\nserialize/deserialize modules (int/real/complex/logical/char) and the\nheader read/write/validate helpers that implement it. The file header is\na fixed sequence of unformatted stream records, written and read in this\norder: magic number ( ARRAY_FILE_MAGIC ),\ntype code, number of dimensions ndim , then ndim dimension sizes. The\nraw array payload follows immediately after the header, written as one\ncontiguous block by the type-specific serializers. The header does NOT record the width of an element, so the payload is only\nreadable by a build that agrees with the writer on the storage size of the\ntype code. Logical arrays changed width once: they are now written as logical(c_bool) , one byte per element, where earlier builds wrote the\ndefault logical kind at four. A logical .bin file written before that\nchange therefore decodes to garbage here rather than failing, and one\nwritten here does the same there. No other type code has moved. Uses f42_safeguard iso_fortran_env f42_serde_utils tox_errors Variables Type Visibility Attributes Name Initial integer(kind=int32), public, parameter :: ARRAY_FILE_MAGIC = int(z'46413230', int32) Magic number for array files Subroutines public  subroutine write_file_header (filename, unit, type_code, ndim, dims, ierr) Author Aaron Schröder License MIT Opens unit and writes fileheader with all metadata to the given filename Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: filename filename to write to integer(kind=int32), intent(out) :: unit Fortran unit number for the file integer(kind=int32), intent(in) :: type_code type code of the array Read more… integer(kind=int32), intent(in) :: ndim number of dimensions integer(kind=int32), intent(in) :: dims (ndim) dimensions of the array integer(kind=int32), intent(inout) :: ierr error code public  subroutine check_file_header (filename, expected_type_code, expected_shape, unit, ierr) Author Franz-Eric Sill License MIT Opens filename , reads its header via read_file_header_helper ,\nand validates the stored type code and shape against the caller's expectations. On any\nmismatch the unit is closed and an error is set; on success the unit is left open (positioned\nright after the header, ready for the caller to read the payload) and it is the caller's\nresponsibility to close it. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: filename filename to read from integer(kind=int32), intent(in) :: expected_type_code Expected type code in header Read more… integer(kind=int32), intent(in), dimension(:) :: expected_shape Expected shape in header integer(kind=int32), intent(out) :: unit Fortran unit number for the file integer(kind=int32), intent(out) :: ierr Error code public  subroutine read_file_header_helper (filename, unit, type_code, ndims, dims, ierr) Author Aaron Schröder License MIT Opens unit and reads file header with all metadata from given file Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: filename filename to read from integer(kind=int32), intent(out) :: unit Fortran unit number for the file integer(kind=int32), intent(out) :: type_code type code of the array Read more… integer(kind=int32), intent(out) :: ndims number of dimensions integer(kind=int32), intent(out), allocatable :: dims (:) dimensions of the array integer(kind=int32), intent(out) :: ierr error code public  subroutine get_array_metadata (filename, dims_out, dims_out_capacity, ndims, type_code, ierr) Author Aaron Schröder License MIT Category C-binding Get the metadata of an array file Read more… Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: dims_out (dims_out_capacity) Array to store output dimensions\nThe first ndims elements will hold the results. integer(kind=int32), intent(in) :: dims_out_capacity Capacity of the dims_out array integer(kind=int32), intent(out) :: ndims number of dimensions integer(kind=int32), intent(out) :: type_code Type code of the serialized array Read more… integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"module/f42_serde_arrays_utils.html"},{"title":"tox_data_read_write – TensorOmics","text":"Wrappers for serialization/deserialization of arrays Uses iso_fortran_env f42_serde_arrays_serialize f42_serde_arrays_deserialize tox_errors Subroutines public  subroutine save_gene_ids (gene_ids, filename, ierr) Author Aaron Schröder License MIT Wrapper for serialize_char_1D function Arguments Type Intent Optional Attributes Name character(len=*), intent(in), contiguous :: gene_ids (:) Gene IDs to write character(len=*), intent(in) :: filename Filename to write to integer(kind=int32), intent(out) :: ierr Error code (0 if successful) public  subroutine save_expression_vectors (expression_vectors, filename, ierr) Author Aaron Schröder License MIT Wrapper for serialize_real_2D function Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), contiguous :: expression_vectors (:,:) Expression vectors to write character(len=*), intent(in) :: filename Filename to write to integer(kind=int32), intent(out) :: ierr Error code (0 if successful) public  subroutine save_gene_to_family (gene_to_fam, filename, ierr) Author Aaron Schröder License MIT Wrapper for serialize_int_1D function Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in), contiguous :: gene_to_fam (:) Gene to family mapping to write character(len=*), intent(in) :: filename Filename to write to integer(kind=int32), intent(out) :: ierr Error code (0 if successful) public  subroutine save_family_ids (family_ids, filename, ierr) Author Aaron Schröder License MIT Wrapper for serialize_char_1D function Arguments Type Intent Optional Attributes Name character(len=*), intent(in), contiguous :: family_ids (:) Family IDs to write character(len=*), intent(in) :: filename Filename to write to integer(kind=int32), intent(out) :: ierr Error code (0 if successful) public  subroutine save_family_centroids (family_centroids, filename, ierr) Author Aaron Schröder License MIT Wrapper for serialize_real_2D function Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), contiguous :: family_centroids (:,:) Family centroids to write character(len=*), intent(in) :: filename Filename to write to integer(kind=int32), intent(out) :: ierr Error code (0 if successful) public  subroutine save_shift_vectors (shift_vectors, filename, ierr) Author Aaron Schröder License MIT Wrapper for serialize_real_2D function Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), contiguous :: shift_vectors (:,:) Shift vectors to write character(len=*), intent(in) :: filename Filename to write to integer(kind=int32), intent(out) :: ierr Error code (0 if successful) public  subroutine load_gene_ids (gene_ids, filename, ierr) Author Aaron Schröder License MIT Wrapper for deserialize_char_1D function Arguments Type Intent Optional Attributes Name character(len=*), intent(out), contiguous :: gene_ids (:) Gene IDs to read character(len=*), intent(in) :: filename Filename to read from integer(kind=int32), intent(out) :: ierr Error code (0 if successful) public  subroutine load_expression_vectors (expression_vectors, filename, ierr) Author Aaron Schröder License MIT Wrapper for deserialize_real_2D function Arguments Type Intent Optional Attributes Name real(kind=real64), intent(out), contiguous :: expression_vectors (:,:) Expression vectors to read character(len=*), intent(in) :: filename Filename to read from integer(kind=int32), intent(out) :: ierr Error code (0 if successful) public  subroutine load_gene_to_family (gene_to_fam, filename, ierr) Author Aaron Schröder License MIT Wrapper for deserialize_int_1D function Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(out), contiguous :: gene_to_fam (:) Gene to family mapping to read character(len=*), intent(in) :: filename Filename to read from integer(kind=int32), intent(out) :: ierr Error code (0 if successful) public  subroutine load_family_ids (family_ids, filename, ierr) Author Aaron Schröder License MIT Wrapper for deserialize_char_1D function Arguments Type Intent Optional Attributes Name character(len=*), intent(out), contiguous :: family_ids (:) Family IDs to read character(len=*), intent(in) :: filename Filename to read from integer(kind=int32), intent(out) :: ierr Error code (0 if successful) public  subroutine load_family_centroids (family_centroids, filename, ierr) Author Aaron Schröder License MIT Wrapper for deserialize_real_2D function Arguments Type Intent Optional Attributes Name real(kind=real64), intent(out), contiguous :: family_centroids (:,:) Family centroids to read character(len=*), intent(in) :: filename Filename to read from integer(kind=int32), intent(out) :: ierr Error code public  subroutine load_shift_vectors (shift_vectors, filename, ierr) Author Aaron Schröder License MIT Wrapper for deserialize_real_2D function Arguments Type Intent Optional Attributes Name real(kind=real64), intent(out), contiguous :: shift_vectors (:,:) Shift vectors to read character(len=*), intent(in) :: filename Filename to read from integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"module/tox_data_read_write.html"},{"title":"f42_config – TensorOmics","text":"Global, mutable runtime configuration flags (module variables, not parameters).\nIntended to be toggled by client code before calling into the library to enable\ndiagnostic print output from the affected modules; both flags default to off. Uses f42_safeguard iso_c_binding Variables Type Visibility Attributes Name Initial logical(kind=c_bool), public :: DEBUG = .false. Toggles debug messages for e.g. tox_data_archive logical(kind=c_bool), public :: debug_hashing = .false. Toggles debug messages for f42_xxh3_hashmap","tags":"","url":"module/f42_config.html"},{"title":"f42_math_impl – TensorOmics","text":"Elementary mathematics: the constants, approximate equality, clamping, angles and logarithms. One of the modules f42_utils_impl gathers; use f42_utils_impl reaches all of them. Uses iso_fortran_env iso_c_binding f42_safeguard ieee_arithmetic tox_errors Variables Type Visibility Attributes Name Initial real(kind=real64), public, parameter :: PI = 4.0_real64*atan(1.0_real64) The mathematical constant . real(kind=real64), public, parameter :: EPS = epsilon(1.0_real64) Machine epsilon for real64 , the base tolerance used by is_close . real(kind=real64), public, parameter :: LOG_2 = log(2.0_real64) Natural logarithm of 2, used to compute base-2 logarithms in logx . Interfaces public        interface clamp Generic clamp of a scalar into [min_val, max_val] , dispatches on the value's type. public pure function clamp_real (val, min_val, max_val) result(clamped) Author Franz-Eric Sill License MIT Clamps a value into a range min_val <= val <= max_val . If max_val < min_val , min_val is returned Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: val Value to be clamped real(kind=real64), intent(in) :: min_val Lower bound real(kind=real64), intent(in) :: max_val Upper bound Return Value real(kind=real64) public pure function clamp_int (val, min_val, max_val) result(clamped) Author Franz-Eric Sill License MIT Clamps a value into a range min_val <= val <= max_val . If max_val < min_val , min_val is returned Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: val Value to be clamped integer(kind=int32), intent(in) :: min_val Lower bound integer(kind=int32), intent(in) :: max_val Upper bound Return Value integer(kind=int32) public        interface is_close Tolerance-based approximate equality for real(real64) .\nCalled as is_close(a, b) with the machine-epsilon tolerance, or as is_close(a, b, eps) where the caller has its own notion of \"the same\" -- a domain\nepsilon such as a smoothing floor, which is coarser than anything the arithmetic\nitself would justify. See is_close_within . public pure function is_close_default (a, b) Author Franz-Eric Sill License MIT Checks if two values are close to eachother, using a tolerance of max(1d-12, EPS*max(abs(a), abs(b))) with EPS=epsilon(1.0_real64) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: a First variable of comparison a==b real(kind=real64), intent(in) :: b Second variable of comparison a==b Return Value logical public pure function is_close_within (a, b, eps) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: a First variable of comparison a==b real(kind=real64), intent(in) :: b Second variable of comparison a==b real(kind=real64), intent(in) :: eps Relative tolerance factor, scaled by the larger operand. Pass a domain epsilon\nto compare on that domain's terms rather than the arithmetic's. Return Value logical public        interface operator(.isclose.) Tolerance-based approximate equality operator for real(real64) ; see is_close_default .\nAn operator takes exactly its two operands, so the custom-tolerance form is reachable\nonly by calling is_close directly. public pure function is_close_default (a, b) Author Franz-Eric Sill License MIT Checks if two values are close to eachother, using a tolerance of max(1d-12, EPS*max(abs(a), abs(b))) with EPS=epsilon(1.0_real64) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: a First variable of comparison a==b real(kind=real64), intent(in) :: b Second variable of comparison a==b Return Value logical Functions public pure function mean (vec) Author Franz-Eric Sill License MIT Calculates the arithmetic mean of vector Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(:) :: vec Vector to compute the mean value from Return Value real(kind=real64) public pure function std_dev (vec, do_bessel_correction) Author Franz-Eric Sill License MIT Calculates the standard deviation of vector, with or without Bessel's correction Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(:) :: vec Vector to compute the standard deviation value from logical(kind=c_bool), intent(in), optional :: do_bessel_correction Tells whether to apply the bessel's correction or not, default: .false. Read more… Return Value real(kind=real64) public pure function clamp_real (val, min_val, max_val) result(clamped) Author Franz-Eric Sill License MIT Clamps a value into a range min_val <= val <= max_val . If max_val < min_val , min_val is returned Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: val Value to be clamped real(kind=real64), intent(in) :: min_val Lower bound real(kind=real64), intent(in) :: max_val Upper bound Return Value real(kind=real64) public pure function clamp_int (val, min_val, max_val) result(clamped) Author Franz-Eric Sill License MIT Clamps a value into a range min_val <= val <= max_val . If max_val < min_val , min_val is returned Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: val Value to be clamped integer(kind=int32), intent(in) :: min_val Lower bound integer(kind=int32), intent(in) :: max_val Upper bound Return Value integer(kind=int32) public pure function below (val) Author Franz-Eric Sill License MIT Returns the next representable float lower than a value. Helpful for exclusive upper bounds in ranges. Doesn't return denormals, thus below(0.0_real64)==-tiny(1.0_real64) and below(tiny(1.0_real64))==0.0_real64 Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: val Return Value real(kind=real64) public pure function above (val) Author Franz-Eric Sill License MIT Returns the next representable float greater than a value. Helpful for exclusive upper bounds in ranges. Doesn't return denormals, thus above(0.0_real64)==tiny(1.0_real64) and above(-tiny(1.0_real64))==0.0_real64 Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: val Return Value real(kind=real64) public pure function is_close_default (a, b) Author Franz-Eric Sill License MIT Checks if two values are close to eachother, using a tolerance of max(1d-12, EPS*max(abs(a), abs(b))) with EPS=epsilon(1.0_real64) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: a First variable of comparison a==b real(kind=real64), intent(in) :: b Second variable of comparison a==b Return Value logical public pure function is_close_within (a, b, eps) Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: a First variable of comparison a==b real(kind=real64), intent(in) :: b Second variable of comparison a==b real(kind=real64), intent(in) :: eps Relative tolerance factor, scaled by the larger operand. Pass a domain epsilon\nto compare on that domain's terms rather than the arithmetic's. Return Value logical public pure function radians (degrees) Author Franz-Eric Sill License MIT Returns the given degrees in positive radian value Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: degrees degrees to be converted Return Value real(kind=real64) public pure function degrees (radians) Author Franz-Eric Sill License MIT Returns the given radians in positive degree value Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: radians radians to be converted Return Value real(kind=real64) public  function next_power_of_two (n) result(power) Author Aaron Schröder License MIT Find the next power of two greater than or equal to n Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n input value Return Value integer(kind=int32) next greater value that is a power of two Subroutines public pure subroutine logx (val, base, exponent, ierr) Author Franz-Eric Sill License MIT Compute logarithm for any base Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: val Value ( x in ) real(kind=real64), intent(in) :: base Base ( b in ) real(kind=real64), intent(out) :: exponent Exponent ( y in ) integer(kind=int32), intent(out) :: ierr Error code public pure subroutine logx_helper (val, base, exponent) Author Franz-Eric Sill License MIT (no input validation) Compute logarithm for any base: log_base(val) = log(val)/log(base) .\nEnsure val > 0 , base > 0 and base /= 1 , yields a NaN/Inf result otherwise. Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: val Value ( x in ), must be > 0 real(kind=real64), intent(in) :: base Base ( b in ), must be > 0 and /= 1 real(kind=real64), intent(out) :: exponent Exponent ( y in )","tags":"","url":"module/f42_math_impl.html"},{"title":"tox_relative_axis_plane_tools – TensorOmics","text":"Relative axis planes (RAPs): planes through higher-dimensional gene expression space, and\nwhat can be read off a vector once it is projected onto one. A RAP is picked by selecting axes (tissues) from the full expression space. vector_RAP_projection projects a single vector onto it and field_RAP_projection a whole\nfield of them. Within the plane, clock_hand_angle_between_vectors measures the signed angle\nbetween two vectors -- signed by an orientation reference, so the sign means the same thing in\nevery dimension -- and clock_hand_angles_for_shift_vectors does that for a whole shift\nvector field at once. relative_axes_changes_from_shift_vector and relative_axes_expression_from_expression_vector give the per-axis breakdown instead of the angle: how much of a change, or of an expression\nlevel, falls on each selected axis. Generated from tox_relative_axis_plane_tools_impl ; do not edit -- regenerate instead. Uses iso_fortran_env iso_c_binding tox_relative_axis_plane_tools_impl f42_safeguard tox_errors Subroutines public pure subroutine omics_vector_RAP_projection (vecs, n_axes, n_vecs, vecs_selection_mask, n_selected_vecs, axes_selection_mask, n_selected_axes, projections, ierr) Validates its inputs, then calls omics_vector_RAP_projection_impl . Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_axes, n_vecs) :: vecs matrix with expression vectors integer(kind=int32), intent(in) :: n_axes number of axes integer(kind=int32), intent(in) :: n_vecs number of vectors per axis logical(kind=c_bool), intent(in), dimension(n_vecs) :: vecs_selection_mask .true. for vectors where projection is to be computed integer(kind=int32), intent(in) :: n_selected_vecs count of .true. values in vecs_selection_mask logical(kind=c_bool), intent(in), dimension(n_axes) :: axes_selection_mask .true. for axes to be included in RAP integer(kind=int32), intent(in) :: n_selected_axes count of .true. values in axes_selection_mask real(kind=real64), intent(out), dimension(n_selected_axes, n_selected_vecs) :: projections projected vectors integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure. public pure subroutine omics_field_RAP_projection (fields, n_axes, n_fields, fields_selection_mask, n_selected_fields, axes_selection_mask, n_selected_axes, projections, ierr) Validates its inputs, then calls omics_field_RAP_projection_impl . Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_axes, 2, n_fields) :: fields matrix with vector fields; each field holds two vectors, the origin first and the target second integer(kind=int32), intent(in) :: n_axes number of axes integer(kind=int32), intent(in) :: n_fields number of vectors per axis logical(kind=c_bool), intent(in), dimension(n_fields) :: fields_selection_mask .true. for vectors where projection is to be computed integer(kind=int32), intent(in) :: n_selected_fields count of .true. values in fields_selection_mask logical(kind=c_bool), intent(in), dimension(n_axes) :: axes_selection_mask .true. for axes to be included in RAP integer(kind=int32), intent(in) :: n_selected_axes count of .true. values in axes_selection_mask real(kind=real64), intent(out), dimension(n_selected_axes, n_selected_fields) :: projections projected vectors integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure. public pure subroutine clock_hand_angle_between_vectors (v1, v2, n_dims, orientation_reference, signed_angle, ierr) Validates its inputs, then calls clock_hand_angle_between_vectors_impl . Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_dims) :: v1 First normalized vector in RAP space real(kind=real64), intent(in), dimension(n_dims) :: v2 Second normalized vector in RAP space integer(kind=int32), intent(in) :: n_dims Dimension of both vectors real(kind=real64), intent(in), dimension(n_dims) :: orientation_reference Orients the plane the rotation happens in, so the angle can carry a sign. A\nrotation from one vector to another has no inherent direction above two\ndimensions -- and in RAP space not even in two, since the axes are tissues or\nfactors and carry no handedness -- so the caller states which way round counts\nas positive. The sign is that of this vector's component along the rotation. real(kind=real64), intent(out) :: signed_angle Signed angle between vectors in radians [-pi, pi] integer(kind=int32), intent(out) :: ierr Error code public pure subroutine clock_hand_angles_for_shift_vectors (fields, n_dims, n_fields, fields_selection_mask, n_selected_fields, orientation_reference, signed_angles, ierr) Validates its inputs, then calls clock_hand_angles_for_shift_vectors_impl . Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_dims, 2, n_fields) :: fields matrix with vector fields; each field holds two vectors, the origin first and the target second integer(kind=int32), intent(in) :: n_dims Dimension of each vector in RAP space integer(kind=int32), intent(in) :: n_fields Number of vector pairs logical(kind=c_bool), intent(in), dimension(n_fields) :: fields_selection_mask .true. for vector pairs where angle should be computed integer(kind=int32), intent(in) :: n_selected_fields Count of .true. values in fields_selection_mask real(kind=real64), intent(in), dimension(n_dims) :: orientation_reference Orients the plane the rotation happens in, so the angle can carry a sign. A\nrotation from one vector to another has no inherent direction above two\ndimensions -- and in RAP space not even in two, since the axes are tissues or\nfactors and carry no handedness -- so the caller states which way round counts\nas positive. The sign is that of this vector's component along the rotation. real(kind=real64), intent(out), dimension(n_selected_fields) :: signed_angles Signed rotation angles between vector pairs in radians [-π, π] integer(kind=int32), intent(out) :: ierr Error code public pure subroutine compute_relative_axis_contributions (vec, n_axes, contributions, ierr) Validates its inputs, then calls compute_relative_axis_contributions_impl . Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_axes) :: vec RAP-projected and normalized vector (expression or shift) integer(kind=int32), intent(in) :: n_axes Number of axes (length of vec and contributions) real(kind=real64), intent(out), dimension(n_axes) :: contributions Fractional contribution of each axis (output), values in [0,1], sum to 1 integer(kind=int32), intent(out) :: ierr Error code public pure subroutine relative_axes_changes_from_shift_vector (vec, n_axes, contributions, ierr) Validates its inputs, then calls relative_axes_changes_from_shift_vector_impl . Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_axes) :: vec RAP-projected and normalized shift vector integer(kind=int32), intent(in) :: n_axes Number of axes real(kind=real64), intent(out), dimension(n_axes) :: contributions Fractional contribution of each axis (output), values in [0,1], sum to 1 integer(kind=int32), intent(out) :: ierr Error code public pure subroutine relative_axes_expression_from_expression_vector (vec, n_axes, contributions, ierr) Validates its inputs, then calls relative_axes_expression_from_expression_vector_impl . Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_axes) :: vec RAP-projected and normalized expression vector integer(kind=int32), intent(in) :: n_axes Number of axes real(kind=real64), intent(out), dimension(n_axes) :: contributions Fractional contribution of each axis (output), values in [0,1], sum to 1 integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"module/tox_relative_axis_plane_tools.html"},{"title":"tox_paralog_analysis_impl_c – TensorOmics","text":"Paralog-subset expression patterns -- dosage effect and subfunctionalization -- relative to an ancestral ortholog. Candidate paralog subsets are enumerated as bitmask-encoded gene sets, built up one gene at a time\nstarting from single genes. At every extension step the candidate is scored against the pattern-specific\ncriterion (small angle plus magnitude gain for dosage effect, or bounded residual distance for\nsubfunctionalization); subsets that can no longer satisfy the criterion are pruned instead of being\nextended further, which keeps the combinatorial subset search tractable. There is a routine per pattern rather than one taking a pattern flag: detect_dosage_effect and detect_subfunctionalization find the subsets, and filter_paralogs_by_pattern_dosage_effect / _subfunctionalization reduce a set of genes to\nthose matching. Which criterion a result was scored against is therefore visible at the call\nsite, and each routine takes only the thresholds its own pattern needs. Uses f42_safeguard iso_c_binding tox_errors Subroutines public  subroutine mask_check_state_c (bit_mask, n_bit_mask_elements, i_gene, state, ierr) bind(C, name=\"mask_check_state_c\") C-wrapper for mask_check_state Read more… Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), dimension(n_bit_mask_elements), target :: bit_mask chunked mask to mark active paralogs integer(kind=c_int), intent(in), target :: n_bit_mask_elements number of elements in bit_mask integer(kind=c_int), intent(in), target :: i_gene index of paralog to be marked active logical(kind=c_bool), intent(out), target :: state check result integer(kind=c_int), intent(out), target :: ierr Error code public  subroutine mask_chunk_count_c (n_genes, count, ierr) bind(C, name=\"mask_chunk_count_c\") C-wrapper for mask_chunk_count Read more… Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_genes number of genes integer(kind=c_int), intent(out), target :: count number of 32 bit chunks a mask needs to encode n_genes genes Read more… integer(kind=c_int), intent(out), target :: ierr Error code public  subroutine calc_work_arr_paralog_subsets_size_c (max_subset_size, n_genes, work_array_size, filtered_paralogs_mask, n_mask_chunks, ierr) bind(C, name=\"calc_work_arr_paralog_subsets_size_c\") C-wrapper for calc_work_arr_paralog_subsets_size Read more… Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(inout), target :: max_subset_size maximum size that a subset must not exceed. Zero is in range and means there is\nnothing to size a work array for, which is reported back as a size of zero.\nThe minimum valid value is 0_int32 . Read more… integer(kind=c_int), intent(in), target :: n_genes number of genes integer(kind=c_int), intent(out), target :: work_array_size The calculated needed work array size in absolute worst case scenario. Look into source for details. integer(kind=c_int), intent(in), dimension(n_mask_chunks), target :: filtered_paralogs_mask Output mask with all genes disabled that did not pass the filter integer(kind=c_int), intent(in), target :: n_mask_chunks number of 32 bit chunks a mask needs to encode n_genes genes integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"module/tox_paralog_analysis_impl_c.html"},{"title":"f42_serde_arrays_deserialize_logical – TensorOmics","text":"Module for deserializing logical arrays from files Uses iso_fortran_env iso_c_binding f42_serde_arrays_utils f42_safeguard tox_errors Subroutines public  subroutine deserialize_logical_helper (arr, n_elements, arr_shape, filename, ierr) Author Aaron Schröder License MIT Category C-binding Deserialize a flat logical array from a file Read more… Arguments Type Intent Optional Attributes Name logical(kind=c_bool), intent(out), dimension(n_elements) :: arr Pre-allocated array to read the data into integer(kind=int32), intent(in) :: n_elements Size of arr integer(kind=int32), intent(in), dimension(:) :: arr_shape Extents of arr , one per dimension\nIt is VERY IMPORTANT to compute this argument from the dims_out output produced by get_array_metadata . Read more… character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code public  subroutine deserialize_logical_1d (arr, filename, ierr) Author Aaron Schröder License MIT Directly deserialize a 1D logical array from a file Arguments Type Intent Optional Attributes Name logical(kind=c_bool), intent(out), dimension(:), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code public  subroutine deserialize_logical_2d (arr, filename, ierr) Author Aaron Schröder License MIT Directly deserialize a 2D logical array from a file Arguments Type Intent Optional Attributes Name logical(kind=c_bool), intent(out), dimension(:, :), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code public  subroutine deserialize_logical_3d (arr, filename, ierr) Author Aaron Schröder License MIT Directly deserialize a 3D logical array from a file Arguments Type Intent Optional Attributes Name logical(kind=c_bool), intent(out), dimension(:, :, :), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code public  subroutine deserialize_logical_4d (arr, filename, ierr) Author Aaron Schröder License MIT Directly deserialize a 4D logical array from a file Arguments Type Intent Optional Attributes Name logical(kind=c_bool), intent(out), dimension(:, :, :, :), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code public  subroutine deserialize_logical_5d (arr, filename, ierr) Author Aaron Schröder License MIT Directly deserialize a 5D logical array from a file Arguments Type Intent Optional Attributes Name logical(kind=c_bool), intent(out), dimension(:, :, :, :, :), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"module/f42_serde_arrays_deserialize_logical.html"},{"title":"f42_serde_arrays_deserialize_complex_c – TensorOmics","text":"Module for deserializing complex arrays from files Uses f42_safeguard iso_c_binding tox_errors Subroutines public  subroutine deserialize_complex_helper_c (arr, n_elements, arr_shape, n_arr_shape_elements, filename, filename_strlen, ierr) bind(C, name=\"deserialize_complex_helper_c\") C-wrapper for deserialize_complex_helper Read more… Arguments Type Intent Optional Attributes Name complex(kind=c_double_complex), intent(out), dimension(*), target :: arr Pre-allocated array to read the data into integer(kind=c_int), intent(in), target :: n_elements Size of arr integer(kind=c_int), intent(in), dimension(n_arr_shape_elements), target :: arr_shape Extents of arr , one per dimension\nIt is VERY IMPORTANT to compute this argument from the dims_out output produced by get_array_metadata . Read more… integer(kind=c_int), intent(in), target :: n_arr_shape_elements number of elements in arr_shape character(kind=c_char, len=1), intent(in), dimension(filename_strlen), target :: filename Name of the file integer(kind=c_int), intent(in), target :: filename_strlen length of the strings in filename integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"module/f42_serde_arrays_deserialize_complex_c.html"},{"title":"tox_normalization_c – TensorOmics","text":"Normalization of expression data: putting samples on a comparable scale before anything\ndistance-based is computed from them. Several schemes, each its own entry point rather than a mode: a log2 transformation, scaling\nby standard deviation (LOESS-smoothed against expression level, so the correction follows the\nmean-variance trend rather than assuming one), root-mean-square scaling, quantile\nnormalization, and normalization to unit length. normalization_pipeline chains them in the order the analysis expects, and is what most\ncallers want. The individual routines are published for a caller assembling their own. Uses f42_safeguard iso_c_binding tox_errors Subroutines public  subroutine normalize_unit_length_c (vector, n_dims, ierr) bind(C, name=\"normalize_unit_length_c\") C-wrapper for normalize_unit_length Read more… Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(inout), dimension(n_dims), target :: vector Vector that will be normalized to unit length\nNaN is permitted for this value.\nInfinite values are permitted for this value. integer(kind=c_int), intent(in), target :: n_dims number of elements in vector integer(kind=c_int), intent(out), target :: ierr Error code public  subroutine normalization_pipeline_c (n_genes, n_replicates, expr, log_transformed_expr, reps_per_tissue, n_tissues, span, degree, use_quantile, ierr) bind(C, name=\"normalization_pipeline_c\") C-wrapper for normalization_pipeline Read more… Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_genes Number of genes (rows) integer(kind=c_int), intent(in), target :: n_replicates Number of replicates per gene real(kind=c_double), intent(in), dimension(n_replicates, n_genes), target :: expr Gene Expression matrix\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=c_double), intent(out), dimension(n_tissues, n_genes), target :: log_transformed_expr Log-transformed grouped expr integer(kind=c_int), intent(in), dimension(n_tissues), target :: reps_per_tissue Number of replicates per tissue in expr . It describes, which slices in expr relate to which tissue,\ne.g. [2,3] means 5 total replicates per gene, the first two of which belong to the first tissue and the remaining three to the second. integer(kind=c_int), intent(in), target :: n_tissues Number of tissues real(kind=c_double), intent(in), target :: span LOESS span parameter.\nThe default value is 0.7_real64 . integer(kind=c_int), intent(in), target :: degree LOESS degree parameter.\nThe default value is 2_int32 . logical(kind=c_bool), intent(in), target :: use_quantile Use quantile normalization.\nThe default value is .false. . integer(kind=c_int), intent(out), target :: ierr Error code public  subroutine normalization_pipeline_expert_c (n_genes, n_replicates, expr, log_transformed_expr, reps_per_tissue, n_tissues, tmp_expr_copy, tmp_loess_y, tmp_indices_used, tmp_yhat_global, tmp_int_workspace, int_workspace_size, tmp_real_workspace, real_workspace_size, tmp_hat_diag, tmp_loess_weights, tmp_eval_points, tmp_robust_weights, tmp_combined_weights, tmp_residuals, tmp_permutation_indices, span, degree, use_quantile, ierr) bind(C, name=\"normalization_pipeline_expert_c\") C-wrapper for normalization_pipeline_expert Read more… Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_genes Number of genes (rows) integer(kind=c_int), intent(in), target :: n_replicates Number of replicates per gene real(kind=c_double), intent(in), dimension(n_replicates, n_genes), 