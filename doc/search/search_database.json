= 1 , num_cols_in DO i = 1 , num_rows DO k = 1 , MAX_FIELD_LEN char_idx = ( i - 1 ) * num_cols_in * MAX_FIELD_LEN + ( j - 1 ) * MAX_FIELD_LEN + k IF ( data_in_ascii ( char_idx ) == 0 ) EXIT data_in_fortran ( i , j )( k : k ) = CHAR ( data_in_ascii ( char_idx )) END DO END DO END DO ALLOCATE ( cols_to_read_fortran ( num_cols_to_read )) cols_to_read_fortran = cols_to_read ( 1 : num_cols_to_read ) ! --- 2. Call the core Fortran subroutine --- CALL read_real_columns ( data_in_fortran , cols_to_read_fortran , real_data_out_fortran , fortran_status ) status = fortran_status ! --- 3. Copy the Fortran result back to the C output buffer --- IF ( ALLOCATED ( real_data_out_fortran )) THEN DO j = 1 , num_cols_to_read DO i = 1 , num_rows char_idx = ( i - 1 ) * num_cols_to_read + j real_data_out ( char_idx ) = real_data_out_fortran ( i , j ) END DO END DO END IF ! --- 4. Cleanup --- DEALLOCATE ( data_in_fortran , cols_to_read_fortran ) IF ( ALLOCATED ( real_data_out_fortran )) DEALLOCATE ( real_data_out_fortran ) END SUBROUTINE read_real_columns_c !> @brief R interface for reading real columns. SUBROUTINE read_real_columns_r ( data_in_ascii , num_rows , num_cols_in , & cols_to_read , num_cols_to_read , & real_data_out , status ) USE , INTRINSIC :: iso_fortran_env , ONLY : INT32 , REAL64 USE csv_read_real_module , ONLY : read_real_columns USE csv_parser_module , ONLY : MAX_FIELD_LEN IMPLICIT NONE ! --- R Interoperable Arguments --- INTEGER ( INT32 ), INTENT ( IN ) :: data_in_ascii ( MAX_FIELD_LEN , num_rows , num_cols_in ) INTEGER ( INT32 ), INTENT ( IN ) :: num_rows , num_cols_in , num_cols_to_read INTEGER ( INT32 ), INTENT ( IN ) :: cols_to_read ( num_cols_to_read ) REAL ( REAL64 ), INTENT ( OUT ) :: real_data_out ( num_rows , num_cols_to_read ) INTEGER ( INT32 ), INTENT ( OUT ) :: status ! --- Fortran Local Variables --- CHARACTER ( LEN = MAX_FIELD_LEN ), ALLOCATABLE :: data_in_fortran (:,:) REAL ( REAL64 ), ALLOCATABLE :: real_data_out_fortran (:,:) INTEGER :: i , j , k ! --- 