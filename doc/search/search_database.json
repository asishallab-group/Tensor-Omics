f an observed contribution can\nbe assessed via a permutation test that recomputes the same contribution against a randomly chosen\nother sample. Generated from tox_trajectory_contribution_analysis_impl ; do not edit -- regenerate instead. Uses iso_fortran_env tox_trajectory_contribution_analysis_impl tox_errors Subroutines public  subroutine perform_permutation_test (trajectories, n_factors, n_samples, n_timepoints, factor_idx, dependent_idx, sample_idx, baseline_mode, n_permutations, local_contributions, total_contributions, random_seed, ierr) Validates its inputs, prepares what perform_permutation_test_impl needs, then calls it. The entry point to reach for first; see perform_permutation_test_expert to prepare it yourself. Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_factors, n_samples, n_timepoints) :: trajectories expression vectors across different samples over time integer(kind=int32), intent(in) :: n_factors number of factors integer(kind=int32), intent(in) :: n_samples number of samples integer(kind=int32), intent(in) :: n_timepoints number of timepoints integer(kind=int32), intent(in) :: factor_idx index of factor to compute the permutation contributions for\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_factors . integer(kind=int32), intent(in) :: dependent_idx index of dependent to compute the permutation contributions for\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_factors . integer(kind=int32), intent(in) :: sample_idx index of sample to compute the permutation contributions for\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_samples . integer(kind=int32), intent(in) :: baseline_mode Read more… integer(kind=int32), intent(in) :: n_permutations number of permutations to perform real(kind=real64), intent(out), dimension(n_timepoints, n_permutations) :: local_contributions Per-timepoint contributions per permutation real(kind=real64), intent(out), dimension(n_permutations) :: total_contributions Total contribution ( sum(local_contributions) ) per permutation integer(kind=int32), intent(in), optional :: random_seed Seed to use for random number generation. integer(kind=int32), intent(out) :: ierr Error code public  subroutine perform_permutation_test_expert (trajectories, n_factors, n_samples, n_timepoints, factor_idx, dependent_idx, sample_idx, baseline_mode, n_permutations, local_contributions, total_contributions, tmp_factor, tmp_dependent, random_seed, ierr) Validates its inputs, then calls perform_permutation_test_impl with what you supply. The expert entry point: it allocates nothing and prepares nothing; perform_permutation_test does both. Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_factors, n_samples, n_timepoints) :: trajectories expression vectors across different samples over time integer(kind=int32), intent(in) :: n_factors number of factors integer(kind=int32), intent(in) :: n_samples number of samples integer(kind=int32), intent(in) :: n_timepoints number of timepoints integer(kind=int32), intent(in) :: factor_idx index of factor to compute the permutation contributions for\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_factors . integer(kind=int32), intent(in) :: dependent_idx index of dependent to compute the permutation contributions for\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_factors . integer(kind=int32), intent(in) :: sample_idx index of sample to compute the permutation contributions for\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_samples . integer(kind=int32), intent(in) :: baseline_mode Read more… integer(kind=int32), intent(in) :: n_permutations number of permutations to perform real(kind=real64), intent(out), dimension(n_timepoints, n_permutations) :: local_contributions Per-timepoint contributions per permutation real(kind=real64), intent(out), 