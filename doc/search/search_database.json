e public  subroutine get_zip_entry_name (zip_handle, entry_index, entry_name) Author Aaron Schröder License MIT Helper function to get the name of a ZIP entry entry_name is a view into libzip's own memory , not a copy: it is valid only while zip_handle is open, and must not be kept past zip_close . The one caller uses it\ninside the loop that reads the archive, which is exactly that window. Arguments Type Intent Optional Attributes Name type(c_ptr), intent(in) :: zip_handle Zip file connection integer(kind=c_int64_t), intent(in) :: entry_index Index of the entry character(len=:), intent(out), pointer :: entry_name Name of the entry, ending at libzip's NUL. Unassociated if the entry has no name. public  subroutine extract_file_from_zip (zip_handle, filename, ierr) Author Aaron Schröder License MIT Extracts a single named entry from an open ZIP archive to a file of the same name on disk,\nstreaming it through a fixed-size buffer rather than reading it into memory whole. Arguments Type Intent Optional Attributes Name type(c_ptr), intent(in) :: zip_handle Zip connection character(len=*), intent(in) :: filename Name of the file to extract integer(kind=int32), intent(out) :: ierr Error code public  subroutine add_data_to_zip (zip_handle, filename, data_source, data_type, ierr) Author Aaron Schröder License MIT Adds one entry to an open ZIP archive, sourced either from a file on disk\n( data_type=DATA_TYPE_FILE , data_source is a path) or from an in-memory string\n( data_type=DATA_TYPE_STRING , data_source is the literal content). Arguments Type Intent Optional Attributes Name type(c_ptr), intent(in) :: zip_handle Zip connection character(len=*), intent(in) :: filename Filename to add character(len=*), intent(in) :: data_source File path or string content integer(kind=int32), intent(in) :: data_type Type of input integer(kind=int32), intent(out) :: ierr Error code public  subroutine write_manifest (keys, filenames, manifest_filename, ierr) Author Aaron Schröder License MIT