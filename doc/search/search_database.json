(0_int32, n_timepoints - 1), n_factors, n_samples) :: velocity output velocity trajectories integer(kind=int32), intent(in) :: n_factors number of factors integer(kind=int32), intent(in) :: n_samples number of samples integer(kind=int32), intent(in) :: n_timepoints number of timepoints integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure. public pure subroutine compute_acceleration_from_velocity (velocity, acceleration, n_factors, n_samples, n_timepoints, ierr) Validates its inputs, then calls compute_acceleration_from_velocity_impl . Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(max(0_int32, n_timepoints - 1), n_factors, n_samples) :: velocity input velocity trajectories real(kind=real64), intent(out), dimension(max(0_int32, n_timepoints - 2), n_factors, n_samples) :: acceleration output acceleration trajectories integer(kind=int32), intent(in) :: n_factors number of factors integer(kind=int32), intent(in) :: n_samples number of samples integer(kind=int32), intent(in) :: n_timepoints number of timepoints integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure. public pure subroutine compute_velocity_acceleration_contributions (trajectories, n_factors, n_samples, n_timepoints, baseline_mode, contrib_velocity, velocity_contribution_series, contrib_acceleration, acceleration_contribution_series, ierr) Validates its inputs, prepares what compute_velocity_acceleration_contributions_impl needs, then calls it. The entry point to reach for first; see compute_velocity_acceleration_contributions_expert to prepare it yourself. Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_factors, n_samples, n_timepoints) :: trajectories input position trajectories integer(kind=int32), intent(in) :: n_factors number of factors integer(kind=int32), intent(in) :: n_samples number of samples integer(kind=int32), intent(in) :: n_timepoints number of timepoints integer(kind=int32), intent(in) :: baseline_mode Read more… real(kind=real64), intent(out), dimension(n_factors, n_factors, n_samples) :: contrib_velocity output velocity contributions real(kind=real64), intent(out), dimension(n_timepoints, n_factors, n_factors, n_samples) :: velocity_contribution_series output velocity contribution series real(kind=real64), intent(out), dimension(n_factors, n_factors, n_samples) :: contrib_acceleration output acceleration contributions real(kind=real64), intent(out), dimension(n_timepoints, n_factors, n_factors, n_samples) :: acceleration_contribution_series output acceleration contribution series integer(kind=int32), intent(out) :: ierr Error code public pure subroutine compute_velocity_acceleration_contributions_expert (trajectories, n_factors, n_samples, n_timepoints, baseline_mode, tmp_factors, tmp_dependent, tmp_contributions, contrib_velocity, velocity_contribution_series, contrib_acceleration, acceleration_contribution_series, ierr) Validates its inputs, then calls compute_velocity_acceleration_contributions_impl with what you supply. The expert entry point: it allocates nothing and prepares nothing; compute_velocity_acceleration_contributions does both. Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_factors, n_samples, n_timepoints) :: trajectories input position trajectories integer(kind=int32), intent(in) :: n_factors number of factors integer(kind=int32), intent(in) :: n_samples number of samples integer(kind=int32), intent(in) :: n_timepoints number of timepoints integer(kind=int32), intent(in) :: baseline_mode Read more… real(kind=real64), intent(out), dimension(n_timepoints - 1, n_factors) :: tmp_factors workspace for factor data (used for velocity and acceleration) real(kind=real64), intent(out), dimension(n_timepoints - 1) :: tmp_dependent workspace for dependent data (used for velocity and acceleration) real(kind=real64), intent(out), dimension(n_timepoints - 1) :: tmp_contributions workspace for contribution calculations (used for velocity and acceleration) real(kind=real64), intent(out), dimension(n_factors, n_factors, n_samples) :: contrib_velocity output velocity contributions real(kind=real64), intent(out), dimension(n_timepoints, n_factors, n_factors, n_samples) :: velocity_contribution_series output velocity contribution series real(kind=real64), intent(out), dimension(n_factors, n_factors, n_samples) :: contrib_acceleration output acceleration contributions real(kind=real64), intent(out), dimension(n_timepoints, n_factors, n_factors, n_samples) :: acceleration_contribution_series output acceleration contribution series integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"module/tox_trajectory_contribution_analysis.html"},{"title":"tox_data_integration_jsd_impl – TensorOmics","text":"Jensen-Shannon-Divergence (JSD) Compatibility Test (gJCT) JSD Calculation The step that turns neighborhood residuals -- as produced by the preprocessing module -- into\na JSD value: residuals are binned into histograms per study, the two distributions are\ncompared per reference point, and the per-point divergences are weighted into one global\nfigure for the pair of studies. Uses iso_fortran_env f42_stats_impl iso_c_binding f42_math_impl f42_safeguard f42_sort_impl ieee_arithmetic Subroutines public pure subroutine determine_shared_residual_range_impl (abs_residual_pool, abs_residual_pool_perm, pool_size, shared_residual_range, residual_range_quantile) Author Franz-Eric Sill License MIT Compute the shared residual range [-R, R] from a pooled set of absolute residuals Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(pool_size) :: abs_residual_pool The absolute residual values of the concatenated S1,S2 residuals\nNaN is permitted for this value. integer(kind=int32), intent(in), dimension(pool_size) :: abs_residual_pool_perm The permutation vector that sorts abs_residual_pool The minimum valid value is 1_int32 .\nThe maximum valid value is pool_size . integer(kind=int32), intent(in) :: pool_size Size of pool of residuals abs_residual_pool , usually (n_reps_S1 + n_reps_2)*n_neighbors*n_points real(kind=real64), intent(out) :: shared_residual_range Computed residual range (R) real(kind=real64), intent(in), optional :: residual_range_quantile Quantile in [0,1] for determining the residual range\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 .\nThe default value is 0.95 . public pure subroutine determine_study_shared_residual_range_impl (neighborhood_residuals_S1, neighborhood_residuals_S2, n_reps_S1, n_reps_S2, n_neighbors, n_points, tmp_abs_residual_pool, tmp_abs_residual_pool_perm, shared_residual_range, residual_range_quantile) Author Franz-Eric Sill License MIT Compute the shared residual range [-R, R] from the neighborhood residuals of two studies Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_reps_S1, n_neighbors, n_points) :: neighborhood_residuals_S1 Computed neighborhood residuals for study 1, NaN is explicitly allowed for missing values\nNaN is permitted for this value. real(kind=real64), intent(in), dimension(n_reps_S2, n_neighbors, n_points) :: neighborhood_residuals_S2 Computed neighborhood residuals for study 2, NaN is explicitly allowed for missing values\nNaN is permitted for this value. integer(kind=int32), intent(in) :: n_reps_S1 Number of replicates in study 1 integer(kind=int32), intent(in) :: n_reps_S2 Number of replicates in study 2 integer(kind=int32), intent(in) :: n_neighbors Number of neighbors in the studies integer(kind=int32), intent(in) :: n_points Number of reference points in the studies real(kind=real64), intent(out), dimension((n_reps_S1 + n_reps_S2)*n_neighbors*n_points) :: tmp_abs_residual_pool Work array holding the pooled absolute residuals of both studies integer(kind=int32), intent(out), dimension((n_reps_S1 + n_reps_S2)*n_neighbors*n_points) :: tmp_abs_residual_pool_perm Work array for the permutation that sorts tmp_abs_residual_pool real(kind=real64), intent(out) :: shared_residual_range Computed residual range (R) real(kind=real64), intent(in), optional :: residual_range_quantile Quantile in [0,1] for determining the residual range\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 .\nThe default value is 0.95 . public pure subroutine build_residual_histograms_impl (neighborhood_residuals, n_reps, n_neighbors, n_points, shared_residual_range, n_bins, counts, pmf, included_n_reps, neighbor_mask) Author Franz-Eric Sill License MIT Summarize the neighborhood residuals in absolute histogram counts and probability mass functions Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_reps, n_neighbors, n_points) :: neighborhood_residuals Computed neighborhood residuals for a study, NaN is explicitly allowed for missing values\nNaN is permitted for this value. integer(kind=int32), intent(in) :: n_reps Number of replicates of the study integer(kind=int32), intent(in) :: n_neighbors Number of reference points (k) integer(kind=int32), intent(in) :: n_points Number of reference points in the study real(kind=real64), intent(in) :: shared_residual_range Computed residual range (R)\nThe minimum valid value is 0.0_real64 . integer(kind=int32), intent(in) :: n_bins Number of equally sized histogram bins in range [-R,R] integer(kind=int32), intent(out), dimension(n_points, n_bins) :: counts Absolute counts of a residual per bin real(kind=real64), intent(out), dimension(n_points, n_bins) :: pmf counts normalized to 0 <= counts(:, i) <= 1 and sum(counts(:, i)) == 1 integer(kind=int32), intent(out), dimension(n_points) :: included_n_reps Stores the count of non-NaN replicates (included ones) logical(kind=c_bool), intent(in), optional, dimension(n_neighbors, n_points) :: neighbor_mask Optional mask to exclude specific neighbors (e.g. for family-wise analysis) public pure subroutine compute_divergence_per_reference_point_impl (pmf_S1, pmf_S2, n_points, n_bins, js_divergences) Author Franz-Eric Sill License MIT Compute the Jensen-Shannon divergence per reference point from two histograms Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_points, n_bins) :: pmf_S1 Computed normalized histogram counts for study 1\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 . real(kind=real64), intent(in), dimension(n_points, n_bins) :: pmf_S2 Computed normalized histogram counts for study 2\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 . integer(kind=int32), intent(in) :: n_points Number of reference points (k) integer(kind=int32), intent(in) :: n_bins Number of equally sized histogram bins in range [-R,R] real(kind=real64), intent(out), dimension(n_points) :: js_divergences Jensen-Shannon divergence per reference point public pure subroutine compute_weighted_global_divergence_impl (js_divergences, n_points, included_n_reps_S1, included_n_reps_S2, global_js_divergence, weights) Author Franz-Eric Sill License MIT Compute the global weighted Jensen-Shannon divergence from the per-neighbor divergences Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_points) :: js_divergences Jensen-Shannon divergence per reference point, computed for studies S1 and S2\nThe minimum valid value is 0.0_real64 . integer(kind=int32), intent(in) :: n_points Number of reference points (k) integer(kind=int32), intent(in), dimension(n_points) :: included_n_reps_S1 Count of non-NaN residuals (included ones) in study 1\nThe minimum valid value is 0_int32 . integer(kind=int32), intent(in), dimension(n_points) :: included_n_reps_S2 Count of non-NaN residuals (included ones) in study 2\nThe minimum valid value is 0_int32 . real(kind=real64), intent(out) :: global_js_divergence Weighted global Jensen-Shannon divergence real(kind=real64), intent(out), dimension(n_points) :: weights Weights used for calculating the global weighted Jensen-Shannon divergence global_js_divergence public pure subroutine jct_compute_jsd_pipeline_helper (neighborhood_residuals_S1, neighborhood_residuals_S2, n_reps_S1, n_reps_S2, n_neighbors, n_points, n_bins, shared_residual_range, js_divergences, included_n_reps_S1, included_n_reps_S2, global_js_divergence, weights, pmf_S1, pmf_S2, tmp_counts, neighbor_mask_S1, neighbor_mask_S2) Author Franz-Eric Sill License MIT Run the pipeline build_residual_histograms => compute_weighted_global_divergence Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_reps_S1, n_neighbors, n_points) :: neighborhood_residuals_S1 Computed neighborhood residuals for study 1, NaN is explicitly allowed for missing values real(kind=real64), intent(in), dimension(n_reps_S2, n_neighbors, n_points) :: neighborhood_residuals_S2 Computed neighborhood residuals for study 2, NaN is explicitly allowed for missing values integer(kind=int32), intent(in) :: n_reps_S1 Number of replicates in study 1 integer(kind=int32), intent(in) :: n_reps_S2 Number of replicates in study 2 integer(kind=int32), intent(in) :: n_neighbors Number of neighbors in the studies integer(kind=int32), intent(in) :: n_points Number of reference points in the studies integer(kind=int32), intent(in) :: n_bins Number of equally sized histogram bins used for the studies real(kind=real64), intent(in) :: shared_residual_range Computed residual range for both studies real(kind=real64), intent(out), dimension(n_points) :: js_divergences Jensen-Shannon divergence per reference point, computed for studies S1 and S2 integer(kind=int32), intent(out), dimension(n_points) :: included_n_reps_S1 Count of non-NaN residuals (included ones) in study 1 integer(kind=int32), intent(out), dimension(n_points) :: included_n_reps_S2 Count of non-NaN residuals (included ones) in study 2 real(kind=real64), intent(out) :: global_js_divergence Weighted global Jensen-Shannon divergence real(kind=real64), intent(out), dimension(n_points) :: weights Weights used for calculating the global weighted Jensen-Shannon divergence global_js_divergence real(kind=real64), intent(out), dimension(n_points, n_bins) :: pmf_S1 Normalized histogram counts for study 1 real(kind=real64), intent(out), dimension(n_points, n_bins) :: pmf_S2 Normalized histogram counts for study 2 integer(kind=int32), intent(out), dimension(n_points, n_bins) :: tmp_counts Working array for the histogram counts logical(kind=c_bool), intent(in), optional, dimension(n_neighbors, n_points) :: neighbor_mask_S1 Optional mask to exclude specific neighbors from study 1 (e.g. for family-wise analysis) logical(kind=c_bool), intent(in), optional, dimension(n_neighbors, n_points) :: neighbor_mask_S2 Optional mask to exclude specific neighbors from study 2 (e.g. for family-wise analysis)","tags":"","url":"module/tox_data_integration_jsd_impl.html"},{"title":"tox_gene_centroids_c – TensorOmics","text":"Expression centroids of gene families. mean_vector is the centroid of a set of expression vectors. group_centroid_orthologs and group_centroid_all take the centroid of a family: over its orthologs only, or over\nevery gene in it -- two routines rather than one taking a flag, so which set a result is\nover is visible at the call site. Uses f42_safeguard iso_c_binding tox_errors Subroutines public  subroutine mean_vector_c (expression_vectors, n_axes, n_genes, gene_indices, n_selected_genes, centroid, ierr) bind(C, name=\"mean_vector_c\") C-wrapper for mean_vector Read more… Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_axes, n_genes), target :: expression_vectors The input matrix of all gene expression vectors (n_axes x n_genes). integer(kind=c_int), intent(in), target :: n_axes Number of axes (tissues/dimensions). integer(kind=c_int), intent(in), target :: n_genes Total number of genes in the input matrix. integer(kind=c_int), intent(in), dimension(n_selected_genes), target :: gene_indices An array containing the column indices of the selected genes in 'expression_vectors'.\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_genes . integer(kind=c_int), intent(in), target :: n_selected_genes The number of genes in the current family to be averaged.\nThe minimum valid value is 0_int32 .\nThe maximum valid value is n_genes . real(kind=c_double), intent(out), dimension(n_axes), target :: centroid The output vector representing the computed centroid. integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure. public  subroutine group_centroid_orthologs_c (expression_vectors, n_axes, n_genes, gene_to_family, n_families, centroid_matrix, ortholog_set, ierr) bind(C, name=\"group_centroid_orthologs_c\") C-wrapper for group_centroid_orthologs Read more… Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(n_axes, n_genes), target :: expression_vectors The input matrix of all gene expression vectors (n_axes x n_genes). integer(kind=c_int), intent(in), target :: n_axes Number of axes (tissues/dimensions). integer(kind=c_int), intent(in), target :: n_genes Total number of genes in the 'expression_vectors' matrix. integer(kind=c_int), intent(in), dimension(n_genes), target :: gene_to_family Index mapping -> each index i holds the family index for the corresponding gene in expression_vectors , using 0_int32 for unassigned genes\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_families .\nThe value 0_int32 is additionally accepted. integer(kind=c_int), intent(in), target :: n_families Total number of gene families to compute centroids for. real(kind=c_double), intent(out), dimension(n_axes, n_families), target :: centroid_matrix The output matrix 