eger(kind=c_int), intent(in), dimension(n_genes), target :: gene_to_family Index mapping -> each index i holds the family index for the corresponding gene in expression_vectors , using 0_int32 for unassigned genes\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_families .\nThe value 0_int32 is additionally accepted. integer(kind=c_int), intent(in), target :: n_families Total number of gene families to compute centroids for. real(kind=c_double), intent(out), dimension(n_axes, n_families), target :: centroid_matrix The output matrix (n_axes x n_families) to store the computed centroids. integer(kind=c_int), intent(out), dimension(n_genes), target :: tmp_group_indices Work array for storing the indices of one family's genes. integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"module/tox_gene_centroids_c.html"},{"title":"f42_serde_arrays_serialize_logical_c – TensorOmics","text":"Module for serializing logical arrays into files Uses f42_safeguard iso_c_binding tox_errors Subroutines public  subroutine serialize_logical_helper_c (arr, n_elements, arr_shape, n_arr_shape_elements, filename, filename_strlen, ierr) bind(C, name=\"serialize_logical_helper_c\") C-wrapper for serialize_logical_helper Read more… Arguments Type Intent Optional Attributes Name logical(kind=c_bool), intent(in), dimension(*), target :: arr Array to be serialized integer(kind=c_int), intent(in), target :: n_elements Number of strings in arr integer(kind=c_int), intent(in), dimension(n_arr_shape_elements), target :: arr_shape Extents of arr , one per dimension integer(kind=c_int), intent(in), target :: n_arr_shape_elements number of elements in arr_shape character(kind=c_char, len=1), intent(in), dimension(filename_strlen), target :: filename Name of the file to write to integer(kind=c_int), intent(in), target :: filename_strlen length of the strings in filename integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"module/f42_serde_arrays_serialize_logical_c.html"},{"title":"tox_data_integration_stats – TensorOmics","text":"Jensen-Shannon-Divergence (JSD) Compatibility Test (gJCT) Permutation Test A permutation test estimating an empirical p-value for the weighted global JSD. Under the null\nhypothesis that both studies are exchangeable, S1/S2 residuals are repeatedly shuffled within\neach reference point's pooled neighborhood and the JSD is recomputed, giving a null\ndistribution against which the observed value is compared. Work copies are shuffled, never the caller's arrays. Generated from tox_data_integration_stats_impl ; do not edit -- regenerate instead. Uses iso_fortran_env iso_c_binding f42_safeguard tox_errors tox_data_integration_stats_impl Subroutines public  subroutine gjct_permutation_test (neighborhood_residuals_S1, neighborhood_residuals_S2, n_reps_S1, n_reps_S2, n_neighbors, n_points, global_jsd_observed, n_bins, shared_residual_range, n_permutations, jsd_null, p_value, random_seed, neighbor_mask_S1, neighbor_mask_S2, ierr) Validates its inputs, prepares what gjct_permutation_test_impl needs, then calls it. The entry point to reach for first; see gjct_permutation_test_expert to prepare it yourself. Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_reps_S1, n_neighbors, n_points) :: neighborhood_residuals_S1 Computed neighborhood residuals for study 1, NaN is explicitly allowed for missing values\nNaN is permitted for this value. real(kind=real64), intent(in), dimension(n_reps_S2, n_neighbors, n_points) :: neighborhood_residuals_S2 Computed neighborhood residuals for study 2, NaN is explicitly allowed for missing values\nNaN is permitted for this value. integer(kind=int32), intent(in) :: n_reps_S1 Number of replicates in study 1 integer(kind=int32), intent(in) :: n_reps_S2 Number of replicates in study 2 integer(kind=int32), intent(in) :: n_neighbors Number of neighbors in the studies integer(kind=int32), intent(in) :: n_points Number of reference points in the studies real(kind=real64), intent(in) :: global_jsd_observed Observed global JSD value for both studies integer(kind=int32), intent(in) :: n_bins Number of equally sized histogram bins used for the studies real(kind=real64), intent(in) :: shared_residual_range Computed residual range for both studies\nThe minimum valid value is 0.0_real64 . integer(kind=int32), intent(in) :: n_permutations Number of permutations to perform real(kind=real64), intent(out), dimension(n_permutations) :: jsd_null Vector of global divergence values obtained under the null hypothesis real(kind=real64), intent(out) :: p_value Empirical p-value of the permutation test: integer(kind=int32), intent(in), optional :: random_seed Seed to use for shuffling logical(kind=c_bool), intent(in), optional, dimension(n_neighbors, n_points) :: neighbor_mask_S1 Optional mask to exclude specific neighbors from study 1 (e.g. for family-wise analysis) logical(kind=c_bool), intent(in), optional, dimension(n_neighbors, n_points) :: neighbor_mask_S2 Optional mask to exclude specific neighbors from study 2 (e.g. for family-wise analysis) integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure. public  subroutine gjct_permutation_test_expert (neighborhood_residuals_S1, neighborhood_residuals_S2, n_reps_S1, n_reps_S2, n_neighbors, n_points, global_jsd_observed, n_bins, shared_residual_range, n_permutations, jsd_null, p_value, tmp_residuals_S1, tmp_residuals_S2, tmp_pool, tmp_pmf_S1, tmp_pmf_S2, tmp_counts, tmp_included_n_reps_S1, tmp_included_n_reps_S2, tmp_js_divergences, tmp_weights, random_seed, neighbor_mask_S1, neighbor_mask_S2, ierr) Validates its inputs, then calls gjct_permutation_test_impl with what you supply. The expert entry point: it allocates nothing and prepares nothing; gjct_permutation_test does both. Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_reps_S1, n_neighbors, n_points) :: neighborhood_residuals_S1 Computed neighborhood residuals for study 1, NaN is explicitly allowed for missing values\nNaN is permitted for this value. real(kind=real64), intent(in), dimension(n_reps_S2, n_neighbors, n_points) :: neighborhood_residuals_S2 Computed neighborhood residuals for study 2, NaN is explicitly allowed for missing values\nNaN is permitted for this value. integer(kind=int32), intent(in) :: n_reps_S1 Number of replicates in study 1 integer(kind=int32), intent(in) :: n_reps_S2 Number of replicates in study 2 integer(kind=int32), intent(in) :: n_neighbors Number of neighbors in the studies integer(kind=int32), intent(in) :: n_points Number of reference points in the studies real(kind=real64), intent(in) :: global_jsd_observed Observed global JSD value for both studies integer(kind=int32), intent(in) :: n_bins Number of equally sized histogram bins used for the studies real(kind=real64), intent(in) :: shared_residual_range Computed residual range for both studies\nThe minimum valid value is 0.0_real64 . integer(kind=int32), intent(in) :: n_permutations Number of permutations to perform real(kind=real64), intent(out), dimension(n_permutations) :: jsd_null Vector of global divergence values obtained under the null hypothesis real(kind=real64), intent(out) :: p_value Empirical p-value of the permutation test: real(kind=real64), intent(out), dimension(n_reps_S1, n_neighbors, n_points) :: tmp_residuals_S1 Work copy of study 1's residuals, shuffled in place real(kind=real64), intent(out), dimension(n_reps_S2, n_neighbors, n_points) :: tmp_residuals_S2 Work copy of study 2's residuals, shuffled in place real(kind=real64), intent(out), dimension(n_reps_S1 + n_reps_S2, n_neighbors) :: tmp_pool Working array for shuffling the concatenated residuals from both studies per reference point real(kind=real64), intent(out), dimension(n_points, n_bins) :: tmp_pmf_S1 Working array for study 1's normalized histogram counts real(kind=real64), intent(out), dimension(n_points, n_bins) :: tmp_pmf_S2 Working array for study 2's normalized histogram counts integer(kind=int32), intent(out), dimension(n_points, n_bins) :: tmp_counts Working array for the histogram counts integer(kind=int32), intent(out), dimension(n_points) :: tmp_included_n_reps_S1 Working array for study 1's included replicate counts integer(kind=int32), intent(out), dimension(n_points) :: tmp_included_n_reps_S2 Working array for study 2's included replicate counts real(kind=real64), intent(out), dimension(n_points) :: tmp_js_divergences Working array for the per-reference-point divergences real(kind=real64), intent(out), dimension(n_points) :: tmp_weights Working array for the divergence weights integer(kind=int32), intent(in), optional :: random_seed Seed to use for shuffling logical(kind=c_bool), intent(in), optional, dimension(n_neighbors, n_points) :: neighbor_mask_S1 Optional mask to exclude specific neighbors from study 1 (e.g. for family-wise analysis) logical(kind=c_bool), intent(in), optional, dimension(n_neighbors, n_points) :: neighbor_mask_S2 Optional mask to exclude specific neighbors from study 2 (e.g. for family-wise analysis) integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"module/tox_data_integration_stats.html"},{"title":"tox_trajectory_contribution_analysis_c – TensorOmics","text":"Module for quantifying how much one trajectory (a \"factor\") contributes to another (a \"dependent\") over time. Contributions are computed per timepoint as the product of both series' deviations from a chosen\nbaseline, for raw expression trajectories as well as for their velocity (first difference) and\nacceleration (second difference) derivatives. Statistical significance of an observed contribution can\nbe assessed via a permutation test that recomputes the same contribution against a randomly chosen\nother sample. Uses f42_safeguard tox_conversions iso_c_binding tox_