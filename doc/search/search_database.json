ions for robust LOESS fitting\nThe default value is 3_int32 . real(kind=real64), intent(out) :: low_sd_cutoff cutoff used to filter families with low std integer(kind=int32), intent(out), dimension(n_families) :: excluded_low_sd Mask to save those families that have low sd real(kind=real64), intent(out), dimension(n_families) :: tmp_means_aux Work array for saving raw means integer(kind=int32), intent(out) :: ierr Error code public pure subroutine compute_rdi (n_genes, distances, gene_to_fam, dscale, rdi, sorted_rdi, perm, ierr) Validates its inputs, prepares what compute_rdi_impl needs, then calls it. The entry point to reach for first; see compute_rdi_expert to prepare it yourself. Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Total number of genes real(kind=real64), intent(in), dimension(n_genes) :: distances Array of Euclidean distances for each gene to its centroid\nNaN is permitted for this value.\nInfinite values are permitted for this value. integer(kind=int32), intent(in), dimension(n_genes) :: gene_to_fam Gene-to-family mapping (1-based indexing) real(kind=real64), intent(in), dimension(:) :: dscale Array of scaling factors for each family\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(out), dimension(n_genes) :: rdi Output array of RDI values for each gene real(kind=real64), intent(out), dimension(n_genes) :: sorted_rdi Work array for sorting (dimension n_genes) integer(kind=int32), intent(out), dimension(n_genes) :: perm Permutation array for sorting (dimension n_genes, should be pre-initialized with 1:n_genes) integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure. public pure subroutine compute_rdi_expert (n_genes, distances, gene_to_fam, dscale, rdi, sorted_rdi, perm, tmp_stack_left, tmp_stack_right, ierr) Validates its inputs, then calls compute_rdi_impl with what you supply. The expert entry point: it allocates nothing and prepares nothing; compute_rdi does both. Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Total number of genes real(kind=real64), intent(in), dimension(n_genes) :: distances Array of Euclidean distances for each gene to its centroid\nNaN is permitted for this value.\nInfinite values are permitted for this value. integer(kind=int32), intent(in), dimension(n_genes) :: gene_to_fam Gene-to-family mapping (1-based indexing) real(kind=real64), intent(in), dimension(:) :: dscale Array of scaling factors for each family\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(out), dimension(n_genes) :: rdi Output array of RDI values for each gene real(kind=real64), intent(out), dimension(n_genes) :: sorted_rdi Work array for sorting (dimension n_genes) integer(kind=int32), intent(out), dimension(n_genes) :: perm Permutation array for sorting (dimension n_genes, should be pre-initialized with 1:n_genes) integer(kind=int32), intent(out), dimension(n_genes) :: tmp_stack_left Stack array for sorting (dimension n_genes) integer(kind=int32), intent(out), dimension(n_genes) :: tmp_stack_right Stack array for sorting (dimension n_genes) integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure. public pure subroutine identify_outliers (n_genes, rdi, sorted_rdi, perm, is_outlier, threshold, quantile, percentile, ierr) Validates its inputs, then calls identify_outliers_impl . Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Total number of genes real(kind=real64), intent(in), dimension(n_genes) :: rdi Array of RDI values for each gene\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(in), dimension(n_genes) :: sorted_rdi Sorted RDI array (must be filtered to remove negatives and sorted in ascending order before calling)\nNaN is permitted for this value.\nInfinite values are permitted for this value. integer(kind=int32), intent(in), dimension(n_genes) :: perm Permutation array with sorted indices logical(kind=c_bool), intent(out), dimension(n_genes) :: is_outlier Output boolean array indicating outliers real(kind=real64), intent(out) :: threshold Output threshold value used for detection real(kind=real64), intent(out), dimension(n_genes) :: quantile Empirical one-sided upper-tail quantile (effect-size measure) for each gene, i.e. how extreme an\nobserved distance is relative to all observed distances -- NOT a null-hypothesis-testing p-value.\nReturned in the same order as the input RDI array. Because distances are non-negative, a one-sided\nupper-tail quantile is used. real(kind=real64), intent(in), optional :: percentile Percentile threshold as a fraction in [0,1] (top 5% for the default).\nThe default value is 0.95_real64 .\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 . integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure. public  subroutine detect_outliers (n_genes, n_families, distances, gene_to_fam, is_outlier, loess_x, loess_y, loess_n, quantile, ierr, percentile) Validates its inputs, prepares what detect_outliers_impl needs, then calls it. The entry point to reach for first; see detect_outliers_expert to prepare it yourself. Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Total number of genes integer(kind=int32), intent(in) :: n_families Total number of gene families real(kind=real64), intent(in), dimension(n_genes) :: distances Array of Euclidean distances for each gene to its centroid\nNaN is permitted for this value.\nInfinite values are permitted for this value. integer(kind=int32), intent(in), dimension(n_genes) :: gene_to_fam Gene-to-family mapping (1-based indexing) logical(kind=c_bool), intent(out), dimension(n_genes) :: is_outlier Output boolean array indicating outliers real(kind=real64), intent(out), dimension(n_families) :: loess_x Reference x-coordinates. real(kind=real64), intent(out), dimension(n_families) :: loess_y Reference y-coordinates (length n_total). integer(kind=int32), intent(out), dimension(n_families) :: loess_n Indices of reference points used for smoothing. real(kind=real64), intent(out), dimension(n_genes) :: quantile Empirical one-sided upper-tail quantile (effect-size measure) for each gene, i.e. how extreme an\nobserved distance is relative to all observed distances -- NOT a null-hypothesis-testing p-value.\nReturned in the same order as the input RDI array. Because distances are non-negative, a one-sided\nupper-tail quantile is used. integer(kind=int32), intent(out) :: ierr Error code real(kind=real64), intent(in), optional :: percentile Percentile threshold as a fraction in [0,1] for outlier detection.\nThe default value is 0.95_real64 .\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 . public  subroutine detect_outliers_expert (n_genes, n_families, distances, gene_to_fam, tmp_perm, tmp_stack_left, tmp_stack_right, tmp_int_workspace, int_workspace_size, tmp_real_workspace, real_workspace_size, tmp_diagl, tmp_weights, tmp_eval_points, tmp_robust_weights, tmp_combined_weights, tmp_residuals, tmp_permutation_indices, tmp_fitted_values, tmp_means_aux, tmp_dscale, tmp_excluded_low_sd, tmp_low_sd_cutoff, tmp_rdi, tmp_sorted_rdi, tmp_threshold, is_outlier, loess_x, loess_y, loess_n, quantile, ierr, percentile) Validates its inputs, then calls detect_outliers_impl with what you supply. The expert entry point: it allocates nothing and prepares nothing; detect_outliers does both. Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Total number of genes integer(kind=int32), intent(in) :: n_families Total number of gene families real(kind=real64), intent(in), dimension(n_genes) :: distances Array of Euclidean distances for each gene to its centroid\nNaN is permitted for this value.\nInfinite values are permitted for this value. integer(kind=int32), intent(in), dimension(n_genes) :: gene_to_fam Gene-to-family mapping (1-based indexing) integer(kind=int32), intent(out), dimension(n_genes) :: tmp_perm Permutation array for sorting integer(kind=int32), intent(out), dimension(n_genes) :: tmp_stack_left Stack array for left indices during sorting integer(kind=int32), intent(out), dimension(n_genes) :: tmp_stack_right Stack array for right indices during sorting integer(kind=int32), intent(out), dimension(int_workspace_size) :: tmp_int_workspace Integer workspace array integer(kind=int32), intent(in) :: int_workspace_size Length of integer workspace.\nIt is VERY IMPORTANT to compute this argument from the int_workspace_size output produced by tox_loess_required_workspace . Read more… real(kind=real64), intent(out), dimension(real_workspace_size) :: tmp_real_workspace Real workspace array integer(kind=int32), intent(in) :: real_workspace_size Length of real workspace.\nIt is VERY IMPORTANT to compute this argument from the real_workspace_size output produced by tox_loess_required_workspace . Read more… real(kind=real64), intent(out), dimension(n_families) :: tmp_diagl Diagonal elements of the weight matrix real(kind=real64), intent(out), dimension(n_families) :: tmp_weights Initial weights for LOESS real(kind=real64), intent(out), dimension(n_families, 1) :: tmp_eval_points Z matrix for LOESS fitting real(kind=real64), intent(out), dimension(n_families) :: tmp_robust_weights Residuals for robust LOESS fitting real(kind=real64), intent(out), dimension(n_families) :: tmp_combined_weights Working weights array real(kind=real64), intent(out), dimension(n_families) :: tmp_residuals Residuals array integer(kind=int32), intent(out), dimension(n_families) :: tmp_permutation_indices Permutation indices for robust LOESS fitting real(kind=real64), intent(out), dimension(n_families) :: tmp_fitted_values Output array for LOESS predictions real(kind=real64), intent(out), dimension(n_families) :: tmp_means_aux Work array for saving raw means real(kind=real64), intent(out), dimension(n_families) :: tmp_dscale Per-family scaling factors (intermediate, consumed by the RDI step) integer(kind=int32), intent(out), dimension(n_families) :: tmp_excluded_low_sd Low-sd family mask (intermediate, discarded) real(kind=real64), intent(out) :: tmp_low_sd_cutoff Low-sd cutoff (intermediate, discarded) real(kind=real64), intent(out), dimension(n_genes) :: tmp_rdi RDI per gene (intermediate, consumed by the outlier step) real(kind=real64), intent(out), dimension(n_genes) :: tmp_sorted_rdi Sorted RDI (intermediate, consumed by the outlier step) real(kind=real64), intent(out) :: tmp_threshold Detection threshold (intermediate, discarded) logical(kind=c_bool), intent(out), dimension(n_genes) :: is_outlier Output boolean array indicating outliers real(kind=real64), intent(out), dimension(n_families) :: loess_x Reference x-coordinates. real(kind=real64), intent(out), dimension(n_families) :: loess_y Reference y-coordinates (length n_total). integer(kind=int32), intent(out), dimension(n_families) :: loess_n Indices of reference points used for smoothing. real(kind=real64), intent(out), dimension(n_genes) :: quantile Empirical one-sided upper-tail quantile (effect-size measure) for each gene, i.e. how extreme an\nobserved distance is relative to all observed distances -- NOT a null-hypothesis-testing p-value.\nReturned in the same order as the input RDI array. Because distances are non-negative, a one-sided\nupper-tail quantile is used. integer(kind=int32), intent(out) :: ierr Error code real(kind=real64), intent(in), optional :: percentile Percentile threshold as a fraction in [0,1] for outlier detection.\nThe default value is 0.95_real64 .\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 .","tags":"","url":"module/tox_get_outliers.html"},{"title":"tox_data_integration_preprocessing_impl – TensorOmics","text":"Jensen-Shannon-Divergence (JSD) Compatibility Test (gJCT) Preprocessing The step that turns expression vectors into the neighborhood residuals the rest of the test\nconsumes: gene-wise means, the signed deviation of each replicate from them, and the\nneighborhoods of reference points those residuals are grouped into so the comparison is\nconditioned on expression level rather than pooled across it. calc_neighborhood_size sizes a neighborhood for a caller that allocates its own. Uses iso_fortran_env f42_stats_impl f42_math_impl f42_sort_impl ieee_arithmetic Functions public pure function calc_neighborhood_size (n_pool, n_points, n_genes_S, mean_S, desired_size) result(n_neighbors) Author Franz-Eric Sill License MIT Category C-binding Calculate the number of neighbors to be used for constructing neighborhoods Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_pool Total number of pooled mean-expression values across both studies integer(kind=int32), intent(in) :: n_points Number of reference points integer(kind=int32), intent(in) :: n_genes_S Number of genes in the current study real(kind=real64), intent(in) :: mean_S (n_genes_S) Per-gene mean expression values\nNaN is permitted for this value. integer(kind=int32), intent(in), optional :: desired_size Optional desired neighborhood size\nThe default value is 1000 . Return Value integer(kind=int32) Calculated neighborhood size Subroutines public pure subroutine compute_gene_means_impl (n_genes, n_reps, expr, means) Author Franz-Eric Sill License MIT Compute per-gene mean expression, ignoring NaN values Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Number of genes in the study integer(kind=int32), intent(in) :: n_reps Number of biological replicates in the study real(kind=real64), intent(in) :: expr (n_reps,n_genes) Expression matrix\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(out) :: means (n_genes) Per-gene mean expression values public pure subroutine compute_residuals_impl (n_genes, n_reps, expr, means, resid) Author Franz-Eric Sill License MIT Compute signed residuals (centering by mean) Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Number of genes in the study integer(kind=int32), intent(in) :: n_reps Number of biological replicates in the study real(kind=real64), intent(in) :: expr (n_reps,n_genes) Expression matrix\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(in) :: means (n_genes) Per-gene mean expression values; NaN where every replicate of a gene was NaN\nNaN is permitted for this value. real(kind=real64), intent(out) :: resid (n_reps,n_genes) Matrix of signed residuals public pure subroutine pool_means_impl (pooled_means, pooled_means_perm, pool_size, n_points, n_pool, x_star) Author Franz-Eric Sill License MIT Turn a sorted pool of per-gene mean expression values into reference points Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: pooled_means (pool_size) Pooled means\nNaN is permitted for this value. integer(kind=int32), intent(in) :: pooled_means_perm (pool_size) Sorting permutation for pooled_means integer(kind=int32), intent(in), target :: pool_size Number of means in the pool, usually n_genes_S1 + n_genes_S2 integer(kind=int32), intent(in) :: n_points Number of reference points to define integer(kind=int32), intent(out) :: n_pool Total number of included (non-NaN) pooled mean-expression values real(kind=real64), intent(out) :: x_star (n_points) Mean-expression reference points public pure subroutine pool_study_means_impl (n_genes_S1, mean_S1, n_genes_S2, mean_S2, n_points, tmp_pooled_means, tmp_pooled_means_perm, n_pool, x_star) Author Franz-Eric Sill License MIT Pool the per-gene mean expression values of two studies into reference points Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes_S1 Number of genes in study S1 real(kind=real64), intent(in) :: mean_S1 (n_genes_S1) Per-gene mean expression values of study S1\nNaN is permitted for this value. integer(kind=int32), intent(in) :: n_genes_S2 Number of genes in study S2 real(kind=real64), intent(in) :: mean_S2 (n_genes_S2) Per-gene mean expression values of study S2\nNaN is permitted for this value. integer(kind=int32), intent(in) :: n_points Number of reference points to define real(kind=real64), intent(out) :: tmp_pooled_means (n_genes_S1+n_genes_S2) Work array holding the concatenated means of both studies integer(kind=int32), intent(out) :: tmp_pooled_means_perm (n_genes_S1+n_genes_S2) Work array for the permutation that sorts tmp_pooled_means integer(kind=int32), intent(out) :: n_pool Total number of included (non-NaN) pooled mean-expression values real(kind=real64), intent(out) :: x_star (n_points) Mean-expression reference points public pure subroutine construct_neighborhoods_impl (n_points, x_star, n_genes_S, mean_S, n_reps_S, resid_S, tmp_distances, tmp_distances_perm, neighborhood_residuals, neighborhood_indices, n_neighbors) Author Franz-Eric Sill License MIT Construct neighborhood-based residual sets (kNN) Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_points Number of reference points real(kind=real64), intent(in) :: x_star (n_points) Mean-expression reference points\nNaN is permitted for this value. integer(kind=int32), intent(in) :: n_genes_S Number of genes in the current study real(kind=real64), intent(in) :: mean_S (n_genes_S) Per-gene mean expression values\nNaN is permitted for this value. integer(kind=int32), intent(in) :: n_reps_S Number of biological replicates in the study real(kind=real64), intent(in) :: resid_S (n_reps_S,n_genes_S) Matrix of signed residuals\nNaN is permitted for this value. real(kind=real64), intent(out) :: tmp_distances (n_genes_S) Distances work array integer(kind=int32), intent(out) :: tmp_distances_perm (n_genes_S) Work array for the permutation that sorts tmp_distances real(kind=real64), intent(out) :: neighborhood_residuals (n_reps_S,n_neighbors,n_points) Collection of residual vectors for each neighborhood integer(kind=int32), intent(out) :: neighborhood_indices (n_neighbors,n_points) Indices of selected neighborhood genes integer(kind=int32), intent(in) :: n_neighbors Number of neighbors; a gene whose mean is NaN can never be a neighbor, so this\ncannot exceed the number of genes with a defined mean\nThe minimum valid value is 1_int32 .\nThe maximum valid value is count(.not. ieee_is_nan(mean_S), kind=int32) .\nIt is recommended to compute this with calc_neighborhood_size .","tags":"","url":"module/tox_data_integration_preprocessing_impl.html"},{"title":"f42_random_impl – TensorOmics","text":"One of the modules f42_utils_impl gathers; use f42_utils_impl reaches all of them. Uses iso_fortran_env f42_sort_impl Interfaces public        interface shuffle_vector Generic in-place Fisher-Yates shuffle, dispatches on the vector's element type. public  subroutine shuffle_vector_real (vec) Author Franz-Eric Sill License MIT Shuffle a vector in-place, using Fisher-Yates shuffle Arguments Type Intent Optional Attributes Name real(kind=real64), intent(inout), dimension(:) :: vec Output permutation array public  subroutine shuffle_vector_int (vec) Author Franz-Eric Sill License MIT Shuffle a vector in-place, using Fisher-Yates shuffle Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(inout), dimension(:) :: vec Output permutation array Functions public  function rand_range (min, max) result(rand_num) Author Franz-Eric Sill License MIT Returns a random real number min <= rand_num < max . If min > max , it will be max <= rand_num < min . If min == max , it will be min . Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: min Lower bound real(kind=real64), intent(in) :: max Upper bound Return Value real(kind=real64) Subroutines public  subroutine init_random (seed) Author Franz-Eric Sill License MIT Initialize Fortran's random number generator Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in), optional :: seed optional random seed, default: 42 Read more… public  subroutine shuffle_vector_real (vec) Author Franz-Eric Sill License MIT Shuffle a vector in-place, using Fisher-Yates shuffle Arguments Type Intent Optional Attributes Name real(kind=real64), intent(inout), dimension(:) :: vec Output permutation array public  subroutine shuffle_vector_int (vec) Author Franz-Eric Sill License MIT Shuffle a vector in-place, using Fisher-Yates shuffle Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(inout), dimension(:) :: vec Output permutation array","tags":"","url":"module/f42_random_impl.html"},{"title":"f42_serde_arrays_deserialize_int – TensorOmics","text":"Module for deserializing integer arrays from files Uses iso_fortran_env f42_serde_arrays_utils tox_errors Subroutines public  subroutine deserialize_int_helper (arr, n_elements, arr_shape, filename, ierr) Author Aaron Schröder License MIT Category C-binding Deserialize a flat integer array from a file Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(out), dimension(n_elements) :: arr Pre-allocated array to read the data into integer(kind=int32), intent(in) :: n_elements Size of arr integer(kind=int32), intent(in), dimension(:) :: arr_shape Extents of arr , one per dimension\nIt is VERY IMPORTANT to compute this argument from the dims_out output produced by get_array_metadata . Read more… character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code public  subroutine deserialize_int_1d (arr, filename, ierr) Author Aaron Schröder License MIT Directly deserialize a 1D integer array from a file Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(out), dimension(:), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code public  subroutine deserialize_int_2d (arr, filename, ierr) Author Aaron Schröder License MIT Directly deserialize a 2D integer array from a file Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(out), dimension(:, :), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code public  subroutine deserialize_int_3d (arr, filename, ierr) Author Aaron Schröder License MIT Directly deserialize a 3D integer array from a file Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(out), dimension(:, :, :), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code public  subroutine deserialize_int_4d (arr, filename, ierr) Author Aaron Schröder License MIT Directly deserialize a 4D integer array from a file Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(out), dimension(:, :, :, :), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code public  subroutine deserialize_int_5d (arr, filename, ierr) Author Aaron Schröder License MIT Directly deserialize a 5D integer array from a file Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(out), dimension(:, :, :, :, :), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"module/f42_serde_arrays_deserialize_int.html"},{"title":"f42_serde_arrays_deserialize – TensorOmics","text":"Main array deserialization module, re-exporting all deserialization routines Uses f42_serde_arrays_deserialize_int f42_serde_arrays_deserialize_logical f42_serde_arrays_deserialize_char f42_serde_arrays_deserialize_real f42_serde_arrays_deserialize_complex","tags":"","url":"module/f42_serde_arrays_deserialize.html"},{"title":"tox_gene_centroids_impl – TensorOmics","text":"Expression centroids of gene families. mean_vector is the centroid of a set of expression vectors. group_centroid_orthologs and group_centroid_all take the centroid of a family: over its orthologs only, or over\nevery gene in it -- two routines rather than one taking a flag, so which set a result is\nover is visible at the call site. Uses f42_safeguard iso_fortran_env iso_c_binding f42_vector_impl Variables Type Visibility Attributes Name Initial integer(kind=int32), public, parameter :: MODE_GROUP_ORTHOLOGS = 0_int32 Mode code for grouping by orthologs integer(kind=int32), public, parameter :: MODE_GROUP_ALL = 1_int32 Mode code for taking all genes as a group Subroutines public pure subroutine mean_vector_impl (expression_vectors, n_axes, n_genes, gene_indices, n_selected_genes, centroid) Author Luka Faensen License MIT Computes the element-wise mean for a given set of vectors. Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_axes, n_genes) :: expression_vectors The input matrix of all gene expression vectors (n_axes x n_genes). integer(kind=int32), intent(in) :: n_axes Number of axes (tissues/dimensions). integer(kind=int32), intent(in) :: n_genes Total number of genes in the input matrix. integer(kind=int32), intent(in), dimension(n_selected_genes) :: gene_indices An array containing the column indices of the selected genes in 'expression_vectors'.\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_genes . integer(kind=int32), intent(in) :: n_selected_genes The number of genes in the current family to be averaged.\nThe minimum valid value is 0_int32 .\nThe maximum valid value is n_genes . real(kind=real64), intent(out), dimension(n_axes) :: centroid The output vector representing the computed centroid. public pure subroutine group_centroid_impl (expression_vectors, n_axes, n_genes, gene_to_family, n_families, centroid_matrix, mode, tmp_group_indices, ortholog_set) Author Luka Faensen License MIT Iterates over families, filters gene indices, and computes centroids. Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_axes, n_genes) :: expression_vectors The input matrix of all gene expression vectors (n_axes x n_genes). integer(kind=int32), intent(in) :: n_axes Number of axes (tissues/dimensions). integer(kind=int32), intent(in) :: n_genes Total number of genes in the 'expression_vectors' matrix. integer(kind=int32), intent(in), dimension(n_genes) :: gene_to_family Index mapping -> each index i holds the family index for the corresponding gene in expression_vectors , using 0_int32 for unassigned genes\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_families .\nThe value 0_int32 is additionally accepted. integer(kind=int32), intent(in) :: n_families Total number of gene families to compute centroids for. real(kind=real64), intent(out), dimension(n_axes, n_families) :: centroid_matrix The output matrix (n_axes x n_families) to store the computed centroids. integer(kind=int32), intent(in) :: mode used mode for grouping Read more… integer(kind=int32), intent(out), dimension(n_genes) :: tmp_group_indices Work array for storing the indices of one family's genes. logical(kind=c_bool), intent(in), optional, dimension(n_genes) :: ortholog_set A logical array indicating if a gene is part of a specific subset (e.g., orthologs).\nThis optional argument needs to be passed if used mode ( mode ) is MODE_GROUP_ORTHOLOGS .","tags":"","url":"module/tox_gene_centroids_impl.html"},{"title":"tox_relative_axis_plane_tools_impl – TensorOmics","text":"Relative axis planes (RAPs): planes through higher-dimensional gene expression space, and\nwhat can be read off a vector once it is projected onto one. A RAP is picked by selecting axes (tissues) from the full expression space. vector_RAP_projection projects a single vector onto it and field_RAP_projection a whole\nfield of them. Within the plane, clock_hand_angle_between_vectors measures the signed angle\nbetween two vectors -- signed by an orientation reference, so the sign means the same thing in\nevery dimension -- and clock_hand_angles_for_shift_vectors does that for a whole shift\nvector field at once. relative_axes_changes_from_shift_vector and relative_axes_expression_from_expression_vector give the per-axis breakdown instead of the angle: how much of a change, or of an expression\nlevel, falls on each selected axis. Uses iso_fortran_env iso_c_binding f42_math_impl f42_safeguard tox_errors Subroutines public pure subroutine omics_vector_RAP_projection_impl (vecs, n_axes, n_vecs, vecs_selection_mask, n_selected_vecs, axes_selection_mask, n_selected_axes, projections) Author Franz-Eric Sill License MIT Project selected vectors (e.g. expression vectors) onto the RAP constructed from a selected set of axes. Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_axes, n_vecs) :: vecs matrix with expression vectors integer(kind=int32), intent(in) :: n_axes number of axes integer(kind=int32), intent(in) :: n_vecs number of vectors per axis logical(kind=c_bool), intent(in), dimension(n_vecs) :: vecs_selection_mask .true. for vectors where projection is to be computed integer(kind=int32), intent(in) :: n_selected_vecs count of .true. values in vecs_selection_mask logical(kind=c_bool), intent(in), dimension(n_axes) :: axes_selection_mask .true. for axes to be included in RAP integer(kind=int32), intent(in) :: n_selected_axes count of .true. values in axes_selection_mask real(kind=real64), intent(out), dimension(n_selected_axes, n_selected_vecs) :: projections projected vectors public pure subroutine omics_field_RAP_projection_impl (fields, n_axes, n_fields, fields_selection_mask, n_selected_fields, axes_selection_mask, n_selected_axes, projections) Author Franz-Eric Sill License MIT Project selected vector fields (e.g. shift vectors) onto the RAP constructed from a selected set of axes. Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_axes, 2, n_fields) :: fields matrix with vector fields; each field holds two vectors, the origin first and the target second integer(kind=int32), intent(in) :: n_axes number of axes integer(kind=int32), intent(in) :: n_fields number of vectors per axis logical(kind=c_bool), intent(in), dimension(n_fields) :: fields_selection_mask .true. for vectors where projection is to be computed integer(kind=int32), intent(in) :: n_selected_fields count of .true. values in fields_selection_mask logical(kind=c_bool), intent(in), dimension(n_axes) :: axes_selection_mask .true. for axes to be included in RAP integer(kind=int32), intent(in) :: n_selected_axes count of .true. values in axes_selection_mask real(kind=real64), intent(out), dimension(n_selected_axes, n_selected_fields) :: projections projected vectors public pure subroutine project_selected_vecs_onto_rap_helper (selected_vecs, n_selected_axes, n_selected_vecs) Author Franz-Eric Sill License MIT Projects selected vectors onto its RAP Arguments Type Intent Optional Attributes Name real(kind=real64), intent(inout), dimension(n_selected_axes, n_selected_vecs) :: selected_vecs matrix with vectors for selected axes integer(kind=int32), intent(in) :: n_selected_axes number of selected axes integer(kind=int32), intent(in) :: n_selected_vecs number of selected vectors per axis public pure subroutine clock_hand_angle_between_vectors_impl (v1, v2, n_dims, orientation_reference, signed_angle, ierr) Author Vivian Bass License MIT Compute the signed clock hand angle between two RAP-projected and normalized vectors. Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_dims) :: v1 First normalized vector in RAP space real(kind=real64), intent(in), dimension(n_dims) :: v2 Second normalized vector in RAP space integer(kind=int32), intent(in) :: n_dims Dimension of both vectors real(kind=real64), intent(in), dimension(n_dims) :: orientation_reference Orients the plane the rotation happens in, so the angle can carry a sign. A\nrotation from one vector to another has no inherent direction above two\ndimensions -- and in RAP space not even in two, since the axes are tissues or\nfactors and carry no handedness -- so the caller states which way round counts\nas positive. The sign is that of this vector's component along the rotation. real(kind=real64), intent(out) :: signed_angle Signed angle between vectors in radians [-pi, pi] integer(kind=int32), intent(out) :: ierr Error code public pure subroutine clock_hand_angle_between_vectors_helper (v1, v2, n_dims, orientation_reference, signed_angle, undefined_sign) Author Vivian Bass License MIT Compute the signed clock hand angle between two RAP-projected and normalized vectors. Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_dims) :: v1 First normalized vector in RAP space real(kind=real64), intent(in), dimension(n_dims) :: v2 Second normalized vector in RAP space integer(kind=int32), intent(in) :: n_dims Dimension of both vectors real(kind=real64), intent(in), dimension(n_dims) :: orientation_reference Orients the plane the rotation happens in, so the angle can carry a sign. A\nrotation from one vector to another has no inherent direction above two\ndimensions -- and in RAP space not even in two, since the axes are tissues or\nfactors and carry no handedness -- so the caller states which way round counts\nas positive. The sign is that of this vector's component along the rotation. real(kind=real64), intent(out) :: signed_angle Signed angle between vectors in radians [-pi, pi] logical(kind=c_bool), intent(out) :: undefined_sign .true. when the reference orients nothing, so no sign could be given public pure subroutine clock_hand_angles_for_shift_vectors_impl (fields, n_dims, n_fields, fields_selection_mask, n_selected_fields, orientation_reference, signed_angles, ierr) Author Vivian Bass License MIT Compute signed rotation angles between for shift vectors, so between their origin and target Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_dims, 2, n_fields) :: fields matrix with vector fields; each field holds two vectors, the origin first and the target second integer(kind=int32), intent(in) :: n_dims Dimension of each vector in RAP space integer(kind=int32), intent(in) :: n_fields Number of vector pairs logical(kind=c_bool), intent(in), dimension(n_fields) :: fields_selection_mask .true. for vector pairs where angle should be computed integer(kind=int32), intent(in) :: n_selected_fields Count of .true. values in fields_selection_mask real(kind=real64), intent(in), dimension(n_dims) :: orientation_reference Orients the plane the rotation happens in, so the angle can carry a sign. A\nrotation from one vector to another has no inherent direction above two\ndimensions -- and in RAP space not even in two, since the axes are tissues or\nfactors and carry no handedness -- so the caller states which way round counts\nas positive. The sign is that of this vector's component along the rotation. real(kind=real64), intent(out), dimension(n_selected_fields) :: signed_angles Signed rotation angles between vector pairs in radians [-π, π] integer(kind=int32), intent(out) :: ierr Error code public pure subroutine compute_relative_axis_contributions_impl (vec, n_axes, contributions, ierr) Author Vivian Bass License MIT Compute the fractional contribution of each axis to a RAP-projected and normalized vector Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_axes) :: vec RAP-projected and normalized vector (expression or shift) integer(kind=int32), intent(in) :: n_axes Number of axes (length of vec and contributions) real(kind=real64), intent(out), dimension(n_axes) :: contributions Fractional contribution of each axis (output), values in [0,1], sum to 1 integer(kind=int32), intent(out) :: ierr Error code public pure subroutine relative_axes_changes_from_shift_vector_impl (vec, n_axes, contributions, ierr) Author Vivian Bass License MIT Compute fractional contribution of each axis to a RAP-projected and normalized shift vector. Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_axes) :: vec RAP-projected and normalized shift vector integer(kind=int32), intent(in) :: n_axes Number of axes real(kind=real64), intent(out), dimension(n_axes) :: contributions Fractional contribution of each axis (output), values in [0,1], sum to 1 integer(kind=int32), intent(out) :: ierr Error code public pure subroutine relative_axes_expression_from_expression_vector_impl (vec, n_axes, contributions, ierr) Author Vivian Bass License MIT Compute fractional contribution of each axis to a RAP-projected and normalized expression vector. Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_axes) :: vec RAP-projected and normalized expression vector integer(kind=int32), intent(in) :: n_axes Number of axes real(kind=real64), intent(out), dimension(n_axes) :: contributions Fractional contribution of each axis (output), values in [0,1], sum to 1 integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"module/tox_relative_axis_plane_tools_impl.html"},{"title":"f42_serde_arrays_serialize_int_c – TensorOmics","text":"Module for serializing integer arrays into files Uses f42_safeguard iso_c_binding tox_errors Subroutines public  subroutine serialize_int_helper_c (arr, n_elements, arr_shape, n_arr_shape_elements, filename, filename_strlen, ierr) bind(C, name=\"serialize_int_helper_c\") C-wrapper for serialize_int_helper Read more… Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), dimension(*), target :: arr Array to be serialized integer(kind=c_int), intent(in), target :: n_elements Number of strings in arr integer(kind=c_int), intent(in), dimension(n_arr_shape_elements), target :: arr_shape Extents of arr , one per dimension integer(kind=c_int), intent(in), target :: n_arr_shape_elements number of elements in arr_shape character(kind=c_char, len=1), intent(in), dimension(filename_strlen), target :: filename Name of the file to write to integer(kind=c_int), intent(in), target :: filename_strlen length of the strings in filename integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"module/f42_serde_arrays_serialize_int_c.html"},{"title":"f42_utils – TensorOmics","text":"General-purpose utilities for data analysis: elementary mathematics, indirect sorting and\nsearching, randomness, vector geometry, and descriptive statistics. It holds nothing itself and only gathers the modules below, so one use reaches every\nutility and which module a given one is defined in stays out of the way. Generated from f42_utils_impl ; do not edit -- regenerate instead. Uses f42_stats","tags":"","url":"module/f42_utils.html"},{"title":"f42_kd_tree – TensorOmics","text":"k-d tree spatial index over fixed-dimensional point sets.\nBuilds a k-d tree by recursively partitioning kd_indices around the median point along a\ncaller-supplied, cycling dimension order, using a stack-based (non-recursive) traversal so it\nis safe to call from pure procedures. The tree is stored implicitly as an in-place-permuted\nindex array rather than as linked nodes. Generated from f42_kd_tree_impl ; do not edit -- regenerate instead. Uses f42_kd_tree_impl iso_fortran_env tox_errors Subroutines public pure subroutine build_kd_index (points, n_dimensions, n_points, kd_indices, dimension_order, ierr) Validates its inputs, prepares what build_kd_index_impl needs, then calls it. The entry point to reach for first; see build_kd_index_expert to prepare it yourself. Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_dimensions, n_points) :: points Data points integer(kind=int32), intent(in) :: n_dimensions Number of dimensions integer(kind=int32), intent(in) :: n_points Number of points integer(kind=int32), intent(out), dimension(n_points) :: kd_indices Output index array (k-d tree order) integer(kind=int32), intent(in), dimension(n_dimensions) :: dimension_order Dimension order (by variance)\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_dimensions . integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure. public pure subroutine build_kd_index_expert (points, n_dimensions, n_points, kd_indices, dimension_order, tmp_workspace, tmp_value_buffer, tmp_permutation, tmp_recursion_stack, ierr) Validates its inputs, then calls build_kd_index_impl with what you supply. The expert entry point: it allocates nothing and prepares nothing; build_kd_index does both. Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_dimensions, n_points) :: points Data points integer(kind=int32), intent(in) :: n_dimensions Number of dimensions integer(kind=int32), intent(in) :: n_points Number of points integer(kind=int32), intent(out), dimension(n_points) :: kd_indices Output index array (k-d tree order) integer(kind=int32), intent(in), dimension(n_dimensions) :: dimension_order Dimension order (by variance)\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_dimensions . integer(kind=int32), intent(out), dimension(n_points) :: tmp_workspace Workspace array real(kind=real64), intent(out), dimension(n_points) :: tmp_value_buffer Workspace for sorting integer(kind=int32), intent(out), dimension(n_points) :: tmp_permutation Workspace for sorting integer(kind=int32), intent(out), dimension(3, n_points) :: tmp_recursion_stack Stack for l, r, depth integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure. public pure subroutine build_spherical_kd (points, n_dimensions, n_points, kd_indices, dimension_order, ierr) Validates its inputs, prepares what build_spherical_kd_impl needs, then calls it. The entry point to reach for first; see build_spherical_kd_expert to prepare it yourself. Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_dimensions, n_points) :: points Data points integer(kind=int32), intent(in) :: n_dimensions Number of dimensions integer(kind=int32), intent(in) :: n_points Number of points integer(kind=int32), intent(out), dimension(n_points) :: kd_indices Output index array (k-d tree order) integer(kind=int32), intent(in), dimension(n_dimensions) :: dimension_order Dimension order (by variance)\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_dimensions . integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure. public pure subroutine build_spherical_kd_expert (points, n_dimensions, n_points, kd_indices, dimension_order, tmp_workspace, tmp_value_buffer, tmp_permutation, tmp_recursion_stack, ierr) Validates its inputs, then calls build_spherical_kd_impl with what you supply. The expert entry point: it allocates nothing and prepares nothing; build_spherical_kd does both. Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_dimensions, n_points) :: points Data points integer(kind=int32), intent(in) :: n_dimensions Number of dimensions integer(kind=int32), intent(in) :: n_points Number of points integer(kind=int32), intent(out), dimension(n_points) :: kd_indices Output index array (k-d tree order) integer(kind=int32), intent(in), dimension(n_dimensions) :: dimension_order Dimension order (by variance)\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_dimensions . integer(kind=int32), intent(out), dimension(n_points) :: tmp_workspace Workspace array real(kind=real64), intent(out), dimension(n_points) :: tmp_value_buffer Workspace for sorting integer(kind=int32), intent(out), dimension(n_points) :: tmp_permutation Workspace for sorting integer(kind=int32), intent(out), dimension(3, n_points) :: tmp_recursion_stack Stack for l, r, depth integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"module/f42_kd_tree.html"},{"title":"tox_tissue_versatility_c – TensorOmics","text":"Normalized tissue (axis) versatility: how uniformly a gene is expressed across tissues. An angle-based metric. A gene expressed equally across every selected axis points along the\ndiagonal of that subspace and scores maximally versatile; one confined to a single tissue\npoints along that axis and scores minimally. Normalized, so scores over different numbers of\nselected axes are comparable. Uses f42_safeguard iso_c_binding tox_errors Subroutines public  subroutine compute_tissue_versatility_c (n_axes, n_vectors, expression_vectors, vectors_selection_mask, n_selected_vectors, axes_selection_mask, n_selected_axes, tissue_versatilities, tissue_angles_deg, ierr) bind(C, name=\"compute_tissue_versatility_c\") C-wrapper for compute_tissue_versatility Read more… Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_axes Number of axes (tissues/dimensions) integer(kind=c_int), intent(in), target :: n_vectors Number of expression vectors (genes) real(kind=c_double), intent(in), dimension(n_axes, n_vectors), target :: expression_vectors 2D array (n_axes, n_vectors), each column is a gene expression vector logical(kind=c_bool), intent(in), dimension(n_vectors), target :: vectors_selection_mask Logical array (n_vectors), .TRUE. for vectors to process integer(kind=c_int), intent(in), target :: n_selected_vectors Number of selected expression vectors (count of .TRUE. in vectors_selection_mask) logical(kind=c_bool), intent(in), dimension(n_axes), target :: axes_selection_mask Logical array (n_axes), .TRUE. for axes to include in calculation integer(kind=c_int), intent(in), target :: n_selected_axes Number of selected axes (count of .TRUE. in axes_selection_mask)\nThe minimum valid value is 1_int32 . real(kind=c_double), intent(out), dimension(n_selected_vectors), target :: tissue_versatilities Output, real array, length = n_selected_vectors, stores the calculated tissue versatilities real(kind=c_double), intent(out), dimension(n_selected_vectors), target :: tissue_angles_deg Output, real array, length = n_selected_vectors, stores the calculated angles in degrees integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"module/tox_tissue_versatility_c.html"},{"title":"tox_data_integration_preprocessing_impl_c – TensorOmics","text":"Jensen-Shannon-Divergence (JSD) Compatibility Test (gJCT) Preprocessing The step that turns expression vectors into the neighborhood residuals the rest of the test\nconsumes: gene-wise means, the signed deviation of each replicate from them, and the\nneighborhoods of reference points those residuals are grouped into so the comparison is\nconditioned on expression level rather than pooled across it. calc_neighborhood_size sizes a neighborhood for a caller that allocates its own. Uses f42_safeguard iso_c_binding tox_errors Subroutines public  subroutine calc_neighborhood_size_c (n_pool, n_points, n_genes_S, mean_S, desired_size, n_neighbors, ierr) bind(C, name=\"calc_neighborhood_size_c\") C-wrapper for calc_neighborhood_size Read more… Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_pool Total number of pooled mean-expression values across both studies integer(kind=c_int), intent(in), target :: n_points Number of reference points integer(kind=c_int), intent(in), target :: n_genes_S Number of genes in the current study real(kind=c_double), intent(in), dimension(n_genes_S), target :: mean_S Per-gene mean expression values\nNaN is permitted for this value. integer(kind=c_int), intent(in), target :: desired_size Optional desired neighborhood size\nThe default value is 1000 . integer(kind=c_int), intent(out), target :: n_neighbors Calculated neighborhood size integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"module/tox_data_integration_preprocessing_impl_c.html"},{"title":"tox_data_integration_per_family – TensorOmics","text":"Jensen-Shannon-Divergence (JSD) Compatibility Test (gJCT) JSD Calculation per family The JSD value for a sub-neighborhood -- typically the genes of one family -- obtained by\ndriving the same pipeline over a masked set of neighbors. Answers whether two studies are\ncompatible for this family , which the global figure can hide either way. Generated from tox_data_integration_per_family_impl ; do not edit -- regenerate instead. Uses iso_fortran_env tox_data_integration_per_family_impl iso_c_binding f42_safeguard tox_errors Subroutines public pure subroutine fjct_compute_jsd (family_idx, gene_to_family_S1, gene_to_family_S2, n_genes_S1, n_genes_S2, neighborhood_residuals_S1, neighborhood_residuals_S2, neighborhood_genes_S1, neighborhood_genes_S2, n_reps_S1, n_reps_S2, n_neighbors, n_points, n_bins, shared_residual_range, js_divergences, included_n_reps_S1, included_n_reps_S2, total_included_n_reps, global_js_divergence, weights, ierr) Validates its inputs, prepares what fjct_compute_jsd_impl needs, then calls it. The entry point to reach for first; see fjct_compute_jsd_expert to prepare it yourself. Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: family_idx Index of the family that should be analyzed\nThe minimum valid value is 1_int32 . integer(kind=int32), intent(in), dimension(n_genes_S1) :: gene_to_family_S1 Mapping for study 1: Each index (gene) holds the index of its family\nThe minimum valid value is 0_int32 . integer(kind=int32), intent(in), dimension(n_genes_S2) :: gene_to_family_S2 Mapping for study 2: Each index (gene) holds the index of its family\nThe minimum valid value is 0_int32 . integer(kind=int32), intent(in) :: n_genes_S1 Number of genes in study 1 integer(kind=int32), intent(in) :: n_genes_S2 Number of genes in study 2 real(kind=real64), intent(in), dimension(n_reps_S1, n_neighbors, n_points) :: neighborhood_residuals_S1 Computed neighborhood residuals for study 1, NaN is explicitly allowed for missing values\nNaN is permitted for this value. real(kind=real64), intent(in), dimension(n_reps_S2, n_neighbors, n_points) :: neighborhood_residuals_S2 Computed neighborhood residuals for study 2, NaN is explicitly allowed for missing values\nNaN is permitted for this value. integer(kind=int32), intent(in), dimension(n_neighbors, n_points) :: neighborhood_genes_S1 Indices of the selected neighborhood genes of study 1\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_genes_S1 . integer(kind=int32), intent(in), dimension(n_neighbors, n_points) :: neighborhood_genes_S2 Indices of the selected neighborhood genes of study 2\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_genes_S2 . integer(kind=int32), intent(in) :: n_reps_S1 Number of replicates in study 1 integer(kind=int32), intent(in) :: n_reps_S2 Number of replicates in study 2 integer(kind=int32), intent(in) :: n_neighbors Number of neighbors in the studies integer(kind=int32), intent(in) :: n_points Number of reference points in the studies integer(kind=int32), intent(in) :: n_bins Number of equally sized histogram bins used for the studies real(kind=real64), intent(in) :: share