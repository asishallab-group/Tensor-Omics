 argument from the n_shift_vectors_rows output produced by get_tox_data_dims . integer(kind=int32), intent(in) :: n_shift_vectors_cols Columns of the shift vectors matrix.\nIt is VERY IMPORTANT to compute this argument from the n_shift_vectors_cols output produced by get_tox_data_dims . real(kind=real64), intent(out), dimension(n_shift_vectors_rows, n_shift_vectors_cols) :: shift_vectors Shift vectors integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"module/tox_data_archive.html"},{"title":"tox_euclidean_distance_impl – TensorOmics","text":"Euclidean distances in gene expression space. euclidean_distance between two expression vectors, and distance_to_centroid from every\ngene of a family to that family's centroid -- the distance the outlier detection and the\nrelative-distance index are built on. Uses iso_fortran_env Subroutines public pure subroutine euclidean_distance_impl (vec1, vec2, n_elements, result) Author Vivian Bass License MIT Compute the Euclidean distance between two vectors. Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_elements) :: vec1 First expression vector real(kind=real64), intent(in), dimension(n_elements) :: vec2 Second expression vector integer(kind=int32), intent(in) :: n_elements Dimension of both vectors real(kind=real64), intent(out) :: result Output scalar distance public pure subroutine distance_to_centroid_impl (n_genes, n_families, genes, centroids, gene_to_fam, distances, n_tissues) Author Vivian Bass License MIT Compute distance from each gene to its corresponding family centroid. Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Total number of genes integer(kind=int32), intent(in) :: n_families Total number of gene families real(kind=real64), intent(in), dimension(n_tissues, n_genes) :: genes Gene expression matrix (n_tissues × n_genes), column-major real(kind=real64), intent(in), dimension(n_tissues, n_families) :: centroids Family centroid matrix (n_tissues × n_families), column-major, -1.0_real64 for unassigned genes integer(kind=int32), intent(in), dimension(n_genes) :: gene_to_fam Index mapping -> each index i holds the family index for the corresponding gene in genes , using 0_int32 for unassigned genes\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_families .\nThe value 0_int32 is additionally accepted. real(kind=real64), intent(out), dimension(n_genes) :: distances Output distances array integer(kind=int32), intent(in) :: n_tissues Expression vector dimension","tags":"","url":"module/tox_euclidean_distance_impl.html"},{"title":"f42_stats – TensorOmics","text":"Descriptive statistics: percentiles, empirical distribution functions, and 2-D LOESS smoothing. One of the modules the f42_utils family gathers. Generated from f42_stats_impl ; do not edit -- regenerate instead. Uses f42_stats_impl iso_fortran_env tox_errors f42_sort_impl Subroutines public pure subroutine loess_smooth_2d (n_total, n_target, x_ref, y_ref, indices_used, n_used, x_query, kernel_sigma, kernel_cutoff, y_out, ierr) Validates its inputs, then calls loess_smooth_2d_impl . Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_total Total number of reference points. integer(kind=int32), intent(in) :: n_target Number of target points to smooth. real(kind=real64), intent(in), dimension(n_total) :: x_ref Reference x-coordinates. real(kind=real64), intent(in), dimension(n_total) :: y_ref Reference y-coordinates (length n_total). integer(kind=int32), intent(in), dimension(n_used) :: indices_used Indices of reference points used for smoothing (only valid indices).\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_total . integer(kind=int32), intent(in) :: n_used Number of indices actually used for smoothing. real(kind=real64), intent(in), dimension(n_target) :: x_query Target x-coordinates to smooth. real(kind=real64), intent(in) :: kernel_sigma Bandwidth parameter for the kernel.\nThe minimum valid value is 0.0_real64 . real(kind=real64), intent(in) :: kernel_cutoff Cutoff for the kernel, not used if zero\nThe minimum valid value is 0.0_real64 . real(kind=real64), intent(out), dimension(n_target) :: y_out Output smoothed values (length n_target). integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure. public pure subroutine compute_edf (values, n_values, unique_values, cdf_values, n_unique, ierr) Validates its inputs, prepares what compute_edf_impl needs, then calls it. The entry point to reach for first; see compute_edf_expert to prepare it yourself. Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_values) :: values Array of observed data values (e.g., contributions or spikes). integer(kind=int32), intent(in) :: n_values Number of values in the input array. real(kind=real64), intent(out), dimension(n_values) :: unique_values Sorted unique data values.\nThe first n_unique elements will hold the results. real(kind=real64), intent(out), dimension(n_values) :: cdf_values Corresponding cumulative frequencies between 0 and 1.\nThe first n_unique elements will hold the results. integer(kind=int32), intent(out) :: n_unique Number of unique values found (actual size of output arrays) integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure. public pure subroutine compute_edf_expert (values, n_values, values_perm, unique_values, cdf_values, n_unique, ierr) Validates its inputs, then calls compute_edf_impl with what you supply. The expert entry point: it allocates nothing and prepares nothing; compute_edf does both. Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_values) :: values Array of observed data values (e.g., contributions or spikes). integer(kind=int32), intent(in) :: n_values Number of values in the input array. integer(kind=int32), intent(in), dimension(n_values) :: values_perm Permutation of values in ascending order. The allocating entry point builds\nand heapsorts it for you; the expert one takes whatever order you supply.\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_values . real(kind=real64), intent(out), dimension(n_values) :: unique_values Sorted unique data values.\nThe first n_unique elements will hold the results. real(kind=real64), intent(out), dimension(n_values) :: cdf_values Corresponding cumulative frequencies between 0 and 1.\nThe first n_unique elements will hold the results. integer(kind=int32), intent(out) :: n_unique Number of unique values found (actual size of output arrays) integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure. public pure subroutine calc_percentile (array, n_array, percentile, value, n_considered, ierr) Validates its inputs, prepares what calc_percentile_impl needs, then calls it. The entry point to reach for first; see calc_percentile_expert to prepare it yourself. Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_array) :: array input array integer(kind=int32), intent(in) :: n_array number of elements in array real(kind=real64), intent(in) :: percentile desired percentile as a fraction in [0,1] (e.g. 0.95 for the 95th percentile)\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 . real(kind=real64), intent(out) :: value output percentile value integer(kind=int32), intent(in), optional :: n_considered How many leading entries of array_perm the percentile is taken over, for a\npercentile of a subset -- the trailing entries are ignored rather than sliced\noff, so the permutation stays the shape the sort produced. Zero, the default,\nconsiders all n_array of them.\nThe default value is 0_int32 .\nThe minimum valid value is 0_int32 .\nThe maximum valid value is n_array . integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure. public pure subroutine calc_percentile_expert (array, n_array, array_perm, percentile, value, n_considered, ierr) Validates its inputs, then calls calc_percentile_impl with what you supply. The expert entry point: it allocates nothing and prepares nothing; calc_percentile does both. Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_array) :: array input array integer(kind=int32), intent(in) :: n_array number of elements in array integer(kind=int32), intent(in), dimension(n_array) :: array_perm Permutation of array in ascending order. The allocating entry point builds and\nheapsorts it for you; the expert one takes whatever order you supply.\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_array . real(kind=real64), intent(in) :: percentile desired percentile as a fraction in [0,1] (e.g. 0.95 for the 95th percentile)\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 . real(kind=real64), intent(out) :: value output percentile value integer(kind=int32), intent(in), optional :: n_considered How many leading entries of array_perm the percentile is taken over, for a\npercentile of a subset -- the trailing entries are ignored rather than sliced\noff, so the permutation stays the shape the sort produced. Zero, the default,\nconsiders all n_array of them.\nThe default value is 0_int32 .\nThe minimum valid value is 0_int32 .\nThe maximum valid value is n_array . integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure. public pure subroutine compute_scaled_distance_quantile (n_genes, rdi, sorted_rdi, quantile, c_const, ierr) Validates its inputs, prepares what compute_scaled_distance_quantile_impl needs, then calls it. The entry point to reach for first; see compute_scaled_distance_quantile_expert to prepare it yourself. Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Number of genes being processed. real(kind=real64), intent(in), dimension(n_genes) :: rdi empirical distribution D\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(in), dimension(n_genes) :: sorted_rdi empirical distribution D with non negative values\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(out), dimension(n_genes) :: quantile Output array to store the computed quantile for each gene. real(kind=real64), intent(in) :: c_const Constant used in the computation, typically 1 integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure. public pure subroutine compute_scaled_distance_quantile_expert (n_genes, rdi, sorted_rdi, sorted_rdi_perm, quantile, c_const, ierr) Validates its inputs, then calls compute_scaled_distance_quantile_impl with what you supply. The expert entry point: it allocates nothing and prepares nothing; compute_scaled_distance_quantile does both. Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Number of genes being processed. real(kind=real64), intent(in), dimension(n_genes) :: rdi empirical distribution D\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(in), dimension(n_genes) :: sorted_rdi empirical distribution D with non negative values\nNaN is permitted for this value.\nInfinite values are permitted for this value. integer(kind=int32), intent(in), dimension(n_genes) :: sorted_rdi_perm Permutation of sorted_rdi in ascending order. The allocating entry point builds\nand heapsorts it for you; the expert one takes whatever order you supply.\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_genes . real(kind=real64), intent(out), dimension(n_genes) :: quantile Output array to store the computed quantile for each gene. real(kind=real64), intent(in) :: c_const Constant used in the computation, typically 1 integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"module/f42_stats.html"},{"title":"f42_serde_arrays_serialize – TensorOmics","text":"Main array serialization module, re-exporting all serialization routines Uses f42_serde_arrays_serialize_real f42_serde_arrays_serialize_char f42_serde_arrays_serialize_logical f42_serde_arrays_serialize_int f42_serde_arrays_serialize_complex","tags":"","url":"module/f42_serde_arrays_serialize.html"},{"title":"tox_loess_impl_c – TensorOmics","text":"LOESS local polynomial regression smoothing, over the netlib dloess / lowesd family. Two fits: loess_fit_plain and loess_fit_robust , the latter reweighting against outliers over\na number of iterations. There is deliberately no combined entry point dispatching on a mode --\na caller chooses the routine, and supplies the weights and the evaluation points it wants. A sample too degenerate to fit (fewer distinct points than the degree needs) is answered\ndirectly from the observations rather than handed to netlib, which cannot fit one and dies\ninside its decomposition instead of reporting. Nothing about that is visible to a caller\nbeyond the result. tox_loess_required_workspace sizes the workspace for a caller that wants to own it; the\nmode and iteration constants and EPS_LOESS are here for the same reason. The netlib\nroutines themselves are not re-documented beyond their calling convention. Uses f42_safeguard iso_c_binding tox_errors Subroutines public  subroutine tox_loess_required_workspace_c (n_dim, max_neighborhood_size, int_workspace_size, real_workspace_size, save_factorization, ierr) bind(C, name=\"tox_loess_required_workspace_c\") C-wrapper for tox_loess_required_workspace Read more… Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_dim Dimensionality of the data integer(kind=c_int), intent(in), target :: max_neighborhood_size Maximum neighborhood size integer(kind=c_int), intent(out), target :: int_workspace_size Required size of the integer workspace array integer(kind=c_int), intent(out), target :: real_workspace_size Required size of the real workspace array logical(kind=c_bool), intent(in), target :: save_factorization Save matrix factorization flag integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"module/tox_loess_impl_c.html"},{"title":"tox_data_accessors – TensorOmics","text":"Bounds-checked lookup and indexing helpers for the TensorOmics data model. Thin accessors over the raw gene/family arrays produced and consumed elsewhere in tox_data_* (e.g. read_tox_data ): given an index, return the\ncorresponding row/column/slice with bounds and shape checks; given an ID string, find its index. Uses iso_fortran_env tox_errors Functions public  function get_gene_index (gene_ids, gene) result(idx) Author Aaron Schröder License MIT Helper function to find gene index Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: gene_ids (:) gene ids array character(len=*), intent(in) :: gene gene to look for Return Value integer(kind=int32) public  function get_family_index (family_ids, family) result(idx) Author Aaron Schröder License MIT Helper function to find family index Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: family_ids (:) family ids array character(len=*), intent(in) :: family family to look for Return Value integer(kind=int32) Subroutines public  subroutine get_family_for_gene_index (gene_idx, gene_to_fam, out_family_idx, ierr) Author Aaron Schröder License MIT returns family index for gene index Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: gene_idx gene index integer(kind=int32), intent(in) :: gene_to_fam (:) gene to family mapping integer(kind=int32), intent(out) :: out_family_idx family index integer(kind=int32), intent(out) :: ierr error code public  subroutine get_expression_vector (gene_idx, expression_vectors, out_vector, ierr) Author Aaron Schröder License MIT get expression vector for a specific gene id Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: gene_idx target gene index real(kind=real64), intent(in) :: expression_vectors (:,:) expression vectors real(kind=real64), intent(out) :: out_vector (:) output vector integer(kind=int32), intent(out) :: ierr error code public  subroutine get_family_centroid (family_idx, family_centroids, out_centroid, ierr) Author Aaron Schröder License MIT get family centroid for a specific family index Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: family_idx Target index real(kind=real64), intent(in) :: family_centroids (:,:) centroid array real(kind=real64), intent(out) :: out_centroid (:) Output centroid integer(kind=int32), intent(out) :: ierr Error code public  subroutine get_shift_components (gene_idx, shift_vectors, d, out_start, out_shift, ierr) Author Aaron Schröder License MIT returns the centroid and the shift of a gene Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: gene_idx gene index to look for real(kind=real64), intent(in) :: shift_vectors (:,:) shift vectors integer(kind=int32), intent(in) :: d number of tissues real(kind=real64), intent(out) :: out_start (:) centroid of the genes family real(kind=real64), intent(out) :: out_shift (:) shift vector of the gene integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"module/tox_data_accessors.html"},{"title":"tox_normalization – TensorOmics","text":"Normalization of expression data: putting samples on a comparable scale before anything\ndistance-based is computed from them. Several schemes, each its own entry point rather than a mode: a log2 transformation, scaling\nby standard deviation (LOESS-smoothed against expression level, so the correction follows the\nmean-variance trend rather than assuming one), root-mean-square scaling, quantile\nnormalization, and normalization to unit length. normalization_pipeline chains them in the order the analysis expects, and is what most\ncallers want. The individual routines are published for a caller assembling their own. Generated from tox_normalization_impl ; do not edit -- regenerate instead. Uses iso_fortran_env iso_c_binding tox_normalization_impl f42_safeguard tox_errors tox_loess_impl Subroutines public pure subroutine normalize_unit_length (vector, n_dims, ierr) Validates its inputs, then calls normalize_unit_length_impl . Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(inout), dimension(n_dims) :: vector Vector that will be normalized to unit length\nNaN is permitted for this value.\nInfinite values are permitted for this value. integer(kind=int32), intent(in) :: n_dims number of elements in vector integer(kind=int32), intent(out) :: ierr Error code public  subroutine normalization_pipeline (n_genes, n_replicates, expr, log_transformed_expr, reps_per_tissue, n_tissues, span, degree, use_quantile, ierr) Validates its inputs, prepares what normalization_pipeline_impl needs, then calls it. The entry point to reach for first; see normalization_pipeline_expert to prepare it yourself. Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Number of genes (rows) integer(kind=int32), intent(in) :: n_replicates Number of replicates per gene real(kind=real64), intent(in), dimension(n_replicates, n_genes) :: expr Gene Expression matrix\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(out), dimension(n_tissues, n_genes) :: log_transformed_expr Log-transformed grouped expr integer(kind=int32), intent(in), dimension(n_tissues) :: reps_per_tissue Number of replicates per tissue in expr . It describes, which slices in expr relate to which tissue,\ne.g. [2,3] means 5 total replicates per gene, the first two of which belong to the first tissue and the remaining three to the second. integer(kind=int32), intent(in) :: n_tissues Number of tissues real(kind=real64), intent(in), optional :: span LOESS span parameter.\nThe default value is 0.7_real64 . integer(kind=int32), intent(in), optional :: degree LOESS degree parameter.\nThe default value is 2_int32 . logical(kind=c_bool), intent(in), optional :: use_quantile Use quantile normalization.\nThe default value is .false. . integer(kind=int32), intent(out) :: ierr Error code public  subroutine normalization_pipeline_expert (n_genes, n_replicates, expr, log_transformed_expr, reps_per_tissue, n_tissues, tmp_expr_copy, tmp_loess_y, tmp_indices_used, tmp_yhat_global, tmp_int_workspace, int_workspace_size, tmp_real_workspace, real_workspace_size, tmp_hat_diag, tmp_loess_weights, tmp_eval_points, tmp_robust_weights, tmp_combined_weights, tmp_residuals, tmp_permutation_indices, span, degree, use_quantile, ierr) Validates its inputs, then calls normalization_pipeline_impl with what you supply. The expert entry point: it allocates nothing and prepares nothing; normalization_pipeline does both. Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Number of genes (rows) integer(kind=int32), intent(in) :: n_replicates Number of replicates per gene real(kind=real64), intent(in), dimension(n_replicates, n_genes) :: expr Gene Expression matrix\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(out), dimension(n_tissues, n_genes) :: log_transformed_expr Log-transformed grouped expr integer(kind=int32), intent(in), dimension(n_tissues) :: reps_per_tissue Number of replicates per tissue in expr . It describes, which slices in expr relate to which tissue,\ne.g. [2,3] means 5 total replicates per gene, the first two of which belong to the first tissue and the remaining three to the second. integer(kind=int32), intent(in) :: n_tissues Number of tissues real(kind=real64), intent(out), dimension(n_replicates, n_genes) :: tmp_expr_copy Work matrix the pipeline normalizes in place real(kind=real64), intent(out), dimension(n_genes) :: tmp_loess_y Work vector for the empirical standard deviations (Y-axis for LOESS) integer(kind=int32), intent(out), dimension(n_genes) :: tmp_indices_used Work vector mapping the fitted points back to gene indices real(kind=real64), intent(out), dimension(n_genes) :: tmp_yhat_global Work vector for the fitted standard deviations (LOESS predictions) integer(kind=int32), intent(out), dimension(int_workspace_size) :: tmp_int_workspace Integer workspace array integer(kind=int32), intent(in) :: int_workspace_size Length of integer workspace.\nIt is VERY IMPORTANT to compute this argument from the int_workspace_size output produced by tox_loess_required_workspace . Read more… real(kind=real64), intent(out), dimension(real_workspace_size) :: tmp_real_workspace Real workspace array integer(kind=int32), intent(in) :: real_workspace_size Length of real workspace.\nIt is VERY IMPORTANT to compute this argument from the real_workspace_size output produced by tox_loess_required_workspace . Read more… real(kind=real64), intent(out), dimension(n_genes) :: tmp_hat_diag Diagonal elements of the LOESS hat matrix real(kind=real64), intent(out), dimension(n_genes) :: tmp_loess_weights Per-point weights handed to the LOESS fit real(kind=real64), intent(out), dimension(n_genes, 1) :: tmp_eval_points Points the fitted curve is evaluated at real(kind=real64), intent(out), dimension(n_genes) :: tmp_robust_weights Robust bisquare weights of the LOESS fit real(kind=real64), intent(out), dimension(n_genes) :: tmp_combined_weights Combined weights of the LOESS fit real(kind=real64), intent(out), dimension(n_genes) :: tmp_residuals Residuals of the LOESS fit integer(kind=int32), intent(out), dimension(n_genes) :: tmp_permutation_indices Permutation indices of the LOESS fit real(kind=real64), intent(in), optional :: span LOESS span parameter.\nThe default value is 0.7_real64 . integer(kind=int32), intent(in), optional :: degree LOESS degree parameter.\nThe default value is 2_int32 . logical(kind=c_bool), intent(in), optional :: use_quantile Use quantile normalization.\nThe default value is .false. . integer(kind=int32), intent(out) :: ierr Error code public  subroutine normalize_by_std_dev (n_genes, n_replicates, expr, normalized_expr, span, degree, ierr) Validates its inputs, prepares what normalize_by_std_dev_impl needs, then calls it. The entry point to reach for first; see normalize_by_std_dev_expert to prepare it yourself. Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Number of genes (rows) integer(kind=int32), intent(in) :: n_replicates Number of replicates per gene real(kind=real64), intent(in), dimension(n_replicates, n_genes) :: expr Gene Expression matrix\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(out), dimension(n_replicates, n_genes) :: normalized_expr Normalized expr real(kind=real64), intent(in), optional :: span LOESS span parameter.\nThe default value is 0.7_real64 . integer(kind=int32), intent(in), optional :: degree LOESS degree parameter.\nThe default value is 2_int32 . integer(kind=int32), intent(out) :: ierr Error code public  subroutine normalize_by_std_dev_expert (n_genes, n_replicates, expr, normalized_expr, tmp_loess_x, tmp_loess_y, tmp_indices_used, tmp_yhat_global, tmp_int_workspace, int_workspace_size, tmp_real_workspace, real_workspace_size, tmp_hat_diag, tmp_loess_weights, tmp_eval_points, tmp_robust_weights, tmp_combined_weights, tmp_residuals, tmp_permutation_indices, span, degree, ierr) Validates its inputs, then calls normalize_by_std_dev_impl with what you supply. The expert entry point: it allocates nothing and prepares nothing; normalize_by_std_dev does both. Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Number of genes (rows) integer(kind=int32), intent(in) :: n_replicates Number of replicates per gene real(kind=real64), intent(in), dimension(n_replicates, n_genes) :: expr Gene Expression matrix\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(out), dimension(n_replicates, n_genes) :: normalized_expr Normalized expr real(kind=real64), intent(out), dimension(n_genes) :: tmp_loess_x Work vector for the mean values (X-axis for LOESS) real(kind=real64), intent(out), dimension(n_genes) :: tmp_loess_y Work vector for the empirical standard deviations (Y-axis for LOESS) integer(kind=int32), intent(out), dimension(n_genes) :: tmp_indices_used Work vector mapping the fitted points back to gene indices real(kind=real64), intent(out), dimension(n_genes) :: tmp_yhat_global Work vector for the fitted standard deviations (LOESS predictions) integer(kind=int32), intent(out), dimension(int_workspace_size) :: tmp_int_workspace Integer workspace array integer(kind=int32), intent(in) :: int_workspace_size Length of integer workspace.\nIt is VERY IMPORTANT to compute this argument from the int_workspace_size output produced by tox_loess_required_workspace . Read more… real(kind=real64), intent(out), dimension(real_workspace_size) :: tmp_real_workspace Real workspace array integer(kind=int32), intent(in) :: real_workspace_size Length of real workspace.\nIt is VERY IMPORTANT to compute this argument from the real_workspace_size output produced by tox_loess_required_workspace . Read more… real(kind=real64), intent(out), dimension(n_genes) :: tmp_hat_diag Diagonal elements of the LOESS hat matrix real(kind=real64), intent(out), dimension(n_genes) :: tmp_loess_weights Per-point weights handed to the LOESS fit real(kind=real64), intent(out), dimension(n_genes, 1) :: tmp_eval_points Points the fitted curve is evaluated at real(kind=real64), intent(out), dimension(n_genes) :: tmp_robust_weights Robust bisquare weights of the LOESS fit real(kind=real64), intent(out), dimension(n_genes) :: tmp_combined_weights Combined weights of the LOESS fit real(kind=real64), intent(out), dimension(n_genes) :: tmp_residuals Residuals of the LOESS fit integer(kind=int32), intent(out), dimension(n_genes) :: tmp_permutation_indices Permutation indices of the LOESS fit real(kind=real64), intent(in), optional :: span LOESS span parameter.\nThe default value is 0.7_real64 . integer(kind=int32), intent(in), optional :: degree LOESS degree parameter.\nThe default value is 2_int32 . integer(kind=int32), intent(out) :: ierr Error code public pure subroutine root_mean_sq_normalization (n_genes, n_replicates, expr, normalized_expr, ierr) Validates its inputs, then calls root_mean_sq_normalization_impl . Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Number of genes (rows) integer(kind=int32), intent(in) :: n_replicates Number of replicates per gene real(kind=real64), intent(in), dimension(n_replicates, n_genes) :: expr Gene Expression matrix\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(out), dimension(n_replicates, n_genes) :: normalized_expr Normalized expr integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure. public pure subroutine quantile_normalization (n_genes, n_replicates, expr, normalized_expr, rank_means, ierr) Validates its inputs, prepares what quantile_normalization_impl needs, then calls it. The entry point to reach for first; see quantile_normalization_expert to prepare it yourself. Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Number of genes (rows) integer(kind=int32), intent(in) :: n_replicates Number of replicates per gene real(kind=real64), intent(in), dimension(n_replicates, n_genes) :: expr Gene Expression matrix\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(out), dimension(n_replicates, n_genes) :: normalized_expr Normalized expr real(kind=real64), intent(out), dimension(n_genes) :: rank_means The mean of each rank across tissues, one per gene integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure. public pure subroutine quantile_normalization_expert (n_genes, n_replicates, expr, normalized_expr, rank_means, tmp_genes_row, tmp_perm, ierr) Validates its inputs, then calls quantile_normalization_impl with what you supply. The expert entry point: it allocates nothing and prepares nothing; quantile_normalization does both. Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Number of genes (rows) integer(kind=int32), intent(in) :: n_replicates Number of replicates per gene real(kind=real64), intent(in), dimension(n_replicates, n_genes) :: expr Gene Expression matrix\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(out), dimension(n_replicates, n_genes) :: normalized_expr Normalized expr real(kind=real64), intent(out), dimension(n_genes) :: rank_means The mean of each rank across tissues, one per gene real(kind=real64), intent(out), dimension(n_genes) :: tmp_genes_row Temporary vector for sorting a tissue in expr across genes integer(kind=int32), intent(out), dimension(n_genes) :: tmp_perm Permutation vector integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure. public pure subroutine log2_transformation (n_genes, n_tissues, expr, transformed_expr, ierr) Validates its inputs, then calls log2_transformation_impl . Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Number of genes (rows) integer(kind=int32), intent(in) :: n_tissues Number of tissues real(kind=real64), intent(in), dimension(n_tissues, n_genes) :: expr Gene Expression matrix, from calc_tiss_avg NaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(out), dimension(n_tissues, n_genes) :: transformed_expr Log-transformed expr integer(kind=int32), intent(out) :: ierr Error code public pure subroutine calc_tiss_avg (n_genes, n_tissues, reps_per_tissue, expr, tissue_averages, ierr) Validates its inputs, then calls calc_tiss_avg_impl . Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Number of genes (rows) integer(kind=int32), intent(in) :: n_tissues Number of tissues integer(kind=int32), intent(in), dimension(n_tissues) :: reps_per_tissue Number of replicates per tissue in expr . It describes, which slices in expr relate to which tissue,\ne.g. [2,3] means 5 total replicates per gene, the first two of which belong to the first tissue and the remaining three to the second.\nThe minimum valid value is 1_int32 . real(kind=real64), intent(in), dimension(sum(reps_per_tissue), n_genes) :: expr Gene Expression matrix\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(out), dimension(n_tissues, n_genes) :: tissue_averages Tissue averages per gene integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure. public pure subroutine calc_fchange (n_genes, n_tissues, n_pairs, control_tissues, condition_tissues, expr, fold_changes, ierr) Validates its inputs, then calls calc_fchange_impl . Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Number of genes (rows) integer(kind=int32), intent(in) :: n_tissues Number of tissues integer(kind=int32), intent(in) :: n_pairs Number of control-condition pairs integer(kind=int32), intent(in), dimension(n_pairs) :: control_tissues Control tissue indices\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_tissues . integer(kind=int32), intent(in), dimension(n_pairs) :: condition_tissues Condition tissue indices\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_tissues . real(kind=real64), intent(in), dimension(n_tissues, n_genes) :: expr Gene Expression matrix, from calc_tiss_avg NaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(out), dimension(n_pairs, n_genes) :: fold_changes Output matrix for fold changes integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"module/tox_normalization.html"},{"title":"f42_serde_arrays_serialize_char_c – TensorOmics","text":"Module for serializing character arrays into files Uses f42_safeguard iso_c_binding tox_errors Subroutines public  subroutine serialize_char_helper_c (arr, arr_strlen, n_strings, arr_shape, n_arr_shape_elements, filename, filename_strlen, ierr) bind(C, name=\"serialize_char_helper_c\") C-wrapper for serialize_char_helper Read more… Arguments Type Intent Optional Attributes Name character(kind=c_char, len=1), intent(in), dimension(arr_strlen, *), target :: arr Array to be serialized integer(kind=c_int), intent(in), target :: arr_strlen length of the strings in arr integer(kind=c_int), intent(in), target :: n_strings Number of strings in arr integer(kind=c_int), intent(in), dimension(n_arr_shape_elements), target :: arr_shape Extents of arr , one per dimension integer(kind=c_int), intent(in), target :: n_arr_shape_elements number of elements in arr_shape character(kind=c_char, len=1), intent(in), dimension(filename_strlen), target :: filename Name of the file to write to integer(kind=c_int), intent(in), target :: filename_strlen length of the strings in filename integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"module/f42_serde_arrays_serialize_char_c.html"},{"title":"tox_trajectory_normalization – TensorOmics","text":"Min-max normalization of factor trajectories over time. Each factor's time series is rescaled to [0,1] independently, per sample -- so trajectories\nof very different magnitudes can be compared by shape. normalize_single_trajectory does one; normalize_all_trajectories does a whole tensor of them in one call. Generated from tox_trajectory_normalization_impl ; do not edit -- regenerate instead. Uses tox_trajectory_normalization_impl iso_fortran_env tox_errors Subroutines public pure subroutine normalize_variable_timeseries (v, v_norm, n_points, status, ierr) Validates its inputs, then calls normalize_variable_timeseries_impl . Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_points) :: v Original time series real(kind=real64), intent(out), dimension(n_points) :: v_norm Normalized time series integer(kind=int32), intent(in) :: n_points Vector length (number of time points) integer(kind=int32), intent(out) :: status Status code for specific warnings integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure. public pure subroutine normalize_single_trajectory (trajectory, trajectory_norm, n_factors, n_timepoints, status, ierr) Validates its inputs, then calls normalize_single_trajectory_impl . Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_timepoints, n_factors) :: trajectory Original trajectory for one sample real(kind=real64), intent(out), dimension(n_timepoints, n_factors) :: trajectory_norm Normalized trajectory for one sample integer(kind=int32), intent(in) :: n_factors Number of factors/variables integer(kind=int32), intent(in) :: n_timepoints Number of time points integer(kind=int32), intent(out), dimension(n_factors) :: status Status code for specific warnings, one per factor integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure. public pure subroutine normalize_all_trajectories (trajectories, trajectories_norm, n_factors, n_samples, n_timepoints, status, ierr) Validates its inputs, prepares what normalize_all_trajectories_impl needs, then calls it. The entry point to reach for first; see normalize_all_trajectories_expert to prepare it yourself. Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_factors, n_samples, n_timepoints) :: trajectories Original trajectories real(kind=real64), intent(out), dimension(n_factors, n_samples, n_timepoints) :: trajectories_norm Normalized trajectories integer(kind=int32), intent(in) :: n_factors Number of factors integer(kind=int32), intent(in) :: n_samples Number of samples/entities integer(kind=int32), intent(in) :: n_timepoints Number of time points integer(kind=int32), intent(out), dimension(n_factors, n_samples) :: status Status code for specific warnings, one per factor per sample integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure. public pure subroutine normalize_all_trajectories_expert (trajectories, trajectories_norm, n_factors, n_samples, n_timepoints, tmp_series, tmp_series_norm, status, ierr) Validates its inputs, then calls normalize_all_trajectories_impl with what you supply. The expert entry point: it allocates nothing and prepares nothing; normalize_all_trajectories does both. Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_factors, n_samples, n_timepoints) :: trajectories Original trajectories real(kind=real64), intent(out), dimension(n_factors, n_samples, n_timepoints) :: trajectories_norm Normalized trajectories integer(kind=int32), intent(in) :: n_factors Number of factors integer(kind=int32), intent(in) :: n_samples Number of samples/entities integer(kind=int32), intent(in) :: n_timepoints Number of time points real(kind=real64), intent(out), dimension(n_timepoints) :: tmp_series Work array: one factor's time series, gathered contiguously real(kind=real64), intent(out), dimension(n_timepoints) :: tmp_series_norm Work array: the normalized time series integer(kind=int32), intent(out), dimension(n_factors, n_samples) :: status Status code for specific warnings, one per factor per sample integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"module/tox_trajectory_normalization.html"},{"title":"tox_get_outliers_c – TensorOmics","text":"Gene outliers, from how far each gene sits from its family's centroid. The pipeline is three steps, each callable on its own. compute_rdi turns raw distances into\na relative distance index, scaled per family so families of different spread are comparable. compute_family_scaling fits that scaling with LOESS against family size. identify_outliers applies the threshold and reports which genes exceed it. detect_outliers runs all three in one call, and is the entry point to reach for first. Uses f42_safeguard tox_conversions iso_c_binding tox_errors Subroutines public  subroutine compute_family_scaling_c (n_genes, n_families, distances, gene_to_fam, dscale, loess_x, loess_y, indices_used, span, degree, mode, n_iters, low_sd_cutoff, excluded_low_sd, ierr) bind(C, name=\"compute_family_scaling_c\") C-wrapper for compute_family_scaling Read more… Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_genes Total number of genes integer(kind=c_int), intent(in), target :: n_families Total number of gene families real(kind=c_double), intent(in), dimension(n_genes), target :: distances Array of Euclidean distances for each gene\nNaN is permitted for this value.\nInfinite values are permitted for this value. integer(kind=c_int), intent(in), dimension(n_genes), target :: gene_to_fam Mapping of each gene to its family (1-based) real(kind=c_double), intent(out), dimension(n_families), target :: dscale Array of scaling factors per family (output) real(kind=c_double), intent(out), dimension(n_families), target :: loess_x Reference x-coordinates for LOESS smoothing real(kind=c_double), intent(out), dimension(n_families), target :: loess_y Reference y-coordinates for LOESS smoothing integer(kind=c_int), intent(out), dimension(n_families), target :: indices_used Indices of reference points used for smoothing real(kind=c_double), intent(in), target :: span Span parameter for LOESS smoothing, passed straight to loess_fit_plain_impl , so it is held to that\nprocedure's own range rather than to the NaN tolerance the distance data carries.\nThe default value is 0.7_real64 .\nThe minimum valid value is EPS_LOESS .\nThe maximum valid value is 1.0_real64 . integer(kind=c_int), intent(in), target :: degree Degree of the LOESS polynomial\nThe default value is 2_int32 . character(kind=c_char, len=1), intent(in), dimension(6), target :: mode Mode for LOESS fitting\nThe default value is 'robust' . Read more… integer(kind=c_int), intent(in), target :: n_iters Number of iterations for robust LOESS fitting\nThe default value is 3_int32 . real(kind=c_double), intent(out), target :: low_sd_cutoff cutoff used to filter families with low std integer(kind=c_int), intent(out), dimension(n_families), target :: excluded_low_sd Mask to save those families that have low sd integer(kind=c_int), intent(out), target :: ierr Error code public  subroutine compute_family_scaling_expert_c (n_genes, n_families, distances, gene_to_fam, dscale, loess_x, loess_y, indices_used, tmp_perm, tmp_stack_left, tmp_stack_right, tmp_int_workspace, int_workspace_size, tmp_real_workspace, real_workspace_size, tmp_diagl, tmp_weights, tmp_eval_points, tmp_robust_weights, tmp_combined_weights, tmp_residuals, tmp_permutation_indices, tmp_fitted_values, span, degree, mode, n_iters, low_sd_cutoff, excluded_low_sd, tmp_means_aux, ierr) bind(C, name=\"compute_family_scaling_expert_c\") C-wrapper for compute_family_scaling_expert Read more… Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_genes Total number of genes integer(kind=c_int), intent(in), target :: n_families Total number of gene families real(kind=c_double), intent(in), dimension(n_genes), target :: distances Array of Euclidean distances for each gene\nNaN is permitted for this value.\nInfinite values are permitted for this value. integer(kind=c_int), intent(in), dimension(n_genes), target :: gene_to_fam Mapping of each gene to its family (1-based) real(kind=c_double), intent(out), dimension(n_families), target :: dscale Array of scaling factors per family (output) real(kind=c_double), intent(out), dimension(n_families), target :: loess_x Reference x-coordinates for LOESS smoothing real(kind=c_double), intent(out), dimension(n_families), target :: loess_y Reference y-coordinates for LOESS smoothing integer(kind=c_int), intent(out), dimension(n_families), target :: indices_used Indices of reference points used for smoothing integer(kind=c_int), intent(out), dimension(n_genes), target :: tmp_perm Permutation array for sorting gene distances integer(kind=c_int), intent(out), dimension(n_genes), target :: tmp_stack_left Stack array for left indices during sorting integer(kind=c_int), intent(out), dimension(n_genes), target :: tmp_stack_right Stack array for right indices during sorting integer(kind=c_int), intent(out), dimension(int_workspace_size), target :: tmp_int_workspace Integer workspace array integer(kind=c_int), intent(in), target :: int_workspace_size Length of integer workspace.\nIt is VERY IMPORTANT to compute this argument from the int_workspace_size output produced by tox_loess_required_workspace . Read more… real(kind=c_double), intent(out), dimension(real_workspace_size), target :: tmp_real_workspace Real workspace array integer(kind=c_int), intent(in), target :: real_workspace_size Length of real workspace.\nIt is VERY IMPORTANT to compute this argument from the real_workspace_size output produced by tox_loess_required_workspace . Read more… real(kind=c_double), intent(inout), dimension(n_families), target :: tmp_diagl Diagonal elements of the weight matrix real(kind=c_double), intent(out), dimension(n_families), target :: tmp_weights Initial weights for LOESS real(kind=c_double), intent(inout), dimension(n_families, 1), target :: tmp_eval_points Z matrix for LOESS fitting real(kind=c_double), intent(out), dimension(n_families), target :: tmp_robust_weights Residuals for robust LOESS fitting real(kind=c_double), intent(out), dimension(n_families), target :: tmp_combined_weights Working weights array real(kind=c_double), intent(out), dimension(n_families), target :: tmp_residuals Residuals array integer(kind=c_int), intent(out), dimension(n_families), target :: tmp_permutation_indices Permutation indices for robust LOESS fitting real(kind=c_double), intent(out), dimension(n_families), target :: tmp_fitted_values Output array for LOESS predictions real(kind=c_double), intent(in), target :: span Span parameter for LOESS smoothing, passed straight to loess_fit_plain_impl , so it is held to that\nprocedure's own range rather than to the NaN tolerance the distance data carries.\nThe default value is 0.7_real64 .\nThe minimum valid value is EPS_LOESS .\nThe maximum valid value is 1.0_real64 . integer(kind=c_int), intent(in), target :: degree Degree of the LOESS polynomial\nThe default value is 2_int32 . character(kind=c_char, len=1), intent(in), dimension(6), target :: mode Mode for LOESS fitting\nThe default value is 'robust' . Read more… integer(kind=c_int), intent(in), target :: n_iters Number of iterations for robust LOESS fitting\nThe default value is 3_int32 . real(kind=c_double), intent(out), target :: low_sd_cutoff cutoff used to filter families with low std integer(kind=c_int), intent(out), dimension(n_families), target :: excluded_low_sd Mask to save those families that have low sd real(kind=c_double), intent(out), dimension(n_families), target :: tmp_means_aux Work array for saving raw means integer(kind=c_int), intent(out), target :: ierr Error code public  subroutine compute_rdi_c (n_genes, distances, gene_to_fam, dscale, n_dscale_elements, rdi, sorted_rdi, perm, ierr) bind(C, name=\"compute_rdi_c\") C-wrapper for compute_rdi Read more… Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_genes Total number of genes real(kind=c_double), intent(in), dimension(n_genes), target :: distances Array of Euclidean distances for each gene to its centroid\nNaN is permitted for this value.\nInfinite values are permitted for this value. integer(kind=c_int), intent(in), dimension(n_genes), target :: gene_to_fam Gene-to-family mapping (1-based indexing) real(kind=c_double), intent(in), dimension(n_dscale_elements), target :: dscale Array of scaling factors for each family\nNaN is permitted for this value.\nInfinite values are permitted for this value. integer(kind=c_int), intent(in), target :: n_dscale_elements number of elements in dscale real(kind=c_double), intent(out), dimension(n_genes), target :: rdi Output array of RDI values for each gene real(kind=c_double), intent(out), dimension(n_genes), target :: sorted_rdi Work array for sorting (dimension n_genes) integer(kind=c_int), intent(out), dimension(n_genes), target :: perm Permutation array for sorting (dimension n_genes, should be pre-initialized with 1:n_genes) integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure. public  subroutine compute_rdi_expert_c (n_genes, distances, gene_to_fam, dscale, n_dscale_elements, rdi, sorted_rdi, perm, tmp_stack_left, tmp_stack_right, ierr) bind(C, name=\"compute_rdi_expert_c\") C-wrapper for compute_rdi_expert Read more… Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_genes Total number of genes real(kind=c_double), intent(in), dimension(n_genes), target :: distances Array of Euclidean distances for each gene to its centroid\nNaN is permitted for this value.\nInfinite values are permitted for this value. integer(kind=c_int), intent(in), dimension(n_genes), target :: gene_to_fam Gene-to-family mapping (1-based indexing) real(kind=c_double), intent(in), dimension(n_dscale_elements), target :: dscale Array of scaling factors for each family\nNaN is permitted for this value.\nInfinite values are permitted for this value. integer(kind=c_int), intent(in), target :: n_dscale_elements number of elements in dscale real(kind=c_double), intent(out), dimension(n_genes), target :: rdi Output array of RDI values for each gene real(kind=c_double), intent(out), dimension(n_genes), target :: sorted_rdi Work array for sorting (dimension n_genes) integer(kind=c_int), intent(out), dimension(n_genes), target :: perm Permutation array for sorting (dimension n_genes, should be pre-initialized with 1:n_genes) integer(kind=c_int), intent(out), dimension(n_genes), target :: tmp_stack_left Stack array for sorting (dimension n_genes) integer(kind=c_int), intent(out), dimension(n_genes), target :: tmp_stack_right Stack array for sorting (dimension n_genes) integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure. public  subroutine identify_outliers_c (n_genes, rdi, sorted_rdi, perm, is_outlier, threshold, quantile, percentile, ierr) bind(C, name=\"identify_outliers_c\") C-wrapper for identify_outliers Read more… Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_genes Total number of genes real(kind=c_double), intent(in), dimension(n_genes), target :: rdi Array of RDI values for each gene\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=c_double), intent(in), dimension(n_genes), target :: sorted_rdi Sorted RDI array (must be filtered to remove negatives and sorted in ascending order before calling)\nNaN is permitted for this value.\nInfinite values are permitted for this value. integer(kind=c_int), intent(in), dimension(n_genes), target :: perm Permutation array with sorted indices logical(kind=c_bool), intent(out), dimension(n_genes), target :: is_outlier Output boolean array indicating outliers real(kind=c_double), intent(out), target :: threshold Output threshold value used for detection real(kind=c_double), intent(out), dimension(n_genes), target :: quantile Empirical one-sided upper-tail quantile (effect-size measure) for each gene, i.e. how extreme an\nobserved distance is relative to all observed distances -- NOT a null-hypothesis-testing p-value.\nReturned in the same order as the input RDI array. Because distances are non-negative, a one-sided\nupper-tail quantile is used. real(kind=c_double), intent(in), target :: percentile Percentile threshold as a fraction in [0,1] (top 5% for the default).\nThe default value is 0.95_real64 .\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 . integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure. public  subroutine detect_outliers_c (n_genes, n_families, distances, gene_to_fam, is_outlier, loess_x, loess_y, loess_n, quantile, ierr, percentile) bind(C, name=\"detect_outliers_c\") C-wrapper for detect_outliers Read more… Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_genes Total number of genes integer(kind=c_int), intent(in), target :: n_families Total number of gene families real(kind=c_double), intent(in), dimension(n_genes), target :: distances Array of Euclidean distances for each gene to its centroid\nNaN is permitted for this value.\nInfinite values are permitted for this value. integer(kind=c_int), intent(in), dimension(n_genes), target :: gene_to_fam Gene-to-family mapping (1-based indexing) logical(kind=c_bool), intent(out), dimension(n_genes), target :: is_outlier Output boolean array indicating outliers real(kind=c_double), intent(out), dimension(n_families), target :: loess_x Reference x-coordinates. real(kind=c_double), intent(out), dimension(n_families), target :: loess_y Reference y-coordinates (length n_total). integer(kind=c_int), intent(out), dimension(n_families), target :: loess_n Indices of reference points used for smoothing. real(kind=c_double), intent(out), dimension(n_genes), target :: quantile Empirical one-sided upper-tail quantile (effect-size measure) for each gene, i.e. how extreme an\nobserved distance is relative to all observed distances -- NOT a null-hypothesis-testing p-value.\nReturned in the same order as the input RDI array. Because distances are non-negative, a one-sided\nupper-tail quantile is used. integer(kind=c_int), intent(out), target :: ierr Error code real(kind=c_double), intent(in), target :: percentile Percentile threshold as a fraction in [0,1] for outlier detection.\nThe default value is 0.95_real64 .\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 . public  subroutine detect_outliers_expert_c (n_genes, n_families, distances, gene_to_fam, tmp_perm, tmp_stack_left, tmp_stack_right, tmp_int_workspace, int_workspace_size, tmp_real_workspace, real_workspace_size, tmp_diagl, tmp_weights, tmp_eval_points, tmp_robust_weights, tmp_combined_weights, tmp_residuals, tmp_permutation_indices, tmp_fitted_values, tmp_means_aux, tmp_dscale, tmp_excluded_low_sd, tmp_low_sd_cutoff, tmp_rdi, tmp_sorted_rdi, tmp_threshold, is_outlier, loess_x, loess_y, loess_n, quantile, ierr, percentile) bind(C, name=\"detect_outliers_expert_c\") C-wrapper for detect_outliers_expert Read more… Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_genes Total number of genes integer(kind=c_int), intent(in), target :: n_families Total number of gene families real(kind=c_double), intent(in), dimension(n_genes), target :: distances Array of Euclidean distances for each gene to its centroid\nNaN is permitted for this value.\nInfinite values are permitted for this value. integer(kind=c_int), intent(in), dimension(n_genes), target :: gene_to_fam Gene-to-family mapping (1-based indexing) integer(kind=c_int), intent(out), dimension(n_genes), target :: tmp_perm Permutation array for sorting integer(kind=c_int), intent(out), dimension(n_genes), target :: tmp_stack_left Stack array for left indices during sorting integer(kind=c_int), intent(out), dimension(n_genes), target :: tmp_stack_right Stack array for right indices during sorting integer(kind=c_int), intent(out), dimension(int_workspace_size), target :: tmp_int_workspace Integer workspace array integer(kind=c_int), intent(in), target :: int_workspace_size Length of integer workspace.\nIt is VERY IMPORTANT to compute this argument from the int_workspace_size output produced by tox_loess_required_workspace . Read more… real(kind=c_double), intent(out), dimension(real_workspace_size), target :: tmp_real_workspace Real workspace array integer(kind=c_int), intent(in), target :: real_workspace_size Length of real workspace.\nIt is VERY IMPORTANT to compute this argument from the real_workspace_size output produced by tox_loess_required_workspace . Read more… real(kind=c_double), intent(out), dimension(n_families), target :: tmp_diagl Diagonal elements of the weight matrix real(kind=c_double), intent(out), dimension(n_families), target :: tmp_weights Initial weights for LOESS real(kind=c_double), intent(out), dimension(n_families, 1), target :: tmp_eval_points Z matrix for LOESS fitting real(kind=c_double), intent(out), dimension(n_families), target :: tmp_robust_weights Residuals for robust LOESS fitting real(kind=c_double), intent(out), dimension(n_families), target :: tmp_combined_weights Working weights array real(kind=c_double), intent(out), dimension(n_families), target :: tmp_residuals Residuals array integer(kind=c_int), intent(out), dimension(n_families), target :: tmp_permutation_indices Permutation indices for robust LOESS fitting real(kind=c_double), intent(out), dimension(n_families), target :: tmp_fitted_values Output array for LOESS predictions real(kind=c_double), intent(out), dimension(n_families), target :: tmp_means_aux Work array for saving raw means real(kind=c_double), intent(out), dimension(n_families), target :: tmp_dscale Per-family scaling factors (intermediate, consumed by the RDI step) integer(kind=c_int), intent(out), dimension(n_families), target :: tmp_excluded_low_sd Low-sd family mask (intermediate, discarded) real(kind=c_double), intent(out), target :: tmp_low_sd_cutoff Low-sd cutoff (intermediate, discarded) real(kind=c_double), intent(out), dimension(n_genes), target :: tmp_rdi RDI per gene (intermediate, consumed by the outlier step) real(kind=c_double), intent(out), dimension(n_genes), target :: tmp_sorted_rdi Sorted RDI (intermediate, consumed by the outlier step) real(kind=c_double), intent(out), target :: tmp_threshold Detection threshold (intermediate, discarded) logical(kind=c_bool), intent(out), dimension(n_genes), target :: is_outlier Output boolean array indicating outliers real(kind=c_double), intent(out), dimension(n_families), target :: loess_x Reference x-coordinates. real(kind=c_double), intent(out), dimension(n_families), target :: loess_y Reference y-coordinates (length n_total). integer(kind=c_int), intent(out), dimension(n_families), target :: loess_n Indices of reference points used for smoothing. real(kind=c_double), intent(out), dimension(n_genes), target :: quantile Empirical one-sided upper-tail quantile (effect-size measure) for each gene, i.e. how extreme an\nobserved distance is relative to all observed distances -- NOT a null-hypothesis-testing p-value.\nReturned in the same order as the input RDI array. Because distances are non-negative, a one-sided\nupper-tail quantile is used. integer(kind=c_int), intent(out), target :: ierr Error code real(kind=c_double), intent(in), target :: percentile Percentile threshold as a fraction in [0,1] for outlier detection.\nThe default value is 0.95_real64 .\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 .","tags":"","url":"module/tox_get_outliers_c.html"},{"title":"f42_serde_arrays_serialize_real – TensorOmics","text":"Module for serializing real arrays into files Uses iso_fortran_env f42_serde_arrays_utils tox_errors Subroutines public  subroutine serialize_real_helper (arr, n_elements, arr_shape, filename, ierr) Author Aaron Schröder License MIT Category C-binding Subroutine to serialize a flat real array into a file Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_elements) :: arr Array to be serialized integer(kind=int32), intent(in) :: n_elements Number of strings in arr integer(kind=int32), intent(in), dimension(:) :: arr_shape Extents of arr , one per dimension character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code public  subroutine serialize_real_1d (arr, filename, ierr) Author Aaron Schröder License MIT Directly serialize a 1D real array into a file Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(:), contiguous :: arr Array to be serialized character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code public  subroutine serialize_real_2d (arr, filename, ierr) Author Aaron Schröder License MIT Directly serialize a 2D real array into a file Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(:, :), contiguous :: arr Array to be serialized character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code public  subroutine serialize_real_3d (arr, filename, ierr) Author Aaron Schröder License MIT Directly serialize a 3D real array into a file Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(:, :, :), contiguous :: arr Array to be serialized character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code public  subroutine serialize_real_4d (arr, filename, ierr) Author Aaron Schröder License MIT Directly serialize a 4D real array into a file Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(:, :, :, :), contiguous :: arr Array to be serialized character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code public  subroutine serialize_real_5d (arr, filename, ierr) Author Aaron Schröder License MIT Directly serialize a 5D real array into a file Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(:, :, :, :, :), contiguous :: arr Array to be serialized character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"module/f42_serde_arrays_serialize_real.html"},{"title":"tox_data_integration_preprocessing_c – TensorOmics","text":"Jensen-Shannon-Divergence (JSD) Compatibility Test (gJCT) Preprocessing The step that turns expression vectors into the neighborhood residuals the rest of the test\nconsumes: gene-wise means, the signed deviation of each replicate from them, and the\nneighborhoods of reference points those residuals are grouped into so the comparison is\nconditioned on expression level rather than pooled across it. calc_neighborhood_size sizes a neighborhood for a caller that allocates its own. Uses f42_safeguard iso_c_binding tox_errors Subroutines public  subroutine compute_gene_means_c (n_genes, n_reps, expr, means, ierr) bind(C, name=\"compute_gene_means_c\") C-wrapper for compute_gene_means Read more… Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_genes Number of genes in the study integer(kind=c_int), intent(in), target :: n_reps Number of biological replicates in the study real(kind=c_double), intent(in), dimension(n_reps, n_genes), target :: expr Expression matrix\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=c_double), intent(out), dimension(n_genes), target :: means Per-gene mean expression values integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure. public  subroutine compute_residuals_c (n_genes, n_reps, expr, means, resid, ierr) bind(C, name=\"compute_residuals_c\") C-wrapper for compute_residuals Read more… Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_genes Number of genes in the study integer(kind=c_int), intent(in), target :: n_reps Number of biological replicates in the study real(kind=c_double), intent(in), dimension(n_reps, n_genes), target :: expr Expression matrix\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=c_double), intent(in), dimension(n_genes), target :: means Per-gene mean expression values; NaN where every replicate of a gene was NaN\nNaN is permitted for this value. real(kind=c_double), intent(out), dimension(n_reps, n_genes), target :: resid Matrix of signed residuals integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure. public  subroutine pool_means_c (pooled_means, pool_size, n_points, n_pool, x_star, ierr) bind(C, name=\"pool_means_c\") C-wrapper for pool_means Read more… Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(pool_size), target :: pooled_means Pooled means\nNaN is permitted for this value. integer(kind=c_int), intent(in), target :: pool_size Number of means in the pool, usually n_genes_S1 + n_genes_S2 integer(kind=c_int), intent(in), target :: n_points Number of reference points to define integer(kind=c_int), intent(out), target :: n_pool Total number of included (non-NaN) pooled mean-expression values real(kind=c_double), intent(out), dimension(n_points), target :: x_star Mean-expression reference points integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure. public  subroutine pool_means_expert_c (pooled_means, pooled_means_perm, pool_size, n_points, n_pool, x_star, ierr) bind(C, name=\"pool_means_expert_c\") C-wrapper for pool_means_expert Read more… Arguments Type Intent Optional Attributes Name real(kind=c_double), intent(in), dimension(pool_size), target :: pooled_means Pooled means\nNaN is permitted for this value. integer(kind=c_int), intent(in), dimension(pool_size), target :: pooled_means_perm Sorting permutation for pooled_means integer(kind=c_int), intent(in), target :: pool_size Number of means in the pool, usually n_genes_S1 + n_genes_S2 integer(kind=c_int), intent(in), target :: n_points Number of reference points to define integer(kind=c_int), intent(out), target :: n_pool Total number of included (non-NaN) pooled mean-expression values real(kind=c_double), intent(out), dimension(n_points), target :: x_star Mean-expression reference points integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure. public  subroutine pool_study_means_c (n_genes_S1, mean_S1, n_genes_S2, mean_S2, n_points, n_pool, x_star, ierr) bind(C, name=\"pool_study_means_c\") C-wrapper for pool_study_means Read more… Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_genes_S1 Number of genes in study S1 real(kind=c_double), intent(in), dimension(n_genes_S1), target :: mean_S1 Per-gene mean expression values of study S1\nNaN is permitted for this value. integer(kind=c_int), intent(in), target :: n_genes_S2 Number of genes in study S2 real(kind=c_double), intent(in), dimension(n_genes_S2), target :: mean_S2 Per-gene mean expression values of study S2\nNaN is permitted for this value. integer(kind=c_int), intent(in), target :: n_points Number of reference points to define integer(kind=c_int), intent(out), target :: n_pool Total number of included (non-NaN) pooled mean-expression values real(kind=c_double), intent(out), dimension(n_points), target :: x_star Mean-expression reference points integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure. public  subroutine pool_study_means_expert_c (n_genes_S1, mean_S1, n_genes_S2, mean_S2, n_points, tmp_pooled_means, tmp_pooled_means_perm, n_pool, x_star, ierr) bind(C, name=\"pool_study_means_expert_c\") C-wrapper for pool_study_means_expert Read more… Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_genes_S1 Number of genes in study S1 real(kind=c_double), intent(in), dimension(n_genes_S1), target :: mean_S1 Per-gene mean expression values of study S1\nNaN is permitted for this value. integer(kind=c_int), intent(in), target :: n_genes_S2 Number of genes in study S2 real(kind=c_double), intent(in), dimension(n_genes_S2), target :: mean_S2 Per-gene mean expression values of study S2\nNaN is permitted for this value. integer(kind=c_int), intent(in), target :: n_points Number of reference points to define real(kind=c_double), intent(out), dimension(n_genes_S1+n_genes_S2), target :: tmp_pooled_means Work array holding the concatenated means of both studies integer(kind=c_int), intent(out), dimension(n_genes_S1+n_genes_S2), target :: tmp_pooled_means_perm Work array for the permutation that sorts tmp_pooled_means integer(kind=c_int), intent(out), target :: n_pool Total number of included (non-NaN) pooled mean-expression values real(kind=c_double), intent(out), dimension(n_points), target :: x_star Mean-expression reference points integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure. public  subroutine construct_neighborhoods_c (n_points, x_star, n_genes_S, mean_S, n_reps_S, resid_S, neighborhood_residuals, neighborhood_indices, n_neighbors, ierr) bind(C, name=\"construct_neighborhoods_c\") C-wrapper for construct_neighborhoods Read more… Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_points Number of reference points real(kind=c_double), intent(in), dimension(n_points), target :: x_star Mean-expression reference points\nNaN is permitted for this value. integer(kind=c_int), intent(in), target :: n_genes_S Number of genes in the current study real(kind=c_double), intent(in), dimension(n_genes_S), target :: mean_S Per-gene mean expression values\nNaN is permitted for this value. integer(kind=c_int), intent(in), target :: n_reps_S Number of biological replicates in the study real(kind=c_double), intent(in), dimension(n_reps_S, n_genes_S), target :: resid_S Matrix of signed residuals\nNaN is permitted for this value. real(kind=c_double), intent(out), dimension(n_reps_S, n_neighbors, n_points), target :: neighborhood_residuals Collection of residual vectors for each neighborhood integer(kind=c_int), intent(out), dimension(n_neighbors, n_points), target :: neighborhood_indices Indices of selected neighborhood genes integer(kind=c_int), intent(in), target :: n_neighbors Number of neighbors; a gene whose mean is NaN can never be a neighbor, so this\ncannot exceed the number of genes with a defined mean\nThe minimum valid value is 1_int32 .\nThe maximum valid value is count(.not. ieee_is_nan(mean_S), kind=int32) .\nIt is recommended to compute this with calc_neighborhood_size . integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure. public  subroutine construct_neighborhoods_expert_c (n_points, x_star, n_genes_S, mean_S, n_reps_S, resid_S, tmp_distances, tmp_distances_perm, neighborhood_residuals, neighborhood_indices, n_neighbors, ierr) bind(C, name=\"construct_neighborhoods_expert_c\") C-wrapper for construct_neighborhoods_expert Read more… Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: n_points Number of reference points real(kind=c_double), intent(in), dimension(n_points), target :: x_star Mean-expression reference points\nNaN is permitted for this value. integer(kind=c_int), intent(in), target :: n_genes_S Number of genes in the current study real(kind=c_double), intent(in), dimension(n_genes_S), target :: mean_S Per-gene mean expression values\nNaN is permitted for this value. integer(kind=c_int), intent(in), target :: n_reps_S Number of biological replicates in the study real(kind=c_double), intent(in), dimension(n_reps_S, n_genes_S), target :: resid_S Matrix of signed residuals\nNaN is permitted for this value. real(kind=c_double), intent(out), dimension(n_genes_S), target :: tmp_distances Distances work array integer(kind=c_int), intent(out), dimension(n_genes_S), target :: tmp_distances_perm Work array for the permutation that sorts tmp_distances real(kind=c_double), intent(out), dimension(n_reps_S, n_neighbors, n_points), target :: neighborhood_residuals Collection of residual vectors for each neighborhood integer(kind=c_int), intent(out), dimension(n_neighbors, n_points), target :: neighborhood_indices Indices of selected neighborhood genes integer(kind=c_int), intent(in), target :: n_neighbors Number of neighbors; a gene whose mean is NaN can never be a neighbor, so this\ncannot exceed the number of genes with a defined mean\nThe minimum valid value is 1_int32 .\nThe maximum valid value is count(.not. ieee_is_nan(mean_S), kind=int32) .\nIt is recommended to compute this with calc_neighborhood_size . integer(kind=c_int), intent(out), target :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"module/tox_data_integration_preprocessing_c.html"},{"title":"tox_conversions – TensorOmics","text":"Module with conversion helpers between Fortran-native types and their iso_c_binding counterparts.\nUsed by the C interface wrapper subroutines throughout tensor-omics to translate arguments (logicals,\ncharacters/strings, and fixed-width integer kinds) crossing the Fortran/C boundary. It keeps its tox_ name for continuity, but it lives in src/f42/ because it is C-interop\nglue with no exports of its own -- infrastructure the binding layer stands on. Uses f42_safeguard iso_fortran_env iso_c_binding Functions public  function c_char_as_view (buffer) result(view) Author Franz-Eric Sill License MIT A zero-copy Fortran view of a c_char buffer, ending at the first NUL if there is one. Read more… Arguments Type Intent Optional Attributes Name character(kind=c_char, len=1), intent(in), dimension(:), target, contiguous :: buffer the C buffer, NUL-terminated or blank-padded Return Value character(len=:), pointer the buffer read as one Fortran string, up to the first NUL Subroutines public elemental subroutine c_int_as_logical (c_val, f_val) Author Franz-Eric Sill License MIT Converts a c_int value to logical, elemental -> any shape Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in) :: c_val the element containing the c variant of the number logical, intent(out) :: f_val the element that will hold the logical representation of the c_int: 0 means .false. , else .true. public elemental subroutine logical_as_c_int (f_val, c_val) Author Franz-Eric Sill License MIT Converts a logical value to c_int, elemental -> any shape Arguments Type Intent Optional Attributes Name logical, intent(in) :: f_val the element containing the fortran variant of the number integer(kind=c_int), intent(out) :: c_val the element that will hold the c_int representation of the logical: 0 if .false. , else 1 public elemental subroutine c_char_as_char (c_val, f_val) Author Franz-Eric Sill License MIT Converts a c_char value to fortran character, elemental -> any shape Arguments Type Intent Optional Attributes Name character(kind=c_char, len=1), intent(in) :: c_val the element containing the c variant of the character character(len=1), intent(out) :: f_val the element that will hold the fortran char representation of the c_char public elemental subroutine char_as_c_char (f_val, c_val) Author Franz-Eric Sill License MIT Converts a character value to c_char, elemental -> any shape Arguments Type Intent Optional Attributes Name character(len=1), intent(in) :: f_val the element containing the fortran variant of the character character(kind=c_char, len=1), intent(out) :: c_val the element that will hold the c_char (ASCII) representation of the character public elemental subroutine int32_as_c_int64 (f_val, c_val) Author Franz-Eric Sill License MIT Converts int32 to c_int64_t, elemental -> any shape Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: f_val the element containing the fortran variant of the number integer(kind=c_int64_t), intent(out) :: c_val the element that will hold the c_int64_t representation public elemental subroutine c_int64_as_int32 (c_val, f_val) Author Aaron Schröder License MIT Converts c_int64_t to int32, elemental -> any shape Arguments Type Intent Optional Attributes Name integer(kind=c_int64_t), intent(in) :: c_val the element containing the c variant of the number integer(kind=int32), intent(out) :: f_val the element that will hold the int32 representation public elemental subroutine int32_as_c_size (f_val, c_val) Author Aaron Schröder License MIT Converts int32 to c_size_t, elemental -> any shape Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: f_val the element containing the fortran variant of the number integer(kind=c_size_t), intent(out) :: c_val the element that will hold the c_size_t representation public elemental subroutine c_size_as_int32 (c_val, f_val) Author Aaron Schröder License MIT Converts c_size_t to int32, elemental -> any shape Arguments Type Intent Optional Attributes Name integer(kind=c_size_t), intent(in) :: c_val the element containing the c variant of the number integer(kind=int32), intent(out) :: f_val the element that will hold the int32 representation public elemental subroutine c_int64_as_c_size (c64_val, csize_val) Author Aaron Schröder License MIT Converts c_int64_t to c_size_t, elemental -> any shape Arguments Type Intent Optional Attributes Name integer(kind=c_int64_t), intent(in) :: c64_val the element containing the c_int64_t value integer(kind=c_size_t), intent(out) :: csize_val the element that will hold the c_size_t representation public elemental subroutine c_size_as_c_int64 (csize_val, c64_val) Author Aaron Schröder License MIT Converts c_size_t to c_int64_t, elemental -> any shape Arguments Type Intent Optional Attributes Name integer(kind=c_size_t), intent(in) :: csize_val the element containing the c_size_t value integer(kind=c_int64_t), intent(out) :: c64_val the element that will hold the c_int64_t representation","tags":"","url":"module/tox_conversions.html"},{"title":"tox_data_integration_per_family_c – TensorOmics","text":"Jensen-Shannon-Divergence (JSD) Compatibility Test (gJCT) JSD Calculation per family The JSD value for a sub-neighborhood -- typically the genes of one family -- obtained by\ndriving the same pipeline over a masked set of neighbors. Answers whether two studies are\ncompatible for this family , which the global figure can hide either way. Uses f42_safeguard iso_c_binding tox_errors Subroutines public  subroutine fjct_compute_jsd_c (family_idx, gene_to_family_S1, gene_to_family_S2, n_genes_S1, n_genes_S2, neighborhood_residuals_S1, neighborhood_residuals_S2, neighborhood_genes_S1, neighborhood_genes_S2, n_reps_S1, n_reps_S2, n_neighbors, n_points, n_bins, shared_residual_range, js_divergences, included_n_reps_S1, included_n_reps_S2, total_included_n_reps, global_js_divergence, weights, ierr) bind(C, name=\"fjct_compute_jsd_c\") C-wrapper for fjct_compute_jsd Read more… Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), target :: family_idx Index of the family that should be analyzed\nThe minimum valid value is 1_int32 . integer(kind=c_int), intent(in), dimension(n_genes_S1), target :: gene_to_family_S1 Mapping for study 1: Each index (gene) holds the index of its family\nThe minimum valid value is 0_int32 . integer(kind=c_int), intent(in), dimension(n_genes_S2), target :: gene_to_family_S2 Mapping for study 2: Each index (gene) holds the index of its family\nThe minimum valid value is 0_int32 . integer(kind=c_int), intent(in), target :: n_genes_S1 Number of genes in study 1 integer(kind=c_int), intent(in), target :: n_genes_S2 Number of genes in study 2 real(kind=c_double), intent(in), dimension(n_reps_S1, n_neighbors, n_points), target :: neighborhood_residuals_S1 Computed neighborhood residuals for study 1, NaN is explicitly allowed for missing values\nNaN is permitted for this value. real(kind=c_double), intent(in), dimension(n_reps_S2, n_neighbors, n_points), target :: neighborhood_residuals_S2 Computed neighborhood residuals for study 2, NaN is explicitly allowed for missing values\nNaN is permitted for this value. integer(kind=c_int), intent(in), dimension(n_neighbors, n_points), target :: neighborhood_genes_S1 Indices of the selected neighborhood genes of study 1\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_genes_S1 . integer(kind=c_int), intent(in), dimension(n_neighbors, n_points), target :: neighborhood_genes_S2 Indices of the selected neighborhood genes of study 2\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_genes_S2 . integer(kind=c_int), intent(in), target :: n_reps_S1 Number of replicates in study 1 integer(kind=c_int), intent(in), target :: n_reps_S2 Number of replicates in study 2 integer(kind=c_int), intent(in), target :: n_neighbors Number of neighbors in the studies integer(kind=c_int), intent(in), target :: n_points Number of reference points in the studies integer(kind=c_int), intent(in), target :: n_bins Number of equally sized histogram bins used for the studies real(kind=c_double), intent(in), target :: shared_residual_range Computed residual range for both studies\nThe minimum valid value is 0.0_real64 . real(kind=c_double), intent(out), dimension(n_points), target :: js_divergences Jensen-Shannon divergence per reference point, computed f