ent(in) :: factor_idx factor index of the trajectory integer(kind=int32), intent(in) :: sample_idx sample index of the trajectory real(kind=real64), intent(out), dimension(max(0, n_timepoints - 1)) :: velocity Calculated velocity for the selected trajectory public pure subroutine compute_velocity_trajectory_impl (trajectory, velocity, n_timepoints) Author Jitu Daba License MIT Compute velocity trajectory from a single position trajectory Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_timepoints) :: trajectory input position trajectory real(kind=real64), intent(out), dimension(max(0_int32, n_timepoints - 1)) :: velocity output velocity trajectory integer(kind=int32), intent(in) :: n_timepoints number of timepoints public pure subroutine compute_acceleration_from_velocity_trajectory_impl (velocity, acceleration, n_timepoints) Author Jitu Daba License MIT Compute acceleration trajectory from a single velocity trajectory Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(max(0_int32, n_timepoints - 1)) :: velocity velocity trajectory real(kind=real64), intent(out), dimension(max(0_int32, n_timepoints - 2)) :: acceleration acceleration trajectory integer(kind=int32), intent(in) :: n_timepoints number of timepoints public pure subroutine compute_velocity_trajectories_impl (trajectories, velocity, n_factors, n_samples, n_timepoints) Author Jitu Daba License MIT Computes velocity trajectories from position trajectories Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_factors, n_samples, n_timepoints) :: trajectories input position trajectories real(kind=real64), intent(out), dimension(max(0_int32, n_timepoints - 1), n_factors, n_samples) :: velocity output velocity trajectories integer(kind=int32), intent(in) :: n_factors number of factors integer(kind=int32), intent(in) :: n_samples number of samples integer(kind=int32), intent(in) :: n_timepoints number of timepoints public pure subroutine compute_acceleration_from_velocity_impl (velocity, acceleration, n_factors, n_samples, n_timepoints) Author Jitu Daba License MIT Computes acceleration trajectories from velocity trajectories Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(max(0_int32, n_timepoints - 1), n_factors, n_samples) :: velocity input velocity trajectories real(kind=real64), intent(out), dimension(max(0_int32, n_timepoints - 2), n_factors, n_samples) :: acceleration output acceleration trajectories integer(kind=int32), intent(in) :: n_factors number of factors integer(kind=int32), intent(in) :: n_samples number of samples integer(kind=int32), intent(in) :: n_timepoints number of timepoints public pure subroutine compute_velocity_acceleration_contributions_impl (trajectories, n_factors, n_samples, n_timepoints, baseline_mode, tmp_factors, tmp_dependent, tmp_contributions, contrib_velocity, velocity_contribution_series, contrib_acceleration, acceleration_contribution_series, ierr) Author Jitu Daba License MIT Compute velocity and acceleration contributions for all variable pairs Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_factors, n_samples, n_timepoints) :: trajectories input position trajectories integer(kind=int32), intent(in) :: n_factors number of factors integer(kind=int32), intent(in) :: n_samples number of samples integer(kind=int32), intent(in) :: n_timepoints number of timepoints integer(kind=int32), intent(in) :: baseline_mode Read more… real(kind=real64), intent(out), dimension(n_timepoints - 1, n_factors) :: tmp_factors workspace for factor data (used for velocity and acceleration) real(kind=real64), intent(out), dimension(n_timepoints - 1) :: tmp_dependent workspace for dependent data (used for velocity and acceleration) real(kind=real64), intent(out), dimension(n_timepoints - 1) :: tmp_contributions workspace for contribution calculations (used for velocity and acceleration) real(kind=real64), intent(out), dimension(n_factors, n_factors, n_samples) :: contrib_velocity output velocity contributions real(kind=real64), intent(out), dimension(n_timepoints, n_factors, n_factors, n_samples) :: velocity_contribution_series output velocity contribution series real(kind=real64), intent(out), dimension(n_factors, n_factors, n_samples) :: contrib_acceleration output acceleration contributions real(kind=real64), intent(out), dimension(n_timepoints, n_factors, n_factors, n_samples) :: acceleration_contribution_series output acceleration contribution series integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"module/tox_trajectory_contribution_analysis_impl.html"},{"title":"f42_serde_arrays_deserialize_char_c – TensorOmics","text":"Module for deserializing character arrays from files Uses f42_safeguard iso_c_binding tox_errors Subroutines public  subroutine deserialize_char_helper_c (arr, n_strings, strlen, arr_shape, n_arr_shape_elements, filename, filename_strlen, ierr) bind(C, name=\"deserialize_char_helper_c\") C-wrapper for deserialize_char_helper Read more… Arguments Type Intent Optional Attributes Name character(kind=c_char, len=1), intent(out), dimension(strlen, *), target :: arr Pre-allocated array to read the data into integer(kind=c_int), intent(in), target :: n_strings Number of strings in arr integer(kind=c_int), intent(in), target :: strlen Length of each string in arr .\nIt is VERY IMPORTANT to compute this argument from the type_code output produced by get_array_metadata . Read more… integer(kind=c_int), intent(in), dimension(n_arr_shape_elements), target :: arr_shape Extents of arr , one per dimension\nIt is VERY IMPORTANT to compute this argument from the dims_out output produced by get_array_metadata . Read more… integer(kind=c_int), intent(in), target :: n_arr_shape_elements number of elements in arr_shape character(kind=c_char, len=1), intent(in), dimension(filename_strlen), target :: filename Name of the file integer(kind=c_int), intent(in), target :: filename_strlen length of the strings in filename integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"module/f42_serde_arrays_deserialize_char_c.html"},{"title":"tox_shift_vectors – TensorOmics","text":"The shift vector field: where each gene sits relative to its family's centroid. One vector per gene, from the centroid of the family it belongs to to the gene itself. It is\nthe input the relative-axis plane tools project and measure angles in, and what the\nparalog-pattern detection reads a gene's direction and magnitude off. Generated from tox_shift_vectors_impl ; do not edit -- regenerate instead. Uses iso_fortran_env tox_shift_vectors_impl tox_errors Subroutines public pure subroutine compute_shift_vector_field (n_tissues, n_genes, n_families, expression_vectors, family_centroids, gene_to_fam, shift_vectors, ierr) Validates its inputs, then calls compute_shift_vector_field_impl . Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_tissues Expression vector dimension integer(kind=int32), intent(in) :: n_genes Total number of genes integer(kind=int32), intent(in) :: n_families Total number of families real(kind=real64), intent(in), dimension(n_tissues, n_genes) :: expression_vectors Gene expression matrix real(kind=real64), intent(in), dimension(n_tissues, n_families) :: family_centroids Family centroid matrix integer(kind=int32), intent(in), dimension(n_genes) :: gene_to_fam Index mapping -> each index i holds the family index for the corresponding gene in expression_vectors , using 0_int32 for unassigned genes\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_families .\nThe value 0_int32 is additionally accepted. real(kind=real64), intent(out), dimension(n_tissues, 2, n_genes) :: shift_vectors Output, real matrix array. For each gene it holds two vectors: the centroid of the gene's family first (a zero vector if no family is assigned), then the shift vector integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"module/tox_shift_vectors.html"},{"title":"tox_data_archive – TensorOmics","text":"Zip-archive backed persistence for TensorOmics data sets. Wraps libzip (via C bindings declared in the interface block below) to create/extract zip\narchives whose members are tox_data_read_write -serialized arrays, indexed by a\nplain-text manifest.txt mapping logical keys (e.g. gene_ids , expression ) to member\nfilenames. save_tox_data and read_tox_data are the standard entry points for the\nfixed TensorOmics data set schema; create_zip_archive / extract_zip_archive and the *_manifest* routines below are the generic key/filename building blocks they are built on. Uses iso_fortran_env f42_config iso_c_binding f42_safeguard tox_data_read_write tox_errors Variables Type Visibility Attributes Name Initial integer(kind=c_int), public, parameter :: ZIP_CREATE = 1 integer(kind=c_int), public, parameter :: ZIP_EXCLUSIVE = 3 integer(kind=c_int), public, parameter :: ZIP_READ_ONLY = 0 integer(kind=c_int), public, parameter :: ZIP_FILE_OVERWRITE = 8192 integer(kind=c_int), public, parameter :: ZIP_COMPRESSION_STORE = 0 integer(kind=c_int), public, parameter :: ZIP_COMPRESSION_DEFLATE = 8 integer(kind=int32), public, parameter :: DATA_TYPE_FILE = 1 integer(kind=int32), public, parameter :: DATA_TYPE_STRING = 2 Interfaces interface public  function malloc(size) bind(C, name=\"malloc\") Arguments Type Intent Optional Attributes Name integer(kind=c_size_t), value :: size Return Value type(c_ptr) interface public  function zip_open(path, flags, errorp) bind(C, name=\"zip_open\") Arguments Type Intent Optional Attributes Name character(kind=c_char, len=1), dimension(*) :: path integer(kind=c_int), value :: flags integer(kind=c_int), intent(out) :: errorp Return Value type(c_ptr) interface public  