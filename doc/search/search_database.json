get :: n_timepoints number of timepoints character(kind=c_char, len=1), intent(in), dimension(13), target :: baseline_mode Read more… real(kind=c_double), intent(out), dimension(n_timepoints - 1, n_factors), target :: tmp_factors workspace for factor data (used for velocity and acceleration) real(kind=c_double), intent(out), dimension(n_timepoints - 1), target :: tmp_dependent workspace for dependent data (used for velocity and acceleration) real(kind=c_double), intent(out), dimension(n_timepoints - 1), target :: tmp_contributions workspace for contribution calculations (used for velocity and acceleration) real(kind=c_double), intent(out), dimension(n_factors, n_factors, n_samples), target :: contrib_velocity output velocity contributions real(kind=c_double), intent(out), dimension(n_timepoints, n_factors, n_factors, n_samples), target :: velocity_contribution_series output velocity contribution series real(kind=c_double), intent(out), dimension(n_factors, n_factors, n_samples), target :: contrib_acceleration output acceleration contributions real(kind=c_double), intent(out), dimension(n_timepoints, n_factors, n_factors, n_samples), target :: acceleration_contribution_series output acceleration contribution series integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"module/tox_trajectory_contribution_analysis_c.html"},{"title":"f42_serde_arrays_serialize_complex_c – TensorOmics","text":"Module for serializing complex arrays into files Uses f42_safeguard iso_c_binding tox_errors Subroutines public  subroutine serialize_complex_helper_c (arr, n_elements, arr_shape, n_arr_shape_elements, filename, filename_strlen, ierr) bind(C, name=\"serialize_complex_helper_c\") C-wrapper for serialize_complex_helper Read more… Arguments Type Intent Optional Attributes Name complex(kind=c_double_complex), intent(in), dimension(*), target :: arr Array to be serialized integer(kind=c_int), intent(in), target :: n_elements Number of strings in arr integer(kind=c_int), intent(in), dimension(n_arr_shape_elements), target :: arr_shape Extents of arr , one per dimension integer(kind=c_int), intent(in), target :: n_arr_shape_elements number of elements in arr_shape character(kind=c_char, len=1), intent(in), dimension(filename_strlen), target :: filename Name of the file to write to integer(kind=c_int), intent(in), target :: filename_strlen length of the strings in filename integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"module/f42_serde_arrays_serialize_complex_c.html"},{"title":"f42_serde_arrays_serialize_int – TensorOmics","text":"Module for serializing integer arrays into files Uses iso_fortran_env f42_serde_arrays_utils tox_errors Subroutines public  subroutine serialize_int_helper (arr, n_elements, arr_shape, filename, ierr) Author Aaron Schröder License MIT Category C-binding Subroutine to serialize a flat integer array into a file Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in), dimension(n_elements) :: arr Array to be serialized integer(kind=int32), intent(in) :: n_elements Number of strings in arr integer(kind=int32), intent(in), dimension(:) :: arr_shape Extents of arr , one per dimension character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code public  subroutine serialize_int_1d (arr, filename, ierr) Author Aaron Schröder License MIT Directly serialize a 1D integer array into a file Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in), dimension(:), contiguous :: arr Array to be serialized character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code public  subroutine serialize_int_2d (arr, filename, ierr) Author Aaron Schröder License MIT Directly serialize a 2D integer array into a file Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in), dimension(:, :), contiguous :: arr Array to be serialized character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code public  subroutine serialize_int_3d (arr, filename, ierr) Author Aaron Schröder License MIT Directly serialize a 3D integer array into a file Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in), dimension(:, :, :), contiguous :: arr Array to be serialized character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code public  subroutine serialize_int_4d (arr, filename, ierr) Author Aaron Schröder License MIT Directly serialize a 4D integer array into a file Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in), dimension(:, :, :, :), contiguous :: arr Array to be serialized character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code public  subroutine serialize_int_5d (arr, filename, ierr) Author Aaron Schröder License MIT Directly serialize a 5D integer array into a file Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in), dimension(:, :, :, :, :), contiguous :: arr Array to be serialized character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"module/f42_serde_arrays_serialize_int.html"},{"title":"tox_paralog_analysis – TensorOmics","text":"Paralog-subset expression patterns -- dosage effect and subfunctionalization -- relative to an ancestral ortholog. Candidate paralog subsets are enumerated as bitmask-encoded gene sets, built up one gene at a time\nstarting from single genes. At every extension step the candidate is scored against the pattern-specific\ncriterion (small angle plus magnitude gain for dosage effect, or bounded residual distance for\nsubfunctionalization); subsets that can no longer satisfy the criterion are pruned instead of being\nextended further, which keeps the combinatorial subset search tractable. There is a routine per pattern rather than one taking a pattern flag: detect_dosage_effect and detect_subfunctionalization find the subsets, and filter_paralogs_by_pattern_dosage_effect / _subfunctionalization reduce a set of genes to\nthose matching. Which criterion a result was scored against is therefore visible at the call\nsite, and each routine takes only the thresholds its own pattern needs. Generated from tox_paralog_analysis_impl ; do not edit -- regenerate instead. Uses iso_fortran_env iso_c_binding f42_math_impl f42_safeguard tox_errors tox_paralog_analysis_impl Subroutines public pure subroutine detect_neofunctionalization (ancestors, n_families, genes, n_axes, gene_to_fam, n_genes, thresholds, neofunc, ierr) Validates its inputs, then calls detect_neofunctionalization_impl . Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_axes, n_families) :: ancestors RAP projected unit length expression vector of ancestral ortholog\nThe minimum valid value is -1.0_real64 .\nThe maximum valid value is 1.0_real64 . integer(kind=int32), intent(in) :: n_families number of vectors in ancestors real(kind=real64), intent(in), dimension(n_axes, n_genes) :: genes RAP projected unit length expression vectors of genes\nThe minimum valid value is -1.0_real64 .\nThe maximum valid value is 1.0_real64 . integer(kind=int32), intent(in) :: n_axes size of ancestors vector and vectors in genes integer(kind=int32), intent(in), dimension(n_genes) :: gene_to_fam Index mapping -> each index i holds the family index for the corresponding gene in genes , using 0_int32 for unassigned genes\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_families .\nThe value 0_int32 is additionally accepted. integer(kind=int32), intent(in) :: n_genes number of vectors in genes real(kind=real64), intent(in), dimension(n_axes) :: thresholds threshold per axis that defines significant change in expression, may be a percentile of all genes' changes per axis\nThe minimum valid value is -1.0_real64 .\nThe maximum valid value is 1.0_real64 . logical(kind=c_bool), intent(out), dimension(n_genes, n_axes) :: neofunc .true. if neofunctionalization has been detected for the respective axes, always .false. for unassigned genes integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure. public pure subroutine detect_dosage_effect (ancestor, genes, n_genes, n_dims, filtered_paralogs_mask, n_mask_chunks, n_results, max_subset_size, work_arr_paralog_subsets, n_paralog_subsets, max_angle, gain_gamma, ierr) Validates its inputs, prepares what detect_patterns_impl needs, then calls it. The entry point to reach for first; see detect_dosage_effect_expert to prepare it yourself. Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_dims) :: ancestor expression vector of ancestral ortholog real(kind=real64), intent(in), dimension(n_dims, n_genes) :: genes expression vectors of genes integer(kind=int32), intent(in) :: n_genes number of vectors in genes integer(kind=int32), intent(in) :: n_dims size of ancestor vector and vectors in genes integer(kind=int32), intent(in), dimension(n_mask_chunks) :: filtered_paralogs_mask bit mask with the genes' indices kept by this pattern set to 1, else 0. Build it with the matching filter_paralogs_by_pattern_* routine integer(kind=int32), intent(in) :: n_mask_chunks number of 32 bit chunks a mask needs to encode n_genes genes. Use subroutine mask_chunk_count for calculation\nThe minimum valid value is (n_genes + 31) / 32 . integer(kind=int32), intent(out) :: n_results number of resulting subsets. They are stored as the first n_results elements of work_arr_paralog_subsets integer(kind=int32), intent(in) :: max_subset_size maximum subset size of checked gene subsets. Too large a value is capped to the\nmaximum valid size. The bindings cap it automatically while sizing the work\narray; a Fortran caller caps it by calling calc_work_arr_paralog_subsets_size first.\nZero is in range and means there is no subset to check -- the sizing routine reports\nit whenever the filtered families hold a single gene each. It reports a work array\nof zero slots along with it, which this routine does not accept, so a caller that\ngets zero back has nothing to detect and should not call here at all.\nThe minimum valid value is 0_int32 . integer(kind=int32), intent(out), dimension(n_mask_chunks, n_paralog_subsets) :: work_arr_paralog_subsets working array to hold bitmask encoded subsets for detection. Read more… integer(kind=int32), intent(in) :: n_paralog_subsets number of gene subsets that can be stored in work_arr_paralog_subsets .\nIt is VERY IMPORTANT to compute this argument from the work_array_size output produced by calc_work_arr_paralog_subsets_size . real(kind=real64), intent(in), optional :: max_angle maximum angle in radians 0<=angle<=Pi that a subset candidate must not exceed, otherwise pruned\nThe default value is 4.0_real64*atan(1.0_real64) .\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is PI . real(kind=real64), intent(in), optional :: gain_gamma positive magnitude gain for dosage effect\nThe default value is 0.1_real64 .\nThe minimum valid value is above(0.0_real64) . integer(kind=int32), intent(out) :: ierr Error code public pure subroutine detect_dosage_effect_expert (ancestor, genes, n_genes, n_dims, filtered_paralogs_mask, n_mask_chunks, n_results, max_subset_size, work_arr_paralog_subsets, n_paralog_subsets, tmp_active_mask, tmp_paralog_vector, max_angle, gain_gamma, ierr) Validates its inputs, then calls detect_patterns_impl with what you supply. The expert entry point: it allocates nothing and prepares nothing; detect_dosage_effect does both. Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_dims) :: ancestor expression vector of ancestral ortholog real(kind=real64), intent(in), dimension(n_dims, n_genes) :: genes expression vectors of genes integer(kind=int32), intent(in) :: n_genes number of vectors in genes integer(kind=int32), intent(in) :: n_dims size of ancestor vector and vectors in genes integer(kind=int32), intent(in), dimension(n_mask_chunks) :: filtered_paralogs_mask bit mask with the genes' indices kept by this pattern set to 1, else 0. Build it with the matching filter_paralogs_by_pattern_* routine integer(kind=int32), intent(in) :: n_mask_chunks number of 32 bit chunks a mask needs to encode n_genes genes. Use subroutine mask_chunk_count for calculation\nThe minimum valid value is (n_genes + 31) / 32 . integer(kind=int32), intent(out) :: n_results number of resulting subsets. They are stored as the first n_results elements of work_arr_paralog_subsets integer(kind=int32), intent(in) :: max_subset_size maximum subset size of checked gene subsets. Too large a value is capped to the\nmaximum valid size. The bindings cap it automatically while sizing the work\narray; a Fortran caller caps it by calling calc_work_arr_paralog_subsets_size first.\nZero is in range and means there is no subset to check -- the sizing routine reports\nit whenever the filtered families hold a single gene each. It reports a work array\nof zero slots along with it, which this routine does not accept, so a caller that\ngets zero back has nothing to detect and should not call here at all.\nThe minimum valid value is 0_int32 . integer(kind=int32), intent(out), dimension(n_mask_chunks, n_paralog_subsets) :: work_arr_paralog_subsets working array to hold bitmask encoded subsets for detection. Read more… integer(kind=int32), intent(in) :: n_paralog_subsets number of gene subsets that can be stored in work_arr_paralog_subsets .\nIt is VERY IMPORTANT to compute this argument from the work_array_size output produced by calc_work_arr_paralog_subsets_size . integer(kind=int32), intent(out), dimension(n_mask_chunks) :: tmp_active_mask working array to hold the extended subsets real(kind=real64), intent(out), dimension(n_dims) :: tmp_paralog_vector vector used for pruning subsets real(kind=real64), intent(in), optional :: max_angle maximum angle in radians 0<=angle<=Pi that a subset candidate must not exceed, otherwise pruned\nThe default value is 4.0_real64*atan(1.0_real64) .\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is PI . real(kind=real64), intent(in), optional :: gain_gamma positive magnitude gain for dosage effect\nThe default value is 0.1_real64 .\nThe minimum valid value is above(0.0_real64) . integer(kind=int32), intent(out) :: ierr Error code public pure subroutine detect_subfunctionalization (ancestor, genes, n_genes, n_dims, filtered_paralogs_mask, n_mask_chunks, n_results, max_subset_size, work_arr_paralog_subsets, n_paralog_subsets, rdi_threshold, paralog_norms, sorted_paralog_norms_perm, ierr) Validates its inputs, prepares what detect_patterns_impl needs, then calls it. The entry point to reach for first; see detect_subfunctionalization_expert to prepare it yourself. Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_dims) :: ancestor expression vector of ancestral ortholog real(kind=real64), intent(in), dimension(n_dims, n_genes) :: genes expression vectors of genes integer(kind=int32), intent(in) :: n_genes number of vectors in genes integer(kind=int32), intent(in) :: n_dims size of ancestor vector and vectors in genes integer(kind=int32), intent(in), dimension(n_mask_chunks) :: filtered_paralogs_mask bit mask with the genes' indices kept by this pattern set to 1, else 0. Build it with the matching filter_paralogs_by_pattern_* routine integer(kind=int32), intent(in) :: n_mask_chunks number of 32 bit chunks a mask needs to encode n_genes genes. Use subroutine mask_chunk_count for calculation\nThe minimum valid value is (n_genes + 31) / 32 . integer(kind=int32), intent(out) :: n_results number of resulting subsets. They are stored as the first n_results elements of work_arr_paralog_subsets integer(kind=int32), intent(in) :: max_subset_size maximum subset size of checked gene subsets. Too large a value is capped to the\nmaximum valid size. The bindings cap it automatically while sizing the work\narray; a Fortran caller caps it by calling calc_work_arr_paralog_subsets_size first.\nZero is in range and means there is no subset to check -- the sizing routine reports\nit whenever the filtered families hold a single gene each. It reports a work array\nof zero slots along with it, which this routine does not accept, so a caller that\ngets zero back has nothing to detect and should not call here at all.\nThe minimum valid value is 0_int32 . integer(kind=int32), intent(out), dimension(n_mask_chunks, n_paralog_subsets) :: work_arr_paralog_subsets working array to hold bitmask encoded subsets for detection. Read more… integer(kind=int32), intent(in) :: n_paralog_subsets number of gene subsets that can be stored in work_arr_paralog_subsets .\nIt is VERY IMPORTANT to compute this argument from the work_array_size output produced by calc_work_arr_paralog_subsets_size . real(kind=real64), intent(in) :: rdi_threshold max allowed residual distance from ancestor The minimum valid value is 0.0_real64 . real(kind=real64), intent(in), dimension(n_genes) :: paralog_norms euclidean norms of the genes, used for subset pruning ( norm from f42_vector_impl computes them)\nThe minimum valid value is 0.0_real64 . integer(kind=int32), intent(in), dimension(n_genes) :: sorted_paralog_norms_perm ascending permutation of the norms, for subset pruning: the smallest norm among the genes that could extend a subset must not fall below the subset's angle to the ancestor\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_genes . integer(kind=int32), intent(out) :: ierr Error code public pure subroutine detect_subfunctionalization_expert (ancestor, genes, n_genes, n_dims, filtered_paralogs_mask, n_mask_chunks, n_results, max_subset_size, work_arr_paralog_subsets, n_paralog_subsets, tmp_active_mask, tmp_paralog_vector, rdi_threshold, paralog_norms, sorted_paralog_norms_perm, tmp_work_array, ierr) Validates its inputs, then calls detect_patterns_impl with what you supply. The expert entry point: it allocates nothing and prepares nothing; detect_subfunctionalization does both. Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_dims) :: ancestor expression vector of ancestral ortholog real(kind=real64), intent(in), dimension(n_dims, n_genes) :: genes expression vectors of genes integer(kind=int32), intent(in) :: n_genes number of vectors in genes integer(kind=int32), intent(in) :: n_dims size of ancestor vector and vectors in genes integer(kind=int32), intent(in), dimension(n_mask_chunks) :: filtered_paralogs_mask bit mask with the genes' indices kept by this pattern set to 1, else 0. Build it with the matching filter_paralogs_by_pattern_* routine integer(kind=int32), intent(in) :: n_mask_chunks number of 32 bit chunks a mask needs to encode n_genes genes. Use subroutine mask_chunk_count for calculation\nThe minimum valid value is (n_genes + 31) / 32 . integer(kind=int32), intent(out) :: n_results number of resulting subsets. They are stored as the first n_results elements of work_arr_paralog_subsets integer(kind=int32), intent(in) :: max_subset_size maximum subset size of checked gene subsets. Too large a value is capped to the\nmaximum valid size. The bindings cap it automatically while sizing the work\narray; a Fortran caller caps it by calling calc_work_arr_paralog_subsets_size first.\nZero is in range and means there is no subset to check -- the sizing routine reports\nit whenever the filtered families hold a single gene each. It reports a work array\nof zero slots along with it, which this routine does not accept, so a caller that\ngets zero back has nothing to detect and should not call here at all.\nThe minimum valid value is 0_int32 . integer(kind=int32), intent(out), dimension(n_mask_chunks, n_paralog_subsets) :: work_arr_paralog_subsets working array to hold bitmask encoded subsets for detection. Read more… integer(kind=int32), intent(in) :: n_paralog_subsets number of gene subsets that can be stored in work_arr_paralog_subsets .\nIt is VERY IMPORTANT to compute this argument from the work_array_size output produced by calc_work_arr_paralog_subsets_size . integer(kind=int32), intent(out), dimension(n_mask_chunks) :: tmp_active_mask working array to hold the extended subsets real(kind=real64), intent(out), dimension(n_dims) :: tmp_paralog_vector vector used for pruning subsets real(kind=real64), intent(in) :: rdi_threshold max allowed residual distance from ancestor The minimum valid value is 0.0_real64 . real(kind=real64), intent(in), dimension(n_genes) :: paralog_norms euclidean norms of the genes, used for subset pruning ( norm from f42_vector_impl computes them)\nThe minimum valid value is 0.0_real64 . integer(kind=int32), intent(in), dimension(n_genes) :: sorted_paralog_norms_perm ascending permutation of the norms, for subset pruning: the smallest norm among the genes that could extend a subset must not fall below the subset's angle to the ancestor\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_genes . real(kind=real64), intent(out), dimension(n_genes) :: tmp_work_array work array for checking the minimum value after a given index efficiently integer(kind=int32), intent(out) :: ierr Error code public pure subroutine filter_paralogs_by_pattern_dosage_effect (gene_angles, threshold, n_genes, n_families, gene_to_fam, masks, n_mask_chunks, ierr) Validates its inputs, then calls filter_paralogs_by_pattern_impl . Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_genes) :: gene_angles vector, holding the angles between ancestor and genes (0<=angle<=Pi)\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is PI . real(kind=real64), intent(in) :: threshold filter threshold integer(kind=int32), intent(in) :: n_genes number of genes integer(kind=int32), intent(in) :: n_families number of families\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_genes . integer(kind=int32), intent(in), dimension(n_genes) :: gene_to_fam a mapping of gene index to family index, so gene i is related to gene_angles(i) and part of family j=gene_to_fam(i) .\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_families . integer(kind=int32), intent(out), dimension(n_mask_chunks, n_families) :: masks bit mask that will have the indices of genes kept by this pattern set to 1, else 0 integer(kind=int32), intent(in) :: n_mask_chunks number of 32 bit chunks a mask needs to encode n_genes genes\nThe minimum valid value is (n_genes + 31) / 32 . integer(kind=int32), intent(out) :: ierr Error code public pure subroutine filter_paralogs_by_pattern_subfunctionalization (gene_angles, threshold, n_genes, n_families, gene_to_fam, masks, n_mask_chunks, ierr) Validates its inputs, then calls filter_paralogs_by_pattern_impl . Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_genes) :: gene_angles vector, holding the angles between ancestor and genes (0<=angle<=Pi)\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is PI . real(kind=real64), intent(in) :: threshold filter threshold integer(kind=int32), intent(in) :: n_genes number of genes integer(kind=int32), intent(in) :: n_families number of families\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_genes . integer(kind=int32), intent(in), dimension(n_genes) :: gene_to_fam a mapping of gene index to family index, so gene i is related to gene_angles(i) and part of family j=gene_to_fam(i) .\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_families . integer(kind=int32), intent(out), dimension(n_mask_chunks, n_families) :: masks bit mask that will have the indices of genes kept by this pattern set to 1, else 0 integer(kind=int32), intent(in) :: n_mask_chunks number of 32 bit chunks a mask needs to encode n_genes genes\nThe minimum valid value is (n_genes + 31) / 32 . integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"module/tox_paralog_analysis.html"},{"title":"tox_data_tools_c – TensorOmics","text":"Parsers for the plain-text input formats TensorOmics data sets are built from (gene-expression\nTSV/CSV files, OrthoFinder-style family files), plus small array-filtering helpers. These populate the raw gene_ids / expression / gene_to_family / family_ids arrays that save_tox_data later persists; unlike the archive/serde\nlayers, everything here works from delimited text rather than the library's binary array format. Uses f42_safeguard iso_c_binding tox_errors Subroutines public  subroutine read_expression_vectors_tsv_c (file_list, file_list_strlen, n_file_list_elements, gene_ids, gene_ids_strlen, n_gene_ids_elements, expression_vectors, n_expression_vectors_elements_dim_1, n_expression_vectors_elements_dim_2, n_header_rows, gene_col, value_cols, n_value_cols_elements, start_row, ierr, delimiter) bind(C, name=\"read_expression_vectors_tsv_c\") C-wrapper for read_expression_vectors_tsv Read more… Arguments Type Intent Optional Attributes Name character(kind=c_char, len=1), intent(in), dimension(file_list_strlen, n_file_list_elements), target :: file_list List of files to read from integer(kind=c_int), intent(in), target :: file_list_strlen length of the strings in file_list integer(kind=c_int), intent(in), target :: n_file_list_elements number of elements in file_list character(kind=c_char, len=1), intent(in), dimension(gene_ids_strlen, n_gene_ids_elements), target :: gene_ids Array of gene IDS integer(kind=c_int), intent(in), target :: gene_ids_strlen length of the strings in gene_ids integer(kind=c_int), intent(in), target :: n_gene_ids_elements number of elements in gene_ids real(kind=c_double), intent(inout), dimension(n_expression_vectors_elements_dim_1, n_expression_vectors_elements_dim_2), target :: expression_vectors Array of expression vectors integer(kind=c_int), intent(in), target :: n_expression_vectors_elements_dim_1 Read more… integer(kind=c_int), intent(in), target :: n_expression_vectors_elements_dim_2 Read more… integer(kind=c_int), intent(in), target :: n_header_rows Number of header rows to skip integer(kind=c_int), intent(in), target :: gene_col Index of column with gene_ids integer(kind=c_int), intent(in), dimension(n_value_cols_elements), target :: value_cols Indicies of columns containing values integer(kind=c_int), intent(in), target :: n_value_cols_elements number of elements in value_cols integer(kind=c_int), intent(in), target :: start_row Row in the expression vectors to start in integer(kind=c_int), intent(out), target :: ierr Error code character(kind=c_char, len=1), intent(in), dimension(1), target :: delimiter optional delimiter\nThe default value is char(9) . public  subroutine read_gene_ids_from_tsv_file_c (filename, filename_strlen, gene_ids, gene_ids_strlen, n_gene_ids_elements, n_header_rows, gene_col, ierr) bind(C, name=\"read_gene_ids_from_tsv_file_c\") C-wrapper for read_gene_ids_from_tsv_file Read more… Arguments Type Intent Optional Attributes Name character(kind=c_char, len=1), intent(in), dimension(filename_strlen), target :: filename Name of the file integer(kind=c_int), intent(in), target :: filename_strlen length of the strings in filename character(kind=c_char, len=1), intent(out), dimension(gene_ids_strlen, n_gene_ids_elements), target :: gene_ids gene ids array integer(kind=c_int), intent(in), target :: gene_ids_strlen length of the strings in gene_ids integer(kind=c_int), intent(in), target :: n_gene_ids_elements number of elements in gene_ids integer(kind=c_int), intent(in), target :: n_header_rows number of headers to skip integer(kind=c_int), intent(in), target :: gene_col Index of the column containing gene ids integer(kind=c_int), intent(out), target :: ierr Error code public  subroutine read_orthofinder_file_c (filename, filename_strlen, gene_ids, gene_ids_strlen, n_gene_ids_elements, family_ids, family_ids_strlen, n_family_ids_elements, gene_to_fam, n_gene_to_fam_elements, ierr) bind(C, name=\"read_orthofinder_file_c\") C-wrapper for read_orthofinder_file Read more… Arguments Type Intent Optional Attributes Name character(kind=c_char, len=1), intent(in), dimension(filename_strlen), target :: filename Name of the file integer(kind=c_int), intent(in), target :: filename_strlen length of the strings in filename character(kind=c_char, len=1), intent(in), dimension(gene_ids_strlen, n_gene_ids_elements), target :: gene_ids gene ids array integer(kind=c_int), intent(in), target :: gene_ids_strlen length of the strings in gene_ids integer(kind=c_int), intent(in), target :: n_gene_ids_elements number of elements in gene_ids character(kind=c_char, len=1), intent(out), dimension(family_ids_strlen, n_family_ids_elements), target :: family_ids family ids array integer(kind=c_int), intent(in), target :: family_ids_strlen length of the strings in family_ids integer(kind=c_int), intent(in), target :: n_family_ids_elements number of elements in family_ids integer(kind=c_int), intent(out), dimension(n_gene_to_fam_elements), target :: gene_to_fam gene to family mapping integer(kind=c_int), intent(in), target :: n_gene_to_fam_elements number of elements in gene_to_fam integer(kind=c_int), intent(out), target :: ierr Error code public  subroutine get_unassigned_mask_c (gene_to_fam, n_gene_to_fam_elements, mask, n_genes_kept, ierr) bind(C, name=\"get_unassigned_mask_c\") C-wrapper for get_unassigned_mask Read more… Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), dimension(n_gene_to_fam_elements), target :: gene_to_fam gene to family mapping integer(kind=c_int), intent(in), target :: n_gene_to_fam_elements number of elements in gene_to_fam logical(kind=c_bool), intent(out), dimension(size(gene_to_fam)), target :: mask mask for mapping integer(kind=c_int), intent(out), target :: n_genes_kept number of genes kept integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"module/tox_data_tools_c.html"},{"title":"f42_stats_impl – TensorOmics","text":"Descriptive statistics: percentiles, empirical distribution functions, and 2-D LOESS smoothing. One of the modules the f42_utils family gathers. Uses f42_safeguard iso_fortran_env iso_c_binding f42_sort_impl Functions public pure function calc_percentile_rank (percentile, n) result(rank) Author Franz-Eric Sill License MIT Calculate the fractional index using linear interpolation method Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: percentile desired percentile as a fraction in [0,1] (e.g. 0.95 for the 95th percentile) integer(kind=int32), intent(in) :: n Sample size Return Value real(kind=real64) Subroutines public pure subroutine loess_smooth_2d_impl (n_total, n_target, x_ref, y_ref, indices_used, n_used, x_query, kernel_sigma, kernel_cutoff, y_out) Author Vivian Bass License MIT Performs LOESS smoothing on a set of data points Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_total Total number of reference points. integer(kind=int32), intent(in) :: n_target Number of target points to smooth. real(kind=real64), intent(in) :: x_ref (n_total) Reference x-coordinates. real(kind=real64), intent(in) :: y_ref (n_total) Reference y-coordinates (length n_total). integer(kind=int32), intent(in) :: indices_used (n_used) Indices of reference points used for smoothing (only valid indices).\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_total . integer(kind=int32), intent(in) :: n_used Number of indices actually used for smoothing. real(kind=real64), intent(in) :: x_query (n_target) Target x-coordinates to smooth. real(kind=real64), intent(in) :: kernel_sigma Bandwidth parameter for the kernel.\nThe minimum valid value is 0.0_real64 . real(kind=real64), intent(in) :: kernel_cutoff Cutoff for the kernel, not used if zero\nThe minimum valid value is 0.0_real64 . real(kind=real64), intent(out) :: y_out (n_target) Output smoothed values (length n_target). public pure subroutine compute_edf_impl (values, n_values, values_perm, unique_values, cdf_values, n_unique) Author Jitu Daba License MIT Compute the Empirical Distribution Function (EDF) from a sorted permutation Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: values (n_values) Array of observed data values (e.g., contributions or spikes). integer(kind=int32), intent(in) :: n_values Number of values in the input array. integer(kind=int32), intent(in) :: values_perm (n_values) Permutation of values in ascending order. The allocating entry point builds\nand heapsorts it for you; the expert one takes whatever order you supply.\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_values . real(kind=real64), intent(out) :: unique_values (n_values) Sorted unique data values.\nThe first n_unique elements will hold the results. real(kind=real64), intent(out) :: cdf_values (n_values) Corresponding cumulative frequencies between 0 and 1.\nThe first n_unique elements will hold the results. integer(kind=int32), intent(out) :: n_unique Number of unique values found (actual size of output arrays) public pure subroutine calc_percentile_impl (array, n_array, array_perm, percentile, value, n_considered) Author Aaron Schröder License MIT Calculate the percentile of an array given a sorted permutation Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: array (n_array) input array integer(kind=int32), intent(in) :: n_array number of elements in array integer(kind=int32), intent(in) :: array_perm (n_array) Permutation of array in ascending order. The allocating entry point builds and\nheapsorts it for you; the expert one takes whatever order you supply.\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_array . real(kind=real64), intent(in) :: percentile desired percentile as a fraction in [0,1] (e.g. 0.95 for the 95th percentile)\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 . real(kind=real64), intent(out) :: value output percentile value integer(kind=int32), intent(in), optional :: n_considered How many leading entries of array_perm the percentile is taken over, for a\npercentile of a subset -- the trailing entries are ignored rather than sliced\noff, so the permutation stays the shape the sort produced. Zero, the default,\nconsiders all n_array of them.\nThe default value is 0_int32 .\nThe minimum valid value is 0_int32 .\nThe maximum valid value is n_array . public pure subroutine compute_scaled_distance_quantile_impl (n_genes, rdi, sorted_rdi, sorted_rdi_perm, quantile, c_const) Author Vivian Bass License MIT Calculate the empirical quantile (effect-size measure) of scaled expression distances (RDI) Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Number of genes being processed. real(kind=real64), intent(in) :: rdi (n_genes) empirical distribution D\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(in) :: sorted_rdi (n_genes) empirical distribution D with non negative values\nNaN is permitted for this value.\nInfinite values are permitted for this value. integer(kind=int32), intent(in) :: sorted_rdi_perm (n_genes) Permutation of sorted_rdi in ascending order. The allocating entry point builds\nand heapsorts it for you; the expert one takes whatever order you supply.\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_genes . real(kind=real64), intent(out) :: quantile (n_genes) Output array to store the computed quantile for each gene. real(kind=real64), intent(in) :: c_const Constant used in the computation, typically 1","tags":"","url":"module/f42_stats_impl.html"},{"title":"f42_serde_arrays_deserialize_char – TensorOmics","text":"Module for deserializing character arrays from files Uses iso_fortran_env f42_serde_arrays_utils tox_errors Subroutines public  subroutine deserialize_char_helper (arr, n_strings, strlen, arr_shape, filename, ierr) Author Aaron Schröder License MIT Category C-binding Subroutine to deserialize a flat character array from a file Read more… Arguments Type Intent Optional Attributes Name character(len=strlen), intent(out), dimension(n_strings) :: arr Pre-allocated array to read the data into integer(kind=int32), intent(in) :: n_strings Number of strings in arr integer(kind=int32), intent(in) :: strlen Length of each string in arr .\nIt is VERY IMPORTANT to compute this argument from the type_code output produced by get_array_metadata . Read more… integer(kind=int32), intent(in), dimension(:) :: arr_shape Extents of arr , one per dimension\nIt is VERY IMPORTANT to compute this argument from the dims_out output produced by get_array_metadata . Read more… character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code public  subroutine deserialize_char_1d (arr, filename, ierr) Author Aaron Schröder License MIT Directly deserialize a 1D character array from a file (array already allocated) Arguments Type Intent Optional Attributes Name character(len=*), intent(out), dimension(:), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file to read from integer(kind=int32), intent(out) :: ierr Error code public  subroutine deserialize_char_2d (arr, filename, ierr) Author Aaron Schröder License MIT Directly deserialize a 2D character array from a file (array already allocated) Arguments Type Intent Optional Attributes Name character(len=*), intent(out), dimension(:, :), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file to read from integer(kind=int32), intent(out) :: ierr Error code public  subroutine deserialize_char_3d (arr, filename, ierr) Author Aaron Schröder License MIT Directly deserialize a 3D character array from a file (array already allocated) Arguments Type Intent Optional Attributes Name character(len=*), intent(out), dimension(:, :, :), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file to read from integer(kind=int32), intent(out) :: ierr Error code public  subroutine deserialize_char_4d (arr, filename, ierr) Author Aaron Schröder License MIT Directly deserialize a 4D character array from a file (array already allocated) Arguments Type Intent Optional Attributes Name character(len=*), intent(out), dimension(:, :, :, :), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file to read from integer(kind=int32), intent(out) :: ierr Error code public  subroutine deserialize_char_5d (arr, filename, ierr) Author Aaron Schröder License MIT Directly deserialize a 5D character array from a file (array already allocated) Arguments Type Intent Optional Attributes Name character(len=*), intent(out), dimension(:, :, :, :, :), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file to read from integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"module/f42_serde_arrays_deserialize_char.html"},{"title":"f42_vector_impl – TensorOmics","text":"Vector geometry in n dimensions: lengths, angles, and element-wise arithmetic. One of the modules f42_utils_impl gathers; use f42_utils_impl reaches all of them. Uses iso_fortran_env f42_math_impl tox_errors Functions public pure function norm (vector) Author Franz-Eric Sill License MIT Calculates the euclidean norm of a vector Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(:) :: vector Input vector the norm will be calcuated for Return Value real(kind=real64) Subroutines public pure subroutine angle_between (v1, v2, n_dims, angle, ierr) Author Franz-Eric Sill License MIT Computes the radian angle between two vectors Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_dims) :: v1 first vector for angle calculation real(kind=real64), intent(in), dimension(n_dims) :: v2 second vector for angle calculation integer(kind=int32), intent(in) :: n_dims number of elements in v1 and v2 real(kind=real64), intent(out) :: angle will hold calculated angle integer(kind=int32), intent(out) :: ierr Error code public pure subroutine add_vector (vector, to_be_added) Author Franz-Eric Sill License MIT Adds two vectors in-place Arguments Type Intent Optional Attributes Name real(kind=real64), intent(inout), dimension(:) :: vector First vector, it will be modified in-place real(kind=real64), intent(in), dimension(:) :: to_be_added Vector that should be added to vector public pure subroutine subtract_vector (vector, to_be_subtracted) Author Franz-Eric Sill License MIT Subtracts two vectors in-place Arguments Type Intent Optional Attributes Name real(kind=real64), intent(inout), dimension(:) :: vector First vector, it will be modified in-place real(kind=real64), intent(in), dimension(:) :: to_be_subtracted Vector that should be subtracted from vector","tags":"","url":"module/f42_vector_impl.html"},{"title":"f42_xxh3_hashmap – TensorOmics","text":"String-keyed hashmap ( character -> integer(int32) ) and hashset ( character membership),\nimplemented as power-of-two-sized bucket arrays with separate chaining and the external XXH3\nalgorithm for hashing. Both containers rehash into a larger bucket array of their own accord\nonce three quarters full, so a caller never sizes one twice. Uses iso_fortran_env iso_c_binding f42_math_impl f42_safeguard tox_errors f42_config Derived Types type, public, extends(../../hashmap_base) :: hashmap_type Hashmap of character keys to integer(int32) values, using separate chaining over a\npower-of-two-sized bucket array. Components Type Visibility Attributes Name Initial integer(kind=int32), public :: size = 0 Number of buckets (always a power of two, see next_power_of_two ). integer(kind=int32), public :: count = 0 Number of key-value pairs currently stored. type(hashmap_node_type), public, pointer :: buckets (:) => null() Bucket array; buckets(i)%next heads the chain for bucket i (the bucket\nelements themselves only ever use their next pointer, never key / value ). type, public, extends(../../hashmap_base) :: hashset_type Hashset of character keys, using separate chaining over a power-of-two-sized bucket array. Components Type Visibility Attributes Name Initial integer(kind=int32), public :: size = 0 Number of buckets (always a power of two, see next_power_of_two ). integer(kind=int32), public :: count = 0 Number of key-value pairs currently stored. type(hashset_node_type), public, pointer :: buckets (:) => null() Bucket array; buckets(i)%next heads the chain for bucket i (the bucket\nelements themselves only ever use their next pointer, never key / value ). Functions public  function is_in_hashset (hashset, key) result(res) Author Aaron Schröder License MIT Checks whether key is a member of hashset . Arguments Type Intent Optional Attributes Name type( hashset_type ), intent(in) :: hashset Hashset to query character(len=*), intent(in) :: key Key to look for Return Value logical public  function hashmap_get (map, key) result(value) Author Aaron Schröder License MIT Lookup a key Arguments Type Intent Optional Attributes Name type( hashmap_type ), intent(in) :: map hashmap character(len=*), intent(in) :: key key to look for Return Value integer(kind=int32) return value Subroutines public  subroutine hashmap_create (map, initial_size) Author Aaron Schröder License MIT Create the hashmap Arguments Type Intent Optional Attributes Name type( hashmap_type ), intent(out) :: map Hashmap object to create integer(kind=int32), intent(in), optional :: initial_size Desired initial element capacity; the actual bucket count is derived from this\n(scaled by MAX_LOAD_FACTOR and rounded up to a power of two, floored at 128),\ndefault: 1024 buckets public  subroutine hashset_create (set, initial_size) Author Aaron Schröder License MIT Create the hashset Arguments Type Intent Optional Attributes Name type( hashset_type ), intent(out) :: set Hashset object to create integer(kind=int32), intent(in), optional :: initial_size Desired initial element capacity; the actual bucket count is derived from this\n(scaled by MAX_LOAD_FACTOR and rounded up to a power of two, floored at 128),\ndefault: 1024 buckets public  subroutine hashmap_destroy (map) Author Aaron Schröder License MIT Destroy the hashmap Arguments Type Intent Optional Attributes Name type( hashmap_type ), intent(inout) :: map The hashmap to delete public  subroutine hashset_destroy (set) Author Aaron Schröder License MIT Destroy the set Arguments Type Intent Optional Attributes Name type( hashset_type ), intent(inout) :: set The set to delete public  subroutine hashmap_put (map, key, value) Author Aaron Schröder License MIT Insert a key-value pair Arguments Type Intent Optional Attributes Name type( hashmap_type ), intent(inout) :: map hashmap to insert into character(len=*), intent(in) :: key Key to store integer(kind=int32), intent(in) :: value value to store public  subroutine hashset_put (set, key, ierr) Author Aaron Schröder License MIT Insert a key-value pair Arguments Type Intent Optional Attributes Name type( hashset_type ), intent(inout) :: set hashmap to insert into character(len=*), intent(in) :: key Key to store integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"module/f42_xxh3_hashmap.html"},{"title":"f42_serde_arrays_deserialize_real – TensorOmics","text":"Module for deserializing real arrays from files Uses iso_fortran_env f42_serde_arrays_utils tox_errors Subroutines public  subroutine deserialize_real_helper (arr, n_elements, arr_shape, filename, ierr) Author Aaron Schröder License MIT Category C-binding Deserialize a flat real array from a file Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(out), dimension(n_elements) :: arr Pre-allocated array to read the data into integer(kind=int32), intent(in) :: n_elements Size of arr integer(kind=int32), intent(in), dimension(:) :: arr_shape Extents of arr , one per dimension\nIt is VERY IMPORTANT to compute this argument from the dims_out output produced by get_array_metadata . Read more… character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code public  subroutine deserialize_real_1d (arr, filename, ierr) Author Aaron Schröder License MIT Directly deserialize a 1D real array from a file Arguments Type Intent Optional Attributes Name real(kind=real64), intent(out), dimension(:), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code public  subroutine deserialize_real_2d (arr, filename, ierr) Author Aaron Schröder License MIT Directly deserialize a 2D real array from a file Arguments Type Intent Optional Attributes Name real(kind=real64), intent(out), dimension(:, :), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code public  subroutine deserialize_real_3d (arr, filename, ierr) Author Aaron Schröder License MIT Directly deserialize a 3D real array from a file Arguments Type Intent Optional Attributes Name real(kind=real64), intent(out), dimension(:, :, :), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code public  subroutine deserialize_real_4d (arr, filename, ierr) Author Aaron Schröder License MIT Directly deserialize a 4D real array from a file Arguments Type Intent Optional Attributes Name real(kind=real64), intent(out), dimension(:, :, :, :), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code public  subroutine deserialize_real_5d (arr, filename, ierr) Author Aaron Schröder License MIT Directly deserialize a 5D real array from a file Arguments Type Intent Optional Attributes Name real(kind=real64), intent(out), dimension(:, :, :, :, :), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"module/f42_serde_arrays_deserialize_real.html"},{"title":"f42_serde_arrays_deserialize_complex – TensorOmics","text":"Module for deserializing complex arrays from files Uses iso_fortran_env f42_serde_arrays_utils tox_errors Subroutines public  subroutine deserialize_complex_helper (arr, n_elements, arr_shape, filename, ierr) Author Aaron Schröder License MIT Category C-binding Deserialize a flat complex array from a file Read more… Arguments Type Intent Optional Attributes Name complex(kind=real64), intent(out), dimension(n_elements) :: arr Pre-allocated array to read the data into integer(kind=int32), intent(in) :: n_elements Size of arr integer(kind=int32), intent(in), dimension(:) :: arr_shape Extents of arr , one per dimension\nIt is VERY IMPORTANT to compute this argument from the dims_out output produced by get_array_metadata . Read more… character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code public  subroutine deserialize_complex_1d (arr, filename, ierr) Author Aaron Schröder License MIT Directly deserialize a 1D complex array from a file Arguments Type Intent Optional Attributes Name complex(kind=real64), intent(out), dimension(:), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code public  subroutine deserialize_complex_2d (arr, filename, ierr) Author Aaron Schröder License MIT Directly deserialize a 2D complex array from a file Arguments Type Intent Optional Attributes Name complex(kind=real64), intent(out), dimension(:, :), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code public  subroutine deserialize_complex_3d (arr, filename, ierr) Author Aaron Schröder License MIT Directly deserialize a 3D complex array from a file Arguments Type Intent Optional Attributes Name complex(kind=real64), intent(out), dimension(:, :, :), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code public  subroutine deserialize_complex_4d (arr, filename, ierr) Author Aaron Schröder License MIT Directly deserialize a 4D complex array from a file Arguments Type Intent Optional Attributes Name complex(kind=real64), intent(out), dimension(:, :, :, :), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code public  subroutine deserialize_complex_5d (arr, filename, ierr) Author Aaron Schröder License MIT Directly deserialize a 5D complex array from a file Arguments Type Intent Optional Attributes Name complex(kind=real64), intent(out), dimension(:, :, :, :, :), contiguous :: arr Pre-allocated array to read the data into character(len=*), intent(in) :: filename Name of the file integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"module/f42_serde_arrays_deserialize_complex.html"},{"title":"tox_data_validation – TensorOmics","text":"Semantic validation of TensorOmics data sets (dimensions, ID uniqueness, value ranges,\nand cross-array consistency). Complements tox_errors 's generic per-argument validators\n( validate_dimension_size , validate_in_range_int/real , ...) with checks specific to the\nTensorOmics gene/family/expression/centroid/shift-vector data model, such as verifying that shift_vectors was actually derived from expression_vectors and family_centroids as\nexpected. validate_all_data runs the full suite. Uses iso_fortran_env iso_c_binding f42_safeguard tox_errors f42_config Subroutines public  subroutine validate_data_structure (n_genes, n_families, n_samples, gene_ids, gene_family_ids, gene_to_fam, expression_vectors, family_centroids, shift_vectors, ierr) Author Aaron Schröder License MIT Category C-binding Validate full data structure Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Expected number of genes integer(kind=int32), intent(in) :: n_families Expected number of families integer(kind=int32), intent(in) :: n_samples Expected number of samples character(len=*), intent(in) :: gene_ids (:) Gene ids character(len=*), intent(in) :: gene_family_ids (:) Gene family ids integer(kind=int32), intent(in) :: gene_to_fam (:) gene to family mapping real(kind=real64), intent(in) :: expression_vectors (:,:) Expression vectors real(kind=real64), intent(in) :: family_centroids (:,:) Family centroids real(kind=real64), intent(in) :: shift_vectors (:,:) Shift vectors integer(kind=int32), intent(out) :: ierr Error code public  subroutine validate_gene_to_family_mapping (gene_to_fam, n_families, ierr) Author Aaron Schröder License MIT Category C-binding Validate gene to family mapping Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: gene_to_fam (:) gene to family mapping integer(kind=int32), intent(in) :: n_families number of families integer(kind=int32), intent(out) :: ierr Error code public  subroutine validate_expression_data (expression_vectors, check_non_negative, ierr) Author Aaron Schröder License MIT Category C-binding Validate expresssion data Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: expression_vectors (:,:) Expression vectors logical(kind=c_bool), intent(in) :: check_non_negative Defines if non negative should be checked integer(kind=int32), intent(out) :: ierr Error code public  subroutine validate_family_centroids (family_centroids, ierr) Author Aaron Schröder License MIT Category C-binding Validate the family centroids Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: family_centroids (:,:) Family centroids array integer(kind=int32), intent(out) :: ierr Error code public  subroutine validate_shift_vectors (shift_vectors, expression_vectors, family_centroids, gene_to_fam, n_samples, ierr) Author Aaron Schröder License MIT Category C-binding Validates shift vectors Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: shift_vectors (:,:) shift vectors real(kind=real64), intent(in) :: expression_vectors (:,:) expression vectors real(kind=real64), intent(in) :: family_centroids (:,:) family centroids integer(kind=int32), intent(in) :: gene_to_fam (:) gene to family mapping integer(kind=int32), intent(in) :: n_samples Number of samples integer(kind=int32), intent(out) :: ierr Error code public  subroutine check_for_nan_inf (array, ierr) Author Aaron Schröder License MIT Check if an array of type real contains NaN or Inf values Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: array (:,:) Input array integer(kind=int32), intent(out) :: ierr Error code public  subroutine validate_string_array_uniqueness (str_arr, ierr) Author Aaron Schröder License MIT Category C-binding Validate that no string appears more than once Read more… Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: str_arr (:) string array integer(kind=int32), intent(out) :: ierr Error code public  subroutine validate_empty_strings (string_array, array_name, ierr) Author Aaron Schröder License MIT Validate that strings in an array are not empty Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: string_array (:) Array of strings character(len=*), intent(in) :: array_name Name of the array integer(kind=int32), intent(out) :: ierr Error code public  subroutine validate_all_data (n_genes, n_families, n_samples, gene_ids, gene_family_ids, gene_to_fam, expression_vectors, family_centroids, shift_vectors, ierr, check_uniqueness, check_shift_consistency) Author Aaron Schröder License MIT Category C-binding Comprehensive validation routine, combining all checks Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Number of genes integer(kind=int32), intent(in) :: n_families Number of families integer(kind=int32), intent(in) :: n_samples Number of samples character(len=*), intent(in) :: gene_ids (:) Gene ids array character(len=*), intent(in) :: gene_family_ids (:) gene family ids integer(kind=int32), intent(in) :: gene_to_fam (:) gene to family mapping real(kind=real64), intent(in) :: expression_vectors (:,:) Expression vectors real(kind=real64), intent(in) :: family_centroids (:,:) family centroids real(kind=real64), intent(in) :: shift_vectors (:,:) shift vectors integer(kind=int32), intent(out) :: ierr error code logical(kind=c_bool), intent(in), optional :: check_uniqueness Check ID arrays for uniqueness.\nThe default value is .true. . logical(kind=c_bool), intent(in), optional :: check_shift_consistency Check consitency of shift array.\nThe default value is .true. .","tags":"","url":"module/tox_data_validation.html"},{"title":"tox_data_integration – TensorOmics","text":"Jensen-Shannon-Divergence (JSD) Compatibility Test (JCT) In multi-study omics analyses, it is often unclear whether biological replicates originating from different studies can be safely treated as sampling the same biological condition.\nEven when studies nominally target the same tissue and condition, differences in sample handling, sequencing technologies, preprocessing pipelines, or cohort,\ncomposition can introduce batch effects that are not easily detectable from mean expression levels alone. This ambiguity has direct consequences for downstream analyses in Tensor Omics. Integrating incompatible replicate sets can: distort expression spaces, affect distance-based analyses, bias machine learning models, while unnecessarily separating compatible datasets reduces statistical power. To address this, we introduce a Jensen-Shannon-Divergence based compatibility test (JSD-Comp-Test)\nthat empirically evaluates whether two sets of biological replicates exhibit comparable replicate-level variability.\nRather than comparing mean expression values, the method focuses on the distribution of signed residuals (replicate deviations from the gene-wise mean),\nconditioned on mean expression levels to account for heteroscedasticity, which is a well-known property of omics data. The test is split over four modules -- preprocessing, JSD calculation, per-family JSD\ncalculation and the permutation test -- which this one gathers, so a caller reaches the whole\npipeline through it and the split stays out of the way. Generated from tox_data_integration_impl ; do not edit -- regenerate instead. Uses tox_data_integration_stats tox_data_integration_jsd tox_data_integration_preprocessing tox_data_integration_per_family","tags":"","url":"module/tox_data_integration.html"},{"title":"tox_data_integration_jsd – TensorOmics","text":"Jensen-Shannon-Divergence (JSD) Compatibility Test (gJCT) JSD Calculation The step that turns neighborhood residuals -- as produced by the preprocessing module -- into\na JSD value: residuals are binned into histograms per study, the two distributions are\ncompared per reference point, and the per-point divergences are weighted into one global\nfigure for the pair of studies. Generated from tox_data_integration_jsd_impl ; do not edit -- regenerate instead. Uses iso_fortran_env iso_c_binding tox_data_integration_jsd_impl f42_safeguard f42_sort_impl tox_errors Subroutines public pure subroutine determine_shared_residual_range (abs_residual_pool, pool_size, shared_residual_range, residual_range_quantile, ierr) Validates its inputs, prepares what determine_shared_residual_range_impl needs, then calls it. The entry point to reach for first; see determine_shared_residual_range_expert to prepare it yourself. Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(pool_size) :: abs_residual_pool The absolute residual values of the concatenated S1,S2 residuals\nNaN is permitted for this value. integer(kind=int32), intent(in) :: pool_size Size of pool of residuals abs_residual_pool , usually (n_reps_S1 + n_reps_2)*n_neighbors*n_points real(kind=real64), intent(out) :: shared_residual_range Computed residual range (R) real(kind=real64), intent(in), optional :: residual_range_quantile Quantile in [0,1] for determining the residual range\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 .\nThe default value is 0.95 . integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure. public pure subroutine determine_shared_residual_range_expert (abs_residual_pool, abs_residual_pool_perm, pool_size, shared_residual_range, residual_range_quantile, ierr) Validates its inputs, then calls determine_shared_residual_range_impl with what you supply. The expert entry point: it allocates nothing and prepares nothing; determine_shared_residual_range does both. Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(pool_size) :: abs_residual_pool The absolute residual values of the concatenated S1,S2 residuals\nNaN is permitted for this value. integer(kind=int32), intent(in), dimension(pool_size) :: abs_residual_pool_perm The permutation vector that sorts abs_residual_pool The minimum valid value is 1_int32 .\nThe maximum valid value is pool_size . integer(kind=int32), intent(in) :: pool_size Size of pool of residuals abs_residual_pool , usually (n_reps_S1 + n_reps_2)*n_neighbors*n_points real(kind=real64), intent(out) :: shared_residual_range Computed residual range (R) real(kind=real64), intent(in), optional :: residual_range_quantile Quantile in [0,1] for determining the residual range\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 .\nThe default value is 0.95 . integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure. public pure subroutine determine_study_shared_residual_range (neighborhood_residuals_S1, neighborhood_residuals_S2, n_reps_S1, n_reps_S2, n_neighbors, n_points, shared_residual_range, residual_range_quantile, ierr) Validates its inputs, prepares what determine_study_shared_residual_range_impl needs, then calls it. The entry point to reach for first; see determine_study_shared_residual_range_expert to prepare it yourself. Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_reps_S1, n_neighbors, n_points) :: neighborhood_residuals_S1 Computed neighborhood residuals for study 1, NaN is explicitly allowed for missing values\nNaN is permitted for this value. real(kind=real64), intent(in), dimension(n_reps_S2, n_neighbors, n_points) :: neighborhood_residuals_S2 Computed neighborhood residuals for study 2, NaN is explicitly allowed for missing values\nNaN is permitted for this value. integer(kind=int32), intent(in) :: n_reps_S1 Number of replicates in study 1 integer(kind=int32), intent(in) :: n_reps_S2 Number of replicates in study 2 integer(kind=int32), intent(in) :: n_neighbors Number of neighbors in the studies integer(kind=int32), intent(in) :: n_points Number of reference points in the studies real(kind=real64), intent(out) :: shared_residual_range Computed residual range (R) real(kind=real64), intent(in), optional :: residual_range_quantile Quantile in [0,1] for determining the residual range\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 .\nThe default value is 0.95 . integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure. public pure subroutine determine_study_shared_residual_range_expert (neighborhood_residuals_S1, neighborhood_residuals_S2, n_reps_S1, n_reps_S2, n_neighbors, n_points, tmp_abs_residual_pool, tmp_abs_residual_pool_perm, shared_residual_range, residual_range_quantile, ierr) Validates its inputs, then calls determine_study_shared_residual_range_impl with what you supply. The expert entry point: it allocates nothing and prepares nothing; determine_study_shared_residual_range does both. Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_reps_S1, n_neighbors, n_points) :: neighborhood_residuals_S1 Computed neighborhood residuals for study 1, NaN is explicitly allowed for missing values\nNaN is permitted for this value. real(kind=real64), intent(in), dimension(n_reps_S2, n_neighbors, n_points) :: neighborhood_residuals_S2 Computed neighborhood residuals for study 2, NaN is explicitly allowed for missing values\nNaN is permitted for this value. integer(kind=int32), intent(in) :: n_reps_S1 Number of replicates in study 1 integer(kind=int32), intent(in) :: n_reps_S2 Number of replicates in study 2 integer(kind=int32), intent(in) :: n_neighbors Number of neighbors in the studies integer(kind=int32), intent(in) :: n_points Number of reference points in the studies real(kind=real64), intent(out), dimension((n_reps_S1 + n_reps_S2)*n_neighbors*n_points) :: tmp_abs_residual_pool Work array holding the pooled absolute residuals of both studies integer(kind=int32), intent(out), dimension((n_reps_S1 + n_reps_S2)*n_neighbors*n_points) :: tmp_abs_residual_pool_perm Work array for the permutation that sorts tmp_abs_residual_pool real(kind=real64), intent(out) :: shared_residual_range Computed residual range (R) real(kind=real64), intent(in), optional :: residual_range_quantile Quantile in [0,1] for determining the residual range\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 .\nThe default value is 0.95 . integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure. public pure subroutine build_residual_histograms (neighborhood_residuals, n_reps, n_neighbors, n_points, shared_residual_range, n_bins, counts, pmf, included_n_reps, neighbor_mask, ierr) Validates its inputs, then calls build_residual_histograms_impl . Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_reps, n_neighbors, n_points) :: neighborhood_residuals Computed neighborhood residuals for a study, NaN is explicitly allowed for missing values\nNaN is permitted for this value. integer(kind=int32), intent(in) :: n_reps Number of replicates of the study integer(kind=int32), intent(in) :: n_neighbors Number of reference points (k) integer(kind=int32), intent(in) :: n_points Number of reference points in the study real(kind=real64), intent(in) :: shared_residual_range Computed residual range (R)\nThe minimum valid value is 0.0_real64 . integer(kind=int32), intent(in) :: n_bins Number of equally sized histogram bins in range [-R,R] integer(kind=int32), intent(out), dimension(n_points, n_bins) :: counts Absolute counts of a residual per bin real(kind=real64), intent(out), dimension(n_points, n_bins) :: pmf counts normalized to 0 <= counts(:, i) <= 1 and sum(counts(:, i)) == 1 integer(kind=int32), intent(out), dimension(n_points) :: included_n_reps Stores the count of non-NaN replicates (included ones) logical(kind=c_bool), intent(in), optional, dimension(n_neighbors, n_points) :: neighbor_mask Optional mask to exclude specific neighbors (e.g. for family-wise analysis) integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure. public pure subroutine compute_divergence_per_reference_point (pmf_S1, pmf_S2, n_points, n_bins, js_divergences, ierr) Validates its inputs, then calls compute_divergence_per_reference_point_impl . Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_points, n_bins) :: pmf_S1 Computed normalized histogram counts for study 1\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 . real(kind=real64), intent(in), dimension(n_points, n_bins) :: pmf_S2 Computed normalized histogram counts for study 2\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 . integer(kind=int32), intent(in) :: n_points Number of reference points (k) integer(kind=int32), intent(in) :: n_bins Number of equally sized histogram bins in range [-R,R] real(kind=real64), intent(out), dimension(n_points) :: js_divergences Jensen-Shannon divergence per reference point integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure. public pure subroutine compute_weighted_global_divergence (js_divergences, n_points, included_n_reps_S1, included_n_reps_S2, global_js_divergence, weights, ierr) Validates its inputs, then calls compute_weighted_global_divergence_impl . Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_points) :: js_divergences Jensen-Shannon divergence per reference point, computed for studies S1 and S2\nThe minimum valid value is 0.0_real64 . integer(kind=int32), intent(in) :: n_points Number of reference points (k) integer(kind=int32), intent(in), dimension(n_points) :: included_n_reps_S1 Count of non-NaN residuals (included ones) in study 1\nThe minimum valid value is 0_int32 . integer(kind=int32), intent(in), dimension(n_points) :: included_n_reps_S2 Count of non-NaN residuals (included ones) in study 2\nThe minimum valid value is 0_int32 . real(kind=real64), intent(out) :: global_js_divergence Weighted global Jensen-Shannon divergence real(kind=real64), intent(out), dimension(n_points) :: weights Weights used for calculating the global weighted Jensen-Shannon divergence global_js_divergence integer(kind=int32), intent(out) :: ierr Error code; zero on success, non-zero on failure.","tags":"","url":"module/tox_data_integration_jsd.html"},{"title":"tox_trajectory_contribution_analysis_impl – TensorOmics","text":"Module for quantifying how much one trajectory (a \"factor\") contributes to another (a \"dependent\") over time. Contributions are computed per timepoint as the product of both series' deviations from a chosen\nbaseline, for raw expression trajectories as well as for their velocity (first difference) and\nacceleration (second difference) derivatives. Statistical significance of an observed contribution can\nbe assessed via a permutation test that recomputes the same contribution against a randomly chosen\nother sample. Uses iso_fortran_env f42_random_impl tox_errors Variables Type Visibility Attributes Name Initial integer(kind=int32), public, parameter :: MODE_BASELINE_RAW = 1_int32 baseline_mode value for no centering (raw values) integer(kind=int32), public, parameter :: MODE_BASELINE_MIN = 2_int32 baseline_mode value for centering on each series' minimum value integer(kind=int32), public, parameter :: MODE_BASELINE_MEAN = 3_int32 baseline_mode value for centering on each series' arithmetic mean Subroutines public  subroutine select_random_sample (n_samples, current_sample, random_sample, ierr) Author Franz-Eric Sill License MIT Selects a random sample different to current_sample . For reproducibility call init_random beforehand. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_samples number of samples integer(kind=int32), intent(in) :: current_sample sample that won't be selected integer(kind=int32), intent(out) :: random_sample selected random sample integer(kind=int32), intent(out) :: ierr Error code public  subroutine select_random_sample_helper (n_samples, current_sample, random_sample) Author Franz-Eric Sill License MIT Selects a random sample different to current_sample . For reproducibility call init_random beforehand. Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_samples number of samples integer(kind=int32), intent(in) :: current_sample sample that won't be selected integer(kind=int32), intent(out) :: random_sample selected random sample public  subroutine perform_permutation_test_impl (trajectories, n_factors, n_samples, n_timepoints, factor_idx, dependent_idx, sample_idx, baseline_mode, n_permutations, local_contributions, total_contributions, tmp_factor, tmp_dependent, random_seed, ierr) Author Franz-Eric Sill License MIT For a factor-dependent pair, calculates the contributions against the same dependent taken from a random different sample Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_factors, n_samples, n_timepoints) :: trajectories expression vectors across different samples over time integer(kind=int32), intent(in) :: n_factors number of factors integer(kind=int32), intent(in) :: n_samples number of samples integer(kind=int32), intent(in) :: n_timepoints number of timepoints integer(kind=int32), intent(in) :: factor_idx index of factor to compute the permutation contributions for\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_factors . integer(kind=int32), intent(in) :: dependent_idx index of dependent to compute the permutation contributions for\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_factors . integer(kind=int32), intent(in) :: sample_idx index of sample to compute the permutation contributions for\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_samples . integer(kind=int32), intent(in) :: baseline_mode Read more… integer(kind=int32), intent(in) :: n_permutations number of permutations to perform real(kind=real64), intent(out), dimension(n_timepoints, n_permutations) :: local_contributions Per-timepoint contributions per permutation real(kind=real64), intent(out), dimension(n_permutations) :: total_contributions Total contribution ( sum(local_contributions) ) per permutation real(kind=real64), intent(out), dimension(n_timepoints) :: tmp_factor Working array to hold the factor in contiguous memory real(kind=real64), intent(out), dimension(n_timepoints) :: tmp_dependent Working array to hold the random dependent in contiguous memory integer(kind=int32), intent(in), optional :: random_seed Seed to use for random number generation. integer(kind=int32), intent(out) :: ierr Error code public pure subroutine compute_p_values_impl (local_contributions_observed, total_contribution_observed, local_contributions_perm_test, total_contributions_perm_test, n_timepoints, n_permutations, local_p_values, total_p_value) Author Franz-Eric Sill License MIT Calculates the p values for the contributions once the permutation tests are done Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_timepoints) :: local_contributions_observed Per-timepoint contributions for the observed factor-dependent-sample combination real(kind=real64), intent(in) :: total_contribution_observed Total contribution ( sum(local_contributions) ) for the observed factor-dependent-sample combination real(kind=real64), intent(in), dimension(n_timepoints, n_permutations) :: local_contributions_perm_test Per-timepoint contributions for the factor-dependent-random_sample combinations from perform_permutation_test_impl real(kind=real64), intent(in), dimension(n_permutations) :: total_contributions_perm_test Total contribution ( sum(local_contributions) ) for the factor-dependent-random_sample combinations from perform_permutation_test_impl integer(kind=int32), intent(in) :: n_timepoints number of timepoints integer(kind=int32), intent(in) :: n_permutations number of permutations to perform real(kind=real64), intent(out), dimension(n_timepoints) :: local_p_values calculated p values for local contributions, like: (local_contributions_perm_test >= local_contributions_observed)/n_permutations real(kind=real64), intent(out) :: total_p_value calculated p values for total contributions, like: (total_contributions_perm_test >= total_contribution_observed)/n_permutations public pure subroutine compute_contributions_impl (factor, dependent, n_dims, baseline_mode, local_contributions, total_contribution, ierr) Author Franz-Eric Sill License MIT Performs contribution analysis for a specific factor-dependent pair Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_dims) :: factor Factor time series, length n_timepoints real(kind=real64), intent(in), dimension(n_dims) :: dependent Dependent variable time series, length n_timepoints integer(kind=int32), intent(in) :: n_dims Number of elements in factor and dependent integer(kind=int32), intent(in) :: baseline_mode Read more… real(kind=real64), intent(out), dimension(n_dims) :: local_contributions Per-element contributions real(kind=real64), intent(out) :: total_contribution Total contribution ( sum(local_contributions) ) integer(kind=int32), intent(out) :: ierr Error code public pure subroutine compute_all_contributions_impl (trajectories, n_factors, n_samples, n_timepoints, factor_indices, n_selected_factors, dependent_indices, n_selected_dependents, baseline_mode, local_contributions, total_contributions, tmp_factors, tmp_dependent, ierr) Author Franz-Eric Sill License MIT Contribution analysis for every selected factor-dependent pair Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_factors, n_samples, n_timepoints) :: trajectories expression vectors across different samples over time integer(kind=int32), intent(in) :: n_factors number of factors integer(kind=int32), intent(in) :: n_samples number of samples integer(kind=int32), intent(in) :: n_timepoints number of timepoints integer(kind=int32), intent(in), dimension(n_selected_factors) :: factor_indices indices of factors to compute the contributions for\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_factors . integer(kind=int32), intent(in) :: n_selected_factors number of selected factors in factor_indices integer(kind=int32), intent(in), dimension(n_selected_dependents) :: dependent_indices indices of dependents to compute the contributions for\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_factors . integer(kind=int32), intent(in) :: n_selected_dependents number of selected dependents in dependent_indices integer(kind=int32), intent(in) :: baseline_mode Read more… real(kind=real64), intent(out), dimension(n_timepoints, n_selected_factors, n_selected_dependents, n_samples) :: local_contributions Per-timepoint contributions per sample-dependent-factor combination real(kind=real64), intent(out), dimension(n_selected_factors, n_selected_dependents, n_samples) :: total_contributions Total contribution ( sum(local_contributions) ) per sample-dependent-factor combination real(kind=real64), intent(out), dimension(n_timepoints, n_selected_factors) :: tmp_factors Working array to hold the currently handled sample's factors in contiguous memory real(kind=real64), intent(out), dimension(n_timepoints) :: tmp_dependent Working array to hold the currently handled dependent in contiguous memory integer(kind=int32), intent(out) :: ierr Error code public pure subroutine compute_baselines_factor_dependent_impl (n_timepoints, factor, dependent, baseline_mode, factor_baseline, dependent_baseline, ierr) 