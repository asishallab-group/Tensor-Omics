ntent(in), target :: filename_strlen length of the strings in filename integer(kind=c_int), intent(out), target :: ierr Error code","tags":"","url":"module/f42_serde_arrays_deserialize_int_c.html"},{"title":"tox_get_outliers_impl – TensorOmics","text":"Gene outliers, from how far each gene sits from its family's centroid. The pipeline is three steps, each callable on its own. compute_rdi turns raw distances into\na relative distance index, scaled per family so families of different spread are comparable. compute_family_scaling fits that scaling with LOESS against family size. identify_outliers applies the threshold and reports which genes exceed it. detect_outliers runs all three in one call, and is the entry point to reach for first. Uses iso_fortran_env f42_stats_impl iso_c_binding f42_math_impl f42_safeguard f42_sort_impl ieee_arithmetic tox_errors tox_loess_impl Variables Type Visibility Attributes Name Initial integer(kind=int32), public, parameter :: MODE_PLAIN = 0_int32 Mode code selecting a plain LOESS fit, for callers that carry the choice as a value integer(kind=int32), public, parameter :: MODE_ROBUST = 1_int32 Mode code selecting a robust LOESS fit, for callers that carry the choice as a value Subroutines public  subroutine compute_family_scaling_impl (n_genes, n_families, distances, gene_to_fam, dscale, loess_x, loess_y, indices_used, tmp_perm, tmp_stack_left, tmp_stack_right, tmp_int_workspace, int_workspace_size, tmp_real_workspace, real_workspace_size, tmp_diagl, tmp_weights, tmp_eval_points, tmp_robust_weights, tmp_combined_weights, tmp_residuals, tmp_permutation_indices, tmp_fitted_values, span, degree, mode, n_iters, low_sd_cutoff, excluded_low_sd, tmp_means_aux, ierr) Author Vivian Bass License MIT Compute family scaling factors (dscale) to normalize distances Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Total number of genes integer(kind=int32), intent(in) :: n_families Total number of gene families real(kind=real64), intent(in) :: distances (n_genes) Array of Euclidean distances for each gene\nNaN is permitted for this value.\nInfinite values are permitted for this value. integer(kind=int32), intent(in) :: gene_to_fam (n_genes) Mapping of each gene to its family (1-based) real(kind=real64), intent(out) :: dscale (n_families) Array of scaling factors per family (output) real(kind=real64), intent(out) :: loess_x (n_families) Reference x-coordinates for LOESS smoothing real(kind=real64), intent(out) :: loess_y (n_families) Reference y-coordinates for LOESS smoothing integer(kind=int32), intent(out) :: indices_used (n_families) Indices of reference points used for smoothing integer(kind=int32), intent(out) :: tmp_perm (n_genes) Permutation array for sorting gene distances integer(kind=int32), intent(out) :: tmp_stack_left (n_genes) Stack array for left indices during sorting integer(kind=int32), intent(out) :: tmp_stack_right (n_genes) Stack array for right indices during sorting integer(kind=int32), intent(out) :: tmp_int_workspace (int_workspace_size) Integer workspace array integer(kind=int32), intent(in) :: int_workspace_size Length of integer workspace.\nIt is VERY IMPORTANT to compute this argument from the int_workspace_size output produced by tox_loess_required_workspace . Read more… real(kind=real64), intent(out) :: tmp_real_workspace (real_workspace_size) Real workspace array integer(kind=int32), intent(in) :: real_workspace_size Length of real workspace.\nIt is VERY IMPORTANT to compute this argument from the real_workspace_size output produced by tox_loess_required_workspace . Read more… real(kind=real64), intent(inout) :: tmp_diagl (n_families) Diagonal elements of the weight matrix real(kind=real64), intent(out) :: tmp_weights (n_families) Initial weights for LOESS real(kind=real64), intent(inout) :: tmp_eval_points (n_families,1) Z matrix for LOESS fitting real(kind=real64), intent(out) :: tmp_robust_weights (n_families) Residuals for robust LOESS fitting real(kind=real64), intent(out), dimension(n_families), target :: tmp_combined_weights Working weights array real(kind=real64), intent(out), dimension(n_families), target :: tmp_residuals Residuals array integer(kind=int32), intent(out) :: tmp_permutation_indices (n_families) Permutation indices for robust LOESS fitting real(kind=real64), intent(out) :: tmp_fitted_values (n_families) Output array for LOESS predictions real(kind=real64), intent(in), optional :: span Span parameter for LOESS smoothing, passed straight to loess_fit_plain_impl , so it is held to that\nprocedure's own range rather than to the NaN tolerance the distance data carries.\nThe default value is 0.7_real64 .\nThe minimum valid value is EPS_LOESS .\nThe maximum valid value is 1.0_real64 . integer(kind=int32), intent(in), optional :: degree Degree of the LOESS polynomial\nThe default value is 2_int32 . integer(kind=int32), intent(in), optional :: mode Mode for LOESS fitting\nThe default value is 1_int32 . Read more… integer(kind=int32), intent(in), optional :: n_iters Number of iterations for robust LOESS fitting\nThe default value is 3_int32 . real(kind=real64), intent(out) :: low_sd_cutoff cutoff used to filter families with low std integer(kind=int32), intent(out) :: excluded_low_sd (n_families) Mask to save those families that have low sd real(kind=real64), intent(out) :: tmp_means_aux (n_families) Work array for saving raw means integer(kind=int32), intent(out) :: ierr Error code public pure subroutine compute_rdi_impl (n_genes, distances, gene_to_fam, dscale, rdi, sorted_rdi, perm, tmp_stack_left, tmp_stack_right) Author Vivian Bass License MIT Compute the hybrid RDI (Relative Distance Index) for each gene Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Total number of genes real(kind=real64), intent(in) :: distances (n_genes) Array of Euclidean distances for each gene to its centroid\nNaN is permitted for this value.\nInfinite values are permitted for this value. integer(kind=int32), intent(in) :: gene_to_fam (n_genes) Gene-to-family mapping (1-based indexing) real(kind=real64), intent(in) :: dscale (:) Array of scaling factors for each family\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(out) :: rdi (n_genes) Output array of RDI values for each gene real(kind=real64), intent(out) :: sorted_rdi (n_genes) Work array for sorting (dimension n_genes) integer(kind=int32), intent(out) :: perm (n_genes) Permutation array for sorting (dimension n_genes, should be pre-initialized with 1:n_genes) integer(kind=int32), intent(out) :: tmp_stack_left (n_genes) Stack array for sorting (dimension n_genes) integer(kind=int32), intent(out) :: tmp_stack_right (n_genes) Stack array for sorting (dimension n_genes) public pure subroutine identify_outliers_impl (n_genes, rdi, sorted_rdi, perm, is_outlier, threshold, quantile, percentile) Author Vivian Bass License MIT Identify gene outliers based on the top percentile of RDI values Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Total number of genes real(kind=real64), intent(in) :: rdi (n_genes) Array of RDI values for each gene\nNaN is permitted for this value.\nInfinite values are permitted for this value. real(kind=real64), intent(in) :: sorted_rdi (n_genes) Sorted RDI array (must be filtered to remove negatives and sorted in ascending order before calling)\nNaN is permitted for this value.\nInfinite values are permitted for this value. integer(kind=int32), intent(in) :: perm (n_genes) Permutation array with sorted indices logical(kind=c_bool), intent(out) :: is_outlier (n_genes) Output boolean array indicating outliers real(kind=real64), intent(out) :: threshold Output threshold value used for detection real(kind=real64), intent(out) :: quantile (n_genes) Empirical one-sided upper-tail quantile (effect-size measure) for each gene, i.e. how extreme an\nobserved distance is relative to all observed distances -- NOT a null-hypothesis-testing p-value.\nReturned in the same order as the input RDI array. Because distances are non-negative, a one-sided\nupper-tail quantile is used. real(kind=real64), intent(in), optional :: percentile Percentile threshold as a fraction in [0,1] (top 5% for the default).\nThe default value is 0.95_real64 .\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 . public  subroutine detect_outliers_impl (n_genes, n_families, distances, gene_to_fam, tmp_perm, tmp_stack_left, tmp_stack_right, tmp_int_workspace, int_workspace_size, tmp_real_workspace, real_workspace_size, tmp_diagl, tmp_weights, tmp_eval_points, tmp_robust_weights, tmp_combined_weights, tmp_residuals, tmp_permutation_indices, tmp_fitted_values, tmp_means_aux, tmp_dscale, tmp_excluded_low_sd, tmp_low_sd_cutoff, tmp_rdi, tmp_sorted_rdi, tmp_threshold, is_outlier, loess_x, loess_y, loess_n, quantile, ierr, percentile) Author Vivian Bass License MIT Main routine to detect outliers using RDI and LOESS-based scaling Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_genes Total number of genes integer(kind=int32), intent(in) :: n_families Total number of gene families real(kind=real64), intent(in) :: distances (n_genes) Array of Euclidean distances for each gene to its centroid\nNaN is permitted for this value.\nInfinite values are permitted for this value. integer(kind=int32), intent(in) :: gene_to_fam (n_genes) Gene-to-family mapping (1-based indexing) integer(kind=int32), intent(out) :: tmp_perm (n_genes) Permutation array for sorting integer(kind=int32), intent(out) :: tmp_stack_left (n_genes) Stack array for left indices during sorting integer(kind=int32), intent(out) :: tmp_stack_right (n_genes) Stack array for right indices during sorting integer(kind=int32), intent(out) :: tmp_int_workspace (int_workspace_size) Integer workspace array integer(kind=int32), intent(in) :: int_workspace_size Length of integer workspace.\nIt is VERY IMPORTANT to compute this argument from the int_workspace_size output produced by tox_loess_required_workspace . Read more… real(kind=real64), intent(out) :: tmp_real_workspace (real_workspace_size) Real workspace array integer(kind=int32), intent(in) :: real_workspace_size Length of real workspace.\nIt is VERY IMPORTANT to compute this argument from the real_workspace_size output produced by tox_loess_required_workspace . Read more… real(kind=real64), intent(out) :: tmp_diagl (n_families) Diagonal elements of the weight matrix real(kind=real64), intent(out) :: tmp_weights (n_families) Initial weights for LOESS real(kind=real64), intent(out) :: tmp_eval_points (n_families,1) Z matrix for LOESS fitting real(kind=real64), intent(out) :: tmp_robust_weights (n_families) Residuals for robust LOESS fitting real(kind=real64), intent(out) :: tmp_combined_weights (n_families) Working weights array real(kind=real64), intent(out) :: tmp_residuals (n_families) Residuals array integer(kind=int32), intent(out) :: tmp_permutation_indices (n_families) Permutation indices for robust LOESS fitting real(kind=real64), intent(out) :: tmp_fitted_values (n_families) Output array for LOESS predictions real(kind=real64), intent(out) :: tmp_means_aux (n_families) Work array for saving raw means real(kind=real64), intent(out) :: tmp_dscale (n_families) Per-family scaling factors (intermediate, consumed by the RDI step) integer(kind=int32), intent(out) :: tmp_excluded_low_sd (n_families) Low-sd family mask (intermediate, discarded) real(kind=real64), intent(out) :: tmp_low_sd_cutoff Low-sd cutoff (intermediate, discarded) real(kind=real64), intent(out) :: tmp_rdi (n_genes) RDI per gene (intermediate, consumed by the outlier step) real(kind=real64), intent(out) :: tmp_sorted_rdi (n_genes) Sorted RDI (intermediate, consumed by the outlier step) real(kind=real64), intent(out) :: tmp_threshold Detection threshold (intermediate, discarded) logical(kind=c_bool), intent(out) :: is_outlier (n_genes) Output boolean array indicating outliers real(kind=real64), intent(out) :: loess_x (n_families) Reference x-coordinates. real(kind=real64), intent(out) :: loess_y (n_families) Reference y-coordinates (length n_total). integer(kind=int32), intent(out) :: loess_n (n_families) Indices of reference points used for smoothing. real(kind=real64), intent(out) :: quantile (n_genes) Empirical one-sided upper-tail quantile (effect-size measure) for each gene, i.e. how extreme an\nobserved distance is relative to all observed distances -- NOT a null-hypothesis-testing p-value.\nReturned in the same order as the input RDI array. Because distances are non-negative, a one-sided\nupper-tail quantile is used. integer(kind=int32), intent(out) :: ierr Error code real(kind=real64), intent(in), optional :: percentile Percentile threshold as a fraction in [0,1] for outlier detection.\nThe default value is 0.95_real64 .\nThe minimum valid value is 0.0_real64 .\nThe maximum valid value is 1.0_real64 .","tags":"","url":"module/tox_get_outliers_impl.html"},{"title":"f42_serde_arrays_serialize_logical – TensorOmics","text":"Module for serializing logical arrays into files Uses iso_fortran_env iso_c_binding f42_serde_arrays_utils f42_safeguard tox_errors Subroutines public  subroutine serialize_logical_helper (arr, n_elements, arr_shape, filename, ierr) Author Aaron Schröder License MIT Category C-binding Subroutine to serialize a flat logical array into a file Read more… Arguments Type Intent Optional Attributes Name logical(kind=c_bool), intent(in), dimension(n_elements) :: arr Array to be serialized integer(kind=int32), intent(in) :: n_elements Number of strings in arr integer(kind=int32), intent(in), dimension(:) :: arr_shape Extents of arr , one per dimension character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code public  subroutine serialize_logical_1d (arr, filename, ierr) Author Aaron Schröder License MIT Directly serialize a 1D logical array into a file Arguments Type Intent Optional Attributes Name logical(kind=c_bool), intent(in), dimension(:), contiguous :: arr Array to be serialized character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code public  subroutine serialize_logical_2d (arr, filename, ierr) Author Aaron Schröder License MIT Directly serialize a 2D logical array into a file Arguments Type Intent Optional Attributes Name logical(kind=c_bool), intent(in), dimension(:, :), contiguous :: arr Array to be serialized character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code public  subroutine serialize_logical_3d (arr, filename, ierr) Author Aaron Schröder License MIT Directly serialize a 3D logical array into a file Arguments Type Intent Optional Attributes Name logical(kind=c_bool), intent(in), dimension(:, :, :), contiguous :: arr Array to be serialized character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code public  subroutine serialize_logical_4d (arr, filename, ierr) Author Aaron Schröder License MIT Directly serialize a 4D logical array into a file Arguments Type Intent Optional Attributes Name logical(kind=c_bool), intent(in), dimension(:, :, :, :), contiguous :: arr Array to be serialized character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code public  subroutine serialize_logical_5d (arr, filename, ierr) Author Aaron Schröder License MIT Directly serialize a 5D logical array into a file Arguments Type Intent Optional Attributes Name logical(kind=c_bool), intent(in), dimension(:, :, :, :, :), contiguous :: arr Array to be serialized character(len=*), intent(in) :: filename Name of the file to write to integer(kind=int32), intent(out) :: ierr Error code","tags":"","url":"module/f42_serde_arrays_serialize_logical.html"},{"title":"tox_clustering_impl – TensorOmics","text":"Clustering for tensor omics: k-means over factors and trajectories, and hierarchical\n(agglomerative) linkage clustering over a precomputed distance matrix. k_means_clustering partitions points in n dimensions; cluster_factor_trajectories_k_means applies the same to whole time series, treating each factor's trajectory as one point. linkage_clustering takes the distances already computed and merges under the linkage\ncriterion asked for, so the same matrix can be re-clustered without recomputing it. Uses f42_safeguard ieee_arithmetic iso_fortran_env iso_c_binding Variables Type Visibility Attributes Name Initial integer(kind=int32), public, parameter :: METHOD_AVERAGE = 0_int32 Method code for average linkage clustering in linkage_clustering integer(kind=int32), public, parameter :: METHOD_WEIGHTED = 1_int32 Method code for weighted linkage clustering in linkage_clustering integer(kind=int32), public, parameter :: METHOD_WARD = 2_int32 Method code for ward linkage clustering in linkage_clustering Subroutines public pure subroutine cluster_factor_trajectories_k_means_impl (n_clusters, trajectories, n_factors, n_samples, n_timepoints, centroids, labels, label_counts, max_iterations) Author Franz-Eric Sill License MIT Performs k-means clustering on factor trajectories, so factor evolution over time Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_clusters number ( k ) of clusters\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_samples*n_timepoints . real(kind=real64), intent(in), dimension(n_factors, n_samples, n_timepoints) :: trajectories matrix with data points to cluster integer(kind=int32), intent(in) :: n_factors number of factors integer(kind=int32), intent(in) :: n_samples number of samples integer(kind=int32), intent(in) :: n_timepoints number of timepoints real(kind=real64), intent(inout), dimension(n_factors, n_clusters) :: centroids matrix with initial centroids of the clusters, could be random data or actual points or unassigned garbage.\nThe centroids should be unique. This is not checked in this routine. Read more… integer(kind=int32), intent(out), dimension(n_samples*n_timepoints) :: labels array of labels, each index corresponds to the respective point's index, so first label is first point's label. Read more… integer(kind=int32), intent(out), dimension(n_clusters) :: label_counts holds the number of points having the respective label assigned integer(kind=int32), intent(in) :: max_iterations number of maximum iterations of the clustering public pure subroutine k_means_clustering_impl (n_clusters, data_points, n_points, n_dims, centroids, labels, label_counts, max_iterations) Author Franz-Eric Sill License MIT k-means clustering algorithm Read more… Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: n_clusters number ( k ) of clusters\nThe minimum valid value is 1_int32 .\nThe maximum valid value is n_points . real(kind=real64), intent(in), dimension(n_dims, n_points) :: data_points matrix with data points to cluster integer(kind=int32), intent(in) :: n_points number of points to cluster integer(kind=int32), intent(in) :: n_dims number of elements a point has real(kind=real64), intent(inout), dimension(n_dims, n_clusters) :: centroids matrix with initial centroids of the clusters, could be random data or actual points or unassigned garbage.\nThe centroids should be unique. This is not checked in this routine. Read more… integer(kind=int32), intent(out), dimension(n_points) :: labels array of labels, each index corresponds to the respective point's index, so first label is first point's label. Read more… integer(kind=int32), intent(out), dimension(n_clusters) :: label_counts holds the number of points having the respective label assigned integer(kind=int32), intent(in), optional :: max_iterations number of maximum iterations of the clustering.\nThe default value is 300_int32 . public pure subroutine k_means_recompute_cluster_centroids_helper (data_points, n_points, n_dims, centroids, n_clusters, labels, label_counts) Author Franz-Eric Sill License MIT Helper to recompute the centroids in k-means by taking the mean of assigned points Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_dims, n_points) :: data_points matrix with data points to cluster integer(kind=int32), intent(in) :: n_points number of points to cluster integer(kind=int32), intent(in) :: n_dims number of elements a point has real(kind=real64), intent(inout), dimension(n_dims, n_clusters) :: centroids matrix with initial centroids of the clusters, could be random data or actual points or unassigned garbage.\nThe centroids should be unique. This is not checked in this routine. Read more… integer(kind=int32), intent(in) :: n_clusters number ( k ) of clusters integer(kind=int32), intent(in), dimension(n_points) :: labels array of labels, each index corresponds to the respective point's index, so first label is first point's label. Read more… integer(kind=int32), intent(in), dimension(n_clusters) :: label_counts holds the number of points having the respective label assigned public pure subroutine k_means_assign_cluster_helper (i_point, n_clusters, data_points, n_points, n_dims, centroids, label) Author Franz-Eric Sill License MIT Helper routine to assign a cluster's label to a point in k-means Arguments Type Intent Optional Attributes Name integer(kind=int32), intent(in) :: i_point index of the point that should be assigned a cluster integer(kind=int32), intent(in) :: n_clusters number ( k ) of clusters real(kind=real64), intent(in), dimension(n_dims, n_points) :: data_points matrix with data points to cluster integer(kind=int32), intent(in) :: n_points number of points to cluster integer(kind=int32), intent(in) :: n_dims number of elements a point has real(kind=real64), intent(in), dimension(n_dims, n_clusters) :: centroids matrix with initial centroids of the clusters, could be random data or actual points or unassigned garbage.\nThe centroids should be unique. This is not checked in this routine. Read more… integer(kind=int32), intent(out) :: label assigned label public pure subroutine linkage_clustering_impl (distances, n_points, merge_i, merge_j, heights, cluster_sizes, method) Author Franz-Eric Sill License MIT Perform linkage clustering on a distance matrix. Read more… Arguments Type Intent Optional Attributes Name real(kind=real64), intent(inout), dimension(n_points, n_points) :: distances symmetric distance matrix, holding the positive distances between points. Distance of X->X is always zero. Read more… integer(kind=int32), intent(in) :: n_points number of points to cluster integer(kind=int32), intent(out), dimension(n_points - 1) :: merge_i holds cluster labels of the merged node pair at iteration k -> positives relate to leafs/data point indices, negatives to inner nodes integer(kind=int32), intent(out), dimension(n_points - 1) :: merge_j holds cluster labels of the merged node pair at iteration k -> positives relate to leafs/data point indices, negatives to inner nodes real(kind=real64), intent(out), dimension(n_points - 1) :: heights height of the shorter branch of the merge, e.g. if (A,B)+(C) merges to ((A,B),C), the branch to (A,B) is shorter integer(kind=int32), intent(out), dimension(n_points - 1) :: cluster_sizes size of cluster at iteration k integer(kind=int32), intent(in) :: method used algorithm\nThe minimum valid value is 0_int32 .\nThe maximum valid value is 2_int32 . Read more… public pure subroutine recover_distance_matrix_helper (distances, n_points) Author Franz-Eric Sill License MIT Helper to recover a distance matrix from its top triangle. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(inout), dimension(n_points, n_points) :: distances top triangle holds distances, bottom triangle will be recovered integer(kind=int32), intent(in) :: n_points number of points to cluster public pure subroutine get_cluster_data_linkage_helper (distances, n_points, cluster_sizes, idx, weight, cluster_label) Author Franz-Eric Sill License MIT Helper for linkage clustering to get the size/weight and label of a cluster\nby using the self-distance as indicator in which iteration the cluster was merged Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in), dimension(n_points, n_points) :: distances distance matrix, holding the distances between points integer(kind=int32), intent(in) :: n_points number of points to cluster integer(kind=int32), intent(in), dimension(n_points - 1) :: cluster_sizes size of cluster at iteration k integer(kind=int32), intent(in) :: idx index of cluster in distances integer(kind=int32), intent(out) :: weight number of leafs of cluster integer(kind=int32), intent(out) :: cluster_label index/label of cluster public pure subroutine merge_distances_xPGMA_linkage_helper (distances, n_points, idx_A, idx_B, size_A, size_B, iteration_k) Author Franz-Eric Sill License MIT Helper for *PGMA algorithms for updating the distance matrix on merge of two clusters Arguments Type Intent Optional Attributes Name real(kind=real64), intent(inout), dimension(n_points, n_points) :: distances distance matrix, holding the distances between points integer(kind=int32), intent(in) :: n_points number of points to cluster integer(kind=int32), intent(in) :: idx_A row index of min distance in distances integer(kind=int32), intent(in) :: idx_B column index of min distance in distances integer(kind=int32), intent(in) :: size_A cluster size of cluster at idx_A integer(kind=int32), intent(in) :: size_B cluster size of cluster at idx_B integer(kind=int32), intent(in) :: iteration_k iteration of current merge public pure subroutine merge_distances_ward_linkage_helper (distances, n_points, idx_A, idx_B, size_A, size_B, 