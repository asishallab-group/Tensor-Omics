      "    abs_residual_pool=${2:abs_residual_pool},",
      "    residual_range_quantile=${3:95.0},",
      ")"
    ]
  },
  "determine_shared_residual_range_expert (call)": {
    "prefix": "tox:determine_shared_residual_range_expert",
    "description": "This takes the pool already built; `determine_study_shared_residual_range` builds it from",
    "body": [
