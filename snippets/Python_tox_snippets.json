    "body": [
      "${1:result} = normalize_all_trajectories(",
      "    trajectories=${2:trajectories},",
      ")"
    ]
  },
  "tox_error (handler)": {
    "prefix": "tox:try",
    "description": "Call a wrapper and handle a ToxError",
    "body": [
      "try:",
      "    ${1:result} = ${2:call}",
      "except ToxError as ${3:error}:",
      "    ${0:raise}"
    ]
  }
}
