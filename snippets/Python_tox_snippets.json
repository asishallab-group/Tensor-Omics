  "determine_study_shared_residual_range (call)": {
    "prefix": "tox:determine_study_shared_residual_range",
    "description": "Pools the absolute residuals of both studies, sorts them, and takes the quantile exactly",
    "body": [
      "${1:result} = determine_study_shared_residual_range(",
      "    neighborhood_residuals_S1=${2:neighborhood_residuals_S1},",
      "    neighborhood_residuals_S2=${3:neighborhood_residuals_S2},",
