# Everything under src/generated is written by helper/generate_code.py from the `_impl`
# modules elsewhere under src/. Marking it keeps it out of language statistics and collapses
# it in diffs, so a review sees the implementation that changed rather than the fan-out it
# produced.
src/generated/** linguist-generated=true
python/tensor_omics/** linguist-generated=true
r/tensor_omics/** linguist-generated=true
snippets/** linguist-generated=true

# doc/ is written by Ford in the main-branch workflow (.github/workflows/main_branch.yml),
# never by hand and never on a feature branch. Marking it collapses it in diffs as well.
doc/** linguist-generated=true
