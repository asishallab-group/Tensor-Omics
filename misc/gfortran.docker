FROM archlinux:latest

# Always update keyring first to avoid verification failures
RUN pacman -Sy --noconfirm archlinux-keyring && \
    pacman -Syu --noconfirm && \
    pacman -Sy --noconfirm gcc-fortran gcc make xxhash libzip python python-pip python-numpy && \
    pacman -Sy --noconfirm r gcc-fortran git && \
    pacman -Scc --noconfirm

# Install fpm binary
RUN curl -L --output /usr/local/bin/fpm \
  https://github.com/fortran-lang/fpm/releases/download/v0.13.0/fpm-0.13.0-linux-x86_64-gcc-12 && \
  chmod a+x /usr/local/bin/fpm

# Install R Rcpp package
RUN Rscript -e "install.packages(c('Rcpp', 'dplyr', 'tidyr', 'ggplot2', 'purr', 'patchwork', 'data.table', 'parallel'), repos='https://cloud.r-project.org/')"

WORKDIR /opt

CMD ["/bin/bash"]