*

# generics
!**/*.gitkeep
!**/[Rr]eadme.md
!**/README.md

# .
!.gitignore
!*.h
!build*.sh
!test_runner.sh
!run_all_tests.sh
!fpm.toml
!*.md
!LICENSE

# test
!test
!test/test_files
!test/test_files/**/*
!test/mod_test*.[fF]90
!test/run_tests.[Ff]90
!test/test_suite.[Ff]90
!test/asserts.[Ff]90

# src
!src
# src all contained dirs
!src/**/*/
!src/**/*.[Ff]90
!src/**/macros.h

# snippets
!snippets

# python
!python
!python/test
!python/test/mod_test_*.py
!python/*.py

# R
!rcpp
!rcpp/test
!rcpp/test/mod_test_*.R
!rcpp/*.R
!rcpp/tensoromics_functions.cpp

# misc
!misc
!misc/**/*

# material
!material
!material/*.[tc]sv

# helper
!helper
!helper/*.py
!helper/*.sh

# loess_netlib
!external
!external/loess_netlib
!external/loess_netlib/fpm.toml
!external/loess_netlib/src
!external/loess_netlib/src/*.f

# drotg
!external/loess_netlib/drotg
!external/loess_netlib/drotg/fpm.toml
!external/loess_netlib/drotg/src
!external/loess_netlib/drotg/src/drotg.f90

# .github
!.github
!.github/actions
!.github/actions/*/
!.github/workflows
!.github/**/*.yml